local settings = env.LHUISettings or {}
env.LHUISettings = settings
if settings.ReducedMotion == nil then settings.ReducedMotion = false end
if settings.LowPerformance == nil then settings.LowPerformance = false end
if settings.DragLocked == nil then settings.DragLocked = false end
if settings.EdgeSnap == nil then settings.EdgeSnap = true end
if settings.ScaleMode == nil then settings.ScaleMode = "Auto" end
if settings.GlassBlur == nil then settings.GlassBlur = false end
if settings.CustomCursor == nil then settings.CustomCursor = false end
if settings.NotificationMuted == nil then settings.NotificationMuted = true end
if settings.NotificationVolume == nil then settings.NotificationVolume = 0.45 end
if settings.UIFont == nil then settings.UIFont = "Gotham" end
if settings.AppearanceMode == nil then settings.AppearanceMode = "Dark" end
if settings.ShelfEnabled == nil then settings.ShelfEnabled = true end
if settings.ShelfAutoSave == nil then settings.ShelfAutoSave = false end
if type(settings.AnimationBundleFavorites) ~= "table" then settings.AnimationBundleFavorites = {} end
if settings.AnimationBundleAutoSave == nil then settings.AnimationBundleAutoSave = true end
if type(settings.FreeEmoteFavorites) ~= "table" then settings.FreeEmoteFavorites = {} end
if settings.FreeEmoteAutoSave == nil then settings.FreeEmoteAutoSave = true end
if type(settings.AvatarKreatorFavorites) ~= "table" then settings.AvatarKreatorFavorites = {} end
if type(settings.AvatarKreatorSavedOutfits) ~= "table" then settings.AvatarKreatorSavedOutfits = {} end
if type(settings.AutoExecuteScripts) ~= "table" then settings.AutoExecuteScripts = {} end
if settings.ThemeBrightness == nil then settings.ThemeBrightness = 0 end
if type(settings.FreeEmoteSpeeds) ~= "table" then settings.FreeEmoteSpeeds = {} end

local active = nil
local fontMap = {}
local fontNames = {}
for _, fontItem in ipairs(Enum.Font:GetEnumItems()) do
    fontMap[fontItem.Name] = fontItem
    table.insert(fontNames, fontItem.Name)
end
table.sort(fontNames)

local function resolveUIFont(fallback)
    return fontMap[tostring(settings.UIFont or "")] or fallback or Enum.Font.Gotham
end

local function applyUIFont()
    if not active or not active.ScreenGui then return end
    local selected = resolveUIFont(Enum.Font.Gotham)
    for _, object in ipairs(active.ScreenGui:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            pcall(function() object.Font = selected end)
        end
    end
end

active = nil
local connections = {}
local bindings = {}
local notificationHistory = env.LHNotificationHistory or {}
env.LHNotificationHistory = notificationHistory
local thumbnailCache = {}
-- Roblox Instances cannot hold arbitrary Lua fields. Keep kontrol metadata in a weak registry instead.
local sectionControlRegistry = setmetatable({}, {__mode = "k"})
local controlFrameRegistry = setmetatable({}, {__mode = "k"})
local controlIdRegistry = {}
local openControlMenu = nil
local activeInlineInfo = nil
local activeInlineInfoToken = 0

local function shallowCopyArray(source)
    local result = {}
    if type(source) == "table" then
        for index, value in ipairs(source) do result[index] = value end
    end
    return result
end

local function valuesEqual(a, b)
    if typeof(a) == "Color3" and typeof(b) == "Color3" then return a == b end
    if typeof(a) == "EnumItem" and typeof(b) == "EnumItem" then return a == b end
    return a == b
end

local function encodeSessionValue(value)
    local kind = typeof(value)
    if kind == "nil" then return nil end
    if kind == "boolean" or kind == "number" or kind == "string" then return value end
    if kind == "Color3" then
        return {__LHType = "Color3", R = value.R, G = value.G, B = value.B}
    end
    if kind == "EnumItem" then
        return {__LHType = "EnumItem", EnumType = tostring(value.EnumType), Name = value.Name}
    end
    return nil
end

local function decodeSessionValue(value)
    if type(value) ~= "table" then return value, true end
    if value.__LHType == "Color3" then
        return Color3.new(
            math.clamp(tonumber(value.R) or 0, 0, 1),
            math.clamp(tonumber(value.G) or 0, 0, 1),
            math.clamp(tonumber(value.B) or 0, 0, 1)
        ), true
    end
    if value.__LHType == "EnumItem" then
        local enumName = tostring(value.EnumType or ""):match("Enum%.(.+)")
        local enumType = enumName and Enum[enumName]
        local enumItem = enumType and enumType[tostring(value.Name or "")]
        if enumItem then return enumItem, true end
        return nil, false
    end
    return nil, false
end

local function markSettingsDirty()
    if env.LHRuntime and type(env.LHRuntime.SettingChanged) == "function" then
        pcall(function() env.LHRuntime:SettingChanged() end)
    end
end

local function saveSettingsNow()
    if env.LHRuntime and type(env.LHRuntime.SaveSettings) == "function" then
        task.defer(function() pcall(function() env.LHRuntime:SaveSettings() end) end)
    end
end

local function persistUiStateEdit()
    markSettingsDirty()
    if settings.ShelfAutoSave == true then saveSettingsNow() end
end

local function persistIndependentShelfSetting()
    -- Shelf Auto Save and Shelf Hold Menu remember their own state even when
    -- the main Save Settings button was not pressed.
    markSettingsDirty()
    saveSettingsNow()
end

local function track(connection)
    if connection then
        table.insert(connections, connection)
    end
    return connection
end

local function disconnectAll()
    for i = #connections, 1, -1 do
        local connection = connections[i]
        pcall(function()
            if connection and connection.Connected then connection:Disconnect() end
        end)
        connections[i] = nil
    end
end

local function safeCall(label, callback, ...)
    local args = table.pack(...)
    local ok, result = xpcall(function()
        return callback(table.unpack(args, 1, args.n))
    end, function(err)
        return debug.traceback(tostring(err), 2)
    end)
    if not ok then
        warn("[Lollypop UI] " .. tostring(label) .. " failed:\n" .. tostring(result))
        if env.LHNotify then
            pcall(env.LHNotify, "error", "Kontrol Error", tostring(result), 7)
        end
    end
    return ok, result
end

local function duration(seconds)
    if settings.ReducedMotion or settings.LowPerformance then return 0 end
    return seconds or 0.16
end

local function tween(object, properties, seconds, style, direction)
    if not object or not object.Parent then return nil end
    local d = duration(seconds)
    if d <= 0 then
        for property, value in pairs(properties) do
            pcall(function() object[property] = value end)
        end
        return nil
    end
    local tweenObject = TweenService:Create(
        object,
        TweenInfo.new(d, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
        properties
    )
    tweenObject:Play()
    return tweenObject
end

local function cloneTheme(source)
    local result = {}
    for key, value in pairs(source or {}) do result[key] = value end
    result.SchemeColor = result.SchemeColor or defaultAccent
    result.Accent2 = result.Accent2 or result.SchemeColor
    result.Background = result.Background or rgb(18, 18, 22)
    result.Header = result.Header or rgb(12, 12, 15)
    result.TextColor = result.TextColor or rgb(255, 255, 255)
    result.MutedText = result.MutedText or rgb(170, 170, 180)
    result.ElementColor = result.ElementColor or rgb(29, 29, 36)
    result.Danger = result.Danger or rgb(255, 70, 88)
    result.NotificationColor = result.NotificationColor or result.ElementColor
    result.NotificationTrack = result.NotificationTrack or result.Header
    result.StatusTextColor = result.StatusTextColor or result.TextColor
    return result
end

local function colorLuminance(color)
    local function channel(value)
        if value <= 0.03928 then return value / 12.92 end
        return ((value + 0.055) / 1.055) ^ 2.4
    end
    return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
    local l1, l2 = colorLuminance(a), colorLuminance(b)
    if l1 < l2 then l1, l2 = l2, l1 end
    return (l1 + 0.05) / (l2 + 0.05)
end

local function readableTextColor(color, theme)
    if typeof(color) ~= "Color3" then return rgb(245, 245, 248) end
    theme = theme or themes.Kandy
    local backgrounds = {
        theme.Background or rgb(18, 18, 22),
        theme.Header or rgb(12, 12, 15),
        theme.ElementColor or rgb(29, 29, 36),
    }
    local function lowestContrast(candidate)
        local lowest = math.huge
        for _, background in ipairs(backgrounds) do
            lowest = math.min(lowest, contrastRatio(candidate, background))
        end
        return lowest
    end
    if lowestContrast(color) >= 3.2 then return color end

    -- Never use pure black. Pick the safer off-white or readable charcoal.
    local light = rgb(248, 248, 252)
    local charcoal = rgb(42, 43, 52)
    if lowestContrast(light) >= lowestContrast(charcoal) then return light end
    return charcoal
end

local function blendColor(a, b, amount)
    amount = math.clamp(tonumber(amount) or 0, 0, 1)
    return Color3.new(
        a.R + (b.R - a.R) * amount,
        a.G + (b.G - a.G) * amount,
        a.B + (b.B - a.B) * amount
    )
end

local function brightenAccent(color, amount)
    local h, s, v = Color3.toHSV(color)
    amount = math.clamp(tonumber(amount) or 0.2, 0, 1)
    return Color3.fromHSV(h, math.clamp(s * 0.94 + 0.03, 0, 1), math.clamp(v + (1 - v) * amount, 0, 1))
end

local function applyAppearanceMode(theme)
    theme = cloneTheme(theme)
    local white = rgb(255, 255, 255)
    local isLight = string.lower(tostring(settings.AppearanceMode or "Dark")) == "light"

    if isLight then
        theme.SchemeColor = brightenAccent(theme.SchemeColor, 0.24)
        theme.Accent2 = brightenAccent(theme.Accent2, 0.24)
        theme.Background = blendColor(theme.Background, white, 0.91)
        theme.Header = blendColor(theme.Header, white, 0.86)
        theme.ElementColor = blendColor(theme.ElementColor, white, 0.80)
        theme.TextColor = rgb(39, 40, 48)
        theme.MutedText = blendColor(theme.SchemeColor, rgb(62, 64, 76), 0.78)
        theme.Danger = brightenAccent(theme.Danger, 0.16)
        theme.NotificationColor = blendColor(theme.ElementColor, white, 0.28)
        theme.NotificationTrack = blendColor(theme.Header, rgb(118, 120, 132), 0.14)
        theme.StatusTextColor = theme.SchemeColor
        return theme
    end

    -- Dark mode keeps the selected theme rich and readable instead of crushing
    -- every panel into near-black. The original kolor identity stays intact.
    theme.SchemeColor = brightenAccent(theme.SchemeColor, 0.15)
    theme.Accent2 = brightenAccent(theme.Accent2, 0.13)
    theme.Danger = brightenAccent(theme.Danger, 0.10)
    local tint = blendColor(theme.SchemeColor, theme.Accent2, 0.34)
    theme.Background = blendColor(blendColor(theme.Background, white, 0.075), tint, 0.095)
    theme.Header = blendColor(blendColor(theme.Header, white, 0.105), tint, 0.085)
    theme.ElementColor = blendColor(blendColor(theme.ElementColor, white, 0.145), tint, 0.105)
    theme.TextColor = blendColor(theme.TextColor, white, 0.12)
    theme.MutedText = blendColor(theme.MutedText, white, 0.20)
    theme.NotificationColor = blendColor(blendColor(theme.ElementColor, white, 0.07), tint, 0.045)
    theme.NotificationTrack = blendColor(theme.Header, white, 0.17)
    theme.StatusTextColor = rgb(255, 255, 255)
    return theme
end

local function resolveTheme(theme)
    local base
    if type(theme) == "string" then
        base = cloneTheme(themes[theme] or themes.Kandy)
    elseif type(theme) == "table" then
        base = cloneTheme(theme)
    else
        base = cloneTheme(themes.Kandy)
    end
    local resolved = applyAppearanceMode(base)
    local brightness = math.clamp(tonumber(settings.ThemeBrightness) or 0, -80, 100) / 100
    if brightness ~= 0 then
        local target = brightness > 0 and rgb(255, 255, 255) or rgb(0, 0, 0)
        local amount = math.abs(brightness) * 0.58
        resolved.SchemeColor = blendColor(resolved.SchemeColor, target, amount)
        resolved.Accent2 = blendColor(resolved.Accent2, target, amount)
        resolved.Background = blendColor(resolved.Background, target, amount * 0.40)
        resolved.Header = blendColor(resolved.Header, target, amount * 0.36)
        resolved.ElementColor = blendColor(resolved.ElementColor, target, amount * 0.46)
        resolved.MutedText = readableTextColor(blendColor(resolved.MutedText, target, amount * 0.28), resolved)
        resolved.TextColor = readableTextColor(resolved.TextColor, resolved)
    end
    return resolved
end

local function bind(object, property, themeKey)
    table.insert(bindings, {Object = object, Property = property, Key = themeKey})
    if active and active.Theme and active.Theme[themeKey] ~= nil then
        pcall(function() object[property] = active.Theme[themeKey] end)
    end
end

local function applyTheme()
    if not active then return end
    for i = #bindings, 1, -1 do
        local record = bindings[i]
        if not record.Object or not record.Object.Parent then
            table.remove(bindings, i)
        else
            local value = active.Theme[record.Key]
            if record.Property == "TextColor3" and record.Object:GetAttribute("LHForceWhiteText") then
                value = rgb(255, 255, 255)
            end
            if value ~= nil then
                pcall(function() record.Object[record.Property] = value end)
            end
        end
    end
    if active.SideGradient then
        active.SideGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, active.Theme.SchemeColor),
            ColorSequenceKeypoint.new(1, active.Theme.Accent2),
        })
    end
    if active.MainStroke then active.MainStroke.Color = DRAG_GLOW_COLOR end
    if active.Island and active.Island.Stroke then active.Island.Stroke.Color = active.Theme.SchemeColor end
    if active.AnimationBundles and type(active.AnimationBundles.RefreshTheme) == "function" then
        pcall(active.AnimationBundles.RefreshTheme)
    end
    if active.FreeEmotes and type(active.FreeEmotes.RefreshTheme) == "function" then
        pcall(active.FreeEmotes.RefreshTheme)
    end
    if active.AvatarKreator and type(active.AvatarKreator.RefreshTheme) == "function" then
        pcall(active.AvatarKreator.RefreshTheme)
    end
end

local function makeCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
    return corner
end

local function makeStroke(parent, color, transparency, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or rgb(255, 255, 255)
    stroke.Transparency = transparency or 0.72
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

local function makeText(parent, text, size, font)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Font = resolveUIFont(font or Enum.Font.Gotham)
    label.Text = tostring(text or "")
    label.TextSize = size or 15
    label.TextWrapped = true
    label.Parent = parent
    bind(label, "TextColor3", "TextColor")
    return label
end

-- Original Lollypop action glyph: kandy head, stick, shine, and spark.
-- This replaces the basic pointer-finger emoji on normal buttons.
local function makeLollyActionIcon(parent)
    local holder = Instance.new("Frame")
    holder.Name = "LollyActionIcon"
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Parent = parent

    local stick = Instance.new("Frame")
    stick.Name = "Stick"
    stick.AnchorPoint = Vector2.new(0.5, 0)
    stick.Position = UDim2.fromOffset(14, 10)
    stick.Size = UDim2.fromOffset(3, 11)
    stick.Rotation = -36
    stick.BackgroundColor3 = rgb(245, 245, 249)
    stick.BorderSizePixel = 0
    stick.Parent = holder
    makeCorner(stick, 999)

    local candy = Instance.new("Frame")
    candy.Name = "Kandy"
    candy.Position = UDim2.fromOffset(2, 1)
    candy.Size = UDim2.fromOffset(13, 13)
    candy.BorderSizePixel = 0
    candy.Parent = holder
    bind(candy, "BackgroundColor3", "SchemeColor")
    makeCorner(candy, 999)
    makeStroke(candy, rgb(255, 255, 255), 0.28, 1)

    local swirl = Instance.new("Frame")
    swirl.Name = "Swirl"
    swirl.AnchorPoint = Vector2.new(0.5, 0.5)
    swirl.Position = UDim2.fromScale(0.55, 0.55)
    swirl.Size = UDim2.fromOffset(8, 3)
    swirl.Rotation = 28
    swirl.BorderSizePixel = 0
    swirl.Parent = candy
    bind(swirl, "BackgroundColor3", "Accent2")
    makeCorner(swirl, 999)

    local shine = Instance.new("Frame")
    shine.Name = "Shine"
    shine.Position = UDim2.fromOffset(3, 2)
    shine.Size = UDim2.fromOffset(3, 3)
    shine.BackgroundColor3 = rgb(255, 255, 255)
    shine.BackgroundTransparency = 0.08
    shine.BorderSizePixel = 0
    shine.Parent = candy
    makeCorner(shine, 999)

    local spark = Instance.new("Frame")
    spark.Name = "Spark"
    spark.Position = UDim2.fromOffset(17, 2)
    spark.Size = UDim2.fromOffset(3, 3)
    spark.BorderSizePixel = 0
    spark.Parent = holder
    bind(spark, "BackgroundColor3", "Accent2")
    makeCorner(spark, 999)

    return holder
end

local function createButtonRipple(button, inputObject)
    if button and button:GetAttribute("LHNoRipple") == true then return end
    if settings.ReducedMotion or settings.LowPerformance then return end
    if not button or not button.Parent then return end
    local absoluteSize = button.AbsoluteSize
    if absoluteSize.X <= 0 or absoluteSize.Y <= 0 then return end

    local absolutePosition = button.AbsolutePosition
    local point = inputObject and inputObject.Position or Vector3.new(
        absolutePosition.X + (absoluteSize.X * 0.5),
        absolutePosition.Y + (absoluteSize.Y * 0.5),
        0
    )
    local diameter = math.max(absoluteSize.X, absoluteSize.Y) * 2.25
    local ripple = Instance.new("Frame")
    ripple.Name = "LHRipple"
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Position = UDim2.fromOffset(point.X - absolutePosition.X, point.Y - absolutePosition.Y)
    ripple.Size = UDim2.fromOffset(0, 0)
    ripple.BackgroundColor3 = (active and active.Theme and active.Theme.SchemeColor) or defaultAccent
    ripple.BackgroundTransparency = 0.52
    ripple.BorderSizePixel = 0
    ripple.Active = false
    ripple.ZIndex = math.max(1, button.ZIndex)
    ripple.Parent = button
    makeCorner(ripple, 999)

    tween(ripple, {
        Size = UDim2.fromOffset(diameter, diameter),
        BackgroundTransparency = 1,
    }, 0.34, Enum.EasingStyle.Quad)
    task.delay(duration(0.38), function()
        if ripple then pcall(function() ripple:Destroy() end) end
    end)
end

local function addButtonPressEffect(button)
    if not button or not button:IsA("GuiButton") then return end
    if button:GetAttribute("LHPressEffectBound") then return end
    button:SetAttribute("LHPressEffectBound", true)
    button.ClipsDescendants = true
    local scaleObject = button:FindFirstChild("LHPressScale") or Instance.new("UIScale")
    scaleObject.Name = "LHPressScale"
    scaleObject.Scale = 1
    scaleObject.Parent = button
    local pressing = false
    track(button.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = true
            createButtonRipple(button, inputObject)
            tween(scaleObject, {Scale = 0.955}, 0.06, Enum.EasingStyle.Quad)
        end
    end))
    track(button.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = false
            tween(scaleObject, {Scale = 1}, 0.09, Enum.EasingStyle.Back)
        end
    end))
    track(button.MouseLeave:Connect(function()
        if pressing then
            pressing = false
            tween(scaleObject, {Scale = 1}, 0.09, Enum.EasingStyle.Back)
        end
    end))
end

local function makeButton(parent, text)
    local button = Instance.new("TextButton")
    button.AutoButtonColor = false
    button.BorderSizePixel = 0
    button.Font = resolveUIFont(Enum.Font.GothamMedium)
    button.Text = tostring(text or "")
    button.TextSize = 14
    button.Parent = parent
    bind(button, "TextColor3", "TextColor")
    bind(button, "BackgroundColor3", "ElementColor")
    makeCorner(button, 7)
    addButtonPressEffect(button)
    return button
end

local function makeKolorButton(parent, text, kolor)
    local button = Instance.new("TextButton")
    button.AutoButtonColor = false
    button.BorderSizePixel = 0
    button.Font = resolveUIFont(Enum.Font.GothamBold)
    button.Text = tostring(text or "")
    button.TextSize = 14
    button.TextColor3 = rgb(255, 255, 255)
    button.BackgroundColor3 = kolor
    button.Parent = parent
    makeCorner(button, 7)
    addButtonPressEffect(button)
    return button
end

local function attachClearX(textBox, onClear)
    if not textBox then return nil end
    local clearParent = textBox.Parent or textBox
    local existing = clearParent:FindFirstChild(tostring(textBox.Name) .. "_ClearTextX")
    if existing then return existing end

    local padding = textBox:FindFirstChildOfClass("UIPadding") or Instance.new("UIPadding")
    if padding.PaddingLeft.Offset == 0 then padding.PaddingLeft = UDim.new(0, 8) end
    padding.PaddingRight = UDim.new(0, 28)
    padding.Parent = textBox

    -- Make X a sibling instead of a child of the TextBox so tapping it cannot focus the keyboard.
    local clear = makeKolorButton(clearParent, "X", rgb(220, 48, 65))
    clear.Name = tostring(textBox.Name) .. "_ClearTextX"
    clear.AnchorPoint = Vector2.new(1, 0.5)
    clear.Position = UDim2.new(
        textBox.Position.X.Scale + textBox.Size.X.Scale,
        textBox.Position.X.Offset + textBox.Size.X.Offset - 3,
        textBox.Position.Y.Scale + (textBox.Size.Y.Scale * 0.5),
        textBox.Position.Y.Offset + (textBox.Size.Y.Offset * 0.5)
    )
    clear.Size = UDim2.fromOffset(20, 20)
    clear.TextSize = 10
    clear.ZIndex = math.max(5, textBox.ZIndex + 2)

    track(clear.MouseButton1Click:Connect(function()
        pcall(function() textBox:ReleaseFocus(false) end)
        textBox.Text = ""
        if type(onClear) == "function" then safeCall("Clear TextBox", onClear, textBox) end
    end))
    return clear
end

local function viewportSize()
    local camera = workspace.CurrentCamera
    if camera then return camera.ViewportSize end
    local ok, size = pcall(function() return UserInputService:GetScreenResolution() end)
    if ok then return size end
    return Vector2.new(1280, 720)
end

local function adaptiveScale()
    local size = viewportSize()
    local safeW = math.max(320, size.X - 24)
    local safeH = math.max(280, size.Y - 70)
    local fit = math.min(safeW / 525, safeH / 330, 1)
    if settings.ScaleMode == "Mini" then fit = math.min(fit, 0.72)
    elseif settings.ScaleMode == "Normal" then fit = math.min(fit, 1)
    elseif settings.ScaleMode == "Large" then fit = math.min(math.max(fit, 0.92), 1.12) end
    return math.max(0.58, fit)
end

local function clampMain(main)
    if not main or not main.Parent then return end
    local view = viewportSize()
    local size = main.AbsoluteSize
    local pos = main.AbsolutePosition
    local x = math.clamp(pos.X, 6, math.max(6, view.X - size.X - 6))
    local y = math.clamp(pos.Y, 6, math.max(6, view.Y - size.Y - 6))
    main.Position = UDim2.fromOffset(
        x + size.X * main.AnchorPoint.X,
        y + size.Y * main.AnchorPoint.Y
    )
end

local function snapMain(main)
    if not settings.EdgeSnap then
        clampMain(main)
        return
    end
    local view = viewportSize()
    local size = main.AbsoluteSize
    local pos = main.AbsolutePosition
    local margin = 14
    local x = math.clamp(pos.X, 6, math.max(6, view.X - size.X - 6))
    local y = math.clamp(pos.Y, 6, math.max(6, view.Y - size.Y - 6))
    local left = x
    local right = view.X - (x + size.X)
    local top = y
    local bottom = view.Y - (y + size.Y)
    local nearest = math.min(left, right, top, bottom)
    if nearest == left and left <= margin then x = 6
    elseif nearest == right and right <= margin then x = math.max(6, view.X - size.X - 6)
    elseif nearest == top and top <= margin then y = 6
    elseif nearest == bottom and bottom <= margin then y = math.max(6, view.Y - size.Y - 6) end
    tween(main, {Position = UDim2.fromOffset(
        x + size.X * main.AnchorPoint.X,
        y + size.Y * main.AnchorPoint.Y
    )}, 0.13)
end

function LULA:DraggingEnabled(handle, target)
    target = target or handle
    local dragging = false
    local dragInput = nil
    local startPosition = nil
    local startFrame = nil

    local function setDragGlow(enabled)
        if not active or target ~= active.Main or not active.MainStroke then return end
        -- The drag outline is intentionally always white. Theme or appearance
        -- changes are never allowed to tint it black, dim, or another kolor.
        active.MainStroke.Color = DRAG_GLOW_COLOR
        if enabled then
            tween(active.MainStroke, {Color = DRAG_GLOW_COLOR, Transparency = 0.10, Thickness = 5.2}, 0.10, Enum.EasingStyle.Quad)
        else
            tween(active.MainStroke, {Color = DRAG_GLOW_COLOR, Transparency = 1, Thickness = 1}, 0.16, Enum.EasingStyle.Quad)
        end
    end

    track(handle.InputBegan:Connect(function(inputObject)
        if settings.DragLocked then return end
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = inputObject
            startPosition = inputObject.Position
            startFrame = target.Position
            setDragGlow(true)
            local ended
            ended = inputObject.Changed:Connect(function()
                if inputObject.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    setDragGlow(false)
                    if ended then ended:Disconnect() end
                    -- Main UI intentionally stays exactly where the user drops it.
                end
            end)
            track(ended)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(inputObject)
        if not dragging or settings.DragLocked then return end
        if inputObject == dragInput or inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then
            local delta = inputObject.Position - startPosition
            target.Position = UDim2.new(
                startFrame.X.Scale, startFrame.X.Offset + delta.X,
                startFrame.Y.Scale, startFrame.Y.Offset + delta.Y
            )
        end
    end))
end

local function createReset(parent, callback)
    local reset = makeButton(parent, "R")
    reset.Name = "Reset"
    reset.AnchorPoint = Vector2.new(1, 0.5)
    reset.Position = UDim2.new(1, -7, 0.5, 0)
    reset.Size = UDim2.fromOffset(24, 24)
    reset.TextSize = 11
    reset.ZIndex = 5
    reset.BackgroundTransparency = 0.12
    track(reset.MouseButton1Click:Connect(function()
        local node = parent
        local settingsControl = false
        while node do
            if node:GetAttribute("LHTabName") == "Ui Kustomization" then
                settingsControl = true
                break
            end
            node = node.Parent
        end
        local resetAction = function()
            safeCall("Reset " .. tostring(parent.Name), callback)
        end
        if settingsControl and type(env.LHConfirmReset) == "function" then
            env.LHConfirmReset("Are you sure you want to reset " .. tostring(parent.Name) .. " to default?", resetAction)
        else
            resetAction()
        end
    end))
    return reset
end

local function dismissInlineInfo(instant)
    local overlay = activeInlineInfo
    if not overlay then return end
    activeInlineInfo = nil
    activeInlineInfoToken = activeInlineInfoToken + 1

    if not overlay.Parent then return end
    if instant then
        overlay:Destroy()
        return
    end

    tween(overlay, {BackgroundTransparency = 1, TextTransparency = 1}, 0.12)
    task.delay(0.14, function()
        if overlay and overlay.Parent then overlay:Destroy() end
    end)
end

-- Any new interaction closes the current explanation immediately. The
-- four-sekond timer is only a fallback for users who do nothing else.
track(UserInputService.InputBegan:Connect(function()
    if activeInlineInfo then dismissInlineInfo(false) end
end))
track(UserInputService.InputChanged:Connect(function(inputObject)
    if not activeInlineInfo then return end
    if inputObject.UserInputType == Enum.UserInputType.MouseWheel
        or inputObject.KeyCode == Enum.KeyCode.Thumbstick1
        or inputObject.KeyCode == Enum.KeyCode.Thumbstick2 then
        dismissInlineInfo(false)
    end
end))

local function createInfoButton(row, title, tip, xOffset, yOffset)
    tip = tostring(tip or "")
    if tip == "" then tip = "No extra information was added for this kontrol yet." end
    local infoButton = makeButton(row, "...")
    infoButton.Name = "InfoDots"
    infoButton.AnchorPoint = Vector2.new(1, 0)
    infoButton.Position = UDim2.new(1, tonumber(xOffset) or -5, 0, tonumber(yOffset) or 4)
    infoButton.Size = UDim2.fromOffset(26, 22)
    infoButton.TextSize = 14
    infoButton.BackgroundTransparency = 0.08
    infoButton.ZIndex = 25
    infoButton.Selectable = false
    infoButton:SetAttribute("LHNoRipple", true)

    track(infoButton.Activated:Connect(function()
        dismissInlineInfo(true)
        activeInlineInfoToken = activeInlineInfoToken + 1
        local mine = activeInlineInfoToken

        local availableWidth = math.max(180, row.AbsoluteSize.X > 0 and row.AbsoluteSize.X or 260)
        local message = tostring(title or row.Name or "Kontrol Info") .. "\n" .. tip
        local bounds = TextService:GetTextSize(
            message,
            11.5,
            resolveUIFont(Enum.Font.GothamMedium),
            Vector2.new(math.max(120, availableWidth - 20), 1000)
        )
        local overlayHeight = math.clamp(
            math.max(row.AbsoluteSize.Y, math.ceil(bounds.Y) + 16),
            34,
            112
        )

        local overlay = Instance.new("TextLabel")
        overlay.Name = "LHInlineKontrolInfo"
        overlay.AnchorPoint = Vector2.new(0, 0.5)
        overlay.Position = UDim2.new(0, 0, 0.5, 0)
        overlay.Size = UDim2.new(1, 0, 0, overlayHeight)
        overlay.BackgroundTransparency = 1
        overlay.BorderSizePixel = 0
        overlay.Font = resolveUIFont(Enum.Font.GothamMedium)
        overlay.Text = message
        overlay.TextSize = 11.5
        overlay.TextWrapped = true
        overlay.TextXAlignment = Enum.TextXAlignment.Left
        overlay.TextYAlignment = Enum.TextYAlignment.Center
        overlay.TextTransparency = 1
        overlay.ZIndex = 80
        overlay.Active = false
        overlay.Parent = row
        bind(overlay, "BackgroundColor3", "Header")
        bind(overlay, "TextColor3", "TextColor")
        makeCorner(overlay, 6)

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 10)
        padding.PaddingRight = UDim.new(0, 10)
        padding.PaddingTop = UDim.new(0, 6)
        padding.PaddingBottom = UDim.new(0, 6)
        padding.Parent = overlay

        activeInlineInfo = overlay
        tween(overlay, {BackgroundTransparency = 0.04, TextTransparency = 0}, 0.1)
        task.delay(4, function()
            if activeInlineInfo ~= overlay or activeInlineInfoToken ~= mine or not overlay.Parent then return end
            dismissInlineInfo(false)
        end)
    end))
    return infoButton
end

local function attachTip(row, tip)
    tip = tostring(tip or "")
    if not active then return end
    if tip ~= "" then row:SetAttribute("LHDescription", tip) end
    local token = 0
    local longPressed = false

    local function show()
        if tip == "" or not active or not active.Tooltip then return end
        active.Tooltip.Text = tip
        active.Tooltip.Visible = true
        tween(active.Tooltip, {BackgroundTransparency = 0.08, TextTransparency = 0}, 0.12)
    end
    local function hide()
        if not active or not active.Tooltip then return end
        tween(active.Tooltip, {BackgroundTransparency = 1, TextTransparency = 1}, 0.1)
        task.delay(duration(0.11), function()
            if active and active.Tooltip then active.Tooltip.Visible = false end
        end)
    end

    track(row.MouseEnter:Connect(function()
        if not UserInputService.TouchEnabled then show() end
    end))
    track(row.MouseLeave:Connect(function()
        token = token + 1
        longPressed = false
        row:SetAttribute("LHLongPressTriggered", false)
        hide()
    end))
    local function beginHold(inputObject)
        if inputObject.UserInputType ~= Enum.UserInputType.Touch and inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        token = token + 1
        local mine = token
        longPressed = false
        row:SetAttribute("LHLongPressTriggered", false)
        task.delay(0.52, function()
            if token ~= mine or not row.Parent then return end
            longPressed = true
            row:SetAttribute("LHLongPressTriggered", true)
            hide()
            if settings.ShelfEnabled == false then return end
            local api = controlFrameRegistry[row]
            if api and type(openControlMenu) == "function" then
                openControlMenu(api)
            else
                show()
            end
        end)
    end
    local function endHold(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.Touch or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
            token = token + 1
            if longPressed then
                task.delay(0.18, function()
                    if row then row:SetAttribute("LHLongPressTriggered", false) end
                end)
            elseif UserInputService.TouchEnabled then
                hide()
            end
            longPressed = false
        end
    end

    local inputTargets = {row}
    for _, descendant in ipairs(row:GetDescendants()) do
        if descendant:IsA("GuiObject") then table.insert(inputTargets, descendant) end
    end
    for _, target in ipairs(inputTargets) do
        track(target.InputBegan:Connect(beginHold))
        track(target.InputEnded:Connect(endHold))
    end
end

local function addHover(row)
    local baseTransparency = row.BackgroundTransparency
    track(row.MouseEnter:Connect(function()
        tween(row, {BackgroundTransparency = math.max(0, baseTransparency - 0.08)}, 0.09)
    end))
    track(row.MouseLeave:Connect(function()
        tween(row, {BackgroundTransparency = baseTransparency}, 0.09)
    end))
end

local function newRow(parent, name, height)
    local row = Instance.new("Frame")
    row.Name = tostring(name or "Kontrol")
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, height or 33)
    row.BackgroundTransparency = 0
    row.Parent = parent
    bind(row, "BackgroundColor3", "ElementColor")
    makeCorner(row, 4)
    addHover(row)
    return row
end

local function setGlassBlur(_enabled)
    settings.GlassBlur = false
    local blur = Lighting:FindFirstChild("LHGlassBlur")
    if blur then
        pcall(function() blur:Destroy() end)
    end
    if active then active.Blur = nil end
end

local function createNotificationHost(screenGui, actionHost)
    local host = Instance.new("Frame")
    host.Name = actionHost and "ActionNotificationHost" or "NotificationHost"
    if actionHost then
        host.AnchorPoint = Vector2.new(0, 1)
        host.Position = UDim2.new(0, 12, 1, -12)
        host.Size = UDim2.fromOffset(340, 500)
    else
        host.AnchorPoint = Vector2.new(1, 0)
        host.Position = UDim2.new(1, -12, 0, 12)
        host.Size = UDim2.fromOffset(320, 500)
    end
    host.BackgroundTransparency = 1
    host.ZIndex = actionHost and 110 or 100
    host.Parent = screenGui

    local layout = Instance.new("UIListLayout")
    layout.HorizontalAlignment = actionHost and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right
    layout.VerticalAlignment = actionHost and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = host
    return host
end

local notificationDedup = {}
local function isDuplicateNotification(channel, kind, title, text, actionText)
    local key = table.concat({
        tostring(channel or "normal"),
        tostring(kind or "info"),
        tostring(title or ""),
        tostring(text or ""),
        tostring(actionText or ""),
    }, "\31")
    local now = os.clock()
    local previous = notificationDedup[key]
    notificationDedup[key] = now
    for oldKey, timestamp in pairs(notificationDedup) do
        if now - timestamp > 8 then notificationDedup[oldKey] = nil end
    end
    return previous ~= nil and now - previous < 1.25
end

local kindColors = {
    success = rgb(46, 204, 113),
    error = rgb(255, 74, 86),
    warning = rgb(255, 184, 61),
    info = rgb(66, 164, 255),
}

function LULA:Notify(kind, title, text, seconds, progress, force)
    kind = string.lower(tostring(kind or "info"))
    title = tostring(title or "Lollypop Hub")
    text = tostring(text or "")
    if progress ~= nil then
        seconds = math.clamp(tonumber(seconds) or 8, 2, 15)
    else
        seconds = math.clamp(tonumber(seconds) or 3, 1.5, 3.5)
    end
    if isDuplicateNotification("normal", kind, title, text, progress ~= nil and tostring(progress) or "") then
        return nil
    end
    table.insert(notificationHistory, 1, {
        Time = os.time(), Kind = kind, Title = title, Text = text, Progress = progress,
    })
    while #notificationHistory > 100 do table.remove(notificationHistory) end
    if (settings.NotificationMuted and force ~= true) or not active or not active.NotificationHost then return nil end

    local width = 310
    local bodyWidth = width - 34
    local bodyBounds = TextService:GetTextSize(text ~= "" and text or " ", 12, resolveUIFont(Enum.Font.Gotham), Vector2.new(bodyWidth, 1000))
    local bodyHeight = math.clamp(math.ceil(bodyBounds.Y) + 4, 18, 96)
    local titleHeight = 20
    local cardHeight = 10 + titleHeight + 4 + bodyHeight + (progress ~= nil and 22 or 9)

    local holder = Instance.new("Frame")
    holder.Name = "NotificationHolder"
    holder.Size = UDim2.fromOffset(width, cardHeight)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = false
    holder.ZIndex = 101
    holder.Parent = active.NotificationHost

    local card = Instance.new("CanvasGroup")
    card.Name = "Notification"
    card.Size = UDim2.fromScale(1, 1)
    card.Position = UDim2.fromOffset(-330, 0)
    card.BackgroundTransparency = 0.04
    card.GroupTransparency = 0
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 102
    card.Parent = holder
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 10)
    makeStroke(card, kindColors[kind] or kindColors.info, 0.2, 1)

    local stripe = Instance.new("Frame")
    stripe.Size = UDim2.new(0, 4, 1, 0)
    stripe.BorderSizePixel = 0
    stripe.BackgroundColor3 = kindColors[kind] or kindColors.info
    stripe.Parent = card

    local titleLabel = makeText(card, title, 14, Enum.Font.GothamBold)
    titleLabel.Position = UDim2.fromOffset(14, 8)
    titleLabel.Size = UDim2.new(1, -46, 0, titleHeight)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.TextWrapped = false

    local body = makeText(card, text, 12, Enum.Font.Gotham)
    body.Position = UDim2.fromOffset(14, 31)
    body.Size = UDim2.new(1, -28, 0, bodyHeight)
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.TextWrapped = true
    bind(body, "TextColor3", "MutedText")

    local close = makeKolorButton(card, "X", rgb(210, 48, 65))
    close.Position = UDim2.new(1, -28, 0, 6)
    close.Size = UDim2.fromOffset(22, 22)
    close.TextSize = 10

    local progressFill = nil
    if progress ~= nil then
        local bar = Instance.new("Frame")
        bar.Position = UDim2.new(0, 14, 1, -13)
        bar.Size = UDim2.new(1, -28, 0, 5)
        bar.BorderSizePixel = 0
        bar.Parent = card
        bind(bar, "BackgroundColor3", "NotificationTrack")
        makeCorner(bar, 3)
        progressFill = Instance.new("Frame")
        progressFill.Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 100) / 100, 0, 1, 0)
        progressFill.BorderSizePixel = 0
        progressFill.BackgroundColor3 = kindColors[kind] or kindColors.info
        progressFill.Parent = bar
        makeCorner(progressFill, 3)
    end

    tween(card, {Position = UDim2.fromOffset(0, 0)}, 0.22)
    local dead = false
    local function dismiss()
        if dead then return end
        dead = true
        tween(card, {
            Position = UDim2.fromOffset(0, -24),
            GroupTransparency = 1,
            BackgroundTransparency = 1,
        }, 0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        task.delay(duration(0.44), function()
            if holder then holder:Destroy() end
        end)
    end
    track(close.MouseButton1Click:Connect(dismiss))
    task.delay(seconds, dismiss)

    local soundIds = env.LH_NOTIFICATION_SOUND_IDS or {
        success = "rbxassetid://9118823107",
        error = "rbxassetid://9118823107",
        warning = "rbxassetid://9118823107",
        info = "rbxassetid://9118823107",
    }
    local soundId = soundIds[kind]
    if not settings.NotificationMuted and soundId and tonumber(settings.NotificationVolume or 0) > 0 then
        local sound = Instance.new("Sound")
        sound.Name = "LHNotificationSound"
        sound.SoundId = tostring(soundId)
        sound.Volume = math.clamp(tonumber(settings.NotificationVolume) or 0.45, 0, 1)
        sound.Parent = card
        pcall(function() sound:Play() end)
        task.delay(6, function() if sound then sound:Destroy() end end)
    end

    local api = {Frame = card, Holder = holder}
    function api:SetProgress(value, newText)
        value = math.clamp(tonumber(value) or 0, 0, 100)
        if progressFill then tween(progressFill, {Size = UDim2.new(value / 100, 0, 1, 0)}, 0.1) end
        if newText ~= nil then body.Text = tostring(newText) end
    end
    function api:Close() dismiss() end
    return api
end

function LULA:NotifyAction(kind, title, text, seconds, buttonText, callback)
    kind = string.lower(tostring(kind or "warning"))
    title = tostring(title or "Lollypop Hub")
    text = tostring(text or "")
    seconds = math.clamp(tonumber(seconds) or 4, 2, 10)
    buttonText = tostring(buttonText or "Undo")
    if isDuplicateNotification("action", kind, title, text, buttonText) then
        return nil
    end

    table.insert(notificationHistory, 1, {
        Time = os.time(), Kind = kind, Title = title, Text = text, Action = buttonText,
    })
    while #notificationHistory > 100 do table.remove(notificationHistory) end
    if not active or not active.ActionNotificationHost then return nil end

    local width, cardHeight = 330, 82
    local holder = Instance.new("Frame")
    holder.Name = "ActionNotificationHolder"
    holder.Size = UDim2.fromOffset(width, cardHeight)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = false
    holder.ZIndex = 111
    holder.Parent = active.ActionNotificationHost

    local view = viewportSize()
    local hostCenter = active.ActionNotificationHost.AbsolutePosition.X + active.ActionNotificationHost.AbsoluteSize.X * 0.5
    local leavesLeft = hostCenter <= view.X * 0.5
    local offscreenX = leavesLeft and -(width + 28) or (width + 28)

    local card = Instance.new("CanvasGroup")
    card.Name = "ActionNotification"
    card.Size = UDim2.fromScale(1, 1)
    card.Position = UDim2.fromOffset(offscreenX, 0)
    card.BackgroundTransparency = 0.03
    card.GroupTransparency = 0
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 112
    card.Parent = holder
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 11)
    makeStroke(card, kindColors[kind] or kindColors.warning, 0.12, 1.2)

    local stripe = Instance.new("Frame")
    stripe.Size = UDim2.new(0, 4, 1, 0)
    stripe.BorderSizePixel = 0
    stripe.BackgroundColor3 = kindColors[kind] or kindColors.warning
    stripe.ZIndex = 113
    stripe.Parent = card

    local titleLabel = makeText(card, title, 14, Enum.Font.GothamBold)
    titleLabel.Position = UDim2.fromOffset(14, 8)
    titleLabel.Size = UDim2.new(1, -120, 0, 20)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 113

    local body = makeText(card, text, 12, Enum.Font.Gotham)
    body.Position = UDim2.fromOffset(14, 31)
    body.Size = UDim2.new(1, -122, 0, 42)
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.TextWrapped = true
    body.ZIndex = 113
    bind(body, "TextColor3", "MutedText")

    local action = makeButton(card, buttonText)
    action.AnchorPoint = Vector2.new(1, 0.5)
    action.Position = UDim2.new(1, -12, 0.5, 0)
    action.Size = UDim2.fromOffset(92, 34)
    action.BackgroundTransparency = 0.02
    action.ZIndex = 114
    bind(action, "BackgroundColor3", "SchemeColor")

    local dead = false
    local function dismiss()
        if dead then return false end
        dead = true
        tween(card, {
            Position = UDim2.fromOffset(offscreenX, 0),
            GroupTransparency = 1,
            BackgroundTransparency = 1,
        }, 0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        task.delay(duration(0.41), function()
            if holder and holder.Parent then holder:Destroy() end
        end)
        return true
    end

    track(action.MouseButton1Click:Connect(function()
        if dead then return end
        dismiss()
        if type(callback) == "function" then safeCall("Notification action " .. buttonText, callback) end
    end))

    tween(card, {Position = UDim2.fromOffset(0, 0)}, 0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    task.delay(seconds, dismiss)

    local api = {Frame = card, Holder = holder, ActionButton = action}
    function api:Close() dismiss() end
    return api
end


--==================================================
-- DYNAMIC ISLAND / UNDO / PERSONAL SHELF
--==================================================
local function normalizeControlId(value)
    return tostring(value or "kontrol"):gsub("[^%w%-%_:%./ ]", ""):sub(1, 180)
end

local function getShelfList()
    local source = env.LHSettings and env.LHSettings.PersonalShelf or settings.PersonalShelf
    local copy = {}
    if type(source) == "table" then
        for _, savedId in ipairs(source) do table.insert(copy, tostring(savedId)) end
    end
    return copy
end

local function shelfIndex(list, controlId)
    for index, savedId in ipairs(type(list) == "table" and list or {}) do
        if tostring(savedId) == tostring(controlId) then return index end
    end
    return nil
end

local function shelfContains(controlId)
    return shelfIndex(getShelfList(), controlId) ~= nil
end

local function saveShelfList(updated)
    env.LHSettings = env.LHSettings or {}
    local clean = {}
    local seen = {}
    for _, savedId in ipairs(type(updated) == "table" and updated or {}) do
        savedId = tostring(savedId)
        if savedId ~= "" and not seen[savedId] then
            seen[savedId] = true
            table.insert(clean, savedId)
        end
    end
    env.LHSettings.PersonalShelf = clean
    settings.PersonalShelf = clean
    persistUiStateEdit()
    return clean
end

local function saveShelf(controlId, shouldPin)
    local updated = getShelfList()
    local index = shelfIndex(updated, controlId)
    if shouldPin and not index then
        table.insert(updated, tostring(controlId))
    elseif not shouldPin and index then
        table.remove(updated, index)
    end
    return saveShelfList(updated)
end

local function updateNavButtons()
    if not active then return end
    if active.BackButton then active.BackButton.TextTransparency = #active.BackStack > 0 and 0 or 0.62 end
    if active.ForwardButton then active.ForwardButton.TextTransparency = #active.ForwardStack > 0 and 0 or 0.62 end
    if active.UndoButton then active.UndoButton.TextTransparency = #active.UndoStack > 0 and 0 or 0.62 end
end

function LULA:RecordUndo(controlId, name, oldValue, newValue, applyOld)
    if not active or active.Undoing or active.RestoringState or type(applyOld) ~= "function" or valuesEqual(oldValue, newValue) then return false end
    local now = os.clock()
    controlId = normalizeControlId(controlId)
    local last = active.UndoStack[#active.UndoStack]
    if last and last.ControlId == controlId and now - last.ChangedAt <= 0.7 then
        last.NewValue = newValue
        last.ChangedAt = now
    else
        table.insert(active.UndoStack, {
            ControlId = controlId,
            Name = tostring(name or controlId),
            OldValue = oldValue,
            NewValue = newValue,
            ApplyOld = applyOld,
            ChangedAt = now,
        })
        while #active.UndoStack > 30 do table.remove(active.UndoStack, 1) end
    end
    updateNavButtons()
    return true
end

function LULA:Undo()
    if not active then return false, "UI is not active" end
    local item = table.remove(active.UndoStack)
    if not item then
        LULA:ShowIsland("Undo History", "Nothing to undo.", {Duration = 2.2})
        updateNavButtons()
        return false, "empty"
    end
    active.Undoing = true
    local ok, err = safeCall("Undo " .. tostring(item.Name), item.ApplyOld)
    active.Undoing = false
    updateNavButtons()
    if ok then
        LULA:ShowIsland("Undone", tostring(item.Name), {Duration = 2.5})
    else
        LULA:Notify("error", "Undo Failed", tostring(err), 5, nil, true)
    end
    return ok, err
end

function LULA:GetUndoHistory()
    if not active then return {} end
    local copy = {}
    for index = #active.UndoStack, 1, -1 do
        local item = active.UndoStack[index]
        table.insert(copy, {Name = item.Name, OldValue = item.OldValue, NewValue = item.NewValue, ChangedAt = item.ChangedAt})
    end
    return copy
end

function LULA:OpenUndoHistory()
    if not active or not active.ScreenGui then return end
    if active.ContextOverlay then active.ContextOverlay:Destroy(); active.ContextOverlay = nil end
    local overlay = Instance.new("CanvasGroup")
    overlay.Name = "LHUndoHistory"
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = rgb(0, 0, 0)
    overlay.BackgroundTransparency = 0.48
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 300
    overlay.Parent = active.ScreenGui
    active.ContextOverlay = overlay

    local dismiss = Instance.new("TextButton")
    dismiss.Size = UDim2.fromScale(1, 1)
    dismiss.BackgroundTransparency = 1
    dismiss.Text = ""
    dismiss.ZIndex = 300
    dismiss.Parent = overlay

    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.fromScale(0.5, 0.5)
    card.Size = UDim2.fromOffset(390, 320)
    card.BorderSizePixel = 0
    card.ZIndex = 301
    card.Parent = overlay
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 13)
    makeStroke(card, active.Theme.SchemeColor, 0.16, 1.2)
    local cardScale = Instance.new("UIScale", card)
    local view = viewportSize()
    cardScale.Scale = math.max(0.72, math.min(1, (view.X - 24) / 410, (view.Y - 50) / 340))

    local title = makeText(card, "Undo History", 17, Enum.Font.GothamBold)
    title.Position = UDim2.fromOffset(14, 8)
    title.Size = UDim2.new(1, -92, 0, 30)
    title.ZIndex = 302
    local undoNow = makeButton(card, "UNDO")
    undoNow.AnchorPoint = Vector2.new(1, 0)
    undoNow.Position = UDim2.new(1, -10, 0, 8)
    undoNow.Size = UDim2.fromOffset(68, 30)
    undoNow.ZIndex = 303

    local scroll = Instance.new("ScrollingFrame")
    scroll.Position = UDim2.fromOffset(10, 46)
    scroll.Size = UDim2.new(1, -20, 1, -56)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new()
    scroll.ScrollBarThickness = 3
    scroll.ZIndex = 302
    scroll.Parent = card
    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0, 5)

    if #active.UndoStack == 0 then
        local empty = makeText(scroll, "Nothing to undo yet.", 13, Enum.Font.GothamMedium)
        empty.Size = UDim2.new(1, 0, 0, 44)
        empty.ZIndex = 303
    else
        for index = #active.UndoStack, 1, -1 do
            local item = active.UndoStack[index]
            local row = makeButton(scroll, tostring(item.Name))
            row.Size = UDim2.new(1, -4, 0, 40)
            row.TextXAlignment = Enum.TextXAlignment.Left
            row.Text = "  " .. tostring(item.Name)
            row.ZIndex = 303
            row.BackgroundTransparency = 0.08
        end
    end

    local function closePanel()
        if active and active.ContextOverlay == overlay then active.ContextOverlay = nil end
        if overlay.Parent then overlay:Destroy() end
    end
    track(dismiss.MouseButton1Click:Connect(closePanel))
    track(undoNow.MouseButton1Click:Connect(function()
        closePanel()
        LULA:Undo()
    end))
end

function LULA:Confirm(titleText, bodyText, onConfirm)
    if not active or not active.ScreenGui then return false end
    if active.ContextOverlay then active.ContextOverlay:Destroy(); active.ContextOverlay = nil end

    local overlay = Instance.new("CanvasGroup")
    overlay.Name = "LHConfirmation"
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = rgb(0, 0, 0)
    overlay.BackgroundTransparency = 0.48
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 320
    overlay.Parent = active.ScreenGui
    active.ContextOverlay = overlay

    local dismiss = Instance.new("TextButton")
    dismiss.Size = UDim2.fromScale(1, 1)
    dismiss.BackgroundTransparency = 1
    dismiss.Text = ""
    dismiss.ZIndex = 320
    dismiss.Parent = overlay

    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.fromScale(0.5, 0.5)
    card.Size = UDim2.fromOffset(390, 178)
    card.BorderSizePixel = 0
    card.ZIndex = 321
    card.Parent = overlay
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 14)
    makeStroke(card, active.Theme.SchemeColor, 0.12, 1.2)

    local scale = Instance.new("UIScale", card)
    local view = viewportSize()
    scale.Scale = math.max(0.72, math.min(1, (view.X - 24) / 410, (view.Y - 40) / 200))

    local title = makeText(card, tostring(titleText or "Are you sure?"), 17, Enum.Font.GothamBold)
    title.Position = UDim2.fromOffset(18, 15)
    title.Size = UDim2.new(1, -36, 0, 28)
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.ZIndex = 322

    local body = makeText(card, tostring(bodyText or "This action cannot be undone."), 13, Enum.Font.GothamMedium)
    body.Position = UDim2.fromOffset(18, 48)
    body.Size = UDim2.new(1, -36, 0, 58)
    body.TextWrapped = true
    body.TextXAlignment = Enum.TextXAlignment.Center
    body.TextYAlignment = Enum.TextYAlignment.Center
    body.ZIndex = 322
    bind(body, "TextColor3", "MutedText")

    local yes = makeButton(card, "Yes")
    yes.Position = UDim2.new(0.5, -142, 1, -54)
    yes.Size = UDim2.fromOffset(130, 38)
    yes.BackgroundTransparency = 0.02
    yes.ZIndex = 323
    yes.BackgroundColor3 = rgb(40, 177, 91)

    local no = makeButton(card, "No")
    no.Position = UDim2.new(0.5, 12, 1, -54)
    no.Size = UDim2.fromOffset(130, 38)
    no.BackgroundTransparency = 0.02
    no.ZIndex = 323
    no.BackgroundColor3 = rgb(210, 48, 65)

    local function closePanel()
        if active and active.ContextOverlay == overlay then active.ContextOverlay = nil end
        if overlay.Parent then overlay:Destroy() end
    end
    track(dismiss.MouseButton1Click:Connect(closePanel))
    track(no.MouseButton1Click:Connect(closePanel))
    track(yes.MouseButton1Click:Connect(function()
        closePanel()
        if type(onConfirm) == "function" then safeCall("Confirmation", onConfirm) end
    end))
    return true
end

function LULA:ShowIsland(titleText, bodyText, options)
    if not active or not active.Island then return nil end
    options = type(options) == "table" and options or {}
    active.IslandToken = (active.IslandToken or 0) + 1
    local token = active.IslandToken
    local island = active.Island
    island.Title.Text = tostring(titleText or "Lollypop Hub")
    island.Body.Text = tostring(bodyText or "")
    island.Progress.Visible = options.Progress ~= nil
    if options.Progress ~= nil then
        island.ProgressFill.Size = UDim2.new(math.clamp(tonumber(options.Progress) or 0, 0, 100) / 100, 0, 1, 0)
    end
    island.Frame.Visible = true
    island.Frame.GroupTransparency = 1
    island.Frame.Size = UDim2.fromOffset(185, 38)
    tween(island.Frame, {GroupTransparency = 0, Size = UDim2.fromOffset(340, options.Progress ~= nil and 72 or 62)}, 0.18, Enum.EasingStyle.Back)

    local handle = {Token = token}
    function handle:Update(newTitle, newBody, progress)
        if not active or token ~= active.IslandToken then return false end
        if newTitle ~= nil then island.Title.Text = tostring(newTitle) end
        if newBody ~= nil then island.Body.Text = tostring(newBody) end
        if progress ~= nil then
            island.Progress.Visible = true
            tween(island.ProgressFill, {Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 100) / 100, 0, 1, 0)}, 0.12)
        end
        return true
    end
    function handle:SetProgress(progress, newBody)
        return self:Update(nil, newBody, progress)
    end
    function handle:Close()
        if not active or token ~= active.IslandToken then return false end
        active.IslandToken = active.IslandToken + 1
        tween(island.Frame, {GroupTransparency = 1, Size = UDim2.fromOffset(185, 38)}, 0.14)
        task.delay(duration(0.16), function()
            if active and active.Island and active.Island.Frame == island.Frame then island.Frame.Visible = false end
        end)
        return true
    end

    local seconds = tonumber(options.Duration)
    if seconds and seconds > 0 then
        task.delay(seconds, function() handle:Close() end)
    end
    return handle
end

function LULA:CloseIsland()
    if not active or not active.Island then return end
    active.IslandToken = (active.IslandToken or 0) + 1
    active.Island.Frame.Visible = false
end

local function findTabByName(name)
    if not active then return nil end
    local filledStar = utf8.char(0x2605)
    local needle = string.lower(tostring(name or ""))
    needle = needle:gsub("^" .. filledStar .. "%s*", "")
    if needle == "animation bundles" or needle == "free animation packs" then
        needle = "free animations"
    end
    for _, tab in ipairs(active.Tabs) do
        local candidate = string.lower(tostring(tab.Name or ""))
        candidate = candidate:gsub("^" .. filledStar .. "%s*", "")
        if candidate == needle then return tab end
    end
    return nil
end

local function makeShelfToolsIcon(parent)
    local icon = Instance.new("Frame")
    icon.Name = "ShelfToolsIcon"
    icon.Size = UDim2.fromOffset(22, 22)
    icon.BackgroundTransparency = 1
    icon.Parent = parent

    local function tool(rotation, x)
        local handle = Instance.new("Frame")
        handle.AnchorPoint = Vector2.new(0.5, 0.5)
        handle.Position = UDim2.fromScale(0.5 + x, 0.55)
        handle.Size = UDim2.fromOffset(4, 18)
        handle.Rotation = rotation
        handle.BorderSizePixel = 0
        handle.Parent = icon
        bind(handle, "BackgroundColor3", "SchemeColor")
        makeCorner(handle, 2)

        local head = Instance.new("Frame")
        head.AnchorPoint = Vector2.new(0.5, 0.5)
        head.Position = UDim2.new(0.5, 0, 0, 1)
        head.Size = UDim2.fromOffset(11, 5)
        head.BorderSizePixel = 0
        head.Parent = handle
        bind(head, "BackgroundColor3", "SchemeColor")
        makeCorner(head, 2)
    end
    tool(42, -0.08)
    tool(-42, 0.08)
    return icon
end

local function setShelfGuiZ(root, base)
    if root:IsA("GuiObject") then root.ZIndex = base end
    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("GuiObject") then descendant.ZIndex = base + 1 end
    end
end

local function normalizeAnimationAssetId(value)
    local digits = tostring(value or ""):match("%d+")
    if not digits then return nil end
    return "rbxassetid://" .. digits
end

local function createAnimatedAvatarViewport(parent, options)
    options = options or {}
    local userId = tonumber(options.UserId) or (LocalPlayer and LocalPlayer.UserId) or 1
    local width = math.max(48, tonumber(options.Width) or 116)
    local height = math.max(48, tonumber(options.Height) or width)
    local radius = tonumber(options.Radius) or math.floor(math.min(width, height) * 0.5)

    local viewport = Instance.new("ViewportFrame")
    viewport.Name = tostring(options.Name or "LHAvatarViewport")
    viewport.Position = options.Position or UDim2.fromOffset(0, 0)
    viewport.Size = UDim2.fromOffset(width, height)
    viewport.BackgroundTransparency = tonumber(options.BackgroundTransparency) or 0.05
    viewport.BorderSizePixel = 0
    viewport.Ambient = rgb(218, 218, 226)
    viewport.LightColor = rgb(255, 255, 255)
    viewport.LightDirection = Vector3.new(-1, -1, -1)
    viewport.Parent = parent
    bind(viewport, "BackgroundColor3", "ElementColor")
    makeCorner(viewport, radius)
    local viewportStroke = makeStroke(viewport, active.Theme.SchemeColor, 0.12, tonumber(options.StrokeThickness) or 2)
    bind(viewportStroke, "Color", "SchemeColor")

    local world = Instance.new("WorldModel")
    world.Name = "AvatarWorld"
    world.Parent = viewport

    local camera = Instance.new("Camera")
    camera.FieldOfView = tonumber(options.FieldOfView) or 32
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local fallback = Instance.new("ImageLabel")
    fallback.Name = tostring(options.Name or "LHAvatarViewport") .. "Fallback"
    fallback.Position = viewport.Position
    fallback.Size = viewport.Size
    fallback.BackgroundTransparency = 1
    fallback.Visible = false
    fallback.Parent = parent
    makeCorner(fallback, radius)

    task.spawn(function()
        local model
        local okModel = pcall(function()
            model = Players:CreateHumanoidModelFromUserId(userId)
        end)

        if (not okModel or not model) and LocalPlayer and userId == LocalPlayer.UserId then
            local character = LocalPlayer.Character
            if character then
                local oldArchivable = character.Archivable
                character.Archivable = true
                pcall(function() model = character:Clone() end)
                character.Archivable = oldArchivable
            end
        end

        if not model or not viewport.Parent then
            local okThumb, image = pcall(function()
                return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size180x180)
            end)
            if okThumb and fallback.Parent then
                fallback.Image = image
                fallback.Visible = true
            end
            return
        end

        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("Tool") then
                descendant:Destroy()
            elseif descendant:IsA("BasePart") then
                descendant.Anchored = false
                descendant.CanCollide = false
                descendant.Massless = true
            end
        end

        model.Name = tostring(options.ModelName or "LHAvatarModel")
        model.Parent = world
        pcall(function() model:PivotTo(CFrame.new()) end)

        local avatarRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        if avatarRoot then avatarRoot.Anchored = true end

        local boxCFrame, boxSize = model:GetBoundingBox()
        local focus = boxCFrame.Position + Vector3.new(0, boxSize.Y * (tonumber(options.FocusYOffset) or 0.035), 0)
        local halfFov = math.rad(math.clamp(camera.FieldOfView, 10, 100) * 0.5)
        local fitHeight = (boxSize.Y * 0.52) / math.max(0.05, math.tan(halfFov))
        local fitWidth = (boxSize.X * 0.58) / math.max(0.05, math.tan(halfFov))
        local distance = math.max(4.8, fitHeight, fitWidth, boxSize.Z * 1.8)
        distance = distance * (tonumber(options.DistanceScale) or 1)

        -- Roblox avatars face -Z. Put the kamera on -Z so the avatar faces the user,
        -- not away from them.
        camera.CFrame = CFrame.lookAt(
            focus + Vector3.new(0, boxSize.Y * (tonumber(options.CameraYOffset) or 0.025), -distance),
            focus,
            Vector3.new(0, 1, 0)
        )

        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local animationAsset = normalizeAnimationAssetId(options.AnimationId)
        local animated = false
        if humanoid and animationAsset then
            local okAnimation = pcall(function()
                humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
                local animation = Instance.new("Animation")
                animation.Name = "LHAvatarDance"
                animation.AnimationId = animationAsset
                local trackObject = animator:LoadAnimation(animation)
                trackObject.Looped = true
                trackObject.Priority = Enum.AnimationPriority.Movement
                trackObject:Play(0.18, 1, tonumber(options.AnimationSpeed) or 0.82)
                viewport:SetAttribute("LHAnimationId", animationAsset)
                animated = true
            end)
            if not okAnimation then animated = false end
        end

        if not animated then
            local started = os.clock()
            while model.Parent and viewport.Parent do
                local wave = math.sin((os.clock() - started) * 2.1)
                pcall(function()
                    model:PivotTo(CFrame.new(0, wave * 0.045, 0))
                end)
                RunService.RenderStepped:Wait()
            end
        end
    end)

    return viewport, fallback
end

local function refreshShelf()
    if not active or not active.Shelf or not active.Shelf.ItemsHolder then return end
    local shelf = active.Shelf
    if shelf.Dragging then return end

    local holder = shelf.ItemsHolder
    for _, child in ipairs(holder:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then child:Destroy() end
    end
    shelf.RowMap = {}

    local saved = getShelfList()
    local count = 0

    local deleteAllUndo = shelf.DeleteAllUndo
    if deleteAllUndo and type(deleteAllUndo.Items) == "table" then
        if os.clock() >= (tonumber(deleteAllUndo.ExpiresAt) or 0) then
            shelf.DeleteAllUndo = nil
        else
            count = count + 1
            local undoToken = tostring(deleteAllUndo.Token or "")
            local undoRow = newRow(holder, "ShelfDeleteAllUndo", 48)
            undoRow.LayoutOrder = -100000
            undoRow.BackgroundTransparency = 0.02

            local undoButton = makeKolorButton(undoRow,
                "Undo Delete All - restore " .. tostring(#deleteAllUndo.Items) .. " skripts",
                TOGGLE_ON_COLOR)
            undoButton.Position = UDim2.fromOffset(5, 5)
            undoButton.Size = UDim2.new(1, -45, 1, -10)
            undoButton.TextXAlignment = Enum.TextXAlignment.Left
            undoButton.Text = "  " .. undoButton.Text
            undoButton.ZIndex = 7

            local closeUndo = makeKolorButton(undoRow, "X", TOGGLE_OFF_COLOR)
            closeUndo.AnchorPoint = Vector2.new(1, 0.5)
            closeUndo.Position = UDim2.new(1, -5, 0.5, 0)
            closeUndo.Size = UDim2.fromOffset(30, 30)
            closeUndo.ZIndex = 8

            track(undoButton.MouseButton1Click:Connect(function()
                if not active or not active.Shelf or not active.Shelf.DeleteAllUndo then return end
                if tostring(active.Shelf.DeleteAllUndo.Token or "") ~= undoToken then return end

                local restored = {}
                local seen = {}
                for _, savedId in ipairs(active.Shelf.DeleteAllUndo.Items) do
                    savedId = tostring(savedId)
                    if savedId ~= "" and not seen[savedId] then
                        seen[savedId] = true
                        table.insert(restored, savedId)
                    end
                end
                -- Keep anything newly added during the seven-second Undo window.
                for _, savedId in ipairs(getShelfList()) do
                    savedId = tostring(savedId)
                    if savedId ~= "" and not seen[savedId] then
                        seen[savedId] = true
                        table.insert(restored, savedId)
                    end
                end

                active.Shelf.DeleteAllUndo = nil
                saveShelfList(restored)
                refreshShelf()
                LULA:Notify("success", "My Shelf", "Delete All was undone. Your Shelf skripts were restored.", 3, nil, true)
            end))

            track(closeUndo.MouseButton1Click:Connect(function()
                if not active or not active.Shelf or not active.Shelf.DeleteAllUndo then return end
                if tostring(active.Shelf.DeleteAllUndo.Token or "") ~= undoToken then return end
                active.Shelf.DeleteAllUndo = nil
                refreshShelf()
            end))
        end
    end

    local function launchShelfItem(api, controlId, launch)
        if api.Kind == "button" and type(api.Fire) == "function" then
            api:Fire()
        elseif api.Kind == "toggle" and type(api.GetValue) == "function" and type(api.SetValue) == "function" then
            api:SetValue(not api:GetValue(), true)
            launch.Text = "  " .. tostring(api.DisplayName or controlId)
            launch.BackgroundColor3 = api:GetValue() and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
            launch.TextColor3 = rgb(255, 255, 255)
        else
            local sourceTab = findTabByName(api.TabName)
            if sourceTab and active.Window then
                active.Window:SelectTab(sourceTab.Name)
                task.defer(function()
                    if not active or not api.Frame or not api.Frame.Parent then return end
                    local scroll = sourceTab.Scroll
                    local y = math.max(0, api.Frame.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y - 8)
                    scroll.CanvasPosition = Vector2.new(0, y)
                    if api.SetSearchHighlighted then
                        api:SetSearchHighlighted(true)
                        task.delay(1.2, function() if api.SetSearchHighlighted then api:SetSearchHighlighted(false) end end)
                    end
                end)
            end
        end
    end

    local function beginShelfDrag(controlId, row, inputObject)
        if not shelf.Editing or shelf.Dragging or not row.Parent then return end
        local isTouch = inputObject.UserInputType == Enum.UserInputType.Touch
        local isMouse = inputObject.UserInputType == Enum.UserInputType.MouseButton1
        if not isTouch and not isMouse then return end

        local order = getShelfList()
        local originalIndex = shelfIndex(order, controlId)
        if not originalIndex then return end

        shelf.Dragging = controlId
        local sourceScroll = shelf.Scroll
        local lockedCanvasPosition = sourceScroll and sourceScroll.CanvasPosition or Vector2.new()
        local oldScrollingEnabled = sourceScroll and sourceScroll.ScrollingEnabled
        if sourceScroll then
            sourceScroll.ScrollingEnabled = false
            sourceScroll.CanvasPosition = lockedCanvasPosition
        end

        local originalAbsolutePosition = row.AbsolutePosition
        local originalAbsoluteSize = row.AbsoluteSize
        local startPointer = isTouch and Vector2.new(inputObject.Position.X, inputObject.Position.Y)
            or UserInputService:GetMouseLocation()

        local placeholder = Instance.new("Frame")
        placeholder.Name = "ShelfDragPlaceholder"
        placeholder.Size = UDim2.new(1, 0, 0, math.max(42, originalAbsoluteSize.Y))
        placeholder.BackgroundTransparency = 0.58
        placeholder.BorderSizePixel = 0
        placeholder.LayoutOrder = originalIndex
        placeholder.Parent = holder
        bind(placeholder, "BackgroundColor3", "SchemeColor")
        makeCorner(placeholder, 8)
        makeStroke(placeholder, active.Theme.SchemeColor, 0.28, 1)

        row.Parent = active.ScreenGui
        row.Position = UDim2.fromOffset(originalAbsolutePosition.X, originalAbsolutePosition.Y)
        row.Size = UDim2.fromOffset(originalAbsoluteSize.X, originalAbsoluteSize.Y)
        row.AnchorPoint = Vector2.new(0, 0)
        row.ClipsDescendants = false
        setShelfGuiZ(row, 460)
        local dragScale = Instance.new("UIScale")
        dragScale.Scale = 1.025
        dragScale.Parent = row

        local currentOrder = order
        local ended = false
        local moveConnection, endConnection, stateConnection, ancestryConnection

        local function sameOrder(a, b)
            if #a ~= #b then return false end
            for index = 1, #a do
                if tostring(a[index]) ~= tostring(b[index]) then return false end
            end
            return true
        end

        local function applyLayoutOrders()
            for index, savedId in ipairs(currentOrder) do
                if tostring(savedId) == tostring(controlId) then
                    placeholder.LayoutOrder = index
                else
                    local other = shelf.RowMap[tostring(savedId)]
                    if other and other.Parent == holder then other.LayoutOrder = index end
                end
            end
        end

        local function calculateOrder(dragCenterY)
            local others = {}
            for _, savedId in ipairs(currentOrder) do
                if tostring(savedId) ~= tostring(controlId) then table.insert(others, tostring(savedId)) end
            end

            local insertAt = #others + 1
            for index, savedId in ipairs(others) do
                local other = shelf.RowMap[tostring(savedId)]
                if other and other.Parent == holder then
                    local centerY = other.AbsolutePosition.Y + other.AbsoluteSize.Y * 0.5
                    if dragCenterY < centerY then
                        insertAt = index
                        break
                    end
                end
            end

            local rebuilt = {}
            for _, savedId in ipairs(others) do table.insert(rebuilt, tostring(savedId)) end
            table.insert(rebuilt, insertAt, tostring(controlId))
            if not sameOrder(rebuilt, currentOrder) then
                currentOrder = rebuilt
                applyLayoutOrders()
                placeholder.BackgroundTransparency = 0.42
                task.delay(0.06, function()
                    if placeholder and placeholder.Parent then
                        tween(placeholder, {BackgroundTransparency = 0.58}, 0.10)
                    end
                end)
            end
        end

        local function disconnectTemporary()
            for _, connection in ipairs({moveConnection, endConnection, stateConnection, ancestryConnection}) do
                if connection then pcall(function() connection:Disconnect() end) end
            end
        end

        local function finishDrag()
            if ended then return end
            ended = true
            disconnectTemporary()
            if sourceScroll and sourceScroll.Parent then
                sourceScroll.CanvasPosition = lockedCanvasPosition
                sourceScroll.ScrollingEnabled = oldScrollingEnabled ~= false
            end
            if row and row.Parent then
                row.Parent = holder
                row.Size = UDim2.new(1, 0, 0, 46)
                row.Position = UDim2.new()
                row.LayoutOrder = shelfIndex(currentOrder, controlId) or originalIndex
                setShelfGuiZ(row, 4)
            end
            if dragScale then dragScale:Destroy() end
            if placeholder then placeholder:Destroy() end
            shelf.Dragging = nil
            saveShelfList(currentOrder)
            refreshShelf()
        end

        local function updateDrag()
            if ended or not row.Parent then return end
            if sourceScroll and sourceScroll.Parent then
                sourceScroll.CanvasPosition = lockedCanvasPosition
            end

            local pointer = isTouch and Vector2.new(inputObject.Position.X, inputObject.Position.Y)
                or UserInputService:GetMouseLocation()
            local deltaY = pointer.Y - startPointer.Y
            local scrollTop = sourceScroll and sourceScroll.AbsolutePosition.Y or 0
            local scrollBottom = sourceScroll and (sourceScroll.AbsolutePosition.Y + sourceScroll.AbsoluteWindowSize.Y)
                or viewportSize().Y
            local minY = math.max(scrollTop + 2, holder.AbsolutePosition.Y)
            local maxY = math.max(minY, math.min(scrollBottom - originalAbsoluteSize.Y - 2,
                holder.AbsolutePosition.Y + holder.AbsoluteSize.Y - originalAbsoluteSize.Y))
            local wantedY = math.clamp(originalAbsolutePosition.Y + deltaY, minY, maxY)

            -- Vertical-only movement prevents the row from sliding sideways or fighting
            -- the ScrollingFrame on mobile.
            row.Position = UDim2.fromOffset(originalAbsolutePosition.X, wantedY)
            calculateOrder(wantedY + originalAbsoluteSize.Y * 0.5)
        end

        moveConnection = RunService.RenderStepped:Connect(function()
            if isTouch and (inputObject.UserInputState == Enum.UserInputState.End
                or inputObject.UserInputState == Enum.UserInputState.Cancel) then
                finishDrag()
                return
            end
            updateDrag()
        end)

        endConnection = UserInputService.InputEnded:Connect(function(endedInput)
            if isTouch then
                if endedInput == inputObject then finishDrag() end
            elseif endedInput.UserInputType == Enum.UserInputType.MouseButton1 then
                finishDrag()
            end
        end)

        stateConnection = inputObject.Changed:Connect(function()
            if inputObject.UserInputState == Enum.UserInputState.End
                or inputObject.UserInputState == Enum.UserInputState.Cancel then
                finishDrag()
            end
        end)

        ancestryConnection = row.AncestryChanged:Connect(function(_, parent)
            if not parent then finishDrag() end
        end)
        updateDrag()
    end

    for savedIndex, controlId in ipairs(saved) do
        local api = controlIdRegistry[tostring(controlId)]
        if api and api.Frame and api.Frame.Parent then
            count = count + 1
            local row = newRow(holder, api.DisplayName or api.Name or controlId, 46)
            row.LayoutOrder = savedIndex
            row.ZIndex = 4
            row:SetAttribute("LHShelfControlId", tostring(controlId))
            shelf.RowMap[tostring(controlId)] = row

            local dragHandle = Instance.new("TextButton")
            dragHandle.Name = "ShelfDragHandle"
            dragHandle.Position = UDim2.fromOffset(4, 4)
            dragHandle.Size = UDim2.fromOffset(31, 38)
            dragHandle.BackgroundTransparency = 1
            dragHandle.Text = ""
            dragHandle.Active = true
            dragHandle.Visible = shelf.Editing == true
            dragHandle.ZIndex = 7
            dragHandle.Parent = row
            for lineIndex = 1, 3 do
                local line = Instance.new("Frame")
                line.Position = UDim2.fromOffset(7, 9 + (lineIndex - 1) * 7)
                line.Size = UDim2.fromOffset(17, 2)
                line.BorderSizePixel = 0
                line.ZIndex = 8
                line.Parent = dragHandle
                bind(line, "BackgroundColor3", "SchemeColor")
                makeCorner(line, 1)
            end

            local isShelfToggle = api.Kind == "toggle" and type(api.GetValue) == "function" and type(api.SetValue) == "function"
            local launch = isShelfToggle
                and makeKolorButton(row, "", api:GetValue() and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR)
                or makeButton(row, "")
            launch.Position = shelf.Editing and UDim2.fromOffset(35, 0) or UDim2.fromOffset(0, 0)
            launch.Size = shelf.Editing and UDim2.new(1, -76, 1, 0) or UDim2.new(1, -40, 1, 0)
            launch.BackgroundTransparency = isShelfToggle and 0.06 or 1
            launch.TextXAlignment = Enum.TextXAlignment.Left
            launch.Text = "  " .. tostring(api.DisplayName or api.Name or controlId)
            launch.ZIndex = 5

            local remove = makeKolorButton(row, "X", rgb(205, 54, 68))
            remove.AnchorPoint = Vector2.new(1, 0.5)
            remove.Position = UDim2.new(1, -6, 0.5, 0)
            remove.Size = UDim2.fromOffset(29, 29)
            remove.ZIndex = 7

            track(remove.MouseButton1Click:Connect(function()
                local before = getShelfList()
                local removedIndex = shelfIndex(before, controlId)
                if not removedIndex then return end
                local removedName = tostring(api.DisplayName or api.Name or controlId)
                table.remove(before, removedIndex)
                saveShelfList(before)
                refreshShelf()
                LULA:NotifyAction("warning", "My Shelf", "Undo delete for " .. removedName .. "?", 4, "Undo", function()
                    local restored = getShelfList()
                    if not shelfIndex(restored, controlId) then
                        table.insert(restored, math.clamp(removedIndex, 1, #restored + 1), tostring(controlId))
                        saveShelfList(restored)
                    end
                    refreshShelf()
                    LULA:Notify("success", "My Shelf", "Skript deletion was undone: " .. removedName, 3, nil, true)
                end)
            end))

            track(launch.MouseButton1Click:Connect(function()
                if shelf.Editing then return end
                launchShelfItem(api, controlId, launch)
            end))
            track(dragHandle.InputBegan:Connect(function(inputObject)
                beginShelfDrag(tostring(controlId), row, inputObject)
            end))

            if isShelfToggle then
                launch.BackgroundColor3 = api:GetValue() and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
                launch.TextColor3 = rgb(255, 255, 255)
            end
        end
    end

    if count == 0 then
        local empty = makeText(holder, settings.ShelfEnabled == false
            and "My Shelf adding is disabled. Turn Shelf Hold Menu on above to add features."
            or "Hold any feature, then choose Add to My Shelf.", 13, Enum.Font.GothamMedium)
        empty.Name = "ShelfEmpty"
        empty.Size = UDim2.new(1, -8, 0, 70)
        empty.TextWrapped = true
        empty.ZIndex = 5
        bind(empty, "TextColor3", "MutedText")
    end
end

local function queueShelfRefresh()
    if not active or not active.Shelf or active.ShelfRefreshQueued then return end
    active.ShelfRefreshQueued = true
    task.defer(function()
        if not active then return end
        active.ShelfRefreshQueued = false
        refreshShelf()
    end)
end

openControlMenu = function(api)
    if settings.ShelfEnabled == false then return end
    if not active or not api or not api.Frame or not active.ScreenGui then return end
    if active.ContextOverlay then active.ContextOverlay:Destroy(); active.ContextOverlay = nil end
    local overlay = Instance.new("CanvasGroup")
    overlay.Name = "LHControlMenu"
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = rgb(0, 0, 0)
    overlay.BackgroundTransparency = 0.55
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 300
    overlay.Parent = active.ScreenGui
    active.ContextOverlay = overlay

    local dismiss = Instance.new("TextButton")
    dismiss.Size = UDim2.fromScale(1, 1)
    dismiss.BackgroundTransparency = 1
    dismiss.Text = ""
    dismiss.ZIndex = 300
    dismiss.Parent = overlay

    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.fromScale(0.5, 0.5)
    card.Size = UDim2.fromOffset(350, 190)
    card.BorderSizePixel = 0
    card.ZIndex = 301
    card.Parent = overlay
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 13)
    makeStroke(card, active.Theme.SchemeColor, 0.14, 1.2)
    local cardScale = Instance.new("UIScale", card)
    local view = viewportSize()
    cardScale.Scale = math.max(0.74, math.min(1, (view.X - 24) / 370, (view.Y - 40) / 210))

    local title = makeText(card, tostring(api.DisplayName or api.Name or "Feature"), 16, Enum.Font.GothamBold)
    title.Position = UDim2.fromOffset(14, 10)
    title.Size = UDim2.new(1, -28, 0, 28)
    title.TextWrapped = true
    title.ZIndex = 302
    local description = makeText(card, tostring(api.Tip or api.Frame:GetAttribute("LHDescription") or "No description."), 12, Enum.Font.GothamMedium)
    description.Position = UDim2.fromOffset(14, 44)
    description.Size = UDim2.new(1, -28, 0, 58)
    description.TextWrapped = true
    description.TextYAlignment = Enum.TextYAlignment.Top
    description.ZIndex = 302

    local pinned = shelfContains(api.ControlId)
    local shelfButton = makeButton(card, pinned and "Remove from My Shelf" or "Add to My Shelf")
    shelfButton.Position = UDim2.fromOffset(14, 112)
    shelfButton.Size = UDim2.new(1, -28, 0, 34)
    shelfButton.ZIndex = 303
    local close = makeButton(card, "Close")
    close.Position = UDim2.fromOffset(14, 151)
    close.Size = UDim2.new(1, -28, 0, 28)
    close.ZIndex = 303

    local function closeMenu()
        if active and active.ContextOverlay == overlay then active.ContextOverlay = nil end
        if overlay.Parent then overlay:Destroy() end
    end
    track(dismiss.MouseButton1Click:Connect(closeMenu))
    track(close.MouseButton1Click:Connect(closeMenu))
    track(shelfButton.MouseButton1Click:Connect(function()
        saveShelf(api.ControlId, not pinned)
        refreshShelf()
        closeMenu()
        LULA:ShowIsland("My Shelf", (not pinned and "Added " or "Removed ") .. tostring(api.DisplayName or api.ControlId), {Duration = 2.4})
    end))
end

function LULA.CreateLib(kavName, themeInput)
    if active then LULA:Destroy() end
    bindings = {}
    connections = {}

    local theme = resolveTheme(themeInput)
    local parent = CoreGui
    pcall(function()
        if gethui then parent = gethui() end
    end)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "LollypopHubUI_" .. tostring(math.random(10000, 99999))
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 900000
    local parented = pcall(function() screenGui.Parent = parent end)
    if not parented or not screenGui.Parent then
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 8)
        if playerGui then screenGui.Parent = playerGui else error("KAVO UI could not find a supported GUI parent") end
    end

    track(screenGui.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("GuiButton") then
            task.defer(addButtonPressEffect, descendant)
        end
    end))

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.Position = UDim2.fromScale(0.5, 0.5)
    main.Size = UDim2.fromOffset(525, 318)
    main.BorderSizePixel = 0
    main.BackgroundTransparency = 0
    main.ClipsDescendants = true
    main.Parent = screenGui
    makeCorner(main, 13)
    bind(main, "BackgroundColor3", "Background")
    local mainStroke = makeStroke(main, theme.SchemeColor, 1, 1)

    local particleLayer = Instance.new("Frame")
    particleLayer.Name = "BackgroundParticles"
    particleLayer.Size = UDim2.fromScale(1, 1)
    particleLayer.BackgroundTransparency = 1
    particleLayer.ClipsDescendants = true
    particleLayer.ZIndex = 0
    particleLayer.Visible = false
    particleLayer.Parent = main
    local particleObjects = {}
    for index = 1, 18 do
        local particle = makeText(particleLayer, index % 3 == 0 and "+" or index % 2 == 0 and "o" or ".", math.random(9, 17), Enum.Font.GothamBold)
        particle.Name = "Particle"
        particle.Position = UDim2.new(math.random(), 0, math.random(), 0)
        particle.Size = UDim2.fromOffset(20, 20)
        particle.TextTransparency = 0.72
        particle.ZIndex = 0
        bind(particle, "TextColor3", index % 2 == 0 and "SchemeColor" or "Accent2")
        table.insert(particleObjects, particle)
    end

    local scale = Instance.new("UIScale")
    scale.Scale = adaptiveScale()
    scale.Parent = main

    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 29)
    header.BorderSizePixel = 0
    header.Parent = main
    bind(header, "BackgroundColor3", "Header")
    makeCorner(header, 13)

    local logo = Instance.new("ImageButton")
    logo.Name = "Logo"
    logo.BackgroundTransparency = 1
    logo.Position = UDim2.fromOffset(5, 3)
    logo.Size = UDim2.fromOffset(23, 23)
    logo.ScaleType = Enum.ScaleType.Fit
    logo.Image = "rbxassetid://" .. tostring(env.getImg or env.lollypopimg or 17767487755)
    logo.Parent = header
    logo.Visible = false

    local title = makeText(header, kavName or "Lollypop Hub", tonumber(env.titlesize) or 16.5, Enum.Font.LuckiestGuy)
    title.Name = "Title"
    title.Position = UDim2.fromOffset(9, 0)
    title.Size = UDim2.new(1, -116, 1, 0)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextWrapped = false

    local close = makeButton(header, "X")
    close.Position = UDim2.new(1, -29, 0, 2)
    close.Size = UDim2.fromOffset(24, 24)
    close.BackgroundTransparency = 1

    local backButton = makeButton(header, utf8.char(0x2039))
    backButton.Name = "BackstackBack"
    backButton.Position = UDim2.new(1, -101, 0, 2)
    backButton.Size = UDim2.fromOffset(22, 24)
    backButton.BackgroundTransparency = 1
    backButton.TextSize = 22

    local forwardButton = makeButton(header, utf8.char(0x203A))
    forwardButton.Name = "BackstackForward"
    forwardButton.Position = UDim2.new(1, -77, 0, 2)
    forwardButton.Size = UDim2.fromOffset(22, 24)
    forwardButton.BackgroundTransparency = 1
    forwardButton.TextSize = 22

    local undoButton = makeButton(header, utf8.char(0x21B6))
    undoButton.Name = "UndoHistory"
    undoButton.Position = UDim2.new(1, -53, 0, 2)
    undoButton.Size = UDim2.fromOffset(22, 24)
    undoButton.BackgroundTransparency = 1
    undoButton.TextSize = 17

    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Position = UDim2.fromOffset(0, 29)
    sidebar.Size = UDim2.new(0, 149, 1, -29)
    sidebar.BorderSizePixel = 0
    sidebar.BackgroundTransparency = 0
    sidebar.Parent = main
    bind(sidebar, "BackgroundColor3", "Header")
    makeCorner(sidebar, 13)

    local sideGradient = Instance.new("UIGradient")
    sideGradient.Rotation = 90
    sideGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.SchemeColor),
        ColorSequenceKeypoint.new(1, theme.Accent2),
    })
    sideGradient.Transparency = NumberSequence.new(1)
    sideGradient.Parent = sidebar

    local tabList = Instance.new("ScrollingFrame")
    tabList.Name = "TabList"
    tabList.Position = UDim2.fromOffset(7, 0)
    tabList.Size = UDim2.new(0, 135, 1, 0)
    tabList.BackgroundTransparency = 1
    tabList.BorderSizePixel = 0
    tabList.ScrollBarThickness = 2
    tabList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabList.CanvasSize = UDim2.new()
    tabList.Parent = sidebar
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 0)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = tabList

    local pages = Instance.new("Frame")
    pages.Name = "Pages"
    pages.Position = UDim2.fromOffset(149, 29)
    pages.Size = UDim2.new(1, -149, 1, -49)
    pages.BackgroundTransparency = 1
    pages.ClipsDescendants = true
    pages.Parent = main

    local footer = makeText(main, "Lollypop Hub v10.3.6", 11, Enum.Font.GothamMedium)
    footer.Name = "Footer"
    footer.Position = UDim2.new(0, 158, 1, -20)
    footer.Size = UDim2.new(1, -165, 0, 18)
    footer.TextXAlignment = Enum.TextXAlignment.Right
    bind(footer, "TextColor3", "MutedText")

    local tooltip = makeText(screenGui, "", 12, Enum.Font.GothamMedium)
    tooltip.Name = "Tooltip"
    tooltip.AnchorPoint = Vector2.new(0.5, 1)
    tooltip.Position = UDim2.new(0.5, 0, 1, -18)
    tooltip.Size = UDim2.new(0, 420, 0, 42)
    tooltip.BackgroundTransparency = 1
    tooltip.TextTransparency = 1
    tooltip.Visible = false
    tooltip.ZIndex = 150
    tooltip.TextWrapped = true
    bind(tooltip, "BackgroundColor3", "Header")
    makeCorner(tooltip, 4)
    makeStroke(tooltip, theme.SchemeColor, 1, 1)

    local islandFrame = Instance.new("CanvasGroup")
    islandFrame.Name = "LHDynamicIsland"
    islandFrame.AnchorPoint = Vector2.new(0.5, 0)
    islandFrame.Position = UDim2.new(0.5, 0, 0, 8)
    islandFrame.Size = UDim2.fromOffset(185, 38)
    islandFrame.BackgroundTransparency = 0.02
    islandFrame.BorderSizePixel = 0
    islandFrame.GroupTransparency = 1
    islandFrame.Visible = false
    islandFrame.ZIndex = 240
    islandFrame.Parent = screenGui
    bind(islandFrame, "BackgroundColor3", "NotificationColor")
    makeCorner(islandFrame, 18)
    local islandStroke = makeStroke(islandFrame, theme.SchemeColor, 0.22, 1)

    local islandTitle = makeText(islandFrame, "Lollypop Hub", 13, Enum.Font.GothamBold)
    islandTitle.Position = UDim2.fromOffset(14, 5)
    islandTitle.Size = UDim2.new(1, -28, 0, 20)
    islandTitle.TextXAlignment = Enum.TextXAlignment.Left
    islandTitle.ZIndex = 241
    local islandBody = makeText(islandFrame, "", 11, Enum.Font.GothamMedium)
    islandBody.Position = UDim2.fromOffset(14, 25)
    islandBody.Size = UDim2.new(1, -28, 0, 22)
    islandBody.TextXAlignment = Enum.TextXAlignment.Left
    islandBody.TextTruncate = Enum.TextTruncate.AtEnd
    islandBody.ZIndex = 241
    bind(islandBody, "TextColor3", "MutedText")
    local islandProgress = Instance.new("Frame")
    islandProgress.Position = UDim2.fromOffset(14, 54)
    islandProgress.Size = UDim2.new(1, -28, 0, 5)
    islandProgress.BorderSizePixel = 0
    islandProgress.Visible = false
    islandProgress.ZIndex = 241
    islandProgress.Parent = islandFrame
    bind(islandProgress, "BackgroundColor3", "NotificationTrack")
    makeCorner(islandProgress, 3)
    local islandProgressFill = Instance.new("Frame")
    islandProgressFill.Size = UDim2.new(0, 0, 1, 0)
    islandProgressFill.BorderSizePixel = 0
    islandProgressFill.ZIndex = 242
    islandProgressFill.Parent = islandProgress
    bind(islandProgressFill, "BackgroundColor3", "SchemeColor")
    makeCorner(islandProgressFill, 3)

    local resize = makeButton(main, "")
    resize.Name = "ResizeHandle"
    resize.AnchorPoint = Vector2.new(1, 1)
    resize.Position = UDim2.new(1, -3, 1, -3)
    resize.Size = UDim2.fromOffset(24, 24)
    resize.BackgroundTransparency = 1
    resize.TextSize = 12
    resize.ZIndex = 30

    active = {
        ScreenGui = screenGui,
        Main = main,
        Header = header,
        Sidebar = sidebar,
        Pages = pages,
        TabList = tabList,
        Theme = theme,
        ThemeSource = themeInput,
        MainStroke = mainStroke,
        SideGradient = sideGradient,
        Tooltip = tooltip,
        NotificationHost = createNotificationHost(screenGui, false),
        ActionNotificationHost = createNotificationHost(screenGui, true),
        Tabs = {},
        SelectedTab = nil,
        Scale = scale,
        Footer = footer,
        Logo = logo,
        ParticleLayer = particleLayer,
        ParticleObjects = particleObjects,
        Cursor = nil,
        SessionStarted = tonumber(env.LHSessionStart) or tick(),
        BackStack = {},
        ForwardStack = {},
        UndoStack = {},
        Undoing = false,
        RestoringState = false,
        BackButton = backButton,
        ForwardButton = forwardButton,
        UndoButton = undoButton,
        IslandToken = 0,
        Island = {
            Frame = islandFrame,
            Title = islandTitle,
            Body = islandBody,
            Progress = islandProgress,
            ProgressFill = islandProgressFill,
            Stroke = islandStroke,
        },
        ContextOverlay = nil,
        Shelf = nil,
        ShelfRefreshQueued = false,
        AnimationBundles = nil,
    }
    applyTheme()
    setGlassBlur(true)
    LULA:DraggingEnabled(header, main)

    local particleClock = 0
    track(RunService.RenderStepped:Connect(function(delta)
        if not active or not particleLayer.Visible or settings.LowPerformance or settings.ReducedMotion then return end
        particleClock = particleClock + delta
        if particleClock < 0.035 then return end
        particleClock = 0
        for index, particle in ipairs(particleObjects) do
            particle.Position = UDim2.new(
                particle.Position.X.Scale,
                particle.Position.X.Offset,
                (particle.Position.Y.Scale - 0.0008 * (index + 4)) % 1,
                particle.Position.Y.Offset
            )
        end
    end))

    local customCursor = Instance.new("ImageLabel")
    customCursor.Name = "LollypopCursor"
    customCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    customCursor.Size = UDim2.fromOffset(26, 26)
    customCursor.BackgroundTransparency = 1
    customCursor.Image = "rbxassetid://" .. tostring(env.getImg or env.lollypopimg or 17767487755)
    customCursor.ScaleType = Enum.ScaleType.Fit
    customCursor.ZIndex = 500
    customCursor.Visible = settings.CustomCursor and not UserInputService.TouchEnabled
    customCursor.Parent = screenGui
    active.Cursor = customCursor
    pcall(function() UserInputService.MouseIconEnabled = not customCursor.Visible end)
    track(UserInputService.InputChanged:Connect(function(inputObject)
        if customCursor.Visible and inputObject.UserInputType == Enum.UserInputType.MouseMovement then
            customCursor.Position = UDim2.fromOffset(inputObject.Position.X, inputObject.Position.Y)
        end
    end))

    track(close.MouseButton1Click:Connect(function()
        if type(env.LHRequestClose) == "function" then
            safeCall("Close confirmation", env.LHRequestClose)
        elseif env.LHRuntime and type(env.LHRuntime.Unload) == "function" then
            safeCall("Unload LH", function() env.LHRuntime:Unload("close button") end)
        else
            LULA:Destroy()
        end
    end))

    local logoClicks = 0
    track(logo.MouseButton1Click:Connect(function()
        logoClicks = logoClicks + 1
        tween(logo, {Rotation = logo.Rotation + 120}, 0.22, Enum.EasingStyle.Back)
        if logoClicks >= 7 then
            logoClicks = 0
            LULA:Notify("success", "Easter Egg", "Seven licks. The lollypop woke up.", 5)
            if env.LHEasterEgg then safeCall("Easter egg", env.LHEasterEgg) end
        end
    end))

    local resizing = false
    local resizeStart = nil
    local sizeStart = nil
    track(resize.InputBegan:Connect(function(inputObject)
        if settings.DragLocked then return end
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = inputObject.Position
            sizeStart = main.Size
        end
    end))
    track(UserInputService.InputChanged:Connect(function(inputObject)
        if not resizing then return end
        if inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then
            local delta = inputObject.Position - resizeStart
            local width = math.clamp(sizeStart.X.Offset + delta.X / math.max(scale.Scale, 0.01), 420, 760)
            local height = math.clamp(sizeStart.Y.Offset + delta.Y / math.max(scale.Scale, 0.01), 250, 520)
            main.Size = UDim2.fromOffset(width, height)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            resizing = false
            -- Resized UI intentionally stays exactly where the user leaves it.
        end
    end))

    local function refreshScale()
        scale.Scale = adaptiveScale()
        -- Do not boomerang/reposition the main UI after viewport changes.
    end
    local camera = workspace.CurrentCamera
    if camera then track(camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale)) end
    track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local newCamera = workspace.CurrentCamera
        if newCamera then track(newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale)) end
        refreshScale()
    end))

    local window = {}

    local function selectTab(tab, mode)
        if not tab or active.SelectedTab == tab then
            if tab and tab.EnsureBuilt then tab:EnsureBuilt() end
            return
        end
        local old = active.SelectedTab
        if old then
            old.LastCanvasPosition = old.Scroll and old.Scroll.CanvasPosition or old.LastCanvasPosition or Vector2.new()
            if mode ~= "back" and mode ~= "forward" and mode ~= "restore" and mode ~= "initial" then
                table.insert(active.BackStack, old.Name)
                while #active.BackStack > 40 do table.remove(active.BackStack, 1) end
                table.clear(active.ForwardStack)
            end
        end
        active.SelectedTab = tab

        if old then
            tween(old.Page, {Position = UDim2.new(-0.04, 0, 0, 0), GroupTransparency = 1}, 0.12)
            task.delay(duration(0.13), function()
                if old.Page and active and active.SelectedTab ~= old then old.Page.Visible = false end
            end)
            tween(old.Button, {BackgroundTransparency = 1}, 0.1)
        end
        tab:EnsureBuilt()
        tab.Page.Position = UDim2.new(0.04, 0, 0, 0)
        tab.Page.GroupTransparency = 1
        tab.Page.Visible = true
        tween(tab.Page, {Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0}, 0.15)
        tween(tab.Button, {BackgroundTransparency = 0.04}, 0.1)
        task.defer(function()
            if active and active.SelectedTab == tab and tab.Scroll then
                local saved = tab.LastCanvasPosition or Vector2.new()
                local maxY = math.max(0, tab.Scroll.AbsoluteCanvasSize.Y - tab.Scroll.AbsoluteWindowSize.Y)
                tab.Scroll.CanvasPosition = Vector2.new(math.max(0, saved.X), math.clamp(saved.Y, 0, maxY))
            end
        end)
        updateNavButtons()
    end

    local function goBack()
        if not active or #active.BackStack == 0 then return false end
        local targetName = table.remove(active.BackStack)
        local current = active.SelectedTab
        local target = findTabByName(targetName)
        if not target then updateNavButtons(); return false end
        if current then table.insert(active.ForwardStack, current.Name) end
        selectTab(target, "back")
        return true
    end

    local function goForward()
        if not active or #active.ForwardStack == 0 then return false end
        local targetName = table.remove(active.ForwardStack)
        local current = active.SelectedTab
        local target = findTabByName(targetName)
        if not target then updateNavButtons(); return false end
        if current then table.insert(active.BackStack, current.Name) end
        selectTab(target, "forward")
        return true
    end

    track(backButton.MouseButton1Click:Connect(goBack))
    track(forwardButton.MouseButton1Click:Connect(goForward))

    -- Tap = undo. Hold = open the full history, including on mobile.
    local undoHoldToken = 0
    local undoHeld = false
    track(undoButton.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType ~= Enum.UserInputType.Touch and inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        undoHoldToken = undoHoldToken + 1
        local mine = undoHoldToken
        undoHeld = false
        task.delay(0.52, function()
            if mine ~= undoHoldToken or not undoButton.Parent then return end
            undoHeld = true
            LULA:OpenUndoHistory()
        end)
    end))
    track(undoButton.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.Touch or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
            undoHoldToken = undoHoldToken + 1
        end
    end))
    track(undoButton.MouseButton1Click:Connect(function()
        if undoHeld then undoHeld = false; return end
        LULA:Undo()
    end))
    track(undoButton.MouseButton2Click:Connect(function() LULA:OpenUndoHistory() end))
    updateNavButtons()

    function window:NewTab(tabName)
        tabName = tostring(tabName or "Tab")
        local tabButton = makeButton(tabList, tabName)
        tabButton.Name = tabName .. "TabButton"
        tabButton.Size = UDim2.new(0, 135, 0, 28)
        tabButton.TextXAlignment = Enum.TextXAlignment.Left
        tabButton.Text = tabName
        tabButton.BackgroundTransparency = 1
        tabButton.TextSize = tonumber(env.tabtextsize) or 16
        tabButton.Font = resolveUIFont(Enum.Font.DenkOne)

        local page = Instance.new("CanvasGroup")
        page.Name = tabName .. "Page"
        page:SetAttribute("LHTabName", tabName)
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.Parent = pages

        local scroll = Instance.new("ScrollingFrame")
        scroll.Name = "Scroll"
        scroll.Position = UDim2.fromOffset(8, 0)
        scroll.Size = UDim2.new(1, -16, 1, 0)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 3
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.CanvasSize = UDim2.new()
        scroll.Parent = page
        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 5)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = scroll

        local tab = {
            Name = tabName,
            Button = tabButton,
            Page = page,
            Scroll = scroll,
            Built = false,
            Builder = nil,
            Sections = {},
            LastCanvasPosition = Vector2.new(),
            SearchBar = nil,
        }
        track(scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
            tab.LastCanvasPosition = scroll.CanvasPosition
        end))

        function tab:SetLazyBuilder(builder)
            self.Builder = builder
            if active and active.SelectedTab == self then self:EnsureBuilt() end
            return self
        end

        function tab:EnsureBuilt()
            if self.Built then return end
            self.Built = true
            if self.Builder then safeCall("Build tab " .. self.Name, self.Builder, self) end
        end

        function tab:NewSection(sectionName, hidden)
            self.Built = true
            sectionName = tostring(sectionName or "Section")
            sectionName = sectionName:gsub("^%s*%[+%s*", ""):gsub("%s*%]+%s*$", "")
            local section = Instance.new("Frame")
            section.Name = sectionName
            section.Size = UDim2.new(1, -4, 0, 0)
            section.AutomaticSize = Enum.AutomaticSize.Y
            section.BackgroundTransparency = 1
            section.Parent = scroll
            local sectionLayout = Instance.new("UIListLayout")
            sectionLayout.Padding = UDim.new(0, 5)
            sectionLayout.SortOrder = Enum.SortOrder.LayoutOrder
            sectionLayout.Parent = section

            if not hidden then
                local heading = Instance.new("TextLabel")
                heading.Name = "SectionHeading"
                heading.Size = UDim2.new(1, 0, 0, 36)
                heading.BackgroundTransparency = 0
                heading.BackgroundColor3 = rgb(235, 177, 45)
                heading.BorderSizePixel = 0
                heading.Font = resolveUIFont(Enum.Font.GothamBold)
                heading.Text = string.upper(sectionName)
                heading.TextSize = tonumber(env.sektiontextsize) or 18.5
                heading.TextColor3 = rgb(42, 27, 5)
                heading.TextXAlignment = Enum.TextXAlignment.Center
                heading.TextWrapped = true
                heading.Parent = section
                makeCorner(heading, 7)
                local headingGradient = Instance.new("UIGradient")
                headingGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, rgb(255, 226, 119)),
                    ColorSequenceKeypoint.new(0.5, rgb(232, 164, 31)),
                    ColorSequenceKeypoint.new(1, rgb(255, 207, 74)),
                })
                headingGradient.Rotation = 8
                headingGradient.Parent = heading
                makeStroke(heading, rgb(255, 225, 125), 0.2, 1)
            end

            local elements = {}
            local controls = {}

            local function register(api, row, searchable)
                api = api or {}
                api.Frame = row
                api.Name = tostring(row.Name or "Kontrol")
                api.DisplayName = api.Name
                api.TabName = tab.Name
                api.SectionName = sectionName
                api.ControlId = normalizeControlId(tab.Name .. "::" .. sectionName .. "::" .. api.Name)
                api.SearchText = string.lower(tostring(searchable or row.Name))
                api.BaseVisible = row.Visible
                local searchStroke = makeStroke(row, active.Theme.SchemeColor, 1, 1.4)
                searchStroke.Name = "LHSearchMatch"
                searchStroke.Enabled = false
                table.insert(controls, api)
                controlFrameRegistry[row] = api
                controlIdRegistry[api.ControlId] = api
                row:SetAttribute("LHControlId", api.ControlId)
                function api:SetMetadata(metadata)
                    metadata = type(metadata) == "table" and metadata or {}
                    if self.ControlId and controlIdRegistry[self.ControlId] == self then controlIdRegistry[self.ControlId] = nil end
                    self.ControlId = normalizeControlId(metadata.ControlId or self.ControlId)
                    self.DisplayName = tostring(metadata.DisplayName or metadata.Name or self.DisplayName or self.Name)
                    self.Name = self.DisplayName
                    self.Kind = tostring(metadata.Kind or self.Kind or "kontrol")
                    self.Tip = tostring(metadata.Tip or self.Tip or row:GetAttribute("LHDescription") or "")
                    self.TabName = tostring(metadata.TabName or self.TabName or tab.Name)
                    self.SectionName = tostring(metadata.SectionName or self.SectionName or sectionName)
                    row:SetAttribute("LHControlId", self.ControlId)
                    controlIdRegistry[self.ControlId] = self
                    queueShelfRefresh()
                    return self
                end
                function api:SetVisible(value)
                    self.BaseVisible = value and true or false
                    row.Visible = self.BaseVisible
                end
                function api:SetSearchHighlighted(value)
                    searchStroke.Enabled = value and true or false
                    if searchStroke.Enabled then
                        searchStroke.Color = active.Theme.SchemeColor
                        tween(searchStroke, {Transparency = 0.08}, 0.1)
                    else
                        searchStroke.Transparency = 1
                    end
                end
                return api
            end

            function elements:NewButton(name, tip, callback)
                callback = callback or function() end
                local row = newRow(section, name, 33)
                local icon = makeLollyActionIcon(row)
                icon.Position = UDim2.fromOffset(8, 5)
                icon.Size = UDim2.fromOffset(22, 22)
                local textLabel = makeText(row, name, tonumber(env.buttontextsize) or 18, Enum.Font.PatrickHand)
                textLabel.Position = UDim2.fromOffset(36, 0)
                textLabel.Size = UDim2.new(1, -48, 1, 0)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local click = Instance.new("TextButton")
                click.BackgroundTransparency = 1
                click.Text = ""
                click.Size = UDim2.new(1, -34, 1, 0)
                click.Parent = row
                createInfoButton(row, name, tip, -5, 5)
                local busy = false
                track(click.MouseButton1Click:Connect(function()
                    if row:GetAttribute("LHLongPressTriggered") then
                        row:SetAttribute("LHLongPressTriggered", false)
                        return
                    end
                    if busy then return end
                    busy = true
                    tween(row, {Size = UDim2.new(1, -3, 0, 31)}, 0.06)
                    safeCall("Button " .. tostring(name), callback)
                    task.delay(0.18, function()
                        if row and row.Parent then tween(row, {Size = UDim2.new(1, 0, 0, 33)}, 0.08) end
                        busy = false
                    end)
                end))
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                api.Kind = "button"
                function api:Fire() safeCall("Button " .. tostring(name), callback) end
                return api
            end

            function elements:NewToggle(name, tip, callback, defaultValue)
                callback = callback or function() end
                local default = defaultValue == true
                local value = default
                local row = newRow(section, name, 36)
                local textLabel = makeText(row, name, tonumber(env.togtextsize) or 17, Enum.Font.PatrickHand)
                textLabel.Position = UDim2.fromOffset(12, 0)
                textLabel.Size = UDim2.new(1, -104, 1, 0)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local pill = Instance.new("Frame")
                pill.Position = UDim2.new(1, -70, 0.5, -11)
                pill.Size = UDim2.fromOffset(38, 22)
                pill.BorderSizePixel = 0
                pill.Parent = row
                makeCorner(pill, 11)
                local knob = Instance.new("Frame")
                knob.Size = UDim2.fromOffset(18, 18)
                knob.Position = UDim2.fromOffset(2, 2)
                knob.BorderSizePixel = 0
                knob.BackgroundColor3 = rgb(245, 245, 248)
                knob.Parent = pill
                makeCorner(knob, 9)
                local hit = Instance.new("TextButton")
                hit.BackgroundTransparency = 1
                hit.Text = ""
                hit.Size = UDim2.fromScale(1, 1)
                hit.Parent = pill
                local function render(animate)
                    local switchColor = value and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
                    if animate then
                        tween(pill, {BackgroundColor3 = switchColor}, 0.12)
                        tween(knob, {Position = value and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)}, 0.12)
                    else
                        pill.BackgroundColor3 = switchColor
                        knob.Position = value and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
                    end
                end
                local function set(newValue, fire)
                    value = newValue and true or false
                    render(true)
                    if fire ~= false then safeCall("Toggle " .. tostring(name), callback, value) end
                    queueShelfRefresh()
                end
                -- Toggles do not need a separate Reset button; switching OFF is already the reset action.
                track(hit.MouseButton1Click:Connect(function()
                    if row:GetAttribute("LHLongPressTriggered") then
                        row:SetAttribute("LHLongPressTriggered", false)
                        return
                    end
                    set(not value)
                end))
                render(false)
                createInfoButton(row, name, tip, -5, 7)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                api.Kind = "toggle"
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault) default = newDefault == true end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewTextBox(name, tip, callback, placeholder, defaultValue)
                callback = callback or function() end
                local default = tostring(defaultValue or "")
                if default == "TextBox" then default = "" end
                local row = newRow(section, name, 66)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 3)
                textLabel.Size = UDim2.new(1, -46, 0, 23)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local box = Instance.new("TextBox")
                box.Position = UDim2.fromOffset(10, 29)
                box.Size = UDim2.new(1, -46, 0, 29)
                box.BackgroundTransparency = 0.1
                box.BorderSizePixel = 0
                box.ClearTextOnFocus = false
                box.Font = resolveUIFont(Enum.Font.Gotham)
                box.TextSize = 13
                box.TextXAlignment = Enum.TextXAlignment.Left
                box.PlaceholderText = tostring(placeholder or "Type here...")
                box.Text = (default == "TextBox") and "" or default
                box.Parent = row
                if box.Text == "TextBox" then box.Text = "" end
                bind(box, "BackgroundColor3", "Header")
                bind(box, "TextColor3", "TextColor")
                makeCorner(box, 6)
                local padding = Instance.new("UIPadding")
                padding.PaddingLeft = UDim.new(0, 8)
                padding.PaddingRight = UDim.new(0, 8)
                padding.Parent = box
                local function submit()
                    safeCall("TextBox " .. tostring(name), callback, box.Text)
                end
                createInfoButton(row, name, tip, -5, 3)
                attachClearX(box)
                track(box.FocusLost:Connect(function(enterPressed)
                    if enterPressed then submit() end
                end))
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                api.Kind = "textbox"
                function api:SetValue(value, fire)
                    box.Text = tostring(value or "")
                    if fire ~= false then submit() end
                end
                function api:GetValue() return box.Text end
                function api:SetResetDefault(newDefault) default = tostring(newDefault or "") end
                function api:Reset() box.Text = default; submit() end
                return api
            end

            function elements:NewSlider(name, tip, minValue, maxValue, callback, defaultValue)
                callback = callback or function() end
                minValue = tonumber(minValue) or 0
                maxValue = tonumber(maxValue) or 100
                if maxValue < minValue then minValue, maxValue = maxValue, minValue end
                local default = math.clamp(tonumber(defaultValue) or minValue, minValue, maxValue)
                local value = default
                local row = newRow(section, name, 70)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 2)
                textLabel.Size = UDim2.new(1, -150, 0, 23)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local valueBox = Instance.new("TextBox")
                valueBox.AnchorPoint = Vector2.new(1, 0)
                -- Keep the number field fully visible and reserve the far-right column for X / R.
                valueBox.Position = UDim2.new(1, -70, 0, 5)
                valueBox.Size = UDim2.fromOffset(70, 24)
                valueBox.BackgroundTransparency = 0.08
                valueBox.BorderSizePixel = 0
                valueBox.ClearTextOnFocus = false
                valueBox.Font = resolveUIFont(Enum.Font.GothamMedium)
                valueBox.TextSize = 12
                valueBox.Parent = row
                bind(valueBox, "BackgroundColor3", "Header")
                bind(valueBox, "TextColor3", "TextColor")
                makeCorner(valueBox, 6)
                local trackBar = Instance.new("Frame")
                trackBar.Position = UDim2.fromOffset(12, 43)
                trackBar.Size = UDim2.new(1, -50, 0, 7)
                trackBar.BorderSizePixel = 0
                trackBar.BackgroundColor3 = rgb(70, 70, 80)
                trackBar.Parent = row
                makeCorner(trackBar, 4)
                local fill = Instance.new("Frame")
                fill.Size = UDim2.new(0, 0, 1, 0)
                fill.BorderSizePixel = 0
                fill.Parent = trackBar
                bind(fill, "BackgroundColor3", "SchemeColor")
                makeCorner(fill, 4)
                local knob = Instance.new("Frame")
                knob.AnchorPoint = Vector2.new(0.5, 0.5)
                knob.Position = UDim2.fromScale(0, 0.5)
                knob.Size = UDim2.fromOffset(15, 15)
                knob.BorderSizePixel = 0
                knob.BackgroundColor3 = rgb(245, 245, 248)
                knob.Parent = trackBar
                makeCorner(knob, 8)
                local dragging = false
                local function set(newValue, fire)
                    value = math.clamp(tonumber(newValue) or value, minValue, maxValue)
                    local alpha = maxValue == minValue and 0 or (value - minValue) / (maxValue - minValue)
                    valueBox.Text = tostring(math.floor(value * 100 + 0.5) / 100)
                    tween(fill, {Size = UDim2.new(alpha, 0, 1, 0)}, 0.08)
                    tween(knob, {Position = UDim2.fromScale(alpha, 0.5)}, 0.08)
                    if fire ~= false then safeCall("Slider " .. tostring(name), callback, value) end
                end
                local function setFromInput(inputObject)
                    local alpha = math.clamp((inputObject.Position.X - trackBar.AbsolutePosition.X) / math.max(trackBar.AbsoluteSize.X, 1), 0, 1)
                    set(minValue + (maxValue - minValue) * alpha)
                end
                track(trackBar.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        setFromInput(inputObject)
                    end
                end))
                track(UserInputService.InputChanged:Connect(function(inputObject)
                    if dragging and (inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch) then
                        setFromInput(inputObject)
                    end
                end))
                track(UserInputService.InputEnded:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then dragging = false end
                end))
                local clearSlider = makeKolorButton(row, "X", rgb(220, 48, 65))
                clearSlider.Name = "ClearSliderTextX"
                clearSlider.AnchorPoint = Vector2.new(1, 0.5)
                clearSlider.Position = UDim2.new(1, -7, 0, 15)
                clearSlider.Size = UDim2.fromOffset(22, 22)
                clearSlider.TextSize = 10
                clearSlider.ZIndex = 7
                track(clearSlider.MouseButton1Click:Connect(function()
                    -- X only clears; it must not summon the keyboard.
                    pcall(function() valueBox:ReleaseFocus(false) end)
                    valueBox.Text = ""
                end))
                track(valueBox.FocusLost:Connect(function(enterPressed) if enterPressed then set(tonumber(valueBox.Text) or value) end end))
                local sliderReset = createReset(row, function() set(default) end)
                sliderReset.Position = UDim2.new(1, -7, 0, 54)
                createInfoButton(row, name, tip, -35, 4)
                set(default, false)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                api.Kind = "slider"
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault) default = math.clamp(tonumber(newDefault) or minValue, minValue, maxValue) end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewDropdown(name, tip, list, callback, defaultValue)
                callback = callback or function() end
                list = type(list) == "table" and list or {}
                local default = defaultValue ~= nil and defaultValue or list[1]
                local value = default
                local row = newRow(section, name, 70)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 2)
                textLabel.Size = UDim2.new(1, -46, 0, 22)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local selectButton = makeButton(row, value ~= nil and tostring(value) or "Select...")
                selectButton.Position = UDim2.fromOffset(10, 29)
                selectButton.Size = UDim2.new(1, -46, 0, 31)
                selectButton.TextXAlignment = Enum.TextXAlignment.Left
                selectButton.Text = "  " .. selectButton.Text
                makeStroke(selectButton, active.Theme.SchemeColor, 0.55, 1)
                local arrow = makeText(selectButton, utf8.char(0x25BC), 12, Enum.Font.GothamBold)
                arrow.AnchorPoint = Vector2.new(1, 0.5)
                arrow.Position = UDim2.new(1, -10, 0.5, 0)
                arrow.Size = UDim2.fromOffset(18, 20)
                arrow.TextXAlignment = Enum.TextXAlignment.Center
                bind(arrow, "TextColor3", "SchemeColor")
                local popup = Instance.new("ScrollingFrame")
                popup.Name = "DropdownPopup"
                popup.Position = UDim2.fromOffset(10, 62)
                popup.Size = UDim2.new(1, -46, 0, 0)
                popup.BackgroundTransparency = 0.02
                popup.BorderSizePixel = 0
                popup.AutomaticCanvasSize = Enum.AutomaticSize.Y
                popup.CanvasSize = UDim2.new()
                popup.ScrollBarThickness = 2
                popup.Visible = false
                popup.ZIndex = 20
                popup.Parent = row
                bind(popup, "BackgroundColor3", "Header")
                makeCorner(popup, 7)
                makeStroke(popup, active.Theme.SchemeColor, 0.45, 1)
                local popupLayout = Instance.new("UIListLayout")
                popupLayout.Padding = UDim.new(0, 2)
                popupLayout.Parent = popup
                local open = false
                local api
                local function set(newValue, fire)
                    value = newValue
                    selectButton.Text = "  " .. tostring(value or "Select...")
                    if fire ~= false then safeCall("Dropdown " .. tostring(name), callback, value) end
                end
                local function closePopup()
                    open = false
                    arrow.Rotation = 0
                    popup.Visible = false
                    row.Size = UDim2.new(1, 0, 0, 70)
                    popup.Size = UDim2.new(1, -46, 0, 0)
                end
                local function rebuild(newList)
                    list = type(newList) == "table" and newList or {}
                    for _, child in ipairs(popup:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    for _, option in ipairs(list) do
                        local optionButton = makeButton(popup, tostring(option))
                        optionButton.Size = UDim2.new(1, -4, 0, 28)
                        optionButton.TextXAlignment = Enum.TextXAlignment.Left
                        optionButton.Text = (option == value and ("  " .. utf8.char(0x2713) .. "  ") or "     ") .. tostring(option)
                        optionButton.ZIndex = 21
                        if option == value then
                            optionButton.BackgroundTransparency = 0.02
                            bind(optionButton, "TextColor3", "SchemeColor")
                        else
                            optionButton.BackgroundTransparency = 0.16
                        end
                        track(optionButton.MouseButton1Click:Connect(function()
                            set(option)
                            closePopup()
                        end))
                    end
                end
                rebuild(list)
                track(selectButton.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        arrow.Rotation = 180
                        local height = math.min(150, math.max(32, #list * 30))
                        popup.Visible = true
                        popup.Size = UDim2.new(1, -46, 0, height)
                        row.Size = UDim2.new(1, 0, 0, 70 + height)
                    else
                        arrow.Rotation = 0
                        closePopup()
                    end
                end))
                local dropdownReset = createReset(row, function() set(default) end)
                dropdownReset.Position = UDim2.new(1, -7, 0, 54)
                createInfoButton(row, name, tip, -5, 4)
                attachTip(row, tip)
                api = register({}, row, tostring(name) .. " " .. tostring(tip) .. " " .. table.concat(list, " "))
                api.Kind = "dropdown"
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:Refresh(newList)
                    rebuild(newList)
                    self.SearchText = string.lower(tostring(name) .. " " .. tostring(tip) .. " " .. table.concat(list, " "))
                end
                function api:ContainsValue(candidate)
                    return table.find(list, candidate) ~= nil
                end
                function api:SetResetDefault(newDefault) default = newDefault end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewCounter(name, tip, stepValue, callback, defaultValue, minValue, maxValue)
                callback = callback or function() end
                local step = math.abs(tonumber(stepValue) or 0.5)
                if step == 0 then step = 0.5 end
                local default = tonumber(defaultValue) or 0
                local minimum = tonumber(minValue)
                local maximum = tonumber(maxValue)
                local value = default
                local row = newRow(section, name, 72)

                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 2)
                textLabel.Size = UDim2.new(1, -46, 0, 22)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left

                local minus = makeKolorButton(row, "-", rgb(214, 50, 67))
                minus.Position = UDim2.fromOffset(10, 31)
                minus.Size = UDim2.fromOffset(42, 31)
                minus.TextSize = 21

                local plus = makeKolorButton(row, "+", rgb(40, 177, 91))
                plus.Position = UDim2.new(1, -87, 0, 31)
                plus.Size = UDim2.fromOffset(42, 31)
                plus.TextSize = 20

                local valueBox = Instance.new("TextBox")
                valueBox.Position = UDim2.fromOffset(58, 31)
                valueBox.Size = UDim2.new(1, -151, 0, 31)
                valueBox.BackgroundTransparency = 0.08
                valueBox.BorderSizePixel = 0
                valueBox.ClearTextOnFocus = false
                valueBox.Font = resolveUIFont(Enum.Font.GothamBold)
                valueBox.TextSize = 13
                valueBox.TextXAlignment = Enum.TextXAlignment.Center
                valueBox.PlaceholderText = tostring(default)
                valueBox.Parent = row
                bind(valueBox, "BackgroundColor3", "Header")
                bind(valueBox, "TextColor3", "TextColor")
                makeCorner(valueBox, 7)
                attachClearX(valueBox)

                local function cleanNumber(number)
                    number = tonumber(number) or 0
                    local rounded = math.floor(number * 10000 + (number >= 0 and 0.5 or -0.5)) / 10000
                    return rounded
                end

                local function set(newValue, fire)
                    local number = tonumber(newValue)
                    if number == nil then number = value end
                    if minimum ~= nil then number = math.max(minimum, number) end
                    if maximum ~= nil then number = math.min(maximum, number) end
                    value = cleanNumber(number)
                    valueBox.Text = tostring(value)
                    if fire ~= false then safeCall("Kounter " .. tostring(name), callback, value) end
                end

                local holdToken = 0
                local function beginHold(direction)
                    holdToken = holdToken + 1
                    local mine = holdToken
                    local started = tick()
                    set(value + (step * direction))
                    task.spawn(function()
                        task.wait(0.3)
                        while mine == holdToken and row.Parent do
                            local elapsed = tick() - started
                            local multiplier = elapsed >= 2 and 5 or (elapsed >= 1 and 2 or 1)
                            set(value + (step * multiplier * direction))
                            task.wait(math.max(0.045, 0.13 - math.min(elapsed, 2) * 0.03))
                        end
                    end)
                end
                local function stopHold()
                    holdToken = holdToken + 1
                end
                local function bindHold(button, direction)
                    track(button.InputBegan:Connect(function(inputObject)
                        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                            beginHold(direction)
                        end
                    end))
                    track(button.InputEnded:Connect(function(inputObject)
                        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                            stopHold()
                        end
                    end))
                    track(button.MouseLeave:Connect(stopHold))
                end
                bindHold(minus, -1)
                bindHold(plus, 1)

                track(valueBox.FocusLost:Connect(function(enterPressed)
                    if enterPressed then set(tonumber(valueBox.Text) or value) end
                end))
                local resetCounter = makeButton(row, "Reset")
                resetCounter.AnchorPoint = Vector2.new(1, 0.5)
                resetCounter.Position = UDim2.new(1, -6, 0, 46)
                resetCounter.Size = UDim2.fromOffset(38, 24)
                resetCounter.TextSize = 9
                resetCounter.ZIndex = 7
                track(resetCounter.MouseButton1Click:Connect(function() set(default) end))
                set(default, false)
                createInfoButton(row, name, tip, -5, 3)
                attachTip(row, tip)

                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                api.Kind = "counter"
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault) default = tonumber(newDefault) or default end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewKeybind(name, tip, first, callback)
                callback = callback or function() end
                local default = first or Enum.KeyCode.RightShift
                local current = default
                local row = newRow(section, name, 48)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 0)
                textLabel.Size = UDim2.new(1, -150, 1, 0)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local bindButton = makeButton(row, UserInputService.TouchEnabled and "MOBILE TAP" or tostring(current.Name or current))
                bindButton.Position = UDim2.new(1, -137, 0.5, -14)
                bindButton.Size = UDim2.fromOffset(101, 28)
                local mobileButton = nil
                local listening = false
                local function removeMobileButton()
                    if mobileButton then mobileButton:Destroy(); mobileButton = nil end
                end
                local function makeMobileButton()
                    removeMobileButton()
                    mobileButton = makeButton(screenGui, ">")
                    mobileButton.Name = "MobileKeybind_" .. tostring(name)
                    mobileButton.AnchorPoint = Vector2.new(1, 0.5)
                    mobileButton.Position = UDim2.new(1, -18, 0.55, 0)
                    mobileButton.Size = UDim2.fromOffset(50, 50)
                    mobileButton.ZIndex = 200
                    makeCorner(mobileButton, 25)
                    track(mobileButton.MouseButton1Click:Connect(function()
                        safeCall("Mobile keybind " .. tostring(name), callback)
                    end))
                    LULA:DraggingEnabled(mobileButton, mobileButton)
                end
                track(bindButton.MouseButton1Click:Connect(function()
                    if UserInputService.TouchEnabled then
                        if mobileButton then
                            removeMobileButton()
                            bindButton.Text = "MOBILE OFF"
                        else
                            makeMobileButton()
                            bindButton.Text = "MOBILE ON"
                        end
                    else
                        listening = true
                        bindButton.Text = "PRESS KEY..."
                    end
                end))
                track(UserInputService.InputBegan:Connect(function(inputObject, processed)
                    if processed then return end
                    if listening and inputObject.UserInputType == Enum.UserInputType.Keyboard then
                        current = inputObject.KeyCode
                        listening = false
                        bindButton.Text = tostring(current.Name)
                        return
                    end
                    if not UserInputService.TouchEnabled and inputObject.KeyCode == current then
                        safeCall("Keybind " .. tostring(name), callback)
                    end
                end))
                createInfoButton(row, name, tip, -35, 13)
                createReset(row, function()
                    current = default
                    listening = false
                    removeMobileButton()
                    bindButton.Text = UserInputService.TouchEnabled and "MOBILE TAP" or tostring(current.Name or current)
                end)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                api.Kind = "keybind"
                function api:SetValue(newValue)
                    current = newValue or default
                    bindButton.Text = UserInputService.TouchEnabled and "MOBILE TAP" or tostring(current.Name or current)
                end
                function api:GetValue() return current end
                function api:SetResetDefault(newDefault) default = newDefault or default end
                function api:Reset()
                    current = default
                    removeMobileButton()
                end
                return api
            end

            function elements:NewColorPicker(name, tip, defaultColor, callback)
                callback = callback or function() end
                local default = typeof(defaultColor) == "Color3" and defaultColor or active.Theme.SchemeColor
                local value = default
                local hue, saturation, brightness = default:ToHSV()
                local rainbow = false
                local rainbowConnection = nil
                local row = newRow(section, name, 156)

                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 0)
                textLabel.Size = UDim2.new(1, -112, 0, 28)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left

                local preview = Instance.new("Frame")
                preview.Position = UDim2.new(1, -70, 0, 6)
                preview.Size = UDim2.fromOffset(34, 22)
                preview.BorderSizePixel = 0
                preview.Parent = row
                makeCorner(preview, 6)
                makeStroke(preview, rgb(255, 255, 255), 0.55, 1)

                -- Main area: full rainbow. X selects hue; Y selects saturation.
                local colorArea = Instance.new("TextButton")
                colorArea.Name = "ManualKolorPicker"
                colorArea.Text = ""
                colorArea.AutoButtonColor = false
                colorArea.Position = UDim2.fromOffset(10, 36)
                colorArea.Size = UDim2.new(1, -96, 0, 82)
                colorArea.BackgroundColor3 = rgb(255, 255, 255)
                colorArea.BorderSizePixel = 0
                colorArea.ClipsDescendants = true
                colorArea.Parent = row
                makeCorner(colorArea, 7)

                local rainbowGradient = Instance.new("UIGradient")
                rainbowGradient.Rotation = 0
                rainbowGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.00, Color3.fromHSV(0.00, 1, 1)),
                    ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
                    ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
                    ColorSequenceKeypoint.new(0.50, Color3.fromHSV(0.50, 1, 1)),
                    ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
                    ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
                    ColorSequenceKeypoint.new(1.00, Color3.fromHSV(1.00, 1, 1)),
                })
                rainbowGradient.Parent = colorArea

                local saturationLayer = Instance.new("Frame")
                saturationLayer.Size = UDim2.fromScale(1, 1)
                saturationLayer.BackgroundColor3 = rgb(255, 255, 255)
                saturationLayer.BorderSizePixel = 0
                saturationLayer.Parent = colorArea
                local saturationGradient = Instance.new("UIGradient")
                saturationGradient.Rotation = 90
                saturationGradient.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1),
                })
                saturationGradient.Parent = saturationLayer

                local colorCursor = Instance.new("Frame")
                colorCursor.AnchorPoint = Vector2.new(0.5, 0.5)
                colorCursor.Size = UDim2.fromOffset(14, 14)
                colorCursor.BackgroundTransparency = 1
                colorCursor.BorderSizePixel = 0
                colorCursor.ZIndex = 5
                colorCursor.Parent = colorArea
                makeCorner(colorCursor, 7)
                makeStroke(colorCursor, rgb(255, 255, 255), 0, 2)

                -- Side slider: bright selected kolor at top, dark at bottom.
                local brightnessBar = Instance.new("TextButton")
                brightnessBar.Name = "BrightnessBar"
                brightnessBar.Text = ""
                brightnessBar.AutoButtonColor = false
                brightnessBar.Position = UDim2.new(1, -75, 0, 36)
                brightnessBar.Size = UDim2.fromOffset(18, 82)
                brightnessBar.BackgroundColor3 = rgb(255, 255, 255)
                brightnessBar.BorderSizePixel = 0
                brightnessBar.ClipsDescendants = false
                brightnessBar.Parent = row
                makeCorner(brightnessBar, 7)
                local brightnessGradient = Instance.new("UIGradient")
                brightnessGradient.Rotation = 90
                brightnessGradient.Parent = brightnessBar

                local brightnessCursor = Instance.new("Frame")
                brightnessCursor.AnchorPoint = Vector2.new(0.5, 0.5)
                brightnessCursor.Size = UDim2.fromOffset(24, 5)
                brightnessCursor.BackgroundColor3 = rgb(255, 255, 255)
                brightnessCursor.BorderSizePixel = 0
                brightnessCursor.ZIndex = 5
                brightnessCursor.Parent = brightnessBar
                makeCorner(brightnessCursor, 3)
                makeStroke(brightnessCursor, rgb(0, 0, 0), 0.2, 1)

                local rainbowButton = makeButton(row, "Rainbow: OFF")
                rainbowButton.Position = UDim2.fromOffset(10, 124)
                rainbowButton.Size = UDim2.new(1, -46, 0, 25)
                rainbowButton.TextSize = 12
                rainbowButton.ZIndex = 5
                makeStroke(rainbowButton, active.Theme.SchemeColor, 0.45, 1)

                local function stopRainbow()
                    rainbow = false
                    rainbowButton.Text = "Rainbow: OFF"
                    if rainbowConnection then
                        pcall(function() rainbowConnection:Disconnect() end)
                        rainbowConnection = nil
                    end
                end

                local function render(fire)
                    value = Color3.fromHSV(hue, saturation, brightness)
                    preview.BackgroundColor3 = value
                    colorCursor.Position = UDim2.fromScale(hue, saturation)
                    brightnessCursor.Position = UDim2.fromScale(0.5, 1 - brightness)
                    brightnessGradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, saturation, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
                    })
                    if fire ~= false then safeCall("Color picker " .. tostring(name), callback, value) end
                end

                local function set(newColor, fire)
                    if typeof(newColor) ~= "Color3" then return end
                    hue, saturation, brightness = newColor:ToHSV()
                    render(fire)
                end

                local function setColorArea(position)
                    stopRainbow()
                    hue = math.clamp((position.X - colorArea.AbsolutePosition.X) / math.max(colorArea.AbsoluteSize.X, 1), 0, 1)
                    saturation = math.clamp((position.Y - colorArea.AbsolutePosition.Y) / math.max(colorArea.AbsoluteSize.Y, 1), 0, 1)
                    render(true)
                end

                local function setBrightness(position)
                    stopRainbow()
                    local y = math.clamp((position.Y - brightnessBar.AbsolutePosition.Y) / math.max(brightnessBar.AbsoluteSize.Y, 1), 0, 1)
                    brightness = 1 - y
                    render(true)
                end

                local draggingColor = false
                local draggingBrightness = false
                track(colorArea.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        draggingColor = true
                        setColorArea(inputObject.Position)
                    end
                end))
                track(brightnessBar.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        draggingBrightness = true
                        setBrightness(inputObject.Position)
                    end
                end))
                track(UserInputService.InputChanged:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then
                        if draggingColor then setColorArea(inputObject.Position) end
                        if draggingBrightness then setBrightness(inputObject.Position) end
                    end
                end))
                track(UserInputService.InputEnded:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        draggingColor = false
                        draggingBrightness = false
                    end
                end))

                local function startRainbow()
                    if rainbow then return end
                    rainbow = true
                    rainbowButton.Text = "Rainbow: ON"
                    rainbowConnection = RunService.RenderStepped:Connect(function()
                        hue = (os.clock() % 5) / 5
                        saturation = 1
                        brightness = 1
                        render(true)
                    end)
                    track(rainbowConnection)
                end

                track(rainbowButton.MouseButton1Click:Connect(function()
                    if rainbow then stopRainbow() else startRainbow() end
                end))

                createInfoButton(row, name, tip, -5, 4)
                createReset(row, function()
                    stopRainbow()
                    set(default)
                end)
                set(default, false)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip) .. " rainbow manual kolor picker")
                api.Kind = "colorpicker"
                function api:SetValue(newColor, fire)
                    stopRainbow()
                    set(newColor, fire)
                end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault)
                    if typeof(newDefault) == "Color3" then default = newDefault end
                end
                function api:SetRainbow(enabled)
                    if enabled then startRainbow() else stopRainbow() end
                end
                function api:Reset()
                    stopRainbow()
                    set(default)
                end
                return api
            end

            function elements:NewLabel(labelText)
                local row = newRow(section, "label", 42)
                row.BackgroundTransparency = 0.08
                local accent = Instance.new("Frame")
                accent.Size = UDim2.new(0, 4, 1, -10)
                accent.Position = UDim2.fromOffset(6, 5)
                accent.BorderSizePixel = 0
                accent.BackgroundColor3 = rgb(236, 176, 40)
                accent.Parent = row
                makeCorner(accent, 2)
                local label = makeText(row, tostring(labelText or ""), 12.5, Enum.Font.GothamMedium)
                label.Position = UDim2.fromOffset(17, 4)
                label.Size = UDim2.new(1, -25, 1, -8)
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.TextYAlignment = Enum.TextYAlignment.Center
                bind(label, "TextColor3", "MutedText")
                local api = register({}, row, tostring(labelText))
                api.Kind = "label"
                function api:UpdateLabel(newText) label.Text = tostring(newText or "") end
                return api
            end

            function elements:NewBannerLabel(labelText)
                local row = newRow(section, "SectionBanner", 42)
                row.BackgroundTransparency = 1
                local heading = Instance.new("TextLabel")
                heading.Size = UDim2.new(1, 0, 1, 0)
                heading.BackgroundTransparency = 0
                heading.BackgroundColor3 = rgb(235, 177, 45)
                heading.BorderSizePixel = 0
                heading.Font = resolveUIFont(Enum.Font.GothamBold)
                heading.Text = string.upper(tostring(labelText or ""))
                heading.TextSize = tonumber(env.sektiontextsize) or 18.5
                heading.TextColor3 = rgb(42, 27, 5)
                heading.TextXAlignment = Enum.TextXAlignment.Center
                heading.TextWrapped = true
                heading.Parent = row
                makeCorner(heading, 7)
                local gradient = Instance.new("UIGradient")
                gradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, rgb(255, 226, 119)),
                    ColorSequenceKeypoint.new(0.5, rgb(232, 164, 31)),
                    ColorSequenceKeypoint.new(1, rgb(255, 207, 74)),
                })
                gradient.Rotation = 8
                gradient.Parent = heading
                makeStroke(heading, rgb(255, 225, 125), 0.2, 1)
                local api = register({}, row, tostring(labelText))
                api.Kind = "banner"
                function api:UpdateLabel(newText) heading.Text = string.upper(tostring(newText or "")) end
                return api
            end

            function elements:NewParagraph(paragraphTitle, paragraphText)
                local row = newRow(section, "paragraph", 76)
                row.AutomaticSize = Enum.AutomaticSize.Y
                local heading = makeText(row, paragraphTitle or "", 14, Enum.Font.GothamBold)
                heading.Position = UDim2.fromOffset(12, 8)
                heading.Size = UDim2.new(1, -24, 0, 20)
                heading.TextXAlignment = Enum.TextXAlignment.Left
                local body = makeText(row, paragraphText or "", 12, Enum.Font.Gotham)
                body.Position = UDim2.fromOffset(12, 31)
                body.Size = UDim2.new(1, -24, 0, 38)
                body.AutomaticSize = Enum.AutomaticSize.Y
                body.TextXAlignment = Enum.TextXAlignment.Left
                body.TextYAlignment = Enum.TextYAlignment.Top
                bind(body, "TextColor3", "MutedText")
                return register({}, row, tostring(paragraphTitle) .. " " .. tostring(paragraphText))
            end

            function elements:NewKreditsCard(config)
                config = config or {}
                local username = tostring(config.Username or "lulaslollipop")
                local displayName = tostring(config.DisplayName or (LocalPlayer and LocalPlayer.DisplayName) or username)
                local userId = tonumber(config.UserId) or 3001347724
                local sessionStarted = tonumber(config.SessionStarted) or tonumber(env.LHSessionStart) or (active and active.SessionStarted) or tick()
                local row = newRow(section, "KreditsCard", 252)

                local ownerAnimationId = config.AnimationId
                    or env.LH_OWNER_KREDITS_ANIMATION_ID
                    or DEFAULT_OWNER_KREDITS_ANIMATION_ID
                local avatar, avatarFallback = createAnimatedAvatarViewport(row, {
                    Name = "OwnerKreditsAvatar",
                    ModelName = "OwnerKreditsAvatarModel",
                    UserId = userId,
                    AnimationId = ownerAnimationId,
                    Position = UDim2.new(0.5, -48, 0, 8),
                    Width = 96,
                    Height = 96,
                    Radius = 48,
                    FieldOfView = 31,
                    DistanceScale = 1.03,
                    AnimationSpeed = 0.82,
                })

                local welcome = makeText(row, "Welkome to Lollypop Hub, " .. displayName, 15, Enum.Font.GothamBold)
                welcome.Position = UDim2.fromOffset(12, 108)
                welcome.Size = UDim2.new(1, -24, 0, 24)
                welcome.TextXAlignment = Enum.TextXAlignment.Center

                local owner = makeText(row, "Owner: @" .. username, 12, Enum.Font.GothamMedium)
                owner.Position = UDim2.fromOffset(12, 132)
                owner.Size = UDim2.new(1, -24, 0, 18)
                owner.TextXAlignment = Enum.TextXAlignment.Center
                bind(owner, "TextColor3", "SchemeColor")

                local liveTime = makeText(row, "Live Time: " .. os.date("%I:%M:%S %p"), 12, Enum.Font.Gotham)
                liveTime.Position = UDim2.fromOffset(14, 154)
                liveTime.Size = UDim2.new(1, -28, 0, 18)
                liveTime.TextXAlignment = Enum.TextXAlignment.Left
                bind(liveTime, "TextColor3", "MutedText")

                local sessionTime = makeText(row, "Session Time: 00:00:00", 12, Enum.Font.Gotham)
                sessionTime.Position = UDim2.fromOffset(14, 174)
                sessionTime.Size = UDim2.new(1, -28, 0, 18)
                sessionTime.TextXAlignment = Enum.TextXAlignment.Left
                bind(sessionTime, "TextColor3", "SchemeColor")

                local today = makeText(row, "Today's Date: " .. os.date("%A, %B %d, %Y"), 12, Enum.Font.Gotham)
                today.Position = UDim2.fromOffset(14, 194)
                today.Size = UDim2.new(1, -28, 0, 18)
                today.TextXAlignment = Enum.TextXAlignment.Left
                bind(today, "TextColor3", "MutedText")

                local lastOnline = makeText(row, "Last Online: " .. tostring(config.LastOnline or "Today"), 12, Enum.Font.Gotham)
                lastOnline.Position = UDim2.fromOffset(14, 216)
                lastOnline.Size = UDim2.new(0.5, -14, 0, 18)
                lastOnline.TextXAlignment = Enum.TextXAlignment.Left
                bind(lastOnline, "TextColor3", "MutedText")

                local statusText = normalizeOnlineStatus(env.LH_ONLINE_STATUS or config.OnlineStatus or online_status)
                local statusIcon = statusText == "Offline" and utf8.char(0x1F534) or utf8.char(0x1F7E2)
                local status = makeText(row, "Online Status: " .. statusText .. " " .. statusIcon, 12, Enum.Font.Gotham)
                status.Position = UDim2.new(0.5, 0, 0, 216)
                status.Size = UDim2.new(0.5, -14, 0, 18)
                status.TextXAlignment = Enum.TextXAlignment.Right
                bind(status, "TextColor3", "StatusTextColor")

                task.spawn(function()
                    while row.Parent do
                        local elapsed = math.max(0, math.floor(tick() - sessionStarted))
                        local hours = math.floor(elapsed / 3600)
                        local minutes = math.floor((elapsed % 3600) / 60)
                        local seconds = elapsed % 60
                        liveTime.Text = "Live Time: " .. os.date("%I:%M:%S %p")
                        sessionTime.Text = string.format("Session Time: %02d:%02d:%02d", hours, minutes, seconds)
                        today.Text = "Today's Date: " .. os.date("%A, %B %d, %Y")
                        local refreshedStatus = normalizeOnlineStatus(env.LH_ONLINE_STATUS or config.OnlineStatus or online_status)
                        if refreshedStatus ~= statusText then
                            statusText = refreshedStatus
                            statusIcon = statusText == "Offline" and utf8.char(0x1F534) or utf8.char(0x1F7E2)
                            status.Text = "Online Status: " .. statusText .. " " .. statusIcon
                        end
                        task.wait(1)
                    end
                end)

                local api = register({}, row, username .. " " .. displayName .. " session time")
                api.Rows = {
                    Username = owner,
                    Welcome = welcome,
                    LastOnline = lastOnline,
                    OnlineStatus = status,
                    LiveTime = liveTime,
                    SessionTime = sessionTime,
                    Today = today,
                    Status = status,
                }
                api.Avatar = avatar
                api.AvatarFallback = avatarFallback
                function api:UpdateRow(key, newValue)
                    if self.Rows[key] then self.Rows[key].Text = tostring(newValue) end
                end
                return api
            end

            sectionControlRegistry[section] = controls
            table.insert(tab.Sections, section)
            return elements
        end

        function tab:NewSearchBar(config)
            config = config or {}
            local holder = newRow(scroll, "KavoSearch", 40)
            holder.LayoutOrder = -100000
            local box = Instance.new("TextBox")
            box.Position = UDim2.fromOffset(8, 5)
            box.Size = UDim2.new(1, -44, 0, 30)
            box.BackgroundTransparency = 1
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            box.Font = resolveUIFont(Enum.Font.Gotham)
            box.TextSize = 13
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.PlaceholderText = tostring(config.Placeholder or "Search...")
            box.Text = ""
            box.Parent = holder
            bind(box, "TextColor3", "TextColor")
            local clear = makeKolorButton(holder, "X", rgb(220, 48, 65))
            clear.Position = UDim2.new(1, -34, 0, 6)
            clear.Size = UDim2.fromOffset(28, 28)
            clear.BackgroundTransparency = 0.08
            local searching = false
            local savedSectionVisibility = setmetatable({}, {__mode = "k"})
            local savedControlVisibility = setmetatable({}, {__mode = "k"})
            local function apply(query)
                query = string.lower(tostring(query or "")):gsub("^%s+", ""):gsub("%s+$", "")

                if query == "" and not searching then
                    for _, sectionFrame in ipairs(tab.Sections) do
                        for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                            if api.SetSearchHighlighted then api:SetSearchHighlighted(false) end
                        end
                    end
                    return
                end

                if query ~= "" and not searching then
                    searching = true
                    for _, sectionFrame in ipairs(tab.Sections) do
                        savedSectionVisibility[sectionFrame] = sectionFrame.Visible
                        for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                            savedControlVisibility[api] = api.Frame.Visible
                        end
                    end
                elseif query == "" and searching then
                    searching = false
                    for _, sectionFrame in ipairs(tab.Sections) do
                        sectionFrame.Visible = savedSectionVisibility[sectionFrame] ~= false
                        for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                            api.Frame.Visible = savedControlVisibility[api] ~= false
                            if api.SetSearchHighlighted then api:SetSearchHighlighted(false) end
                        end
                    end
                    table.clear(savedSectionVisibility)
                    table.clear(savedControlVisibility)
                    return
                end

                for _, sectionFrame in ipairs(tab.Sections) do
                    local any = query == ""
                    for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                        local originallyVisible = savedControlVisibility[api] ~= false
                        local matched = query == "" or (originallyVisible and string.find(api.SearchText or "", query, 1, true) ~= nil)
                        api.Frame.Visible = matched
                        if api.SetSearchHighlighted then api:SetSearchHighlighted(query ~= "" and matched) end
                        if matched then any = true end
                    end
                    sectionFrame.Visible = any
                end
            end
            track(box:GetPropertyChangedSignal("Text"):Connect(function() apply(box.Text) end))
            track(clear.MouseButton1Click:Connect(function() box.Text = ""; apply("") end))
            local searchApi = {Frame = holder, TextBox = box, ClearButton = clear, Apply = apply}
            tab.SearchBar = searchApi
            return searchApi
        end

        table.insert(active.Tabs, tab)
        track(tabButton.MouseButton1Click:Connect(function() selectTab(tab) end))
        if not active.SelectedTab then
            active.SelectedTab = tab
            tab.Page.Visible = true
            tab.Button.BackgroundTransparency = 0.04
        end
        return tab
    end

    function window:SelectTab(name)
        local needle = string.lower(tostring(name or ""))
        for _, tab in ipairs(active.Tabs) do
            if string.lower(tab.Name) == needle or string.find(string.lower(tab.Name), needle, 1, true) then
                selectTab(tab)
                return true
            end
        end
        return false
    end

    function window:Back() return goBack() end
    function window:Forward() return goForward() end
    function window:Undo() return LULA:Undo() end
    function window:OpenUndoHistory() return LULA:OpenUndoHistory() end



    function window:EnableNotificationCenter(tabName)
        if active.NotificationCenter then return active.NotificationCenter.Tab end

        local notificationTab = self:NewTab(tabName or "Notifications")
        notificationTab:EnsureBuilt()
        local scroll = notificationTab.Scroll
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.CanvasSize = UDim2.new()

        local clearAll = makeKolorButton(scroll, "Klear All Notifikations", rgb(164, 42, 58))
        clearAll.Name = "ClearAllNotifications"
        clearAll.LayoutOrder = -10000
        clearAll.Size = UDim2.new(1, -4, 0, 36)
        clearAll.TextSize = 12
        clearAll.TextColor3 = rgb(248, 248, 252)

        local itemCount = makeText(scroll, "0 items", 12, Enum.Font.GothamBold)
        itemCount.Name = "NotificationItemCount"
        itemCount.LayoutOrder = -9990
        itemCount.Size = UDim2.new(1, -4, 0, 28)
        itemCount.TextXAlignment = Enum.TextXAlignment.Left
        bind(itemCount, "TextColor3", "MutedText")

        local holder = Instance.new("Frame")
        holder.Name = "NotificationHistoryStack"
        holder.LayoutOrder = -9980
        holder.Size = UDim2.new(1, -4, 0, 0)
        holder.AutomaticSize = Enum.AutomaticSize.Y
        holder.BackgroundTransparency = 1
        holder.Parent = scroll
        local holderLayout = Instance.new("UIListLayout")
        holderLayout.Padding = UDim.new(0, 6)
        holderLayout.SortOrder = Enum.SortOrder.LayoutOrder
        holderLayout.Parent = holder

        local state = {Tab = notificationTab, Holder = holder, LastSignature = nil}
        active.NotificationCenter = state

        local function historySignature()
            local parts = {tostring(#notificationHistory)}
            for index, item in ipairs(notificationHistory) do
                parts[#parts + 1] = table.concat({
                    tostring(index), tostring(item.Time or ""), tostring(item.Kind or ""),
                    tostring(item.Title or ""), tostring(item.Text or ""), tostring(item.Action or "")
                }, "|")
            end
            return table.concat(parts, "\n")
        end

        local function clearRows()
            for _, child in ipairs(holder:GetChildren()) do
                if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then child:Destroy() end
            end
        end

        local function refresh(force)
            local signature = historySignature()
            if not force and signature == state.LastSignature then return end
            state.LastSignature = signature
            clearRows()

            local count = #notificationHistory
            itemCount.Text = tostring(count) .. (count == 1 and " item" or " items")
            if count == 0 then
                local empty = newRow(holder, "NotificationHistoryEmpty", 48)
                empty.LayoutOrder = 1
                local emptyText = makeText(empty, "No notifikations yet.", 12, Enum.Font.GothamMedium)
                emptyText.Position = UDim2.fromOffset(10, 0)
                emptyText.Size = UDim2.new(1, -20, 1, 0)
                emptyText.TextXAlignment = Enum.TextXAlignment.Center
                bind(emptyText, "TextColor3", "MutedText")
                return
            end

            for index, item in ipairs(notificationHistory) do
                local bodyText = tostring(item.Text or "")
                local bodyBounds = TextService:GetTextSize(
                    bodyText ~= "" and bodyText or " ",
                    11.5,
                    resolveUIFont(Enum.Font.Gotham),
                    Vector2.new(math.max(220, scroll.AbsoluteSize.X - 52), 1000)
                )
                local rowHeight = math.clamp(58 + math.ceil(bodyBounds.Y), 72, 150)
                local row = newRow(holder, "NotificationHistoryItem_" .. tostring(index), rowHeight)
                row.LayoutOrder = index
                row.BackgroundTransparency = 0.03

                local stripe = Instance.new("Frame")
                stripe.Position = UDim2.fromOffset(5, 7)
                stripe.Size = UDim2.new(0, 4, 1, -14)
                stripe.BorderSizePixel = 0
                stripe.BackgroundColor3 = kindColors[string.lower(tostring(item.Kind or "info"))] or kindColors.info
                stripe.Parent = row
                makeCorner(stripe, 2)

                local title = makeText(row, tostring(item.Title or "Lollypop Hub"), 12.5, Enum.Font.GothamBold)
                title.Position = UDim2.fromOffset(16, 7)
                title.Size = UDim2.new(1, -28, 0, 20)
                title.TextXAlignment = Enum.TextXAlignment.Left

                local body = makeText(row, bodyText, 11.5, Enum.Font.Gotham)
                body.Position = UDim2.fromOffset(16, 29)
                body.Size = UDim2.new(1, -28, 0, math.max(20, math.ceil(bodyBounds.Y) + 4))
                body.TextXAlignment = Enum.TextXAlignment.Left
                body.TextYAlignment = Enum.TextYAlignment.Top
                body.TextWrapped = true
                bind(body, "TextColor3", "MutedText")

                local timeText = ""
                if tonumber(item.Time) then
                    timeText = os.date("%I:%M:%S %p", tonumber(item.Time))
                end
                local meta = makeText(row, string.upper(tostring(item.Kind or "info")) .. (timeText ~= "" and ("  |  " .. timeText) or ""), 9.5, Enum.Font.GothamMedium)
                meta.AnchorPoint = Vector2.new(0, 1)
                meta.Position = UDim2.new(0, 16, 1, -5)
                meta.Size = UDim2.new(1, -28, 0, 16)
                meta.TextXAlignment = Enum.TextXAlignment.Left
                meta.TextColor3 = stripe.BackgroundColor3
            end
        end

        track(clearAll.Activated:Connect(function()
            table.clear(notificationHistory)
            refresh(true)
        end))

        state.Refresh = refresh
        refresh(true)
        task.spawn(function()
            while active and active.NotificationCenter == state and notificationTab.Page.Parent do
                refresh(false)
                task.wait(0.5)
            end
        end)
        return notificationTab
    end

    function window:EnableAnimationBundles(tabName)
        if active.AnimationBundles then return active.AnimationBundles.Tab end

        local MarketplaceService = get.MarketplaceService
        local AvatarEditorService = get.AvatarEditorService
        local AssetService = get.AssetService
        local InsertService = get.InsertService

        local bundleTab = self:NewTab(tabName or (utf8.char(0x2605) .. " Free Animations"))
        bundleTab:EnsureBuilt()
        local scroll = bundleTab.Scroll
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.CanvasSize = UDim2.new()

        local STAR_EMPTY = utf8.char(0x2606)
        local STAR_FILLED = utf8.char(0x2605)
        local STAR_EMOJI = utf8.char(0x2B50, 0xFE0F)
        local SEARCH_ICON = utf8.char(0x1F50D)
        local YELLOW = rgb(255, 213, 54)
        local ANIMATION_DARK = rgb(18, 18, 24)
        local ANIMATION_GREEN = blendColor(TOGGLE_ON_COLOR, ANIMATION_DARK, 0.42)
        local ANIMATION_RED = blendColor(TOGGLE_OFF_COLOR, ANIMATION_DARK, 0.42)
        local function animationAccent(color)
            return blendColor(color, ANIMATION_DARK, 0.48)
        end
        local function animationText(button)
            if button then button.TextColor3 = rgb(248, 248, 252) end
            return button
        end

        local function trim(value)
            return tostring(value or ""):match("^%s*(.-)%s*$") or ""
        end

        local function lower(value)
            return string.lower(tostring(value or ""))
        end

        local function normalizeWords(value)
            local text = lower(value)
            text = text:gsub("_", " ")
            text = text:gsub("[^%w%s]", " ")
            text = text:gsub("%s+", " ")
            return trim(text)
        end

        local function tokenize(value)
            local output = {}
            for token in normalizeWords(value):gmatch("%S+") do
                table.insert(output, token)
            end
            return output
        end

        local function containsPlain(haystack, needle)
            return string.find(lower(haystack), lower(needle), 1, true) ~= nil
        end

        local function bundleNotify(message, kind, durationValue)
            kind = tostring(kind or "info")
            local title = "Free Animations"
            if kind == "error" then
                LULA:Notify("error", title, tostring(message), durationValue or 3.5, nil, true)
            elseif kind == "warning" then
                LULA:Notify("warning", title, tostring(message), durationValue or 3.2, nil, true)
            else
                LULA:ShowIsland(title, tostring(message), {Duration = durationValue or 2.7})
            end
        end

        local notify = bundleNotify

        local function getRequestFunction()
            local candidates = {
                rawget(env, "request"),
                rawget(env, "http_request"),
                rawget(env, "httprequest"),
            }
            local synTable = rawget(env, "syn")
            if type(synTable) == "table" then table.insert(candidates, synTable.request) end
            local fluxusTable = rawget(env, "fluxus")
            if type(fluxusTable) == "table" then table.insert(candidates, fluxusTable.request) end
            for _, candidate in ipairs(candidates) do
                if typeof(candidate) == "function" then return candidate end
            end
            return nil
        end

        local executorRequest = getRequestFunction()
        local function httpGet(url)
            url = tostring(url or "")
            local failures = {}

            -- Executor request is tried first because it exposes the real status code.
            if executorRequest then
                local requestOk, response = pcall(executorRequest, {
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["Accept"] = "application/json",
                        ["User-Agent"] = "Roblox/LollypopHub-AnimationBundles-V4",
                    },
                })
                if requestOk and type(response) == "table" then
                    local status = tonumber(response.StatusCode or response.Status or response.status_code or 0) or 0
                    local responseBody = response.Body or response.body
                    if status >= 200 and status < 300 and type(responseBody) == "string" and #responseBody > 0 then
                        return responseBody
                    end
                    table.insert(failures, "request HTTP " .. tostring(status > 0 and status or "unknown"))
                elseif not requestOk then
                    table.insert(failures, "request error: " .. tostring(response))
                end
            end

            local ok, body = pcall(function() return game:HttpGet(url, true) end)
            if ok and type(body) == "string" and #body > 0 then return body end
            if not ok then table.insert(failures, "game:HttpGet error: " .. tostring(body)) end

            error("HTTP GET failed for " .. url .. (#failures > 0 and (" (" .. table.concat(failures, "; ") .. ")") or ""))
        end

        local function copyText(text)
            text = tostring(text or "")
            local compat = rawget(env, "LHCompat")
            if type(compat) == "table" and type(compat.SetClipboard) == "function" then
                local ok, result = pcall(compat.SetClipboard, text)
                if ok and result ~= false then return true end
            end

            local candidates = {
                rawget(env, "setclipboard"),
                rawget(env, "toclipboard"),
                rawget(env, "writeclipboard"),
            }
            local synTable = rawget(env, "syn")
            if type(synTable) == "table" then
                table.insert(candidates, synTable.write_clipboard)
                table.insert(candidates, synTable.setclipboard)
            end
            local clipboardTable = rawget(env, "Clipboard")
            if type(clipboardTable) == "table" then table.insert(candidates, clipboardTable.set) end

            for _, writer in ipairs(candidates) do
                if typeof(writer) == "function" then
                    local ok = pcall(writer, text)
                    if ok then return true end
                end
            end
            return false
        end

