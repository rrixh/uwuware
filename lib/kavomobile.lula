        local function updateGrid()
            local width = UI.MarketHolder.AbsoluteSize.X
            if width <= 0 then return end
            local columns = width >= 510 and 3 or (width >= 320 and 2 or 1)
            local gap = 6
            local usable = width - gap * (columns - 1)
            local cellWidth = math.max(132, math.floor(usable / columns))
            UI.MarketGrid.FillDirectionMaxCells = columns
            UI.MarketGrid.CellPadding = UDim2.fromOffset(gap, gap)
            UI.MarketGrid.CellSize = UDim2.fromOffset(cellWidth, 252)
        end
        track(UI.MarketHolder:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateGrid))
        task.defer(updateGrid)

