            UI.DetailsSpeedLabel.Position = UDim2.fromOffset(8, 0)
            UI.DetailsSpeedLabel.Size = UDim2.new(0.45, -8, 1, 0)
            UI.DetailsSpeedLabel.TextXAlignment = Enum.TextXAlignment.Left
            UI.DetailsSpeedHolder = Instance.new("Frame")
            UI.DetailsSpeedHolder.Position = UDim2.new(0.45, 0, 0.5, -12)
