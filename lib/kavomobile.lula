            UI.DetailsActions.ZIndex = 9004
            UI.DetailsActions.Parent = UI.DetailsScroll
            UI.DetailsActionGrid = Instance.new("UIGridLayout")
            UI.DetailsActionGrid.CellSize = UDim2.new(0.5, -4, 0, 34)
            UI.DetailsActionGrid.CellPadding = UDim2.fromOffset(7, 7)
            UI.DetailsActionGrid.FillDirectionMaxCells = 2
            UI.DetailsActionGrid.SortOrder = Enum.SortOrder.LayoutOrder
            UI.DetailsActionGrid.Parent = UI.DetailsActions

            UI.DetailsPlay = makeButton(UI.DetailsActions, "Play Emote")
            UI.DetailsPlay.LayoutOrder = 1
            UI.DetailsStop = makeButton(UI.DetailsActions, "Stop Emote")
            UI.DetailsStop.LayoutOrder = 2
            UI.DetailsCopy = makeButton(UI.DetailsActions, "Kopy Animation ID")
            UI.DetailsCopy.LayoutOrder = 3
            UI.DetailsFavorite = makeButton(UI.DetailsActions, "Add Favorite")
            UI.DetailsFavorite.LayoutOrder = 4
        end
        createDetailsOverlay()

        local function raiseDetailsZ()
            if not UI.DetailsPanel then return end
            for _, descendant in ipairs(UI.DetailsPanel:GetDescendants()) do
                if descendant:IsA("GuiObject") then
                    descendant.ZIndex = math.max(descendant.ZIndex, 9004)
                end
            end
            UI.DetailsShade.ZIndex = 9001
            UI.DetailsPanel.ZIndex = 9002
            UI.DetailsScroll.ZIndex = 9003
        end
        raiseDetailsZ()

        local function closeDetails()
            UI.DetailsShade.Active = false
            UI.DetailsOverlay.Visible = false
            state.DetailItem = nil
            if state.DetailPreview then state.DetailPreview:Destroy() end
            state.DetailPreview = nil
            clearHolder(UI.DetailsSpeedHolder)
        end

        local function openDetails(item)
            if type(item) ~= "table" then return end
            closeDetails()
            state.DetailItem = item
            UI.DetailsOverlay.Visible = true
            UI.DetailsShade.Active = false
            UI.DetailsTitle.Text = tostring(item.Name)
            UI.DetailsCreator.Text = "By " .. tostring(item.CreatorName or "Unknown creator")
            UI.DetailsMeta.Text = "Marketplace ID: " .. tostring(item.Id) .. " | Resolving animation ID..."
            UI.DetailsDescription.Text = trim(item.Description) ~= "" and item.Description or "No description was provided."
            UI.DetailsFavorite.Text = favoriteIndex(item.Id) and "Remove Favorite" or "Add Favorite"
            state.DetailPreview = createAvatarPreview(UI.DetailsPreview, item, false)
            makeSpeedControl(UI.DetailsSpeedHolder, item.Id, false)
            raiseDetailsZ()

            task.delay(0.22, function()
                if UI.DetailsOverlay.Visible and state.DetailItem == item then
                    UI.DetailsShade.Active = true
                end
            end)

            task.spawn(function()
                local ok, details = pcall(fetchDetails, item)
                if not ok or not UI.DetailsOverlay.Visible or state.DetailItem ~= item then return end
                UI.DetailsTitle.Text = tostring(details.Name)
                UI.DetailsCreator.Text = "By " .. tostring(details.CreatorName or "Unknown creator")
                UI.DetailsMeta.Text = "Marketplace ID: " .. tostring(details.Id)
                    .. " | Animation ID: " .. tostring(details.PlayableAnimationId)
                    .. " | " .. tostring(details.PlayableSource or "Roblox")
                if details.Price then
                    UI.DetailsMeta.Text = UI.DetailsMeta.Text .. " | " .. tostring(details.Price) .. " Robux"
                end
                UI.DetailsDescription.Text = trim(details.Description) ~= "" and details.Description or "No description was provided."
            end)
        end

        track(UI.DetailsShade.Activated:Connect(function()
            if UI.DetailsShade.Active then closeDetails() end
        end))
        track(UI.DetailsClose.Activated:Connect(closeDetails))
        track(UI.DetailsPlay.Activated:Connect(function()
            if state.DetailItem then playEmote(state.DetailItem) end
        end))
        track(UI.DetailsStop.Activated:Connect(function() stopActiveEmote(false) end))
        track(UI.DetailsCopy.Activated:Connect(function()
            if not state.DetailItem then return end
            local ok, playableId = pcall(resolvePlayableAnimationId, state.DetailItem)
            if not ok then
                emoteNotify("Could not resolve this emote's animation ID.", "error", 3)
                return
            end
            if copyText(playableId) then
                emoteNotify("Animation ID kopied: " .. tostring(playableId), "success", 2.5)
            else
                emoteNotify("Clipboard is not supported by this executor.", "error", 3)
            end
        end))
        track(UI.DetailsFavorite.Activated:Connect(function()
            if not state.DetailItem then return end
            toggleFavorite(state.DetailItem)
            UI.DetailsFavorite.Text = favoriteIndex(state.DetailItem.Id) and "Remove Favorite" or "Add Favorite"
        end))

        local function makeMarketplaceCard(item, order)
            local card = newRow(UI.MarketHolder, "FreeEmote_" .. tostring(item.Id), 252)
            card.LayoutOrder = order
            card.Size = UDim2.new()
            card.ClipsDescendants = true
            makeStroke(card, active.Theme.SchemeColor, 0.25, 1)

            local preview = Instance.new("Frame")
            preview.Position = UDim2.fromOffset(7, 7)
            preview.Size = UDim2.new(1, -14, 0, 100)
            preview.BackgroundTransparency = 1
            preview.Parent = card
            createAvatarPreview(preview, item, false)

            local star = makeStarButton(card, item)
            star.Button.AnchorPoint = Vector2.new(1, 0)
            star.Button.Position = UDim2.new(1, -9, 0, 9)

            local name = makeText(card, tostring(item.Name), 11.5, Enum.Font.GothamBold)
            name.Position = UDim2.fromOffset(7, 111)
            name.Size = UDim2.new(1, -14, 0, 31)
            name.TextWrapped = true
            name.TextXAlignment = Enum.TextXAlignment.Center

            local creator = makeText(card, "By " .. tostring(item.CreatorName or "Unknown creator"), 9.5, Enum.Font.GothamMedium)
            creator.Position = UDim2.fromOffset(7, 142)
            creator.Size = UDim2.new(1, -14, 0, 15)
            creator.TextXAlignment = Enum.TextXAlignment.Center
            creator.TextTruncate = Enum.TextTruncate.AtEnd
            bind(creator, "TextColor3", "MutedText")

            local info = makeButton(card, "View Info")
            info.Position = UDim2.fromOffset(7, 160)
            info.Size = UDim2.new(1, -14, 0, 25)
            info.TextSize = 10
            info.BackgroundTransparency = 0.08
            track(info.Activated:Connect(function()
                task.defer(function() openDetails(item) end)
            end))

            local speedLabel = makeText(card, "Speed", 9.5, Enum.Font.GothamBold)
            speedLabel.Position = UDim2.fromOffset(7, 188)
            speedLabel.Size = UDim2.new(0, 42, 0, 20)
            speedLabel.TextXAlignment = Enum.TextXAlignment.Left

            local speedHolder = Instance.new("Frame")
            speedHolder.Position = UDim2.fromOffset(48, 187)
            speedHolder.Size = UDim2.new(1, -55, 0, 22)
            speedHolder.BackgroundTransparency = 1
            speedHolder.Parent = card
            makeSpeedControl(speedHolder, item.Id, true)

            local toggleHolder = Instance.new("Frame")
            toggleHolder.AnchorPoint = Vector2.new(0.5, 0)
            toggleHolder.Position = UDim2.new(0.5, 0, 0, 218)
            toggleHolder.Size = UDim2.fromOffset(50, 22)
            toggleHolder.BackgroundTransparency = 1
            toggleHolder.Parent = card
            makeToggleSwitch(toggleHolder, item.Id, function(api) playEmote(item, api) end, false)
            return card
        end

        local function makeFavoriteRow(item, order)
            local row = newRow(UI.FavoritesHolder, "FreeEmoteFavorite_" .. tostring(item.Id), 94)
