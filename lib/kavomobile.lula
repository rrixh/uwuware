        local function canonicalReferenceName(value)
            local text = tostring(value or ""):lower()
            text = text:gsub("[\"']", " ")
            text = text:gsub("[^%w%s]", " ")
            text = text:gsub("%s+", " ")
            text = text:match("^%s*(.-)%s*$") or ""

            local suffixes = {
                " animation package",
                " animation bundle",
                " animation pack",
                " animations",
                " animation"
            }

            for _, suffix in ipairs(suffixes) do
                if text:sub(-#suffix) == suffix then
                    text = text:sub(1, #text - #suffix)
                    text = text:match("^%s*(.-)%s*$") or text
                    break
                end
            end

            return text
        end

        local function getKnownReference(bundleName)
            local key = canonicalReferenceName(bundleName)
            return key, KNOWN_REFERENCE_PACKS[key]
        end

        local function normalizeCatalogItem(raw)
            if type(raw) ~= "table" then
                return nil
            end

            local id = tonumber(raw.Id or raw.id or raw.AssetId or raw.assetId or raw.BundleId or raw.bundleId)
            local name = raw.Name or raw.name
            if not id or type(name) ~= "string" then
                return nil
            end

            local itemType = raw.ItemType or raw.itemType or raw.Type or raw.type
            local bundleType = raw.BundleType or raw.bundleType

            if typeof(itemType) == "EnumItem" then
                itemType = itemType.Name
            end
            if typeof(bundleType) == "EnumItem" then
                bundleType = bundleType.Name
            end

            local creator = raw.Creator or raw.creator
            local creatorName = raw.CreatorName or raw.creatorName
            local creatorId = raw.CreatorId or raw.creatorId or raw.CreatorTargetId or raw.creatorTargetId
            local creatorType = raw.CreatorType or raw.creatorType

            if type(creator) == "table" then
                creatorName = creatorName or creator.Name or creator.name
                creatorId = creatorId or creator.Id or creator.id
                creatorType = creatorType or creator.Type or creator.type
            end

            local isBundle = false
            if itemType then
                if type(itemType) == "number" then
                    -- AvatarItemType.Bundle is commonly represented as 2 in web data.
                    isBundle = itemType == 2
                else
                    isBundle = containsPlain(tostring(itemType), "bundle")
                end
            end
            if bundleType ~= nil then
                isBundle = true
            end

            local isAnimationBundle = true
            if bundleType ~= nil then
                if type(bundleType) == "number" then
                    -- BundleType.Animations = 2.
                    isAnimationBundle = bundleType == 2
                else
                    local bundleText = lower(bundleType)
                    isAnimationBundle = bundleText:find("animation", 1, true) ~= nil
                end
            end

            if not isBundle or not isAnimationBundle then
                return nil
            end

            local price = raw.Price or raw.price
            if price == nil and type(raw.Product) == "table" then
                price = raw.Product.PriceInRobux or raw.Product.priceInRobux
            end

            return {
                Id = id,
                Name = name,
                Description = raw.Description or raw.description or "",
                CreatorName = creatorName or "Unknown creator",
                CreatorId = tonumber(creatorId),
                CreatorType = creatorType,
                BundleType = bundleType or "Animations",
                Price = tonumber(price),
                Raw = raw
            }
        end

        local function normalizeCatalogPage(page)
            local output = {}
            local seen = {}

            for _, raw in ipairs(page or {}) do
                local item = normalizeCatalogItem(raw)
                if item and not seen[item.Id] then
                    seen[item.Id] = true
                    table.insert(output, item)
                end
            end

            return output
        end

        local SearchService = {
            FuzzyItems = {},
            FuzzyIndexReady = false,
            FuzzyIndexBuilding = false,
            FuzzyQuickReady = false,
            BackendName = nil
        }

        local function createEngineSearch(query)
            local params = CatalogSearchParams.new()
            params.SearchKeyword = query or ""
            params.BundleTypes = {Enum.BundleType.Animations}
            params.IncludeOffSale = true
            params.Limit = 30

            pcall(function()
                params.SortType = Enum.CatalogSortType.Relevance
            end)
            pcall(function()
                params.SortAggregation = Enum.CatalogSortAggregation.AllTime
            end)
            pcall(function()
                local category = Enum.CatalogCategoryFilter.AvatarAnimations
                if category then
                    params.CategoryFilter = category
                end
            end)

            local pages = AvatarEditorService:SearchCatalogAsync(params)
            local firstPage = normalizeCatalogPage(pages:GetCurrentPage())

            local function hasMorePages()
                local ok, finished = pcall(function()
                    return pages.IsFinished
                end)
                return ok and not finished
            end

            local function nextPage()
                if not hasMorePages() then
                    return {}, false
                end

                pages:AdvanceToNextPageAsync()
                return normalizeCatalogPage(pages:GetCurrentPage()), hasMorePages()
            end

            return firstPage, nextPage, hasMorePages()
        end

        local function buildCatalogUrl(query, cursor)
            local parts = {
                "Category=12",
                "Subcategory=38",
                "Limit=30",
                "SortType=0",
                "SortAggregation=5"
            }

            if trim(query) ~= "" then
                table.insert(parts, "Keyword=" .. HttpService:UrlEncode(trim(query)))
            end

            if cursor and cursor ~= "" then
                table.insert(parts, "Cursor=" .. HttpService:UrlEncode(cursor))
            end

            return "https://catalog.roblox.com/v1/search/items/details?" .. table.concat(parts, "&")
        end

        local function createHttpSearch(query)
            local currentCursor = nil

            local function requestPage(cursor)
                local body = httpGet(buildCatalogUrl(query, cursor))
                local decoded = HttpService:JSONDecode(body)
                local data = normalizeCatalogPage(decoded.data or decoded.Data or {})
                local nextCursor = decoded.nextPageCursor or decoded.NextPageCursor
                return data, nextCursor
            end

            local firstPage, nextCursor = requestPage(nil)
            currentCursor = nextCursor

            local function nextPage()
                if not currentCursor then
                    return {}, false
                end
                local page, newCursor = requestPage(currentCursor)
                currentCursor = newCursor
                return page, currentCursor ~= nil
            end

            return firstPage, nextPage, currentCursor ~= nil
        end

        function SearchService:SearchOne(query)
            local engineOk, engineResults, engineNext, engineHasMore = pcall(createEngineSearch, query)

            -- A successful engine call can still return an unusable empty page in an
            -- experience that restricts avatar catalog reads. In that case, try HTTP.
            if engineOk and type(engineResults) == "table" and #engineResults > 0 then
                self.BackendName = "AvatarEditorService"
                return engineResults, engineNext, engineHasMore
            end

            local httpOk, httpResults, httpNext, httpHasMore = pcall(createHttpSearch, query)
            if httpOk and type(httpResults) == "table" then
                self.BackendName = "Catalog HTTP"
                return httpResults, httpNext, httpHasMore
            end

            if engineOk and type(engineResults) == "table" then
                self.BackendName = "AvatarEditorService"
                return engineResults, engineNext, engineHasMore
            end

            error(
                "Roblox catalog search failed through both backends. Engine error: "
                .. tostring(engineResults)
                .. " | HTTP error: "
                .. tostring(httpResults)
            )
        end

        local GENERIC_SEARCH_WORDS = {
            animation = true,
            animations = true,
            bundle = true,
            bundles = true,
            pack = true,
            packs = true,
            full = true,
            set = true,
            the = true,
            a = true,
            an = true,
            by = true
        }

        local function meaningfulTokens(query)
            local output = {}
            local seen = {}
            for _, token in ipairs(tokenize(query)) do
                if not GENERIC_SEARCH_WORDS[token] and #token >= 2 and not seen[token] then
                    seen[token] = true
                    table.insert(output, token)
                end
            end
            return output
        end

        local function levenshtein(a, b)
            a = tostring(a or "")
            b = tostring(b or "")

            local lenA = #a
            local lenB = #b
            if lenA == 0 then
                return lenB
            end
            if lenB == 0 then
                return lenA
            end

            local previous = {}
            local current = {}
            for j = 0, lenB do
                previous[j] = j
            end

            for i = 1, lenA do
                current[0] = i
                local charA = a:sub(i, i)
                for j = 1, lenB do
                    local cost = charA == b:sub(j, j) and 0 or 1
                    current[j] = math.min(
                        current[j - 1] + 1,
                        previous[j] + 1,
                        previous[j - 1] + cost
                    )
                end
                previous, current = current, previous
            end

            return previous[lenB]
        end

        local function allowedTypoDistance(token)
            local length = #token
            if length <= 4 then
                return 1
            elseif length <= 7 then
                return 2
            end
            return 3
        end

        local function resultScore(itemName, query)
            local name = normalizeWords(itemName)
            local normalizedQuery = normalizeWords(query)
            if normalizedQuery == "" then
                return 0
            end

            local score = 0
            if name == normalizedQuery then
                score = score + 300
            elseif name:find(normalizedQuery, 1, true) then
                score = score + 180
            end

            local nameTokens = tokenize(name)
            local queryTokens = tokenize(normalizedQuery)
            local matched = 0

            for _, queryToken in ipairs(queryTokens) do
                local best = 0
                for _, nameToken in ipairs(nameTokens) do
                    if nameToken == queryToken then
                        best = math.max(best, 30)
                    elseif nameToken:sub(1, #queryToken) == queryToken then
                        best = math.max(best, 22)
                    elseif queryToken:sub(1, #nameToken) == nameToken then
                        best = math.max(best, 15)
                    else
                        local distance = levenshtein(queryToken, nameToken)
                        if distance <= allowedTypoDistance(queryToken) then
                            best = math.max(best, 10 - distance)
                        end
                    end
                end

                if best > 0 then
                    matched = matched + 1
                    score = score + best
                end
            end

            if matched == #queryTokens and #queryTokens > 0 then
                score = score + 60
            end

            return score
        end

        local function sortResults(results, query)
            if normalizeWords(query) == "" then return end
            table.sort(results, function(a, b)
                local scoreA = resultScore(a.Name, query)
                local scoreB = resultScore(b.Name, query)
                if scoreA == scoreB then
                    return lower(a.Name) < lower(b.Name)
                end
                return scoreA > scoreB
            end)
        end

        local function mergeResults(target, source, seen)
            for _, item in ipairs(source or {}) do
                if not seen[item.Id] then
                    seen[item.Id] = true
                    table.insert(target, item)
                end
            end
        end

        function SearchService:SearchMerged(query, exactOnly)
            local normalizedQuery = normalizeWords(query)
            local tokens = meaningfulTokens(query)
            local primaryQuery = query

            if #tokens > 0 then
                local strippedQuery = table.concat(tokens, " ")
                if strippedQuery ~= "" and strippedQuery ~= normalizedQuery then
                    primaryQuery = strippedQuery
                end
            end

            local results, primaryNext, hasMore = self:SearchOne(primaryQuery)
            local merged = {}
            local seen = {}
            mergeResults(merged, results, seen)

            if not exactOnly and #merged < 20 then
                for index = 1, math.min(#tokens, 3) do
                    local token = tokens[index]
                    if token ~= normalizeWords(primaryQuery) then
                        local ok, tokenResults = pcall(function()
                            local page = self:SearchOne(token)
                            return page
                        end)
                        if ok then
                            mergeResults(merged, tokenResults, seen)
                        end
                    end
                end
            end

            sortResults(merged, query)
            return merged, primaryNext, hasMore
        end

        function SearchService:BuildFuzzyIndex(waitForQuickBatch)
            if self.FuzzyIndexReady then
                return self.FuzzyItems
            end

            if not self.FuzzyIndexBuilding then
                self.FuzzyIndexBuilding = true

                task.spawn(function()
                    local collected = {}
                    local seen = {}
                    local ok, firstPage, nextPage, hasMore = pcall(function()
                        return self:SearchOne("")
                    end)

                    if not ok then
                        self.FuzzyIndexBuilding = false
                        self.FuzzyIndexReady = true
                        self.FuzzyItems = {}
                        return
                    end

                    mergeResults(collected, firstPage, seen)
                    self.FuzzyItems = collected

                    local pagesLoaded = 1
                    if #collected >= 30 then
                        self.FuzzyQuickReady = true
                    end

                    while hasMore and pagesLoaded < 15 do
                        local pageOk, page, more = pcall(nextPage)
                        if not pageOk then
                            break
                        end

                        mergeResults(collected, page, seen)
                        self.FuzzyItems = collected
                        hasMore = more
                        pagesLoaded = pagesLoaded + 1

                        if pagesLoaded >= 4 or #collected >= 100 then
                            self.FuzzyQuickReady = true
                        end

                        task.wait(0.02)
                    end

                    self.FuzzyItems = collected
                    self.FuzzyIndexBuilding = false
                    self.FuzzyIndexReady = true
                    self.FuzzyQuickReady = true
                end)
            end

            if waitForQuickBatch then
                local deadline = os.clock() + 1.35
                while self.FuzzyIndexBuilding
                    and not self.FuzzyQuickReady
                    and os.clock() < deadline do
                    task.wait(0.05)
                end
            end

            return self.FuzzyItems
        end

        local function findCorrectedQuery(query, candidates)
            local originalTokens = tokenize(query)
            if #originalTokens == 0 then
                return nil
            end

            local vocabulary = {}
            local vocabularySeen = {}

            for _, item in ipairs(candidates or {}) do
                for _, token in ipairs(tokenize(item.Name)) do
                    if #token >= 2 and not vocabularySeen[token] then
                        vocabularySeen[token] = true
                        table.insert(vocabulary, token)
                    end
                end
            end

            if #vocabulary == 0 then
                return nil
            end

            local changed = false
            local corrected = {}

            for _, token in ipairs(originalTokens) do
                if GENERIC_SEARCH_WORDS[token] or vocabularySeen[token] then
                    table.insert(corrected, token)
                else
                    local bestWord = token
                    local bestDistance = math.huge
                    local bestLengthDifference = math.huge

                    for _, candidate in ipairs(vocabulary) do
                        local lengthDifference = math.abs(#candidate - #token)
                        if lengthDifference <= allowedTypoDistance(token) then
                            local distance = levenshtein(token, candidate)
                            if distance < bestDistance
                                or (distance == bestDistance and lengthDifference < bestLengthDifference) then
                                bestDistance = distance
                                bestLengthDifference = lengthDifference
                                bestWord = candidate
                            end
                        end
                    end

                    if bestWord ~= token and bestDistance <= allowedTypoDistance(token) then
                        changed = true
                        table.insert(corrected, bestWord)
                    else
                        table.insert(corrected, token)
                    end
                end
            end

            if not changed then
                return nil
            end

            return table.concat(corrected, " ")
        end

        local DetailCache = {}
        local ProductInfoCache = {}
        local RuntimeAnimationIdCache = {}

        local function normalizeBundleDetails(raw, fallbackItem)
            if type(raw) ~= "table" then
                return nil
            end

            local details = {
                Id = tonumber(raw.Id or raw.id or (fallbackItem and fallbackItem.Id)),
                Name = raw.Name or raw.name or (fallbackItem and fallbackItem.Name) or "Animation Bundle",
                Description = raw.Description or raw.description or (fallbackItem and fallbackItem.Description) or "",
                BundleType = raw.BundleType or raw.bundleType or "Animations",
                Items = raw.Items or raw.items or {},
                CreatorName = fallbackItem and fallbackItem.CreatorName or "Unknown creator",
                CreatorId = fallbackItem and fallbackItem.CreatorId or nil
            }

            local creator = raw.Creator or raw.creator
            if type(creator) == "table" then
                details.CreatorName = creator.Name or creator.name or details.CreatorName
                details.CreatorId = tonumber(creator.Id or creator.id) or details.CreatorId
            end

            return details
        end

        local function fetchBundleDetails(item)
            if DetailCache[item.Id] then
                return DetailCache[item.Id]
            end

            local engineOk, engineDetails = pcall(function()
                return AssetService:GetBundleDetailsAsync(item.Id)
            end)

            local details
            if engineOk then
                details = normalizeBundleDetails(engineDetails, item)
            else
                local httpOk, httpDetails = pcall(function()
                    local body = httpGet(
                        "https://catalog.roblox.com/v1/bundles/"
                        .. tostring(item.Id)
                        .. "/details"
                    )
                    return HttpService:JSONDecode(body)
                end)

                if httpOk then
                    details = normalizeBundleDetails(httpDetails, item)
                else
                    error(
                        "Could not load bundle details. Engine error: "
                        .. tostring(engineDetails)
                        .. " | HTTP error: "
                        .. tostring(httpDetails)
                    )
                end
            end

            DetailCache[item.Id] = details
            return details
        end

        local function normalizeAvatarAssetType(value)
            if typeof(value) == "EnumItem" then
                return value.Name, value.Value
            end

            if type(value) == "number" then
                return nil, value
            end

            if type(value) == "string" then
                local cleanName = value:match("([^%.]+)$") or value
                return cleanName, tonumber(value)
            end

            return nil, nil
        end

        local function normalizeBundleAsset(raw)
            if type(raw) ~= "table" then
                return nil
            end

            local itemType = raw.Type or raw.type or raw.ItemType or raw.itemType
            if itemType and not containsPlain(tostring(itemType), "asset") then
                return nil
            end

            local id = tonumber(raw.Id or raw.id or raw.AssetId or raw.assetId)
            if not id then
                return nil
            end

            local assetTypeName, assetTypeId = normalizeAvatarAssetType(
                raw.AssetType
                or raw.assetType
                or raw.AvatarAssetType
                or raw.avatarAssetType
                or raw.AssetTypeId
                or raw.assetTypeId
            )

            return {
                Id = id,
                Name = raw.Name or raw.name or ("Animation " .. tostring(id)),
                AssetTypeName = assetTypeName,
                AssetTypeId = assetTypeId,
                Raw = raw
            }
        end

        local function classifySlotFromName(name)
            local normalized = normalizeWords(name)

            if normalized:find("swim idle", 1, true)
                or normalized:find("swimming idle", 1, true)
                or normalized:find("swimidle", 1, true) then
                return "swimidle"
            end

            if normalized:find("idle", 1, true) then
                if normalized:find("idle 2", 1, true)
                    or normalized:find("idle animation 2", 1, true)
                    or normalized:match("idle%s*ii") then
                    return "idle2"
                elseif normalized:find("idle 1", 1, true)
                    or normalized:find("idle animation 1", 1, true)
                    or normalized:match("idle%s*i$") then
                    return "idle1"
                end
                return "idle"
            end

            if normalized:find("walk", 1, true) then
                return "walk"
            elseif normalized:find("run", 1, true) then
                return "run"
            elseif normalized:find("jump", 1, true) then
                return "jump"
            elseif normalized:find("fall", 1, true) then
                return "fall"
            elseif normalized:find("climb", 1, true) then
                return "climb"
            elseif normalized:find("swim", 1, true) then
                return "swim"
            end

            return nil
        end

        local ASSET_TYPE_TO_SLOT = {
            [48] = "climb",
            [50] = "fall",
            [51] = "idle",
            [52] = "jump",
            [53] = "run",
            [54] = "swim",
            [55] = "walk"
        }

        local ASSET_TYPE_NAME_TO_SLOT = {
            climbanimation = "climb",
            fallanimation = "fall",
            idleanimation = "idle",
            jumpanimation = "jump",
            runanimation = "run",
            swimanimation = "swim",
            walkanimation = "walk"
        }

        local function slotFromAssetType(assetTypeName, assetTypeId)
            local byId = ASSET_TYPE_TO_SLOT[tonumber(assetTypeId)]
            if byId then
                return byId
            end

            local normalizedName = lower(assetTypeName or ""):gsub("[^%w]", "")
            return ASSET_TYPE_NAME_TO_SLOT[normalizedName]
        end

        local function getProductInfo(assetId)
            if ProductInfoCache[assetId] ~= nil then
                return ProductInfoCache[assetId] or nil
            end

            local ok, info = pcall(function()
                return MarketplaceService:GetProductInfoAsync(assetId, Enum.InfoType.Asset)
            end)

            if not ok then
                ok, info = pcall(function()
                    return MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
                end)
            end

            if ok and type(info) == "table" then
                ProductInfoCache[assetId] = info
                return info
            end

            ProductInfoCache[assetId] = false
            return nil
        end

        local function cleanAnimationAssetId(value)
            return tonumber(tostring(value or ""):match("%d+"))
        end

        local function extractAnimationIdFromInstance(root, fallbackId)
            if not root then
                return nil
            end

            local candidates = {}

            local function inspect(instance)
                if instance and instance:IsA("Animation") then
                    local id = cleanAnimationAssetId(instance.AnimationId)
                    if id then
                        table.insert(candidates, id)
                    end
                end
            end

            inspect(root)
            for _, descendant in ipairs(root:GetDescendants()) do
                inspect(descendant)
            end

            for _, id in ipairs(candidates) do
                if id ~= tonumber(fallbackId) then
                    return id
                end
            end

            return candidates[1]
        end

        local function destroyLoadedResult(result)
            if typeof(result) == "Instance" then
                pcall(function()
                    result:Destroy()
                end)
            elseif type(result) == "table" then
                for _, instance in ipairs(result) do
                    if typeof(instance) == "Instance" then
                        pcall(function()
                            instance:Destroy()
                        end)
                    end
                end
            end
        end

        local function inspectLoadedResult(result, fallbackId)
            if typeof(result) == "Instance" then
                return extractAnimationIdFromInstance(result, fallbackId)
            end

            if type(result) == "table" then
                for _, instance in ipairs(result) do
                    if typeof(instance) == "Instance" then
                        local id = extractAnimationIdFromInstance(instance, fallbackId)
                        if id then
                            return id
                        end
                    end
                end
            end

            return nil
        end

        local function resolvePlayableAnimationId(catalogItemId)
            catalogItemId = tonumber(catalogItemId)
            if not catalogItemId then
                return nil, "invalid ID"
            end

            local cached = RuntimeAnimationIdCache[catalogItemId]
            if cached then
                return cached.Id, cached.Source
            end

            local attempts = {
                {
                    Name = "AssetService inner AnimationId",
                    Load = function()
                        return AssetService:LoadAssetAsync(catalogItemId)
                    end
                },
                {
                    Name = "InsertService inner AnimationId",
                    Load = function()
                        return InsertService:LoadAsset(catalogItemId)
                    end
                },
                {
                    Name = "GetObjects inner AnimationId",
                    Load = function()
                        return game:GetObjects("rbxassetid://" .. tostring(catalogItemId))
                    end
                }
            }

            for _, attempt in ipairs(attempts) do
                local ok, loaded = pcall(attempt.Load)
                if ok and loaded then
                    local extractedId = inspectLoadedResult(loaded, catalogItemId)
                    destroyLoadedResult(loaded)

                    if extractedId then
                        RuntimeAnimationIdCache[catalogItemId] = {
                            Id = extractedId,
                            Source = attempt.Name
                        }
                        return extractedId, attempt.Name
                    end
                end
            end

            RuntimeAnimationIdCache[catalogItemId] = {
                Id = catalogItemId,
                Source = "bundle item catalog ID"
            }
            return catalogItemId, "bundle item catalog ID"
        end

        local function compareWithKnownReference(bundleName, slots)
            local key, reference = getKnownReference(bundleName)
            if not reference then
                return nil
            end

            local matched = 0
            local mismatched = {}

            for _, slot in ipairs(SLOT_ORDER) do
                local actual = tonumber(slots[slot])
                local expected = tonumber(reference[slot])
                if actual == expected then
                    matched = matched + 1
                else
                    table.insert(mismatched, {
                        Slot = slot,
                        Actual = actual,
                        Expected = expected
                    })
                end
            end

            return {
                Key = key,
                Matched = matched,
                Total = #SLOT_ORDER,
                Mismatched = mismatched,
                Exact = matched == #SLOT_ORDER
            }
        end

        local function resolveAnimationSlots(details)
            local assignedAssets = {}
            local catalogSlots = {}
            local slots = {}
            local slotSources = {}
            local usedIds = {}
            local assets = {}

            for _, raw in ipairs(details.Items or {}) do
                local asset = normalizeBundleAsset(raw)
                if asset then
                    table.insert(assets, asset)
                end
            end

            local function assign(baseSlot, asset, source)
                if not baseSlot or not asset or usedIds[asset.Id] then
                    return false
                end

                local slot = baseSlot
                if baseSlot == "idle" then
                    slot = assignedAssets.idle1 and "idle2" or "idle1"
                elseif baseSlot == "swim" then
                    slot = assignedAssets.swim and "swimidle" or "swim"
                end

                if assignedAssets[slot] == nil then
                    assignedAssets[slot] = asset
                    catalogSlots[slot] = asset.Id
                    slotSources[slot] = source or "unknown"
                    usedIds[asset.Id] = true
                    return true
                end

                return false
            end

            -- GetBundleDetailsAsync guarantees each bundle item's Id, Name, and Type.
            -- Some engine/API responses also expose an animation-specific AssetType.
            for _, asset in ipairs(assets) do
                local typedSlot = slotFromAssetType(asset.AssetTypeName, asset.AssetTypeId)
                local namedSlot = classifySlotFromName(asset.Name)
                if typedSlot == "idle" and (namedSlot == "idle1" or namedSlot == "idle2") then
                    typedSlot = namedSlot
                elseif typedSlot == "swim" and namedSlot == "swimidle" then
                    typedSlot = "swimidle"
                end
                assign(typedSlot, asset, "bundle item AssetType")
            end

            -- Official product metadata exposes AssetTypeId. Values 48 and 50-55
            -- identify climb, fall, idle, jump, run, swim, and walk catalog assets.
            for _, asset in ipairs(assets) do
                if not usedIds[asset.Id] then
                    local info = getProductInfo(asset.Id)
                    if info then
                        local infoTypeName, infoTypeId = normalizeAvatarAssetType(
                            info.AssetType
                            or info.AssetTypeId
                            or info.AvatarAssetType
                        )
                        local typedSlot = slotFromAssetType(infoTypeName, infoTypeId)
                        local namedSlot = classifySlotFromName(info.Name or asset.Name)
                        if typedSlot == "idle" and (namedSlot == "idle1" or namedSlot == "idle2") then
                            typedSlot = namedSlot
                        elseif typedSlot == "swim" and namedSlot == "swimidle" then
                            typedSlot = "swimidle"
                        end
                        assign(typedSlot, asset, "GetProductInfo AssetTypeId")
                    end
                end
            end

            -- Final classification fallback uses the individual item's own name.
            for _, asset in ipairs(assets) do
                if not usedIds[asset.Id] then
                    assign(classifySlotFromName(asset.Name), asset, "individual asset name")
                end
            end

            -- Use known classic packs only to correct ambiguous idle/swim order.
            local _, knownReference = getKnownReference(details.Name)
            if knownReference then
                if catalogSlots.idle1 == knownReference.idle2
                    and catalogSlots.idle2 == knownReference.idle1 then
                    assignedAssets.idle1, assignedAssets.idle2 = assignedAssets.idle2, assignedAssets.idle1
                    catalogSlots.idle1, catalogSlots.idle2 = catalogSlots.idle2, catalogSlots.idle1
                    slotSources.idle1, slotSources.idle2 = slotSources.idle2, slotSources.idle1
                end

                if catalogSlots.swim == knownReference.swimidle
                    and catalogSlots.swimidle == knownReference.swim then
                    assignedAssets.swim, assignedAssets.swimidle = assignedAssets.swimidle, assignedAssets.swim
                    catalogSlots.swim, catalogSlots.swimidle = catalogSlots.swimidle, catalogSlots.swim
                    slotSources.swim, slotSources.swimidle = slotSources.swimidle, slotSources.swim
                end
            end

            local catalogVerification = compareWithKnownReference(details.Name, catalogSlots)

            for _, slot in ipairs(SLOT_ORDER) do
                local asset = assignedAssets[slot]
                if asset then
                    if catalogVerification and catalogVerification.Exact then
                        slots[slot] = asset.Id
                        slotSources[slot] = "verified bundle item ID"
                    else
                        local playableId, source = resolvePlayableAnimationId(asset.Id)
                        slots[slot] = playableId
                        slotSources[slot] = source .. " | classified by " .. tostring(slotSources[slot])
                    end
                end
            end

            local playableVerification = compareWithKnownReference(details.Name, slots)
            local verification = playableVerification or catalogVerification
            if verification then
                verification.Catalog = catalogVerification
                verification.Playable = playableVerification
            end

            return slots, assets, slotSources, verification, catalogSlots
        end

        local function quoteLuaString(value)
            return string.format("%q", tostring(value or "Animation Pack"))
        end

        local function makePackTable(bundleName, slots)
            local lines = {"[" .. quoteLuaString(bundleName) .. "] = {"}
            for index, slot in ipairs(SLOT_ORDER) do
                local value = tonumber(slots and slots[slot]) or 0
                local suffix = index < #SLOT_ORDER and "," or ""
                table.insert(lines, string.format("    %s = %d%s", slot, value, suffix))
            end
            table.insert(lines, "},")
            return table.concat(lines, "\n")
        end

        local originalAnimationsByCharacter = setmetatable({}, {__mode = "k"})
        local activeBundle = nil
        local characterAddedConnection = nil

        local function getAnimationObject(animateScript, path)
            local current = animateScript
            for segment in tostring(path):gmatch("[^%.]+") do
                current = current and current:FindFirstChild(segment)
                if not current then
                    return nil
                end
            end

            if current and current:IsA("Animation") then
                return current
            end
            return nil
        end

        local function patchAnimateSlots(animateScript, slots, originalRecord)
            if not animateScript then
                return 0
            end

            local changed = 0
            for _, slot in ipairs(SLOT_ORDER) do
                local id = slots[slot]
                local path = R15_SLOTS[slot]
                if id and path then
                    local animation = getAnimationObject(animateScript, path)
                    if animation then
                        if originalRecord.Paths[path] == nil then
                            originalRecord.Paths[path] = animation.AnimationId
                        end
                        animation.AnimationId = "rbxassetid://" .. tostring(id)
                        changed = changed + 1
                    end
                end
            end

            -- Some packs only expose one idle or one swim asset. For live testing,
            -- mirror it into the second default slot without fabricating a copied ID.
            if slots.idle1 and not slots.idle2 then
                local idle2 = getAnimationObject(animateScript, R15_SLOTS.idle2)
                if idle2 then
                    if originalRecord.Paths[R15_SLOTS.idle2] == nil then
                        originalRecord.Paths[R15_SLOTS.idle2] = idle2.AnimationId
                    end
                    idle2.AnimationId = "rbxassetid://" .. tostring(slots.idle1)
                end
            elseif slots.idle2 and not slots.idle1 then
                local idle1 = getAnimationObject(animateScript, R15_SLOTS.idle1)
                if idle1 then
                    if originalRecord.Paths[R15_SLOTS.idle1] == nil then
                        originalRecord.Paths[R15_SLOTS.idle1] = idle1.AnimationId
                    end
                    idle1.AnimationId = "rbxassetid://" .. tostring(slots.idle2)
                end
            end

            if slots.swim and not slots.swimidle then
                local swimIdle = getAnimationObject(animateScript, R15_SLOTS.swimidle)
                if swimIdle then
                    if originalRecord.Paths[R15_SLOTS.swimidle] == nil then
                        originalRecord.Paths[R15_SLOTS.swimidle] = swimIdle.AnimationId
                    end
                    swimIdle.AnimationId = "rbxassetid://" .. tostring(slots.swim)
                end
            end

            return changed
        end

        local function stopCurrentCharacterTracks(humanoid)
            local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
            if not animator then
                return 0
            end

            local stopped = 0
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local ok = pcall(function()
                    track:Stop(0)
                end)
                if ok then
                    stopped = stopped + 1
                end
            end

            return stopped
        end

        local function applyAnimationSlots(slots, silent)
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local humanoid = character:FindFirstChildOfClass("Humanoid")
                or character:WaitForChild("Humanoid", 8)

            if not humanoid then
                if not silent then
                    notify("This character does not have a Humanoid.", "error")
                end
                return false
            end

            if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
                if not silent then
                    notify("Animation bundles require an R15 avatar.", "error", 5)
                end
                return false
            end

            local animateScript = character:FindFirstChild("Animate")
                or character:WaitForChild("Animate", 5)

            if not animateScript then
                if not silent then
                    notify("Character.Animate was not found.", "error", 5)
                end
                return false
            end

            local originalRecord = originalAnimationsByCharacter[character]
            if not originalRecord then
                originalRecord = {
                    Paths = {},
                    AnimateWasDisabled = animateScript.Disabled == true
                }
                originalAnimationsByCharacter[character] = originalRecord
            end

            -- Match the user's working Animation Bundles GUI: edit the normal
            -- Character.Animate Animation objects and let Roblox's Animate LocalScript
            -- control idle, walking, running, jumping, falling, climbing, and swimming.
            pcall(function()
                animateScript.Disabled = true
            end)

            stopCurrentCharacterTracks(humanoid)
            local changed = patchAnimateSlots(animateScript, slots, originalRecord)

            task.wait()
            pcall(function()
                animateScript.Disabled = false
            end)

            activeBundle = {
                Name = activeBundle and activeBundle.Name or "Animation Bundle",
                Slots = slots
            }

            if not silent then
                if changed > 0 then
                    notify(
                        "Applied " .. tostring(changed) .. " IDs through Character.Animate. Move or jump to test every slot.",
                        "success",
                        4.5
                    )
                else
                    notify("No matching Animation objects were found under Character.Animate.", "error", 5)
                end
            end

            return changed > 0
        end

        local function restoreOriginalAnimations(silent)
            local character = LocalPlayer.Character
            if not character then
                return false
            end

            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local animateScript = character:FindFirstChild("Animate")
            local originalRecord = originalAnimationsByCharacter[character]

            if not animateScript or not originalRecord then
                activeBundle = nil
                if not silent then
                    notify("No stored original animation set was found.", "warning")
                end
                return false
            end

            pcall(function()
                animateScript.Disabled = true
            end)
            stopCurrentCharacterTracks(humanoid)

            local restored = 0
            for path, animationId in pairs(originalRecord.Paths or {}) do
                local animation = getAnimationObject(animateScript, path)
                if animation then
                    animation.AnimationId = animationId
                    restored = restored + 1
                end
            end

            task.wait()
            pcall(function()
                animateScript.Disabled = originalRecord.AnimateWasDisabled == true
            end)

            activeBundle = nil

            if not silent then
                notify("Restored " .. tostring(restored) .. " original animation slots.", "success")
            end

            return restored > 0
        end

        characterAddedConnection = track(LocalPlayer.CharacterAdded:Connect(function()
            task.wait(1.5)
            if activeBundle and activeBundle.Slots then
                applyAnimationSlots(activeBundle.Slots, true)
            end
        end))

