        function state.Viewer:ClearViewport()
            for _, child in ipairs(self.Viewport:GetChildren()) do
                child:Destroy()
            end
        end

        function state.Viewer:RefreshViewport()
            self:ClearViewport()
            local character = getCharacter()
            if not character then return end

            local oldArchivable = character.Archivable
            character.Archivable = true
            local cloneOk, model = pcall(function() return character:Clone() end)
            character.Archivable = oldArchivable
            if not cloneOk or not model then return end

            for _, object in ipairs(model:GetDescendants()) do
                if object:IsA("Script") or object:IsA("LocalScript") or object:IsA("Tool") then
                    object:Destroy()
                elseif object:IsA("BasePart") then
                    object.Anchored = true
                    object.CanCollide = false
                    object.CanTouch = false
                end
            end

            local world = Instance.new("WorldModel")
            world.Name = "AvatarViewerWorld"
            world.Parent = self.Viewport
            model.Name = "AvatarViewerModel"
            model.Parent = world
            pcall(function() model:PivotTo(CFrame.new()) end)

            local camera = Instance.new("Camera")
            camera.FieldOfView = 32
            camera.Parent = self.Viewport
            self.Viewport.CurrentCamera = camera

            local boxCFrame, boxSize = model:GetBoundingBox()
            local focus = boxCFrame.Position + Vector3.new(0, boxSize.Y * 0.03, 0)
            local halfFov = math.rad(camera.FieldOfView * 0.5)
            local distance = math.max(
                4.5,
                (boxSize.Y * 0.60) / math.max(0.05, math.tan(halfFov)),
                (boxSize.X * 0.67) / math.max(0.05, math.tan(halfFov))
            )
            local angle = math.rad(self.Rotation or 0)
            local offset = Vector3.new(math.sin(angle) * distance, boxSize.Y * 0.02, -math.cos(angle) * distance)
            camera.CFrame = CFrame.lookAt(focus + offset, focus, Vector3.new(0, 1, 0))
        end

        function state.Viewer:ClearItems()
            for _, child in ipairs(self.Items:GetChildren()) do
                if child:IsA("Frame") and child.Name == "ViewerItem" then child:Destroy() end
            end
        end

        function state.Viewer:RenderItems(items, serial)
            if serial ~= state.ViewerRenderSerial or state.Destroyed then return end
            self:ClearItems()
            self.WearingTitle.Text = "Kurrently Wearing (" .. tostring(#items) .. ")"

            for index, item in ipairs(items) do
                local card = create("Frame", {
                    Name = "ViewerItem",
                    Size = UDim2.fromOffset(110, 94),
                    BackgroundColor3 = PANEL,
                    BorderSizePixel = 0,
                    LayoutOrder = index,
                    ZIndex = 14
                })
                addCorner(card, 9)
                addStroke(card, STROKE, 1, 0.2)
                card.Parent = self.Items

                local image = create("ImageLabel", {
                    Position = UDim2.fromOffset(4, 4),
                    Size = UDim2.fromOffset(44, 44),
                    BackgroundColor3 = PANEL_2,
                    BorderSizePixel = 0,
                    Active = false,
                    Image = thumbnailFor(item.Id),
                    ScaleType = Enum.ScaleType.Fit,
                    ZIndex = 15
                })
                addCorner(image, 7)
                image.Parent = card

                local name = create("TextLabel", {
                    Position = UDim2.fromOffset(52, 4),
                    Size = UDim2.new(1, -56, 0, 44),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamBold,
                    Text = item.Name,
                    TextColor3 = TEXT,
                    TextSize = 7.2,
                    TextWrapped = true,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center,
                    ZIndex = 15
                })
                name.Parent = card

                local buy = create("TextButton", {
                    Position = UDim2.fromOffset(4, 53),
                    Size = UDim2.new(0.32, -3, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(46, 156, 82),
                    AutoButtonColor = false,
                    Font = Enum.Font.GothamBold,
                    Text = "Buy",
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 7.2,
                    ZIndex = 15
                })
                addCorner(buy, 6)
                buy.Parent = card
                bindButtonVisual(buy, Color3.fromRGB(46, 156, 82), Color3.fromRGB(56, 180, 96))

                local info = create("TextButton", {
                    Position = UDim2.new(0.34, 0, 0, 53),
                    Size = UDim2.new(0.28, -2, 0, 32),
                    BackgroundColor3 = PANEL_2,
                    AutoButtonColor = false,
                    Font = Enum.Font.GothamBold,
                    Text = "Info",
                    TextColor3 = TEXT,
                    TextSize = 7,
                    ZIndex = 15
                })
                addCorner(info, 6)
                info.Parent = card
                bindButtonVisual(info, PANEL_2, PANEL_3)

                local remove = create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -4, 0, 53),
                    Size = UDim2.new(0.36, -2, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(78, 38, 48),
                    AutoButtonColor = false,
                    Font = Enum.Font.GothamBold,
                    Text = "Remove",
                    TextColor3 = Color3.fromRGB(255, 189, 198),
                    TextSize = 6.4,
                    TextWrapped = true,
                    ZIndex = 15
                })
                addCorner(remove, 6)
                remove.Parent = card
                bindButtonVisual(remove, Color3.fromRGB(78, 38, 48), Color3.fromRGB(95, 44, 56))

                buy.MouseButton1Click:Connect(function() state.Purchase:Prompt(item) end)
                info.MouseButton1Click:Connect(function()
                    openDetails(item)
                end)
                remove.MouseButton1Click:Connect(function()
                    task.spawn(function()
                        local ok, err = Wear.RemoveCurrentAsset(item)
                        if not ok then
                            notify(err or "The item kould not be removed.", "error", 4)
                            return
                        end
                        refreshSelectedUi()
                    end)
                end)

                -- IMPORTANT FOR MOBILE:
                -- The image intentionally has NO InputBegan/InputEnded click handler.
                -- Touch-dragging anywhere over the image therefore belongs to the
                -- horizontal ScrollingFrame and cannot accidentally open Item Details.
            end
        end

        function state.Viewer:Refresh()
            state.ViewerRenderSerial = (state.ViewerRenderSerial or 0) + 1
            local serial = state.ViewerRenderSerial
            self:RefreshViewport()
            self.WearingTitle.Text = "Kurrently Wearing (loading...)"
            task.spawn(function()
                local items = state.GetCurrentWornItems()
                if serial ~= state.ViewerRenderSerial or state.Destroyed then return end
                self:RenderItems(items, serial)
            end)
        end

