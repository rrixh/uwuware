            local toggleHolder = Instance.new("Frame")
            toggleHolder.AnchorPoint = Vector2.new(1, 0)
            toggleHolder.Position = UDim2.new(1, -43, 0, 51)
            toggleHolder.Size = UDim2.fromOffset(44, 20)
            toggleHolder.BackgroundTransparency = 1
            toggleHolder.Parent = row
            makeToggleSwitch(toggleHolder, item.Id, function(api) playEmote(item, api) end, true)

            local remove = makeKolorButton(row, "X", EMOTE_RED)
            remove.AnchorPoint = Vector2.new(1, 0)
