        state.LoadRemoteCustomAsset = function(url, relativePath)
            local asset
            local fromUrl = getGlobal("getcustomassetfromurl")
                or getGlobal("get_custom_asset_from_url")
            if typeof(fromUrl) == "function" then
                local ok, result = pcall(fromUrl, url)
                if ok and type(result) == "string" and result ~= "" then asset = result end
            end

            if not asset then
                local getAsset = getGlobal("getcustomasset")
                    or getGlobal("getsynasset")
                    or getGlobal("get_custom_asset")
                local writeFile = getGlobal("writefile") or getGlobal("write_file")
                local makeFolder = getGlobal("makefolder") or getGlobal("make_folder")
                local isFolder = getGlobal("isfolder") or getGlobal("is_folder")
                if typeof(getAsset) == "function" and typeof(writeFile) == "function" then
                    local folder = "LollypopHub"
                    pcall(function()
                        if typeof(makeFolder) == "function"
                            and (typeof(isFolder) ~= "function" or not isFolder(folder)) then
                            makeFolder(folder)
                        end
                    end)
                    local path = folder .. "/" .. tostring(relativePath or "asset.bin")
                    local bodyOk, body = pcall(httpGet, url)
                    if bodyOk and type(body) == "string" and #body > 0 then
                        local writeOk = pcall(writeFile, path, body)
                        if writeOk then
                            local assetOk, result = pcall(getAsset, path)
                            if assetOk and type(result) == "string" and result ~= "" then asset = result end
                        end
                    end
                end
            end
            return asset
        end

