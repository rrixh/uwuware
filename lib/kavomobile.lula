        local function thumbnailFor(assetId)
            return "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=420&h=420"
        end

        local function normalizeAssetType(value)
            if typeof(value) == "EnumItem" then
                return value.Value, value.Name
            end

            if type(value) == "number" then
                return value, ASSET_TYPE_NAMES[value]
            end

            if type(value) == "string" then
                local numeric = tonumber(value)
                if numeric then
                    return numeric, ASSET_TYPE_NAMES[numeric]
                end
                local clean = value:match("([^%.]+)$") or value
                local enumItem = avatarAssetType(clean)
                if enumItem then
                    return enumItem.Value, enumItem.Name
                end
                return nil, clean
            end

            return nil, nil
        end

        local function normalizeCatalogItem(raw)
            if type(raw) ~= "table" then
                return nil
            end

            local itemType = raw.ItemType or raw.itemType or raw.Type or raw.type
            if typeof(itemType) == "EnumItem" then
                itemType = itemType.Name
            end
            itemType = tostring(itemType or "Asset")
            if not containsPlain(itemType, "asset") then
                return nil
            end

            local id = tonumber(raw.Id or raw.id or raw.AssetId or raw.assetId)
            if not id then
                return nil
            end

            local assetTypeId, assetTypeName = normalizeAssetType(
                raw.AssetType
                or raw.assetType
                or raw.AssetTypeId
                or raw.assetTypeId
                or raw.AvatarAssetType
                or raw.avatarAssetType
            )

            local creatorName = raw.CreatorName or raw.creatorName
            local creatorId = raw.CreatorTargetId or raw.creatorTargetId or raw.CreatorId or raw.creatorId
            local creatorType = raw.CreatorType or raw.creatorType
            local creator = raw.Creator or raw.creator
            if type(creator) == "table" then
                creatorName = creator.Name or creator.name or creatorName
                creatorId = creator.Id or creator.id or creatorId
                creatorType = creator.Type or creator.type or creatorType
            end

            local price = raw.Price or raw.price or raw.LowestPrice or raw.lowestPrice
            if price ~= nil then
                price = tonumber(price)
            end
            local premiumPrice = raw.PremiumPrice or raw.premiumPrice or raw.PremiumPricing or raw.premiumPricing
            if type(premiumPrice) == "table" then
                premiumPrice = premiumPrice.Price or premiumPrice.price or premiumPrice.LowestPrice or premiumPrice.lowestPrice
            end
            premiumPrice = tonumber(premiumPrice)
            local premiumText = string.lower(tostring(raw.PriceStatus or raw.priceStatus or ""))
            local isPremium = raw.IsPremium == true or raw.isPremium == true or premiumPrice ~= nil
                or raw.PremiumPricing ~= nil or raw.premiumPricing ~= nil
                or string.find(premiumText, "premium", 1, true) ~= nil

            return {
                Id = id,
                Name = tostring(raw.Name or raw.name or ("Asset " .. tostring(id))),
                Description = tostring(raw.Description or raw.description or ""),
                CreatorName = tostring(creatorName or "Unknown creator"),
                CreatorId = tonumber(creatorId),
                CreatorType = tostring(creatorType or ""),
                AssetTypeId = assetTypeId,
                AssetTypeName = ASSET_TYPE_NAMES[assetTypeId] or assetTypeName or "Avatar Item",
                Price = price,
                PriceStatus = raw.PriceStatus or raw.priceStatus,
                PremiumPrice = premiumPrice,
                Premium = isPremium,
                FavoriteCount = tonumber(raw.FavoriteCount or raw.favoriteCount),
                Raw = raw
            }
        end

        local STAR_EMPTY = utf8.char(0x2606)
        local STAR_FILLED = utf8.char(0x2605)
        local FAVORITE_YELLOW = Color3.fromRGB(255, 213, 54)

        local function favoriteSerializable(item)
            return {
                ItemType = "Asset",
                Id = tonumber(item.Id),
                Name = tostring(item.Name or ("Asset " .. tostring(item.Id))),
                Description = tostring(item.Description or ""),
                CreatorName = tostring(item.CreatorName or "Unknown creator"),
                CreatorId = tonumber(item.CreatorId),
                CreatorType = tostring(item.CreatorType or ""),
                AssetTypeId = tonumber(item.AssetTypeId),
                AssetTypeName = tostring(item.AssetTypeName or "Avatar Item"),
                Price = tonumber(item.Price),
                PriceStatus = item.PriceStatus,
                PremiumPrice = tonumber(item.PremiumPrice),
                Premium = item.Premium == true,
                FavoriteCount = tonumber(item.FavoriteCount)
            }
        end

        local function getFavorites()
            local output, seen = {}, {}
            for _, raw in ipairs(settings.AvatarKreatorFavorites or {}) do
                local item = normalizeCatalogItem(raw)
                if item and item.Id and not seen[item.Id] then
                    seen[item.Id] = true
                    output[#output + 1] = item
                end
            end
            return output
        end

        local function saveFavorites(items)
            local clean, seen = {}, {}
            for _, item in ipairs(items or {}) do
                local id = tonumber(item and item.Id)
                if id and not seen[id] then
                    seen[id] = true
                    clean[#clean + 1] = favoriteSerializable(item)
                end
            end
            settings.AvatarKreatorFavorites = clean
            if type(env.LHUISettings) == "table" then env.LHUISettings.AvatarKreatorFavorites = clean end
            if type(env.LHSettings) == "table" then env.LHSettings.AvatarKreatorFavorites = clean end
            markSettingsDirty()
            saveSettingsNow()
            return clean
        end

        local function isFavorite(item)
            local wanted = tonumber(item and item.Id)
            if not wanted then return false end
            for _, favorite in ipairs(settings.AvatarKreatorFavorites or {}) do
                if tonumber(favorite.Id or favorite.id) == wanted then return true end
            end
            return false
        end

        local renderFavorites
        local refreshFavoriteVisuals

        local function toggleFavorite(item)
            if not item or not item.Id then return end
            local favorites = getFavorites()
            local wanted = tonumber(item.Id)
            local removed = false
            for index = #favorites, 1, -1 do
                if tonumber(favorites[index].Id) == wanted then
                    table.remove(favorites, index)
                    removed = true
                    break
                end
            end
            if not removed then favorites[#favorites + 1] = item end
            saveFavorites(favorites)
            if state.Mode == "favorites" and renderFavorites then
                renderFavorites(SearchBox.Text)
            elseif refreshFavoriteVisuals then
                refreshFavoriteVisuals()
            end
        end

        local function itemAllowed(item, category)
            if not item or not item.AssetTypeId then
                return false
            end
            return category.AllowedIds[item.AssetTypeId] == true
        end

        local function normalizePage(rawPage, category)
            local output = {}
            local seen = {}

            for _, raw in ipairs(rawPage or {}) do
                local item = normalizeCatalogItem(raw)
                if item and itemAllowed(item, category) and not seen[item.Id] then
                    seen[item.Id] = true
                    table.insert(output, item)
                end
            end

            return output
        end

        local function resultScore(item, query)
            query = lower(trim(query))
            if query == "" then
                return 0
            end

            local name = lower(item.Name)
            if name == query then
                return 1000
            end
            if name:sub(1, #query) == query then
                return 700
            end
            if name:find(query, 1, true) then
                return 500
            end

            local score = 0
            for token in query:gmatch("%S+") do
                if name:find(token, 1, true) then
                    score = score + 100
                end
            end
            return score
        end

        local function sortResults(results, query)
            table.sort(results, function(a, b)
                local aScore = resultScore(a, query)
                local bScore = resultScore(b, query)
                if aScore == bScore then
                    return lower(a.Name) < lower(b.Name)
                end
                return aScore > bScore
            end)
        end

        local function createEngineSearch(query, category)
            local params = CatalogSearchParams.new()
            params.SearchKeyword = query or ""
            params.AssetTypes = category.EngineTypes
            params.IncludeOffSale = true
            params.Limit = 30

            pcall(function()
                params.SortType = Enum.CatalogSortType.Relevance
            end)
            pcall(function()
                params.SortAggregation = Enum.CatalogSortAggregation.AllTime
            end)

            local pages = AvatarEditorService:SearchCatalogAsync(params)
            local firstPage = normalizePage(pages:GetCurrentPage(), category)

            local function hasMorePages()
                local ok, finished = pcall(function()
                    return pages.IsFinished
                end)
                return ok and not finished
            end

            local function nextPage()
                if not hasMorePages() then
                    return {}, false
                end
                pages:AdvanceToNextPageAsync()
                return normalizePage(pages:GetCurrentPage(), category), hasMorePages()
            end

            return firstPage, nextPage, hasMorePages(), "AvatarEditorService"
        end

        local function buildCatalogUrl(query, category, cursor)
            local parts = {
                "Category=" .. tostring(category.HttpCategory or 1),
                "Subcategory=" .. tostring(category.HttpSubcategory or 1),
                "Limit=30",
                "SortType=0",
                "SortAggregation=5"
            }

            if trim(query) ~= "" then
                table.insert(parts, "Keyword=" .. HttpService:UrlEncode(trim(query)))
            end

            if cursor and cursor ~= "" then
                table.insert(parts, "Cursor=" .. HttpService:UrlEncode(cursor))
            end

            return "https://catalog.roblox.com/v1/search/items/details?" .. table.concat(parts, "&")
        end

        local function createHttpSearch(query, category)
            local currentCursor = nil

            local function requestPage(cursor)
                local body = httpGet(buildCatalogUrl(query, category, cursor))
                local decoded = HttpService:JSONDecode(body)
                local data = normalizePage(decoded.data or decoded.Data or {}, category)
                local nextCursor = decoded.nextPageCursor or decoded.NextPageCursor
                return data, nextCursor
            end

            local firstPage, nextCursor = requestPage(nil)
            currentCursor = nextCursor

            local function nextPage()
                if not currentCursor then
                    return {}, false
                end
                local page, newCursor = requestPage(currentCursor)
                currentCursor = newCursor
                return page, currentCursor ~= nil
            end

            return firstPage, nextPage, currentCursor ~= nil, "Catalog HTTP"
        end

        local ProductInfoCache = {}

        local function getProductInfo(assetId)
            assetId = tonumber(assetId)
            if not assetId then
                return nil
            end

            if ProductInfoCache[assetId] ~= nil then
                return ProductInfoCache[assetId] or nil
            end

            local ok, info = pcall(function()
                return MarketplaceService:GetProductInfoAsync(assetId, Enum.InfoType.Asset)
            end)
            if not ok then
                ok, info = pcall(function()
                    return MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
                end)
            end

            if ok and type(info) == "table" then
                ProductInfoCache[assetId] = info
                return info
            end

            ProductInfoCache[assetId] = false
            return nil
        end

        local function itemFromProductInfo(assetId)
            local info = getProductInfo(assetId)
            if not info then
                return nil
            end

            local item = normalizeCatalogItem({
                Id = assetId,
                Name = info.Name,
                Description = info.Description,
                Creator = info.Creator,
                CreatorName = info.Creator and info.Creator.Name,
                CreatorId = info.Creator and info.Creator.Id,
                CreatorType = info.Creator and info.Creator.CreatorType,
                AssetTypeId = info.AssetTypeId,
                Price = info.PriceInRobux,
                PriceStatus = info.IsForSale == false and "OffSale" or nil,
                PremiumPrice = info.PremiumPriceInRobux or info.PremiumPrice,
                IsPremium = info.IsPremium == true,
                ItemType = "Asset"
            })

            return item
        end

        local function searchMarketplace(query, category)
            local exactId = trim(query):match("^%d+$") and tonumber(trim(query)) or nil
            local directItem = exactId and itemFromProductInfo(exactId) or nil

            local engineOk, engineResults, engineNext, engineHasMore, engineBackend = pcall(
                createEngineSearch,
                query,
                category
            )

            local results
            local nextPage
            local hasMore
            local backend

            if engineOk and type(engineResults) == "table" and #engineResults > 0 then
                results = engineResults
                nextPage = engineNext
                hasMore = engineHasMore
                backend = engineBackend
            else
                local httpOk, httpResults, httpNext, httpHasMore, httpBackend = pcall(
                    createHttpSearch,
                    query,
                    category
                )

                if httpOk then
                    results = httpResults
                    nextPage = httpNext
                    hasMore = httpHasMore
                    backend = httpBackend
                elseif engineOk then
                    results = engineResults or {}
                    nextPage = engineNext
                    hasMore = engineHasMore
                    backend = engineBackend or "AvatarEditorService"
                else
                    error(
                        "AvatarEditorService error: "
                        .. tostring(engineResults)
                        .. " | HTTP error: "
                        .. tostring(httpResults)
                    )
                end
            end

            if directItem and itemAllowed(directItem, category) then
                local alreadyAdded = false
                for _, item in ipairs(results) do
                    if item.Id == directItem.Id then
                        alreadyAdded = true
                        break
                    end
                end
                if not alreadyAdded then
                    table.insert(results, 1, directItem)
                end
            end

            sortResults(results, query)
            return results, nextPage, hasMore, backend
        end

        local function getCharacter()
            local character = LocalPlayer.Character
            if character and character.Parent then
                state.CurrentCharacter = character
                return character
            end
            return nil
        end

        local function getHumanoid(character)
            character = character or getCharacter()
            if not character then
                return nil
            end
            return character:FindFirstChildOfClass("Humanoid")
                or character:WaitForChild("Humanoid", 5)
        end

        local function getSnapshot(character)
            local snapshot = state.SnapshotByCharacter[character]
            if not snapshot then
                snapshot = {
                    Captured = {},
                    Slots = {}
                }
                state.SnapshotByCharacter[character] = snapshot
            end
            return snapshot
        end

        local function slotForAccessory(accessory)
            if not accessory or not accessory:IsA("Accessory") then
                return nil
            end

            local customSlot = accessory:GetAttribute("LHAvatarSlot")
            if type(customSlot) == "string" and customSlot ~= "" then
                return customSlot
            end

            local handle = accessory:FindFirstChild("Handle")
            if handle then
                -- Hair/Hat attachment names are more reliable than AccessoryType for
                -- several older Marketplace items.
                if handle:FindFirstChild("HairAttachment") then return "Hair" end
                if handle:FindFirstChild("HatAttachment") then return "Hat" end
            end

            local ok, typeName = pcall(function()
                return accessory.AccessoryType.Name
            end)
            if ok and typeName and ACCESSORY_NAME_TO_SLOT[typeName] then
                return ACCESSORY_NAME_TO_SLOT[typeName]
            end

            if handle then
                for _, child in ipairs(handle:GetChildren()) do
                    if child:IsA("Attachment") then
                        local inferred = ACCESSORY_ATTACHMENT_TO_SLOT[child.Name]
                        if inferred then return inferred end
                    end
                end
            end

            return nil
        end

        local function instanceBelongsToSlot(instance, slot)
            if not instance then
                return false
            end

            if slot == "ClassicTShirt" then
                return instance:IsA("ShirtGraphic")
            elseif slot == "ClassicShirt" then
                return instance:IsA("Shirt")
            elseif slot == "ClassicPants" then
                return instance:IsA("Pants")
            elseif slot == "FaceDecal" then
                return instance:IsA("Decal") and lower(instance.Name) == "face"
            elseif slot == "Gear" then
                return instance:IsA("Tool")
                    and instance:GetAttribute("LHAvatarKreator") == true
                    and instance:GetAttribute("LHAvatarSlot") == "Gear"
            elseif instance:IsA("Accessory") then
                return slotForAccessory(instance) == slot
            end

            return false
        end

        local function captureOriginalSlot(character, slot)
            local snapshot = getSnapshot(character)
            if snapshot.Captured[slot] then
                return
            end

            snapshot.Captured[slot] = true
            snapshot.Slots[slot] = {}

            if slot == "Gear" then
                -- Gear is a Tool, not part of HumanoidDescription. Preserve game tools.
                return
            end

            if slot == "FaceDecal" then
                local head = character:FindFirstChild("Head")
                if head then
                    for _, child in ipairs(head:GetChildren()) do
                        if instanceBelongsToSlot(child, slot) then
                            table.insert(snapshot.Slots[slot], child:Clone())
                        end
                    end
                end
                return
            end

            for _, child in ipairs(character:GetChildren()) do
                if instanceBelongsToSlot(child, slot) then
                    table.insert(snapshot.Slots[slot], child:Clone())
                end
            end
        end

        local function destroySlotInstances(character, slot)
            if not character then
                return
            end

            if slot == "FaceDecal" then
                local head = character:FindFirstChild("Head")
                if head then
                    for _, child in ipairs(head:GetChildren()) do
                        if instanceBelongsToSlot(child, slot) then
                            child:Destroy()
                        end
                    end
                end
                return
            end

            if slot == "Gear" then
                for _, parent in ipairs({
                    character,
                    LocalPlayer:FindFirstChildOfClass("Backpack")
                }) do
                    if parent then
                        for _, child in ipairs(parent:GetChildren()) do
                            if instanceBelongsToSlot(child, slot) then
                                child:Destroy()
                            end
                        end
                    end
                end
                return
            end

            for _, child in ipairs(character:GetChildren()) do
                if instanceBelongsToSlot(child, slot) then
                    child:Destroy()
                end
            end
        end

        local function prepareAccessory(accessory, item, slot)
            accessory:SetAttribute("LHAvatarItemId", item.Id)
            accessory:SetAttribute("LHAvatarSlot", slot)
            accessory:SetAttribute("LHAvatarKreator", true)

            local desiredType = ASSET_TYPE_TO_ACCESSORY_TYPE[item.AssetTypeId]
            if desiredType then
                pcall(function()
                    accessory.AccessoryType = desiredType
                end)
            end

            local handle = accessory:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                handle.CanCollide = false
                handle.CanTouch = false
                handle.Massless = true
            end
        end

        local function findAccessoryHandle(accessory)
            local handle = accessory and accessory:FindFirstChild("Handle")
            return handle and handle:IsA("BasePart") and handle or nil
        end

        local function findMatchingCharacterAttachment(character, accessory)
            local handle = findAccessoryHandle(accessory)
            if not handle then return nil, nil end

            for _, handleChild in ipairs(handle:GetChildren()) do
                if handleChild:IsA("Attachment") then
                    for _, characterDescendant in ipairs(character:GetDescendants()) do
                        if characterDescendant:IsA("Attachment")
                            and characterDescendant.Name == handleChild.Name
                            and not characterDescendant:IsDescendantOf(accessory) then
                            return handleChild, characterDescendant
                        end
                    end
                end
            end
            return nil, nil
        end

        local function accessoryHasCharacterJoint(character, accessory)
            local handle = findAccessoryHandle(accessory)
            if not handle then return false end

            for _, descendant in ipairs(character:GetDescendants()) do
                if descendant:IsA("JointInstance") then
                    local part0 = descendant.Part0
                    local part1 = descendant.Part1
                    if (part0 == handle and part1 and part1:IsDescendantOf(character) and not part1:IsDescendantOf(accessory))
                        or (part1 == handle and part0 and part0:IsDescendantOf(character) and not part0:IsDescendantOf(accessory)) then
                        return true, descendant
                    end
                elseif descendant:IsA("RigidConstraint") then
                    local attachment0 = descendant.Attachment0
                    local attachment1 = descendant.Attachment1
                    if attachment0 and attachment1 then
                        local part0 = attachment0.Parent
                        local part1 = attachment1.Parent
                        if (part0 == handle and part1 and part1:IsDescendantOf(character) and not part1:IsDescendantOf(accessory))
                            or (part1 == handle and part0 and part0:IsDescendantOf(character) and not part0:IsDescendantOf(accessory)) then
                            return true, descendant
                        end
                    end
                end
            end

            return false
        end

        local function makeManualAttachmentWeld(character, accessory)
            local handle = findAccessoryHandle(accessory)
            if not handle then return false, "Accessory Handle is missing." end

            local handleAttachment, characterAttachment = findMatchingCharacterAttachment(character, accessory)
            if not handleAttachment or not characterAttachment then
                return false, "No matching character Attachment was found."
            end

            local bodyPart = characterAttachment.Parent
            if not bodyPart or not bodyPart:IsA("BasePart") then
                return false, "Matching character Attachment was not inside a BasePart."
            end

            pcall(function()
                handle.CFrame = characterAttachment.WorldCFrame * handleAttachment.CFrame:Inverse()
            end)

            local existing = handle:FindFirstChild("AccessoryWeld")
            if existing and existing:IsA("JointInstance") then existing:Destroy() end

            local weld = Instance.new("Weld")
            weld.Name = "AccessoryWeld"
            weld.Part0 = handle
            weld.Part1 = bodyPart
            weld.C0 = handleAttachment.CFrame
            weld.C1 = characterAttachment.CFrame
            weld.Parent = handle

            local attached = accessoryHasCharacterJoint(character, accessory)
            return attached == true, attached and "matching Attachment weld created" or "manual weld verification failed"
        end

        local function makeLegacyHeadWeld(character, accessory)
            local handle = findAccessoryHandle(accessory)
            local head = character and character:FindFirstChild("Head")
            if not handle or not head or not head:IsA("BasePart") then
                return false, "Legacy head weld is unavailable."
            end

            local slot = slotForAccessory(accessory)
            if slot ~= "Hat" and slot ~= "Hair" and slot ~= "FaceAccessory" then
                return false, "Legacy head weld is only used for head accessories."
            end

            local attachmentPoint = CFrame.new()
            pcall(function() attachmentPoint = accessory.AttachmentPoint end)
            local headOffset = CFrame.new(0, head.Size.Y / 2, 0)

            pcall(function()
                handle.CFrame = head.CFrame * headOffset * attachmentPoint:Inverse()
            end)

            local weld = Instance.new("Weld")
            weld.Name = "AccessoryWeld"
            weld.Part0 = handle
            weld.Part1 = head
            weld.C0 = attachmentPoint
            weld.C1 = headOffset
            weld.Parent = handle

            local attached = accessoryHasCharacterJoint(character, accessory)
            return attached == true, attached and "legacy head weld created" or "legacy weld verification failed"
        end

        local function attachAccessory(humanoid, character, accessory)
            accessory.Parent = nil

            local addOk, addError = pcall(function()
                humanoid:AddAccessory(accessory)
            end)
            if not addOk then
                return false, "Humanoid:AddAccessory", tostring(addError)
            end

            for _ = 1, 2 do RunService.Heartbeat:Wait() end
            if accessory.Parent == character and accessoryHasCharacterJoint(character, accessory) then
                return true, "Humanoid:AddAccessory"
            end

            -- Roblox documents that client-sided AddAccessory calls may parent the
            -- Accessory without producing the expected weld. BuildRigFromAttachments
            -- is the official repair path for that client-side case.
            local buildOk, buildError = pcall(function()
                humanoid:BuildRigFromAttachments()
            end)
            for _ = 1, 2 do RunService.Heartbeat:Wait() end
            if buildOk and accessory.Parent == character and accessoryHasCharacterJoint(character, accessory) then
                return true, "Humanoid:AddAccessory + BuildRigFromAttachments"
            end

            return false,
                "Humanoid:AddAccessory + BuildRigFromAttachments",
                tostring(buildError or addError or "Accessory stayed unattached after BuildRigFromAttachments.")
        end

        local function restoreOriginalSlot(character, slot)
            if not character then
                return false
            end

            destroySlotInstances(character, slot)

            local snapshot = getSnapshot(character)
            local originals = snapshot.Slots[slot] or {}
            local humanoid = getHumanoid(character)

            for _, original in ipairs(originals) do
                local clone = original:Clone()
                if slot == "FaceDecal" then
                    local head = character:FindFirstChild("Head")
                    if head then
                        clone.Parent = head
                    else
                        clone:Destroy()
                    end
                elseif clone:IsA("Accessory") and humanoid then
                    local restored = attachAccessory(humanoid, character, clone)
                    if not restored then
                        pcall(function() clone:Destroy() end)
                    end
                else
                    clone.Parent = character
                end
            end

            return true
        end

        local function destroyLoadedResult(result)
            if typeof(result) == "Instance" then
                pcall(function()
                    result:Destroy()
                end)
            elseif type(result) == "table" then
                for _, instance in ipairs(result) do
                    if typeof(instance) == "Instance" then
                        pcall(function()
                            instance:Destroy()
                        end)
                    end
                end
            end
        end

        local function getLoadedRoots(result)
            if typeof(result) == "Instance" then
                return {result}
            end

            local roots = {}
            if type(result) == "table" then
                for _, instance in ipairs(result) do
                    if typeof(instance) == "Instance" then
                        table.insert(roots, instance)
                    end
                end
            end
            return roots
        end

        local Wear = {}

        -- Avatar Kreator v3 Try On notes:
        -- * Default: matching item types replace each other.
        -- * Item Stacking: accessories of the same type are preserved and appended locally.
        -- * Every successful Try On toast includes [the method that aktually worked].
        -- * Failed methods are written to the developer/executor console for testing.

        function Wear.DescendantsIncludingRoot(root)
            local output = {root}
            for _, descendant in ipairs(root:GetDescendants()) do
                output[#output + 1] = descendant
            end
            return output
        end

        function Wear.CloneFirstClass(roots, className)
            for _, root in ipairs(roots) do
                for _, instance in ipairs(Wear.DescendantsIncludingRoot(root)) do
                    if instance:IsA(className) then return instance:Clone() end
                end
            end
            return nil
        end

        function Wear.CloneAccessories(roots)
            local output = {}
            local seen = {}
            for _, root in ipairs(roots) do
                for _, instance in ipairs(Wear.DescendantsIncludingRoot(root)) do
                    if instance:IsA("Accessory") and not seen[instance] then
                        seen[instance] = true
                        output[#output + 1] = instance:Clone()
                    end
                end
            end
            return output
        end

        function Wear.ResolveMissingAssetType(item)
            if item.AssetTypeId and ASSET_TYPE_TO_SLOT[item.AssetTypeId] then return true end
            local info = getProductInfo(item.Id)
            if not info then return false end
            local typeId = tonumber(info.AssetTypeId)
            if not typeId or not ASSET_TYPE_TO_SLOT[typeId] then return false end
            item.AssetTypeId = typeId
            item.AssetTypeName = ASSET_TYPE_NAMES[typeId] or item.AssetTypeName
            item.Name = info.Name or item.Name
            item.Description = info.Description or item.Description
            if info.Creator then
                item.CreatorName = info.Creator.Name or item.CreatorName
                item.CreatorId = tonumber(info.Creator.Id) or item.CreatorId
            end
            item.Price = tonumber(info.PriceInRobux) or item.Price
            return true
        end

        Wear.AssetLoaders = {
            {
                Name = "GetObjects",
                Run = function(assetId)
                    return game:GetObjects("rbxassetid://" .. tostring(assetId))
                end
            }
        }

        function Wear.Debug(methodName, worked, detail)
            local stateText = worked and "WORKED" or "FAILED"
            warn(("[Avatar Kreator][%s] %s%s"):format(
                tostring(methodName),
                stateText,
                detail and (" - " .. tostring(detail)) or ""
            ))
        end

        function Wear.WithRobloxIdentity(callback)
            local setter = getGlobal("setthreadidentity")
                or getGlobal("set_thread_identity")
                or getGlobal("setidentity")
            local getter = getGlobal("getthreadidentity")
                or getGlobal("get_thread_identity")
                or getGlobal("getidentity")

            local previous
            if typeof(getter) == "function" then
                pcall(function() previous = getter() end)
            end
            if typeof(setter) == "function" then
                pcall(setter, 8)
            end

            local ok, packed = pcall(function()
                return table.pack(callback())
            end)

            if typeof(setter) == "function" and previous ~= nil then
                pcall(setter, previous)
            end

            if not ok then return false, packed end
            return true, packed
        end

        function Wear.CharacterSlotLooksApplied(character, slot, selectedItems)
            if #selectedItems == 0 then return true end
            if not character then return false end

            if slot == "ClassicTShirt" then
                return character:FindFirstChildOfClass("ShirtGraphic") ~= nil
            elseif slot == "ClassicShirt" then
                return character:FindFirstChildOfClass("Shirt") ~= nil
            elseif slot == "ClassicPants" then
                return character:FindFirstChildOfClass("Pants") ~= nil
            elseif slot == "FaceDecal" then
                local head = character:FindFirstChild("Head")
                return head and head:FindFirstChild("face") ~= nil
            end

            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("Accessory")
                    and slotForAccessory(child) == slot
                    and accessoryHasCharacterJoint(character, child) then
                    return true
                end
            end
            return false
        end

        function Wear.GetSlotItems(slot)
            local items = state.EquippedBySlot[slot]
            if type(items) ~= "table" then return {} end
            if items.Id then return {items} end
            return items
        end

        function Wear.CopyItems(items)
            local output = {}
            for _, item in ipairs(items or {}) do
                output[#output + 1] = item
            end
            return output
        end

        function Wear.IsEquipped(item)
            if not item or not item.AssetTypeId then return false end
            local slot = ASSET_TYPE_TO_SLOT[item.AssetTypeId]
            for _, selected in ipairs(Wear.GetSlotItems(slot)) do
                if tonumber(selected.Id) == tonumber(item.Id) then return true end
            end
            return false
        end

        function Wear.IsAccessoryItem(item)
            return item and ASSET_TYPE_TO_ACCESSORY_TYPE[item.AssetTypeId] ~= nil
        end

        function Wear.GetOriginalDescription(character, humanoid)
            local cached = state.OriginalDescriptionByCharacter[character]
            if cached then return cached end

            local ok, description = pcall(function()
                return humanoid:GetAppliedDescription()
            end)
            if not ok or not description then
                Wear.Debug("Humanoid.GetAppliedDescription", false, description)
                return nil
            end

            local cloneOk, clone = pcall(function() return description:Clone() end)
            state.OriginalDescriptionByCharacter[character] = (cloneOk and clone) or description
            Wear.Debug("Humanoid.GetAppliedDescription", true, "original avatar captured")
            return state.OriginalDescriptionByCharacter[character]
        end

        function Wear.GetDescriptionProperty(slot)
            if slot == "ClassicTShirt" then return "GraphicTShirt" end
            if slot == "ClassicShirt" then return "Shirt" end
            if slot == "ClassicPants" then return "Pants" end
            if slot == "FaceDecal" then return "Face" end
            return nil
        end

        function Wear.BuildDescription(character, humanoid, slot, selectedItems)
            local currentOk, description = pcall(function()
                return humanoid:GetAppliedDescription()
            end)
            if not currentOk or not description then
                return nil, "Humanoid:GetAppliedDescription failed: " .. tostring(description)
            end

            local original = Wear.GetOriginalDescription(character, humanoid)
            if not original then
                return nil, "Original HumanoidDescription was unavailable."
            end

            local propertyName = Wear.GetDescriptionProperty(slot)
            if propertyName then
                local targetId
                if #selectedItems > 0 then
                    targetId = tonumber(selectedItems[#selectedItems].Id) or 0
                else
                    local readOk, originalId = pcall(function() return original[propertyName] end)
                    targetId = readOk and tonumber(originalId) or 0
                end
                local writeOk, writeError = pcall(function() description[propertyName] = targetId end)
                if not writeOk then return nil, writeError end
                return description
            end

            local targetType = nil
            if #selectedItems > 0 then
                targetType = ASSET_TYPE_TO_ACCESSORY_TYPE[selectedItems[1].AssetTypeId]
            else
                for typeId, mappedSlot in pairs(ASSET_TYPE_TO_SLOT) do
                    if mappedSlot == slot and ASSET_TYPE_TO_ACCESSORY_TYPE[typeId] then
                        targetType = ASSET_TYPE_TO_ACCESSORY_TYPE[typeId]
                        break
                    end
                end
            end
            if not targetType then return nil, "AccessoryType could not be resolved for " .. tostring(slot) end

            local okCurrent, currentAccessories = pcall(function() return description:GetAccessories(true) end)
            local okOriginal, originalAccessories = pcall(function() return original:GetAccessories(true) end)
            if not okCurrent or type(currentAccessories) ~= "table" then
                return nil, "GetAccessories failed."
            end
            if not okOriginal or type(originalAccessories) ~= "table" then originalAccessories = {} end

            local rebuilt = {}
            for _, record in ipairs(currentAccessories) do
                if record.AccessoryType ~= targetType then
                    rebuilt[#rebuilt + 1] = record
                end
            end

            if #selectedItems == 0 or state.ItemStacking then
                for _, record in ipairs(originalAccessories) do
                    if record.AccessoryType == targetType then
                        rebuilt[#rebuilt + 1] = record
                    end
                end
            end

            local order = #rebuilt + 1
            for _, item in ipairs(selectedItems) do
                rebuilt[#rebuilt + 1] = {
                    AssetId = tonumber(item.Id),
                    AccessoryType = ASSET_TYPE_TO_ACCESSORY_TYPE[item.AssetTypeId] or targetType,
                    IsLayered = tonumber(item.AssetTypeId) and item.AssetTypeId >= 64 or false,
                    Order = order
                }
                order = order + 1
            end

            local setOk, setError = pcall(function() description:SetAccessories(rebuilt, true) end)
            if not setOk then return nil, setError end
            return description
        end

        function Wear.DescriptionContains(description, slot, selectedItems)
            if not description then return false end
            if #selectedItems == 0 then return true end

            local propertyName = Wear.GetDescriptionProperty(slot)
            if propertyName then
                local ok, value = pcall(function() return description[propertyName] end)
                return ok and tonumber(value) == tonumber(selectedItems[#selectedItems].Id)
            end

            local ok, accessories = pcall(function() return description:GetAccessories(true) end)
            if not ok or type(accessories) ~= "table" then return false end
            local found = {}
            for _, record in ipairs(accessories) do
                found[tonumber(record.AssetId)] = (found[tonumber(record.AssetId)] or 0) + 1
            end
            for _, item in ipairs(selectedItems) do
                local id = tonumber(item.Id)
                if not id or not found[id] or found[id] <= 0 then return false end
                found[id] = found[id] - 1
            end
            return true
        end

        function Wear.TryDescriptionMethod(humanoid, description, slot, selectedItems, methodName, resetMode)
            local method = resetMode and humanoid.ApplyDescriptionResetAsync or humanoid.ApplyDescriptionAsync
            if typeof(method) ~= "function" then
                Wear.Debug(methodName, false, "method unavailable")
                return false
            end

            local variants = {
                {
                    Name = methodName .. " + ClientOnly",
                    Run = function()
                        method(humanoid, description, Enum.AssetTypeVerification.ClientOnly)
                    end
                },
                {
                    Name = methodName .. " + Default",
                    Run = function()
                        method(humanoid, description)
                    end
                }
            }

            for _, variant in ipairs(variants) do
                local callOk, packed = Wear.WithRobloxIdentity(variant.Run)
                if callOk then
                    pcall(function() humanoid:BuildRigFromAttachments() end)
                    for _ = 1, 2 do RunService.Heartbeat:Wait() end

                    local readOk, applied = pcall(function() return humanoid:GetAppliedDescription() end)
                    local descriptionVerified = readOk and Wear.DescriptionContains(applied, slot, selectedItems)
                    local visibleVerified = Wear.CharacterSlotLooksApplied(humanoid.Parent, slot, selectedItems)
                    if applied and applied ~= description then
                        pcall(function() applied:Destroy() end)
                    end

                    local verified = descriptionVerified and visibleVerified
                    Wear.Debug(
                        variant.Name,
                        verified,
                        verified and "description + visible avatar verified"
                            or "method returned but the avatar did not visibly attach the requested item"
                    )
                    if verified then return true, variant.Name end
                else
                    Wear.Debug(variant.Name, false, packed)
                end
            end

            return false
        end

        function Wear.TryDeprecatedDescriptionMethod(humanoid, description, slot, selectedItems, methodName, resetMode)
            local method = resetMode and humanoid.ApplyDescriptionReset or humanoid.ApplyDescription
            if typeof(method) ~= "function" then
                Wear.Debug(methodName, false, "method unavailable")
                return false
            end

            local variants = {
                {
                    Name = methodName .. " + ClientOnly",
                    Run = function()
                        method(humanoid, description, Enum.AssetTypeVerification.ClientOnly)
                    end
                },
                {
                    Name = methodName .. " + Default",
                    Run = function()
                        method(humanoid, description)
                    end
                }
            }

            for _, variant in ipairs(variants) do
                local callOk, packed = Wear.WithRobloxIdentity(variant.Run)
                if callOk then
                    pcall(function() humanoid:BuildRigFromAttachments() end)
                    for _ = 1, 2 do RunService.Heartbeat:Wait() end

                    local readOk, applied = pcall(function() return humanoid:GetAppliedDescription() end)
                    local descriptionVerified = readOk and Wear.DescriptionContains(applied, slot, selectedItems)
                    local visibleVerified = Wear.CharacterSlotLooksApplied(humanoid.Parent, slot, selectedItems)
                    if applied and applied ~= description then
                        pcall(function() applied:Destroy() end)
                    end

                    local verified = descriptionVerified and visibleVerified
                    Wear.Debug(
                        variant.Name,
                        verified,
                        verified and "description + visible avatar verified"
                            or "method returned but visible verification failed"
                    )
                    if verified then return true, variant.Name end
                else
                    Wear.Debug(variant.Name, false, packed)
                end
            end

            return false
        end

        function Wear.TryDescription(character, humanoid, slot, selectedItems)
            local description, buildError = Wear.BuildDescription(character, humanoid, slot, selectedItems)
            if not description then
                Wear.Debug("HumanoidDescription.Build", false, buildError)
                return false
            end

            local attempts = {
                {"HumanoidDescription.ApplyAsync", false, false},
                {"HumanoidDescription.ResetAsync", true, false},
                {"HumanoidDescription.Apply", false, true},
                {"HumanoidDescription.Reset", true, true}
            }

            for _, attempt in ipairs(attempts) do
                local methodName, resetMode, deprecatedMode = attempt[1], attempt[2], attempt[3]
                local worked, workedMethod
                if deprecatedMode then
                    worked, workedMethod = Wear.TryDeprecatedDescriptionMethod(
                        humanoid, description, slot, selectedItems, methodName, resetMode
                    )
                else
                    worked, workedMethod = Wear.TryDescriptionMethod(
                        humanoid, description, slot, selectedItems, methodName, resetMode
                    )
                end
                if worked then
                    pcall(function() description:Destroy() end)
                    return true, workedMethod or methodName
                end
            end

            pcall(function() description:Destroy() end)
            return false
        end

        function Wear.LoadBy(loader, assetId)
            local ok, result = pcall(loader.Run, assetId)
            if not ok or not result then
                Wear.Debug(loader.Name, false, result)
                return nil
            end
            return result
        end

        function Wear.TryDirectItem(item, character, slot)
            for _, loader in ipairs(Wear.AssetLoaders) do
                local loaded = Wear.LoadBy(loader, item.Id)
                if loaded then
                    local roots = getLoadedRoots(loaded)
                    local worked = false
                    local methodSuffix = "Klassic Instance"

                    if slot == "Gear" then
                        local humanoid = getHumanoid(character)
                        local tool = Wear.CloneFirstClass(roots, "Tool")
                        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                        if tool and humanoid then
                            tool:SetAttribute("LHAvatarItemId", item.Id)
                            tool:SetAttribute("LHAvatarSlot", slot)
                            tool:SetAttribute("LHAvatarKreator", true)
                            tool.Parent = backpack or character
                            pcall(function() humanoid:EquipTool(tool) end)
                            RunService.Heartbeat:Wait()
                            worked = tool.Parent == character or tool.Parent == backpack
                        end
                        methodSuffix = "Gear Tool"
                    elseif slot == "ClassicTShirt" or slot == "ClassicShirt" or slot == "ClassicPants" then
                        local className = slot == "ClassicTShirt" and "ShirtGraphic" or (slot == "ClassicShirt" and "Shirt" or "Pants")
                        local clothing = Wear.CloneFirstClass(roots, className)
                        if clothing then
                            clothing:SetAttribute("LHAvatarItemId", item.Id)
                            clothing:SetAttribute("LHAvatarSlot", slot)
                            clothing:SetAttribute("LHAvatarKreator", true)
                            clothing.Parent = character
                            worked = clothing.Parent == character
                        end
                    elseif slot == "FaceDecal" then
                        local head = character:FindFirstChild("Head")
                        local decal
                        for _, root in ipairs(roots) do
                            for _, instance in ipairs(Wear.DescendantsIncludingRoot(root)) do
                                if instance:IsA("Decal") and instance.Texture ~= "" then
                                    decal = instance:Clone()
                                    break
                                end
                            end
                            if decal then break end
                        end
                        if head and decal then
                            decal.Name = "face"
                            decal.Face = Enum.NormalId.Front
                            decal:SetAttribute("LHAvatarItemId", item.Id)
                            decal:SetAttribute("LHAvatarSlot", slot)
                            decal:SetAttribute("LHAvatarKreator", true)
                            decal.Parent = head
                            worked = decal.Parent == head
                        end
                        methodSuffix = "Face Decal"
                    else
                        local humanoid = getHumanoid(character)
                        local accessories = Wear.CloneAccessories(roots)
                        if humanoid and #accessories > 0 then
                            worked = true
                            local attachMethods = {}
                            for _, accessory in ipairs(accessories) do
                                prepareAccessory(accessory, item, slot)
                                local attached, attachMethod, attachError = attachAccessory(
                                    humanoid, character, accessory
                                )
                                if not attached then
                                    worked = false
                                    Wear.Debug(
                                        loader.Name .. " + " .. tostring(attachMethod),
                                        false,
                                        attachError or "Accessory was parented but not welded to the character."
                                    )
                                    pcall(function() accessory:Destroy() end)
                                    break
                                end
                                attachMethods[#attachMethods + 1] = attachMethod
                            end

                            if worked then
                                methodSuffix = attachMethods[1] or "Verified Accessory"
                                for index = 2, #attachMethods do
                                    if attachMethods[index] ~= methodSuffix then
                                        methodSuffix = "Mixed Verified Accessory Methods"
                                        break
                                    end
                                end
                            end
                        end
                    end

                    destroyLoadedResult(loaded)
                    local methodName = loader.Name .. " + " .. methodSuffix
                    Wear.Debug(
                        methodName,
                        worked,
                        worked and "wearable instance verified on avatar"
                            or "asset loaded but no verified avatar attachment/weld was created"
                    )
                    if worked then return true, methodName end
                end
            end
            return false
        end

        function Wear.TryDirectSlot(character, slot, selectedItems)
            local accessorySelection = #selectedItems > 0 and Wear.IsAccessoryItem(selectedItems[1])

            if #selectedItems == 0 then
                restoreOriginalSlot(character, slot)
                Wear.Debug("Original Slot Snapshot", true, tostring(slot) .. " restored")
                return true, "Original Slot Snapshot"
            end

            if state.ItemStacking and accessorySelection then
                restoreOriginalSlot(character, slot)
            else
                destroySlotInstances(character, slot)
            end

            local methods = {}
            for _, item in ipairs(selectedItems) do
                local ok, methodName = Wear.TryDirectItem(item, character, slot)
                if not ok then
                    restoreOriginalSlot(character, slot)
                    Wear.Debug("Direct Slot Rollback", false, "restored original after fallback failure")
                    return false
                end
                methods[#methods + 1] = methodName
            end

            local firstMethod = methods[1] or "Direct Wear"
            for index = 2, #methods do
                if methods[index] ~= firstMethod then
                    firstMethod = "Mixed Direct Methods"
                    break
                end
            end
            return true, firstMethod
        end

        function Wear.ApplySlotSelection(slot, selectedItems)
            local character = getCharacter()
            local humanoid = character and getHumanoid(character)
            if not character or not humanoid then
                return false, nil, "Character/Humanoid unavailable."
            end

            captureOriginalSlot(character, slot)
            Wear.GetOriginalDescription(character, humanoid)

            local directOk, directMethod = Wear.TryDirectSlot(character, slot, selectedItems)
            if directOk then
                if state.ItemStacking and Wear.IsAccessoryItem(selectedItems[1]) then
                    return true, "Item Stacking + " .. tostring(directMethod)
                end
                return true, directMethod
            end

            return false, nil, "This item kould not be applied to your avatar."
        end

        local function countEquipped()
            local count = 0
            for slot in pairs(state.EquippedBySlot) do
                count = count + #Wear.GetSlotItems(slot)
            end
            return count
        end

        local function updateOutfitButton()
            -- The Outfit page now shows the complete kurrent avatar, not only LH-added items.
            OutfitButton.Text = "Outfit"
        end

        local function internalWearItem(item, silent)
            if state.Destroyed then return false end
            if not Wear.ResolveMissingAssetType(item) then
                if not silent then notify("This asset type is not supported by the local avatar tester.", "error", 4) end
                return false
            end

            local slot = ASSET_TYPE_TO_SLOT[item.AssetTypeId]
            if not slot then
                if not silent then notify("This item does not have a supported avatar slot.", "error") end
                return false
            end

            local selected = Wear.CopyItems(Wear.GetSlotItems(slot))
            local accessoryItem = Wear.IsAccessoryItem(item)
            if state.ItemStacking and accessoryItem then
                selected[#selected + 1] = item
            else
                selected = {item}
            end

            local ok, methodName, errorMessage = Wear.ApplySlotSelection(slot, selected)
            if not ok then
                if not silent then notify(errorMessage or "The item kould not be worn locally.", "error", 5) end
                return false
            end

            state.EquippedBySlot[slot] = selected
            if state.ViewerHiddenAssetIds then
                state.ViewerHiddenAssetIds[tonumber(item.Id)] = nil
            end
            return true
        end

        local function removeItem(item, silent)
            if not item or not Wear.ResolveMissingAssetType(item) then return false end
            local slot = ASSET_TYPE_TO_SLOT[item.AssetTypeId]
            if not slot then return false end

            local selected = {}
            local removed = false
            for _, existing in ipairs(Wear.GetSlotItems(slot)) do
                if not removed and tonumber(existing.Id) == tonumber(item.Id) then
                    removed = true
                else
                    selected[#selected + 1] = existing
                end
            end
            if not removed then return false end

            local ok, methodName, errorMessage = Wear.ApplySlotSelection(slot, selected)
            if not ok then
                if not silent then notify(errorMessage or "The item kould not be taken off.", "error", 5) end
                return false
            end

            state.EquippedBySlot[slot] = #selected > 0 and selected or nil
            return true
        end

        local function removeSlot(slot, silent)
            local current = Wear.GetSlotItems(slot)
            if #current == 0 then return false end
            local ok, methodName, errorMessage = Wear.ApplySlotSelection(slot, {})
            if not ok then
                if not silent then notify(errorMessage or "The item type kould not be restored.", "error", 5) end
                return false
            end
            state.EquippedBySlot[slot] = nil
            return true
        end

        local refreshAllCardStates
        local rebuildOutfitList

        local function refreshSelectedUi()
            updateOutfitButton()
            if refreshAllCardStates then refreshAllCardStates() end
            if rebuildOutfitList and OutfitOverlay.Visible then rebuildOutfitList() end
            if state.Viewer and state.Viewer.Visible and state.Viewer.Refresh then
                state.Viewer:Refresh()
            end

            if state.DetailsItem then
                if Wear.IsEquipped(state.DetailsItem) then
                    DetailsTryButton.Text = "Take Off"
                    DetailsTryButton.BackgroundColor3 = Color3.fromRGB(79, 53, 64)
                else
                    DetailsTryButton.Text = "Try On"
                    DetailsTryButton.BackgroundColor3 = ACCENT
                end
            end
        end

        local function toggleItem(item)
            if state.Loading then return end
            if not Wear.ResolveMissingAssetType(item) then
                notify("This asset type is not supported.", "error")
                return
            end

            if Wear.IsEquipped(item) then
                if removeItem(item, false) then refreshSelectedUi() end
                return
            end

            task.spawn(function()
                if internalWearItem(item, false) then refreshSelectedUi() end
            end)
        end

        local function resetAllItems(silent)
            local character = getCharacter()
            local humanoid = character and getHumanoid(character)
            local restored = false
            if character and humanoid then
                local original = state.OriginalDescriptionByCharacter[character]
                if original then
                    local cloneOk, clone = pcall(function() return original:Clone() end)
                    local description = cloneOk and clone or original
                    local asyncMethod = humanoid.ApplyDescriptionResetAsync or humanoid.ApplyDescriptionAsync
                    if typeof(asyncMethod) == "function" then
                        for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                            local ok = Wear.WithRobloxIdentity(function()
                                asyncMethod(humanoid, description, verification)
                            end)
                            if ok == true then restored = true; break end
                        end
                    end
                    if not restored then
                        local syncMethod = humanoid.ApplyDescriptionReset or humanoid.ApplyDescription
                        if typeof(syncMethod) == "function" then
                            for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                                local ok = Wear.WithRobloxIdentity(function()
                                    syncMethod(humanoid, description, verification)
                                end)
                                if ok == true then restored = true; break end
                            end
                        end
                    end
                    if cloneOk and clone then pcall(function() clone:Destroy() end) end
                end
            end
            if not restored then
                local slots, seen = {}, {}
                for slot in pairs(state.EquippedBySlot) do seen[slot] = true; slots[#slots + 1] = slot end
                for slot in pairs(state.ViewerModifiedSlots or {}) do
                    if not seen[slot] then seen[slot] = true; slots[#slots + 1] = slot end
                end
                for _, slot in ipairs(slots) do
                    if state.EquippedBySlot[slot] then removeSlot(slot, true) else Wear.ApplySlotSelection(slot, {}) end
                end
            end
            state.EquippedBySlot = {}
            state.ViewerModifiedSlots = {}
            state.ViewerHiddenAssetIds = {}
            if humanoid then pcall(function() humanoid:BuildRigFromAttachments() end) end
            refreshSelectedUi()
        end

        local function formatPrice(item)
            if item.Price ~= nil then
                if item.Price <= 0 then
                    return "Free"
                end
                return tostring(math.floor(item.Price)) .. " R$"
            end

            if item.PriceStatus then
                local text = tostring(item.PriceStatus)
                if containsPlain(text, "off") then
                    return "Off Sale"
                end
                return text
            end

            return "Price N/A"
        end

        state.Purchase = {}

        function state.Purchase:IsSaleable(item)
            if not item or not tonumber(item.Id) then return false, "Invalid item." end
            local info = getProductInfo(item.Id)
            if info then
                if info.IsForSale == false then return false, "This item is off sale." end
                if info.PriceInRobux ~= nil then item.Price = tonumber(info.PriceInRobux) end
            end
            if item.PriceStatus and containsPlain(tostring(item.PriceStatus), "off") then
                return false, "This item is off sale."
            end
            return true
        end

        function state.Purchase:Owns(assetId)
            assetId = tonumber(assetId)
            if not assetId then return nil, "invalid asset id" end
            local ok, result = pcall(
                MarketplaceService.PlayerOwnsAssetAsync,
                MarketplaceService,
                LocalPlayer,
                assetId
            )
            if ok then return result == true end
            return nil, result
        end

        function state.Purchase:CallAsNormalClient(callback)
            if type(callback) ~= "function" then return false, "invalid purchase callback" end

            local setter = getGlobal("setthreadidentity")
                or getGlobal("set_thread_identity")
                or getGlobal("setidentity")
            local getter = getGlobal("getthreadidentity")
                or getGlobal("get_thread_identity")
                or getGlobal("getidentity")

            local previous
            if typeof(getter) == "function" then
                pcall(function() previous = getter() end)
            end

            -- Roblox documents PromptPurchase as callable by a LocalScript.
            -- Identity 2 is the normal client LocalScript context. This is a
            -- compatibility normalization, not a privileged purchase bypass.
            if typeof(setter) == "function" then
                pcall(setter, 2)
            end

            local ok, err = pcall(callback)

            if typeof(setter) == "function" and previous ~= nil then
                pcall(setter, previous)
            end
            return ok, err
        end

        function state.Purchase:PromptSingleRaw(item)
            if not item or not tonumber(item.Id) then return false, "invalid asset id" end
            local saleable, saleError = self:IsSaleable(item)
            if not saleable then return false, saleError end

            local owns = self:Owns(item.Id)
            if owns == true then return false, "owned" end

            local ok, err = self:CallAsNormalClient(function()
                MarketplaceService:PromptPurchase(LocalPlayer, tonumber(item.Id), false)
            end)
            if ok then return true end

            local message = tostring(err or "Roblox could not open the purchase prompt.")
            local lowered = string.lower(message)
            if string.find(lowered, "blocked", 1, true)
                or string.find(lowered, "current thread cannot call", 1, true)
                or string.find(lowered, "lacking capability", 1, true) then
                return false, "Your executor does not allow Roblox purchase prompts here."
            end
            return false, message
        end

        function state.Purchase:Prompt(item)
            task.spawn(function()
                local ok, why = self:PromptSingleRaw(item)
                if not ok then
                    if why == "owned" then
                        LULA:ShowIsland(
                            "Already Owned",
                            tostring(item.Name or "This item") .. " is already in your inventory.",
                            {Duration = 2.6}
                        )
                    else
                        notify(tostring(why or "Roblox could not open the purchase prompt."), "error", 4)
                    end
                end
            end)
        end

        function state.Purchase:PrepareMany(items)
            local eligible, seen = {}, {}
            for _, item in ipairs(items or {}) do
                local id = tonumber(item and item.Id)
                if id and not seen[id] then
                    seen[id] = true
                    local saleable = self:IsSaleable(item)
                    local owns = self:Owns(id)
                    if saleable and owns ~= true then eligible[#eligible + 1] = item end
                end
            end
            return eligible
        end

        function state.Purchase:PromptSequential(items)
            for _, item in ipairs(items or {}) do
                if state.Destroyed then return end
                local id = tonumber(item.Id)
                local finished = false
                local connection

                local connectOk = pcall(function()
                    connection = MarketplaceService.PromptPurchaseFinished:Connect(function(player, assetId)
                        if player == LocalPlayer and tonumber(assetId) == id then
                            finished = true
                        end
                    end)
                end)

                local ok, why = self:PromptSingleRaw(item)
                if not ok then
                    if connection and connection.Connected then connection:Disconnect() end
                    if why ~= "owned" then
                        warn("[Avatar Kreator][Buy All] " .. tostring(item.Name) .. ": " .. tostring(why))
                        notify(tostring(why), "error", 4)
                        return
                    end
                else
                    if connectOk and connection then
                        local deadline = os.clock() + 60
                        while not finished and os.clock() < deadline and not state.Destroyed do
                            task.wait(0.1)
                        end
                        if connection and connection.Connected then connection:Disconnect() end
                    else
                        -- If the close event itself is unavailable, leave enough time
                        -- for the purchase sheet to be used before prompting another.
                        task.wait(2.5)
                    end
                end
            end
        end

        function state.Purchase:PromptMany(items)
            task.spawn(function()
                local eligible = self:PrepareMany(items)
                if #eligible == 0 then
                    LULA:ShowIsland(
                        "Buy All",
                        "Every available item is already owned or off sale.",
                        {Duration = 2.8}
                    )
                    return
                end

                -- PromptBulkPurchase is documented as server-script only.
                -- LH is universal/client-side, so sequential PromptPurchase is
                -- the supported purchase path available to this injected UI.
                self:PromptSequential(eligible)
            end)
        end

        function state.Purchase:ConfirmMany(items, title)
            local count = 0
            local seen = {}
            for _, item in ipairs(items or {}) do
                local id = tonumber(item and item.Id)
                if id and not seen[id] then seen[id] = true; count = count + 1 end
            end
            if count <= 0 then
                LULA:ShowIsland("Buy All", "There are no katalog items to buy.", {Duration = 2.3})
                return
            end
            LULA:Confirm(
                title or "Buy All?",
                "Open Roblox purchase prompt(s) for up to "
                    .. tostring(count)
                    .. " outfit item(s)? You still approve every purchase through Roblox.",
                function() self:PromptMany(items) end
            )
        end

        state.GetCurrentWornItems = function()
            local byId, order = {}, {}

            local function add(assetId, metadata)
                assetId = tonumber(assetId)
                if not assetId or assetId <= 0 then return end
                if state.ViewerHiddenAssetIds and state.ViewerHiddenAssetIds[assetId] then return end

                local item = byId[assetId]
                if not item then
                    item = itemFromProductInfo(assetId)
                    if not item then return end
                    byId[assetId] = item
                    order[#order + 1] = assetId
                end

                if type(metadata) == "table" then
                    for key, value in pairs(metadata) do
                        if value ~= nil and item[key] == nil then
                            item[key] = value
                        end
                    end
                end
            end

            local character = getCharacter()
            local humanoid = character and getHumanoid(character)

            -- Read the actual live character first. This gives Take Off an
            -- exact Instance reference instead of trusting description data.
            if character then
                for _, object in ipairs(character:GetDescendants()) do
                    if object:IsA("Accessory") then
                        local sourceId
                        pcall(function() sourceId = tonumber(object.SourceAssetId) end)
                        local id = tonumber(object:GetAttribute("LHAvatarItemId")) or sourceId
                        if id and id > 0 then
                            add(id, {
                                LiveInstance = object,
                                LiveSource = "Accessory",
                                LiveSlot = slotForAccessory(object)
                            })
                        end
                    elseif object:IsA("Shirt")
                        or object:IsA("Pants")
                        or object:IsA("ShirtGraphic") then
                        local id = tonumber(object:GetAttribute("LHAvatarItemId"))
                        if id and id > 0 then
                            add(id, {
                                LiveInstance = object,
                                LiveSource = object.ClassName
                            })
                        end
                    end
                end
            end

            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, object in ipairs(backpack:GetChildren()) do
                    if object:IsA("Tool") then
                        local id = tonumber(object:GetAttribute("LHAvatarItemId"))
                        if id and id > 0 then
                            add(id, {
                                LiveInstance = object,
                                LiveSource = "Gear",
                                LiveSlot = "Gear"
                            })
                        end
                    end
                end
            end

            -- Merge HumanoidDescription IDs. This fills in classic clothing,
            -- faces, and accessories whose live instances don't expose a
            -- useful SourceAssetId on the client.
            if humanoid then
                local ok, description = pcall(function()
                    return humanoid:GetAppliedDescription()
                end)
                if ok and description then
                    local propertyMap = {
                        GraphicTShirt = "ClassicTShirt",
                        Shirt = "ClassicShirt",
                        Pants = "ClassicPants",
                        Face = "FaceDecal"
                    }
                    for property, slot in pairs(propertyMap) do
                        local id
                        pcall(function() id = tonumber(description[property]) end)
                        -- A locally replaced slot can leave the old ID inside
                        -- GetAppliedDescription. Do not show that stale item.
                        if id and id > 0 and not state.EquippedBySlot[slot] then
                            add(id, {
                                DescriptionProperty = property,
                                LiveSlot = slot
                            })
                        end
                    end

                    local accessoriesOk, accessories = pcall(function()
                        return description:GetAccessories(true)
                    end)
                    if accessoriesOk and type(accessories) == "table" then
                        for _, record in ipairs(accessories) do
                            local id = tonumber(record.AssetId)
                            local accessoryName = record.AccessoryType and record.AccessoryType.Name or ""
                            local slot = ACCESSORY_NAME_TO_SLOT[accessoryName]
                            -- Same stale-description protection as klassic
                            -- klothing: the live LH replacement is the truth.
                            if id and id > 0 and not (slot and state.EquippedBySlot[slot]) then
                                add(id, {
                                    DescriptionAccessory = true,
                                    DescriptionAccessoryType = record.AccessoryType,
                                    LiveSlot = slot
                                })
                            end
                        end
                    end
                    pcall(function() description:Destroy() end)
                end
            end

            -- Always merge LH-selected items too.
            for slot in pairs(state.EquippedBySlot) do
                for _, item in ipairs(Wear.GetSlotItems(slot)) do
                    add(item.Id, {
                        LHSelected = true,
                        LiveSlot = slot
                    })
                end
            end

            local items = {}
            for _, assetId in ipairs(order) do
                if byId[assetId] then items[#items + 1] = byId[assetId] end
            end
            table.sort(items, function(a, b)
                local ta = tostring(a.AssetTypeName or "")
                local tb = tostring(b.AssetTypeName or "")
                if ta == tb then return tostring(a.Name) < tostring(b.Name) end
                return ta < tb
            end)
            return items
        end

        state.GetCurrentWornAssetIds = function()
            local ids = {}
            for _, item in ipairs(state.GetCurrentWornItems()) do
                if item and tonumber(item.Id) then ids[#ids + 1] = tonumber(item.Id) end
            end
            return ids
        end

        state.DescriptionNumberProperties = {
            "GraphicTShirt", "Shirt", "Pants", "Face", "Head", "Torso",
            "LeftArm", "RightArm", "LeftLeg", "RightLeg",
            "ClimbAnimation", "FallAnimation", "IdleAnimation", "JumpAnimation",
            "MoodAnimation", "RunAnimation", "SwimAnimation", "WalkAnimation",
            "HeightScale", "WidthScale", "DepthScale", "HeadScale",
            "BodyTypeScale", "ProportionScale"
        }
        state.DescriptionColorProperties = {
            "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor"
        }

        state.SerializeDescription = function(description)
            if typeof(description) ~= "Instance" or not description:IsA("HumanoidDescription") then return nil end
            local data = {Properties = {}, Colors = {}, Accessories = {}}
            for _, propertyName in ipairs(state.DescriptionNumberProperties) do
                pcall(function()
                    local value = description[propertyName]
                    if type(value) == "number" then data.Properties[propertyName] = value end
                end)
            end
            for _, propertyName in ipairs(state.DescriptionColorProperties) do
                pcall(function()
                    local value = description[propertyName]
                    if typeof(value) == "Color3" then
                        data.Colors[propertyName] = {R = value.R, G = value.G, B = value.B}
                    end
                end)
            end
            local ok, accessories = pcall(function() return description:GetAccessories(true) end)
            if ok and type(accessories) == "table" then
                for _, record in ipairs(accessories) do
                    local assetId = tonumber(record.AssetId)
                    if assetId and assetId > 0 then
                        data.Accessories[#data.Accessories + 1] = {
                            AssetId = assetId,
                            AccessoryType = record.AccessoryType and record.AccessoryType.Name or tostring(record.AccessoryType or ""),
                            IsLayered = record.IsLayered == true,
                            Order = tonumber(record.Order) or 1,
                            Puffiness = tonumber(record.Puffiness)
                        }
                    end
                end
            end
            return data
        end

        state.DeserializeDescription = function(data)
            if type(data) ~= "table" then return nil end
            local description = Instance.new("HumanoidDescription")
            for propertyName, value in pairs(type(data.Properties) == "table" and data.Properties or {}) do
                pcall(function() description[propertyName] = tonumber(value) or value end)
            end
            for propertyName, color in pairs(type(data.Colors) == "table" and data.Colors or {}) do
                if type(color) == "table" then
                    pcall(function()
                        description[propertyName] = Color3.new(
                            math.clamp(tonumber(color.R) or 0, 0, 1),
                            math.clamp(tonumber(color.G) or 0, 0, 1),
                            math.clamp(tonumber(color.B) or 0, 0, 1)
                        )
                    end)
                end
            end
            local accessories = {}
            for _, record in ipairs(type(data.Accessories) == "table" and data.Accessories or {}) do
                local accessoryType = Enum.AccessoryType[tostring(record.AccessoryType or "")]
                local assetId = tonumber(record.AssetId)
                if accessoryType and assetId then
                    accessories[#accessories + 1] = {
                        AssetId = assetId,
                        AccessoryType = accessoryType,
                        IsLayered = record.IsLayered == true,
                        Order = tonumber(record.Order) or (#accessories + 1),
                        Puffiness = tonumber(record.Puffiness)
                    }
                end
            end
            pcall(function() description:SetAccessories(accessories, true) end)
            return description
        end

        state.CaptureCurrentDescriptionData = function(currentItems)
            local character = getCharacter()
            local humanoid = character and getHumanoid(character)
            if not humanoid then return nil end
            local ok, description = pcall(function() return humanoid:GetAppliedDescription() end)
            if not ok or not description then return nil end
            local data = state.SerializeDescription(description)
            pcall(function() description:Destroy() end)
            if type(data) ~= "table" then return nil end
            pcall(function() data.RigType = humanoid.RigType.Name end)

            -- Reconcile the description snapshot with the ACTUAL local avatar.
            -- Direct Try On can change live accessories without Roblox updating
            -- GetAppliedDescription immediately.
            local liveItems = type(currentItems) == "table" and currentItems or state.GetCurrentWornItems()
            local wantedIds = {}
            local wantedBySlot = {}
            for _, item in ipairs(liveItems or {}) do
                local id = tonumber(item and item.Id)
                local slot = item and (item.LiveSlot or ASSET_TYPE_TO_SLOT[item.AssetTypeId])
                if id then
                    wantedIds[id] = true
                    if slot then
                        wantedBySlot[slot] = wantedBySlot[slot] or {}
                        wantedBySlot[slot][#wantedBySlot[slot] + 1] = item
                    end
                end
            end

            local rebuilt = {}
            for _, record in ipairs(data.Accessories or {}) do
                local slot = ACCESSORY_NAME_TO_SLOT[tostring(record.AccessoryType or "")]
                if wantedIds[tonumber(record.AssetId)] and not (slot and wantedBySlot[slot]) then
                    rebuilt[#rebuilt + 1] = record
                elseif wantedIds[tonumber(record.AssetId)] and slot and wantedBySlot[slot] then
                    -- Keep only records still present in the actual outfit. The
                    -- slot is rebuilt below to include direct LH accessories too.
                end
            end

            for slot, items in pairs(wantedBySlot) do
                local propertyName = Wear.GetDescriptionProperty(slot)
                if propertyName then
                    local chosen = items[#items]
                    if chosen and tonumber(chosen.Id) then data.Properties[propertyName] = tonumber(chosen.Id) end
                else
                    for order, item in ipairs(items) do
                        local accessoryType = ASSET_TYPE_TO_ACCESSORY_TYPE[item.AssetTypeId]
                        if accessoryType and tonumber(item.Id) then
                            rebuilt[#rebuilt + 1] = {
                                AssetId = tonumber(item.Id),
                                AccessoryType = accessoryType.Name,
                                IsLayered = tonumber(item.AssetTypeId) and tonumber(item.AssetTypeId) >= 64 or false,
                                Order = order
                            }
                        end
                    end
                end
            end
            data.Accessories = rebuilt
            return data
        end

        state.ApplyDescriptionData = function(data)
            local character = getCharacter()
            local humanoid = character and getHumanoid(character)
            local description = state.DeserializeDescription(data)
            if not character or not humanoid or not description then return false end
            Wear.GetOriginalDescription(character, humanoid)
            local applied = false
            local asyncMethod = humanoid.ApplyDescriptionResetAsync or humanoid.ApplyDescriptionAsync
            if typeof(asyncMethod) == "function" then
                for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                    local ok = Wear.WithRobloxIdentity(function()
                        asyncMethod(humanoid, description, verification)
                    end)
                    if ok == true then applied = true; break end
                end
            end
            if not applied then
                local syncMethod = humanoid.ApplyDescriptionReset or humanoid.ApplyDescription
                if typeof(syncMethod) == "function" then
                    for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                        local ok = Wear.WithRobloxIdentity(function()
                            syncMethod(humanoid, description, verification)
                        end)
                        if ok == true then applied = true; break end
                    end
                end
            end
            if applied then
                pcall(function() humanoid:BuildRigFromAttachments() end)
                for _ = 1, 2 do RunService.Heartbeat:Wait() end
            end
            pcall(function() description:Destroy() end)
            return applied
        end

        state.MakeSavedOutfitViewport = function(parent, descriptionData, fallbackItem)
            local viewport = create("ViewportFrame", {
                Position = UDim2.fromOffset(6, 6),
                Size = UDim2.new(1, -12, 0, 76),
                BackgroundColor3 = PANEL_2,
                BorderSizePixel = 0,
                Ambient = Color3.fromRGB(205, 205, 218),
                LightColor = Color3.fromRGB(255, 255, 255),
                LightDirection = Vector3.new(-1, -1, -1),
                ZIndex = 53
            })
            addCorner(viewport, 8)
            viewport.Parent = parent

            local fallback = create("ImageLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Image = fallbackItem and tonumber(fallbackItem.Id) and thumbnailFor(fallbackItem.Id) or "",
                ImageTransparency = fallbackItem and 0.12 or 1,
                ScaleType = Enum.ScaleType.Fit,
                ZIndex = 53
            })
            fallback.Parent = viewport

            local loading = create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Font = Enum.Font.GothamMedium,
                Text = "Loading avatar...",
                TextColor3 = MUTED,
                TextSize = 7.5,
                ZIndex = 54
            })
            loading.Parent = viewport

            local world = Instance.new("WorldModel")
            world.Parent = viewport
            local camera = Instance.new("Camera")
            camera.FieldOfView = 32
            camera.Parent = viewport
            viewport.CurrentCamera = camera

            task.spawn(function()
                local description = state.DeserializeDescription(descriptionData)
                if not description or not viewport.Parent then
                    loading.Text = fallback.Image ~= "" and "" or "Preview unavailable"
                    return
                end

                local rig
                local rigType = Enum.HumanoidRigType[tostring(descriptionData.RigType or "")] or Enum.HumanoidRigType.R15
                local asyncCreator = Players.CreateHumanoidModelFromDescriptionAsync
                local syncCreator = Players.CreateHumanoidModelFromDescription

                if typeof(asyncCreator) == "function" then
                    for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                        local ok, result = pcall(asyncCreator, Players, description, rigType, verification)
                        if ok and typeof(result) == "Instance" then rig = result; break end
                    end
                end
                if not rig and typeof(syncCreator) == "function" then
                    for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                        local ok, result = pcall(syncCreator, Players, description, rigType, verification)
                        if ok and typeof(result) == "Instance" then rig = result; break end
                    end
                    if not rig then
                        local ok, result = pcall(syncCreator, Players, description, rigType)
                        if ok and typeof(result) == "Instance" then rig = result end
                    end
                end
                pcall(function() description:Destroy() end)

                if typeof(rig) ~= "Instance" or not rig:IsA("Model") or not viewport.Parent then
                    if rig then pcall(function() rig:Destroy() end) end
                    loading.Text = fallback.Image ~= "" and "" or "Preview unavailable"
                    return
                end

                for _, object in ipairs(rig:GetDescendants()) do
                    if object:IsA("Script") or object:IsA("LocalScript") or object:IsA("Tool") then
                        object:Destroy()
                    elseif object:IsA("BasePart") then
                        object.Anchored = true
                        object.CanCollide = false
                        object.CanTouch = false
                    end
                end
                rig.Parent = world
                pcall(function() rig:PivotTo(CFrame.new()) end)

                local bodyMin, bodyMax
                for _, object in ipairs(rig:GetDescendants()) do
                    if object:IsA("BasePart")
                        and not object:FindFirstAncestorOfClass("Accessory")
                        and not object:FindFirstAncestorOfClass("Tool") then
                        local half = object.Size * 0.5
                        local p = object.Position
                        local lo, hi = p - half, p + half
                        bodyMin = bodyMin and Vector3.new(
                            math.min(bodyMin.X, lo.X), math.min(bodyMin.Y, lo.Y), math.min(bodyMin.Z, lo.Z)
                        ) or lo
                        bodyMax = bodyMax and Vector3.new(
                            math.max(bodyMax.X, hi.X), math.max(bodyMax.Y, hi.Y), math.max(bodyMax.Z, hi.Z)
                        ) or hi
                    end
                end
                local boxCFrame, boxSize = rig:GetBoundingBox()
                local focus, bodySize
                if bodyMin and bodyMax then
                    bodySize = bodyMax - bodyMin
                    focus = (bodyMin + bodyMax) * 0.5
                else
                    bodySize = boxSize
                    focus = boxCFrame.Position
                end
                bodySize = Vector3.new(
                    math.clamp(bodySize.X, 2.5, 8),
                    math.clamp(bodySize.Y, 4.5, 9),
                    math.clamp(bodySize.Z, 1.5, 6)
                )
                local halfFov = math.rad(camera.FieldOfView * 0.5)
                local distance = math.max(5.8, (bodySize.Y * 0.62) / math.max(0.05, math.tan(halfFov)))
                camera.CFrame = CFrame.lookAt(
                    focus + Vector3.new(0, bodySize.Y * 0.01, -distance),
                    focus + Vector3.new(0, bodySize.Y * 0.03, 0),
                    Vector3.new(0, 1, 0)
                )
                fallback.Visible = false
                loading.Visible = false
            end)
            return viewport
        end

        state.GetSavedOutfits = function()
            local output = {}
            for index, raw in ipairs(settings.AvatarKreatorSavedOutfits or {}) do
                if type(raw) == "table" and type(raw.Items) == "table" then
                    local items = {}
                    for _, rawItem in ipairs(raw.Items) do
                        local item = normalizeCatalogItem(rawItem)
                        if item then items[#items + 1] = item end
                    end
                    local descriptionData = type(raw.Description) == "table" and raw.Description or nil
                    if not descriptionData and #items > 0 then
                        -- One-time kompatibility for outfits saved before v10.3.2.
                        -- Their item list is used to build the new avatar preview/apply snapshot.
                        descriptionData = state.CaptureCurrentDescriptionData(items)
                    end
                    output[#output + 1] = {
                        Name = tostring(raw.Name or ("Outfit " .. tostring(index))),
                        SavedAt = tonumber(raw.SavedAt) or 0,
                        Items = items,
                        Description = descriptionData
                    }
                end
            end
            return output
        end

        state.PersistSavedOutfits = function(outfits)
            local clean = {}
            for index, outfit in ipairs(outfits or {}) do
                if type(outfit) == "table" and type(outfit.Items) == "table" then
                    local items = {}
                    for _, item in ipairs(outfit.Items) do
                        if item and tonumber(item.Id) then items[#items + 1] = favoriteSerializable(item) end
                    end
                    clean[#clean + 1] = {
                        Name = tostring(outfit.Name or ("Outfit " .. tostring(index))),
                        SavedAt = tonumber(outfit.SavedAt) or os.time(),
                        Items = items,
                        Description = type(outfit.Description) == "table" and outfit.Description or nil
                    }
                end
            end
            settings.AvatarKreatorSavedOutfits = clean
            if type(env.LHUISettings) == "table" then env.LHUISettings.AvatarKreatorSavedOutfits = clean end
            if type(env.LHSettings) == "table" then env.LHSettings.AvatarKreatorSavedOutfits = clean end
            markSettingsDirty()
            saveSettingsNow() -- independent autosave: Saved Outfits always persist.
        end

        state.SaveCurrentOutfit = function()
            local items = state.GetCurrentWornItems()
            if #items == 0 then
                notify("No katalog items were found on the kurrent avatar.", "warning", 3)
                return false
            end
            local descriptionData = state.CaptureCurrentDescriptionData(items)
            local outfits = state.GetSavedOutfits()
            outfits[#outfits + 1] = {
                Name = "Outfit " .. tostring(#outfits + 1),
                SavedAt = os.time(),
                Items = items,
                Description = descriptionData
            }
            state.PersistSavedOutfits(outfits)
            if state.RenderSavedOutfits then state.RenderSavedOutfits() end
            notify("Saved " .. tostring(#items) .. " avatar item(s) as Outfit " .. tostring(#outfits) .. ".", "success", 3)
            return true
        end

        state.WearSavedOutfit = function(outfit)
            if type(outfit) ~= "table" or type(outfit.Items) ~= "table" then return false end

            -- Apply the full saved appearance first when supported, then enforce every
            -- saved katalog item through Avatar Kreator's normal Try On path. This avoids
            -- executors reporting a successful description apply without visually changing the avatar.
            if type(outfit.Description) == "table" then pcall(state.ApplyDescriptionData, outfit.Description) end
            resetAllItems(true)
            task.wait()

            local previousStacking = state.ItemStacking
            state.ItemStacking = true
            local worn = 0
            for _, item in ipairs(outfit.Items) do
                local itemCopy = normalizeCatalogItem(item)
                if itemCopy then
                    pcall(Wear.ResolveMissingAssetType, itemCopy)
                    local ok = internalWearItem(itemCopy, true)
                    if ok then worn = worn + 1 end
                end
                task.wait()
            end
            state.ItemStacking = previousStacking
            state.ViewerHiddenAssetIds = {}
            refreshSelectedUi()
            if state.Viewer and state.Viewer.Refresh then pcall(function() state.Viewer:Refresh() end) end
            notify("Wore " .. tostring(worn) .. "/" .. tostring(#outfit.Items) .. " saved outfit item(s).", worn > 0 and "success" or "warning", 3)
            return worn > 0
        end

        state.RenderSavedOutfits = function()
            if not state.SavedOutfitsScroll then return end
            state.SavedOutfitRenderSerial = (state.SavedOutfitRenderSerial or 0) + 1
            for _, child in ipairs(state.SavedOutfitsScroll:GetChildren()) do
                if child:IsA("Frame") and child.Name == "SavedOutfitCard" then child:Destroy() end
            end
            local outfits = state.GetSavedOutfits()
            state.SavedOutfitsEmpty.Visible = #outfits == 0
            for index, outfit in ipairs(outfits) do
                local card = create("Frame", {
                    Name = "SavedOutfitCard",
                    BackgroundColor3 = PANEL,
                    BorderSizePixel = 0,
                    LayoutOrder = index,
                    ZIndex = 52
                })
                addCorner(card, 10)
                addStroke(card, STROKE, 1, 0.25)
                card.Parent = state.SavedOutfitsScroll

                if type(outfit.Description) == "table" then
                    state.MakeSavedOutfitViewport(card, outfit.Description, outfit.Items[1])
                else
                    local preview = create("ImageLabel", {
                        Position = UDim2.fromOffset(6, 6),
                        Size = UDim2.new(1, -12, 0, 76),
                        BackgroundColor3 = PANEL_2,
                        BorderSizePixel = 0,
                        Image = (#outfit.Items > 0 and thumbnailFor(outfit.Items[1].Id)) or "",
                        ScaleType = Enum.ScaleType.Fit,
                        ZIndex = 53
                    })
                    addCorner(preview, 8)
                    preview.Parent = card
                end

                local name = create("TextLabel", {
                    Position = UDim2.fromOffset(6, 85),
                    Size = UDim2.new(1, -12, 0, 18),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamBold,
                    Text = tostring(outfit.Name) .. " (" .. tostring(#outfit.Items) .. ")",
                    TextColor3 = TEXT,
                    TextSize = 8.2,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 53
                })
                name.Parent = card

                local wear = create("TextButton", {
                    Position = UDim2.fromOffset(6, 108),
                    Size = UDim2.new(0.58, -5, 0, 34),
                    BackgroundColor3 = ACCENT,
                    AutoButtonColor = false,
                    Font = Enum.Font.GothamBold,
                    Text = "Wear Outfit",
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 7.5,
                    ZIndex = 53
                })
                addCorner(wear, 7)
                wear.Parent = card
                bindButtonVisual(wear, ACCENT, ACCENT_HOVER)

                local remove = create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -6, 0, 108),
                    Size = UDim2.new(0.42, -5, 0, 34),
                    BackgroundColor3 = Color3.fromRGB(78, 38, 48),
                    AutoButtonColor = false,
                    Font = Enum.Font.GothamBold,
                    Text = "Remove Outfit",
                    TextColor3 = Color3.fromRGB(255, 189, 198),
                    TextSize = 6.6,
                    TextWrapped = true,
                    ZIndex = 53
                })
                addCorner(remove, 7)
                remove.Parent = card
                bindButtonVisual(remove, Color3.fromRGB(78, 38, 48), Color3.fromRGB(95, 44, 56))

                wear.MouseButton1Click:Connect(function()
                    task.spawn(function() state.WearSavedOutfit(outfit) end)
                end)
                remove.MouseButton1Click:Connect(function()
                    local current = state.GetSavedOutfits()
                    table.remove(current, index)
                    state.PersistSavedOutfits(current)
                    state.RenderSavedOutfits()
                end)
            end
            if state.ResizeSavedOutfitGrid then state.ResizeSavedOutfitGrid() end
        end

        function Wear.RemoveCurrentAsset(item)
            if not item or not Wear.ResolveMissingAssetType(item) then
                return false, "This item type cannot be removed locally."
            end

            local id = tonumber(item.Id)
            local slot = item.LiveSlot or ASSET_TYPE_TO_SLOT[item.AssetTypeId]
            local character = getCharacter()
            local humanoid = character and getHumanoid(character)
            if not id or not slot or not character or not humanoid then
                return false, "Character/Humanoid unavailable."
            end

            -- If LH equipped it, use the existing verified slot path.
            local selected = Wear.CopyItems(Wear.GetSlotItems(slot))
            local foundSelected = false
            local remaining = {}
            for _, existing in ipairs(selected) do
                if not foundSelected and tonumber(existing.Id) == id then
                    foundSelected = true
                else
                    remaining[#remaining + 1] = existing
                end
            end
            if foundSelected then
                local ok, _, err = Wear.ApplySlotSelection(slot, remaining)
                if ok then
                    state.EquippedBySlot[slot] = #remaining > 0 and remaining or nil
                    state.ViewerHiddenAssetIds[id] = true
                    return true
                end
                return false, err
            end

            captureOriginalSlot(character, slot)
            Wear.GetOriginalDescription(character, humanoid)

            local function markRemoved()
                state.ViewerModifiedSlots[slot] = true
                state.ViewerHiddenAssetIds[id] = true
            end

            -- Best route: remove the exact live instance recorded when the
            -- Kurrent Outfit / Viewer page was rendered.
            local live = item.LiveInstance
            if typeof(live) == "Instance" and live.Parent
                and (live:IsDescendantOf(character)
                    or (LocalPlayer:FindFirstChildOfClass("Backpack")
                        and live:IsDescendantOf(LocalPlayer:FindFirstChildOfClass("Backpack")))) then
                pcall(function() live:Destroy() end)
                markRemoved()
                pcall(function() humanoid:BuildRigFromAttachments() end)
                return true
            end

            -- Next, match actual instances by SourceAssetId, LH attribute, or
            -- exact catalog name. This fixes Roblox accessories whose current
            -- HumanoidDescription and replicated Accessory data disagree.
            local exact = {}
            for _, object in ipairs(character:GetDescendants()) do
                if object:IsA("Accessory") then
                    local sourceId
                    pcall(function() sourceId = tonumber(object.SourceAssetId) end)
                    local attrId = tonumber(object:GetAttribute("LHAvatarItemId"))
                    if sourceId == id
                        or attrId == id
                        or lower(trim(object.Name)) == lower(trim(item.Name or "")) then
                        exact[#exact + 1] = object
                    end
                end
            end

            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if slot == "Gear" and backpack then
                for _, object in ipairs(backpack:GetChildren()) do
                    if object:IsA("Tool")
                        and tonumber(object:GetAttribute("LHAvatarItemId")) == id then
                        exact[#exact + 1] = object
                    end
                end
            end

            if #exact > 0 then
                for _, object in ipairs(exact) do
                    pcall(function() object:Destroy() end)
                end
                markRemoved()
                pcall(function() humanoid:BuildRigFromAttachments() end)
                return true
            end

            -- HumanoidDescription route for classic clothing / faces and
            -- accessories that only expose IDs through GetAppliedDescription.
            local pivot
            pcall(function() pivot = character:GetPivot() end)

            local descOk, description = pcall(function()
                return humanoid:GetAppliedDescription()
            end)
            if descOk and description then
                local changed = false
                local propertyName = Wear.GetDescriptionProperty(slot)

                if propertyName then
                    local currentId
                    pcall(function() currentId = tonumber(description[propertyName]) end)
                    if currentId == id then
                        changed = pcall(function() description[propertyName] = 0 end)
                    end
                else
                    local accessoriesOk, accessories = pcall(function()
                        return description:GetAccessories(true)
                    end)
                    if accessoriesOk and type(accessories) == "table" then
                        local rebuilt = {}
                        for _, record in ipairs(accessories) do
                            if tonumber(record.AssetId) == id then
                                changed = true
                            else
                                rebuilt[#rebuilt + 1] = record
                            end
                        end
                        if changed then
                            changed = pcall(function()
                                description:SetAccessories(rebuilt, true)
                            end)
                        end
                    end
                end

                if changed then
                    local applied = false
                    local asyncMethod = humanoid.ApplyDescriptionResetAsync or humanoid.ApplyDescriptionAsync
                    if typeof(asyncMethod) == "function" then
                        for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                            local ok = Wear.WithRobloxIdentity(function()
                                asyncMethod(humanoid, description, verification)
                            end)
                            if ok == true then applied = true; break end
                        end
                    end
                    if not applied then
                        local syncMethod = humanoid.ApplyDescriptionReset or humanoid.ApplyDescription
                        if typeof(syncMethod) == "function" then
                            for _, verification in ipairs({Enum.AssetTypeVerification.ClientOnly, Enum.AssetTypeVerification.Default}) do
                                local ok = Wear.WithRobloxIdentity(function()
                                    syncMethod(humanoid, description, verification)
                                end)
                                if ok == true then applied = true; break end
                            end
                        end
                    end

                    pcall(function() humanoid:BuildRigFromAttachments() end)
                    for _ = 1, 2 do RunService.Heartbeat:Wait() end
                    if pivot then pcall(function() character:PivotTo(pivot) end) end
                    pcall(function() description:Destroy() end)

                    if applied then
                        markRemoved()
                        return true
                    end
                else
                    pcall(function() description:Destroy() end)
                end
            end

            -- Last safe visual fallback: if exactly ONE live object occupies
            -- this slot, it is the item represented by this outfit row.
            local slotCandidates = {}
            if slot == "FaceDecal" then
                local head = character:FindFirstChild("Head")
                local face = head and head:FindFirstChild("face")
                if face and face:IsA("Decal") then slotCandidates[1] = face end
            elseif slot == "ClassicTShirt" then
                local obj = character:FindFirstChildOfClass("ShirtGraphic")
                if obj then slotCandidates[1] = obj end
            elseif slot == "ClassicShirt" then
                local obj = character:FindFirstChildOfClass("Shirt")
                if obj then slotCandidates[1] = obj end
            elseif slot == "ClassicPants" then
                local obj = character:FindFirstChildOfClass("Pants")
                if obj then slotCandidates[1] = obj end
            else
                for _, child in ipairs(character:GetChildren()) do
                    if child:IsA("Accessory") and slotForAccessory(child) == slot then
                        slotCandidates[#slotCandidates + 1] = child
                    end
                end
            end

            if #slotCandidates == 1 then
                pcall(function() slotCandidates[1]:Destroy() end)
                markRemoved()
                return true
            end

            if #slotCandidates > 1 then
                return false,
                    "This avatar has multiple "
                    .. tostring(item.AssetTypeName or slot)
                    .. " items and Roblox did not expose a reliable ID for this one."
            end

            return false, "The item was not found on the kurrent local avatar."
        end

        local function openDetails(item)
            state.DetailsItem = item
            OutfitOverlay.Visible = false
            if state.SavedOutfitsArea then state.SavedOutfitsArea.Visible = false end
            DetailsOverlay.Visible = true

            DetailsImage.Image = thumbnailFor(item.Id)
            DetailsName.Text = item.Name
            DetailsCreator.Text = "By " .. item.CreatorName
            DetailsMeta.Text = table.concat({
                item.AssetTypeName or "Avatar Item",
                "Asset ID: " .. tostring(item.Id),
                formatPrice(item)
            }, "\n")
            DetailsDescription.Text = trim(item.Description) ~= ""
                and item.Description
                or "No Marketplace description was returned for this item."
            task.defer(resizeDetailsDescription)

            refreshSelectedUi()
        end

        local function closeDetails()
            DetailsOverlay.Visible = false
            state.DetailsItem = nil
        end

        track(DetailsBack.MouseButton1Click:Connect(closeDetails))

        track(DetailsTryButton.MouseButton1Click:Connect(function()
            if state.DetailsItem then
                toggleItem(state.DetailsItem)
            end
        end))

        track(state.DetailsBuyButton.MouseButton1Click:Connect(function()
            if state.DetailsItem then
                state.Purchase:Prompt(state.DetailsItem)
            end
        end))

        track(DetailsCopyButton.MouseButton1Click:Connect(function()
            if not state.DetailsItem then
                return
            end

            if copyToClipboard(tostring(state.DetailsItem.Id)) then
                notify("Kopied asset ID " .. tostring(state.DetailsItem.Id) .. ".", "success")
            else
                notify("Clipboard is unsupported. Asset ID: " .. tostring(state.DetailsItem.Id), "warning", 5)
            end
        end))

        local function clearOutfitRows()
            for _, child in ipairs(OutfitScroll:GetChildren()) do
                if child:IsA("Frame") and child.Name == "OutfitRow" then
                    child:Destroy()
                end
            end
        end

        rebuildOutfitList = function()
            state.OutfitRenderSerial = (state.OutfitRenderSerial or 0) + 1
            local serial = state.OutfitRenderSerial
            clearOutfitRows()
            OutfitEmpty.Visible = true
            OutfitEmpty.Text = "Loading kurrent avatar items..."

            task.spawn(function()
                local entries = state.GetCurrentWornItems()
                if state.Destroyed or serial ~= state.OutfitRenderSerial then return end
                clearOutfitRows()
                OutfitEmpty.Visible = #entries == 0
                OutfitEmpty.Text = "No katalog items were found on your kurrent avatar."

                for index, item in ipairs(entries) do
                    local row = create("Frame", {
                        Name = "OutfitRow",
                        Size = UDim2.new(1, -4, 0, 88),
                        BackgroundColor3 = PANEL,
                        BorderSizePixel = 0,
                        LayoutOrder = index,
                        ZIndex = 52
                    })
                    addCorner(row, 12)
                    addStroke(row, STROKE, 1, 0.2)
                    row.Parent = OutfitScroll

                    local imageShell = create("Frame", {
                        Position = UDim2.fromOffset(8, 8),
                        Size = UDim2.fromOffset(72, 72),
                        BackgroundColor3 = PANEL_2,
                        BorderSizePixel = 0,
                        ZIndex = 53
                    })
                    addCorner(imageShell, 10)
                    imageShell.Parent = row

                    local image = create("ImageLabel", {
                        Position = UDim2.fromOffset(4, 4),
                        Size = UDim2.new(1, -8, 1, -8),
                        BackgroundTransparency = 1,
                        Image = thumbnailFor(item.Id),
                        ScaleType = Enum.ScaleType.Fit,
                        ZIndex = 54
                    })
                    image.Parent = imageShell

                    local name = create("TextLabel", {
                        Position = UDim2.fromOffset(92, 12),
                        Size = UDim2.new(1, -250, 0, 28),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        Text = item.Name,
                        TextColor3 = TEXT,
                        TextSize = 11,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 53
                    })
                    name.Parent = row

                    local meta = create("TextLabel", {
                        Position = UDim2.fromOffset(92, 42),
                        Size = UDim2.new(1, -250, 0, 30),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.Gotham,
                        Text = (item.AssetTypeName or "Avatar Item") .. " | " .. formatPrice(item),
                        TextColor3 = MUTED,
                        TextSize = 9,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 53
                    })
                    meta.Parent = row

                    local buyButton = create("TextButton", {
                        AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -94, 0.5, 0),
                        Size = UDim2.fromOffset(62, 32),
                        BackgroundColor3 = Color3.fromRGB(46, 156, 82),
                        AutoButtonColor = false,
                        Font = Enum.Font.GothamBold,
                        Text = "Buy",
                        TextColor3 = Color3.new(1, 1, 1),
                        TextSize = 9.5,
                        ZIndex = 53
                    })
                    addCorner(buyButton, 9)
                    buyButton.Parent = row
                    bindButtonVisual(
                        buyButton,
                        Color3.fromRGB(46, 156, 82),
                        Color3.fromRGB(56, 180, 96)
                    )

                    local removeButton = create("TextButton", {
                        AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -8, 0.5, 0),
                        Size = UDim2.fromOffset(78, 32),
                        BackgroundColor3 = Color3.fromRGB(78, 38, 48),
                        AutoButtonColor = false,
                        Font = Enum.Font.GothamBold,
                        Text = "Take Off",
                        TextColor3 = Color3.fromRGB(255, 189, 198),
                        TextSize = 9.5,
                        ZIndex = 53
                    })
                    addCorner(removeButton, 9)
                    removeButton.Parent = row
                    bindButtonVisual(removeButton, Color3.fromRGB(78, 38, 48), Color3.fromRGB(95, 44, 56))

                    buyButton.MouseButton1Click:Connect(function()
                        state.Purchase:Prompt(item)
                    end)

                    removeButton.MouseButton1Click:Connect(function()
                        task.spawn(function()
                            local ok, err = Wear.RemoveCurrentAsset(item)
                            if not ok then
                                notify(err or "The item kould not be removed.", "error", 4)
                                return
                            end
                            refreshSelectedUi()
                            rebuildOutfitList()
                        end)
                    end)
                end
            end)
        end

        track(OutfitButton.MouseButton1Click:Connect(function()
            DetailsOverlay.Visible = false
            state.DetailsItem = nil
            if state.SetMode then
                state.SetMode("outfit")
            else
                OutfitOverlay.Visible = true
                rebuildOutfitList()
            end
        end))

        track(OutfitBack.MouseButton1Click:Connect(function()
            if state.SetMode then
                state.SetMode("marketplace")
            else
                OutfitOverlay.Visible = false
            end
        end))

        track(state.BuyAllButton.MouseButton1Click:Connect(function()
            task.spawn(function()
                state.Purchase:ConfirmMany(state.GetCurrentWornItems(), "Buy All Outfit Items?")
            end)
        end))

        track(ResetAllButton.MouseButton1Click:Connect(function()
            if countEquipped() <= 0 and next(state.ViewerModifiedSlots or {}) == nil then return end
            LULA:Confirm(
                "Remove all klothing?",
                "Are you sure you want to remove all klothing?",
                function()
                    resetAllItems(true)
                    rebuildOutfitList()
                end
            )
        end))

        track(StackingButton.MouseButton1Click:Connect(function()
            state.ItemStacking = not state.ItemStacking
            StackingButton.Text = state.ItemStacking and "Item Stacking: ON" or "Item Stacking: OFF"
            StackingButton.BackgroundColor3 = state.ItemStacking and ACCENT or PANEL_2
            StackingButton.TextColor3 = state.ItemStacking and Color3.new(1, 1, 1) or MUTED
            -- The button itself shows the state; no extra toast needed.
        end))

        local function clearResultCards()
            state.CurrentResults = {}
            state.CurrentResultIds = {}
            state.CardRecords = {}

            for _, child in ipairs(ResultsScroll:GetChildren()) do
                if child:IsA("Frame") and child.Name == "ResultCard" then
                    child:Destroy()
                end
            end
        end

        local function updateCardRecord(record)
            if not record or not record.Item then return end
            local active = Wear.IsEquipped(record.Item)
            if active then
                record.TryButton.Text = "Take Off"
                record.TryButton.BackgroundColor3 = Color3.fromRGB(79, 53, 64)
                record.Stroke.Color = SUCCESS
                record.Stroke.Transparency = 0.15
            else
                record.TryButton.Text = "Try On"
                record.TryButton.BackgroundColor3 = ACCENT
                record.Stroke.Color = STROKE
                record.Stroke.Transparency = 0.25
            end
            if record.BuyButton then
                if record.Owned == true then
                    record.BuyButton.Text = "Owned"
                    record.BuyButton.BackgroundColor3 = Color3.fromRGB(56, 92, 68)
                elseif record.OffSale == true or (record.Item.PriceStatus and containsPlain(tostring(record.Item.PriceStatus), "off")) then
                    record.BuyButton.Text = "Off Sale"
                    record.BuyButton.BackgroundColor3 = Color3.fromRGB(88, 62, 67)
                else
                    record.BuyButton.Text = "Buy"
                    record.BuyButton.BackgroundColor3 = Color3.fromRGB(46, 156, 82)
                end
            end
            if record.StarButton then
                local favorite = isFavorite(record.Item)
                record.StarButton.Text = favorite and STAR_FILLED or STAR_EMPTY
                record.StarButton.TextColor3 = favorite and FAVORITE_YELLOW or MUTED
            end
        end

        refreshAllCardStates = function()
            for _, records in pairs(state.CardRecords) do
                for _, record in ipairs(records) do
                    updateCardRecord(record)
                end
            end
        end

        refreshFavoriteVisuals = function()
            refreshAllCardStates()
        end

        local function createResultCard(item, order)
            local card = create("Frame", {
                Name = "ResultCard",
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                LayoutOrder = order,
                ZIndex = 4
            })
            addCorner(card, 11)
            local cardStroke = addStroke(card, STROKE, 1, 0.25)
            card.Parent = ResultsScroll

            local imageShell = create("Frame", {
                Position = UDim2.fromOffset(7, 7),
                Size = UDim2.new(1, -14, 0, 106),
                BackgroundColor3 = PANEL_2,
                BorderSizePixel = 0,
                ZIndex = 5
            })
            addCorner(imageShell, 9)
            imageShell.Parent = card

            local image = create("ImageLabel", {
                Position = UDim2.fromOffset(4, 4),
                Size = UDim2.new(1, -8, 1, -8),
                BackgroundTransparency = 1,
                Image = thumbnailFor(item.Id),
                ScaleType = Enum.ScaleType.Fit,
                ZIndex = 6
            })
            image.Parent = imageShell

            local typeBadge = create("TextLabel", {
                Position = UDim2.fromOffset(5, 5),
                Size = UDim2.new(0.44, 0, 0, 20),
                BackgroundColor3 = Color3.fromRGB(18, 20, 31),
                BackgroundTransparency = 0.08,
                Font = Enum.Font.GothamBold,
                Text = item.AssetTypeName or "Avatar Item",
                TextColor3 = Color3.fromRGB(205, 214, 255),
                TextSize = 7.5,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 7
            })
            addCorner(typeBadge, 6)
            typeBadge.Parent = imageShell

            local priceBadge = create("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -33, 0, 5),
                Size = UDim2.new(0.30, 0, 0, 20),
                BackgroundColor3 = Color3.fromRGB(18, 20, 31),
                BackgroundTransparency = 0.08,
                Font = Enum.Font.GothamBold,
                Text = formatPrice(item),
                TextColor3 = TEXT,
                TextSize = 7.5,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 7
            })
            addCorner(priceBadge, 6)
            priceBadge.Parent = imageShell
            if item.Premium == true or item.PremiumPrice ~= nil then
                local premiumBadge = create("ImageLabel", {
                    Position = UDim2.fromOffset(3, 3),
                    Size = UDim2.fromOffset(14, 14),
                    BackgroundTransparency = 1,
                    Image = state.PremiumIconAsset or "",
                    ImageTransparency = state.PremiumIconAsset and 0 or 1,
                    ScaleType = Enum.ScaleType.Fit,
                    ZIndex = 8
                })
                premiumBadge:SetAttribute("LHPremiumBadge", true)
                premiumBadge.Parent = priceBadge
                table.insert(state.PremiumBadgeImages, premiumBadge)
                local pricePadding = Instance.new("UIPadding")
                pricePadding.PaddingLeft = UDim.new(0, 17)
                pricePadding.PaddingRight = UDim.new(0, 2)
                pricePadding.Parent = priceBadge
                priceBadge.TextXAlignment = Enum.TextXAlignment.Right
            end

            local starButton = create("TextButton", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -4, 0, 4),
                Size = UDim2.fromOffset(26, 24),
                BackgroundColor3 = PANEL_3,
                BackgroundTransparency = 0.05,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = STAR_EMPTY,
                TextColor3 = MUTED,
                TextSize = 16,
                ZIndex = 8
            })
            addCorner(starButton, 7)
            starButton.Parent = imageShell

            local nameLabel = create("TextLabel", {
                Position = UDim2.fromOffset(7, 117),
                Size = UDim2.new(1, -14, 0, 23),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = item.Name,
                TextColor3 = TEXT,
                TextSize = 9.5,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
                ZIndex = 5
            })
            nameLabel.Parent = card

            local creatorLabel = create("TextLabel", {
                Position = UDim2.fromOffset(7, 141),
                Size = UDim2.new(1, -14, 0, 13),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = item.CreatorName,
                TextColor3 = MUTED,
                TextSize = 8,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 5
            })
            creatorLabel.Parent = card

            local tryButton = create("TextButton", {
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0, 7, 1, -7),
                Size = UDim2.new(0.37, -4, 0, 27),
                BackgroundColor3 = ACCENT,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = "Try On",
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 8.5,
                ZIndex = 6
            })
            addCorner(tryButton, 7)
            tryButton.Parent = card

            local buyButton = create("TextButton", {
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0.38, 3, 1, -7),
                Size = UDim2.new(0.29, -4, 0, 27),
                BackgroundColor3 = Color3.fromRGB(46, 156, 82),
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = "Buy",
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 8.5,
                ZIndex = 6
            })
            addCorner(buyButton, 7)
            buyButton.Parent = card

            local infoButton = create("TextButton", {
                AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.new(1, -7, 1, -7),
                Size = UDim2.new(0.31, -4, 0, 27),
                BackgroundColor3 = PANEL_3,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = "Info",
                TextColor3 = TEXT,
                TextSize = 8.5,
                ZIndex = 6
            })
            addCorner(infoButton, 7)
            infoButton.Parent = card

            bindButtonVisual(tryButton, ACCENT, ACCENT_HOVER)
            bindButtonVisual(
                buyButton,
                Color3.fromRGB(46, 156, 82),
                Color3.fromRGB(56, 180, 96)
            )
            bindButtonVisual(infoButton, PANEL_3, blendColor(PANEL_3, TEXT, 0.08))
            bindButtonVisual(starButton, PANEL_3, blendColor(PANEL_3, TEXT, 0.08))

            card.MouseEnter:Connect(function()
                tween(card, 0.14, {BackgroundColor3 = PANEL_2})
                if not Wear.IsEquipped(item) then
                    tween(cardStroke, 0.14, {Color = ACCENT, Transparency = 0.25})
                end
            end)

            card.MouseLeave:Connect(function()
                tween(card, 0.14, {BackgroundColor3 = PANEL})
                updateCardRecord({
                    Item = item,
                    TryButton = tryButton,
                    BuyButton = buyButton,
                    StarButton = starButton,
                    Stroke = cardStroke
                })
            end)

            tryButton.MouseButton1Click:Connect(function()
                toggleItem(item)
            end)

            buyButton.MouseButton1Click:Connect(function()
                state.Purchase:Prompt(item)
            end)

            infoButton.MouseButton1Click:Connect(function()
                openDetails(item)
            end)

            starButton.MouseButton1Click:Connect(function()
                toggleFavorite(item)
            end)

            state.CardRecords[item.Id] = state.CardRecords[item.Id] or {}
            local record = {
                Item = item,
                Card = card,
                TryButton = tryButton,
                BuyButton = buyButton,
                StarButton = starButton,
                Stroke = cardStroke
            }
            table.insert(state.CardRecords[item.Id], record)
            updateCardRecord(record)
            task.spawn(function()
                local owns = state.Purchase:Owns(item.Id)
                if record.Card and record.Card.Parent then
                    record.Owned = owns == true
                    local saleable = state.Purchase:IsSaleable(item)
                    record.OffSale = saleable ~= true
                    updateCardRecord(record)
                end
            end)
        end

        local function appendResults(results)
            for _, item in ipairs(results or {}) do
                if not state.CurrentResultIds[item.Id] then
                    state.CurrentResultIds[item.Id] = true
                    table.insert(state.CurrentResults, item)
                    createResultCard(item, #state.CurrentResults)
                end
            end

            ResultsCount.Text = tostring(#state.CurrentResults) .. " found"
            EmptyState.Visible = #state.CurrentResults == 0
            LoadMoreButton.Visible = state.CurrentHasMore and #state.CurrentResults > 0
        end

        local function displayResults(results, query, nextPage, hasMore, backend)
            clearResultCards()
            state.CurrentQuery = query
            state.CurrentNextPage = nextPage
            state.CurrentHasMore = hasMore == true

            local title = state.CurrentCategory.Name
            if trim(query) ~= "" then
                title = title .. " results for \"" .. trim(query) .. "\""
            end
            ResultsTitle.Text = title

            appendResults(results)
            if backend then
                ResultsCount.Text = tostring(#state.CurrentResults) .. " found | " .. tostring(backend)
            end
        end

        local function setLoading(value, message)
            state.Loading = value == true
            LoadingOverlay.Visible = state.Loading
            LoadingText.Text = message or "Searching Roblox Marketplace..."
            SearchButton.Active = not state.Loading
            SearchBox.TextEditable = not state.Loading
            LoadMoreButton.Active = not state.Loading
        end

        local function performSearch(rawQuery)
            local query = trim(rawQuery)
            state.SearchSerial = state.SearchSerial + 1
            local serial = state.SearchSerial
            local category = state.CurrentCategory

            setLoading(true, "Searching Roblox Marketplace...")
            ResultsScroll.CanvasPosition = Vector2.zero

            task.spawn(function()
                local ok, results, nextPage, hasMore, backend = pcall(
                    searchMarketplace,
                    query,
                    category
                )

                if state.Destroyed or serial ~= state.SearchSerial then
                    return
                end

                setLoading(false)

                if not ok then
                    displayResults({}, query, nil, false, nil)
                    EmptyTitle.Text = "Marketplace search failed"
                    EmptyText.Text = tostring(results)
                    notify("Roblox Marketplace search failed.", "error", 4.5)
                    return
                end

                EmptyTitle.Text = "No avatar items found"
                EmptyText.Text = "Try another name, another kategory, or paste an asset ID."
                displayResults(results, query, nextPage, hasMore, backend)
            end)
        end

        renderFavorites = function(rawQuery)
            local query = trim(rawQuery)
            clearResultCards()
            state.CurrentQuery = query
            state.CurrentNextPage = nil
            state.CurrentHasMore = false
            LoadMoreButton.Visible = false

            local filtered = {}
            local needle = lower(query)
            for _, item in ipairs(getFavorites()) do
                if itemAllowed(item, state.CurrentCategory) then
                    local searchable = lower(table.concat({
                        tostring(item.Name or ""),
                        tostring(item.CreatorName or ""),
                        tostring(item.AssetTypeName or ""),
                        tostring(item.Id or "")
                    }, " "))
                    if needle == "" or string.find(searchable, needle, 1, true) then
                        filtered[#filtered + 1] = item
                    end
                end
            end
            sortResults(filtered, query)

            local title = utf8.char(0x2605) .. " Favorites"
            if query ~= "" then title = title .. " - " .. query end
            ResultsTitle.Text = title
            appendResults(filtered)
            ResultsCount.Text = tostring(#filtered) .. " saved"
            EmptyTitle.Text = "No saved avatar favorites"
            EmptyText.Text = "Star Marketplace items to save them here."
        end

        local function updateModeVisuals()
            local marketplace = state.Mode == "marketplace"
            local favorites = state.Mode == "favorites"
            local viewer = state.Mode == "viewer"
            local outfit = state.Mode == "outfit"
            local saved = state.Mode == "savedoutfits"

            MarketplaceModeButton.BackgroundColor3 = marketplace and ACCENT or PANEL_2
            MarketplaceModeButton.TextColor3 = marketplace and Color3.new(1, 1, 1) or MUTED
            FavoritesModeButton.BackgroundColor3 = favorites and ACCENT or PANEL_2
            FavoritesModeButton.TextColor3 = favorites and Color3.new(1, 1, 1) or MUTED
            state.ViewerModeButton.BackgroundColor3 = viewer and ACCENT or PANEL_2
            state.ViewerModeButton.TextColor3 = viewer and Color3.new(1, 1, 1) or MUTED
            state.OutfitModeButton.BackgroundColor3 = outfit and ACCENT or PANEL_2
            state.OutfitModeButton.TextColor3 = outfit and Color3.new(1, 1, 1) or MUTED
            if state.SavedModeButton then
                state.SavedModeButton.BackgroundColor3 = saved and ACCENT or PANEL_2
                state.SavedModeButton.TextColor3 = saved and Color3.new(1, 1, 1) or MUTED
            end

            local browse = marketplace or favorites
            SearchShell.Visible = browse
            CategoryScroll.Visible = browse
            ResultsArea.Visible = browse
            OutfitOverlay.Visible = outfit
            if state.SavedOutfitsArea then state.SavedOutfitsArea.Visible = saved end

            if state.ClassicSubScroll then
                state.ClassicSubScroll.Visible = browse
                    and (state.CurrentCategory.ParentKey == "classic"
                        or state.CurrentCategory.Key == "classic")
            end

            if state.Viewer and state.Viewer.Area then
                state.Viewer.Visible = viewer
                state.Viewer.Area.Visible = viewer
            end

            if viewer or outfit or saved then
                Controls.Size = UDim2.new(1, 0, 0, 28)
            else
                local classicOpen = state.CurrentCategory.ParentKey == "classic"
                    or state.CurrentCategory.Key == "classic"
                Controls.Size = UDim2.new(1, 0, 0, classicOpen and 113 or 88)
                ResultsArea.Position = UDim2.fromOffset(0, classicOpen and 153 or 128)
                ResultsArea.Size = UDim2.new(1, 0, 1, classicOpen and -153 or -128)
            end

            SearchBox.PlaceholderText = marketplace
                and "Search Roblox avatar items or paste an ID..."
                or "Search saved avatar favorites..."
            if not marketplace then LoadMoreButton.Visible = false end
        end

        local function runActiveSearch()
            if state.Mode == "viewer" then
                if state.Viewer and state.Viewer.Refresh then state.Viewer:Refresh() end
                return
            elseif state.Mode == "outfit" then
                rebuildOutfitList()
                return
            elseif state.Mode == "savedoutfits" then
                if state.RenderSavedOutfits then state.RenderSavedOutfits() end
                return
            end

            ResultsScroll.CanvasPosition = Vector2.zero
            if state.Mode == "favorites" then
                renderFavorites(SearchBox.Text)
            else
                EmptyTitle.Text = "No avatar items found"
                EmptyText.Text = "Try another name, another kategory, or paste an asset ID."
                performSearch(SearchBox.Text)
            end
        end

        local function setMode(mode)
            if mode ~= "favorites" and mode ~= "viewer" and mode ~= "outfit" and mode ~= "savedoutfits" then
                mode = "marketplace"
            end
            if mode ~= "marketplace" then
                state.SearchSerial = state.SearchSerial + 1
                setLoading(false)
            end
            if state.Mode == mode then
                updateModeVisuals()
                runActiveSearch()
                return
            end

            DetailsOverlay.Visible = false
            state.DetailsItem = nil
            state.Mode = mode
            updateModeVisuals()
            if mode == "viewer" and state.Viewer and state.Viewer.Area then
                state.Viewer.Area.CanvasPosition = Vector2.zero
            end
            runActiveSearch()
        end

        state.SetMode = setMode

        -- Split the remaining Avatar Kreator setup into a fresh Luau function frame.
        -- Delta/Luau caps a single function at 200 local registers; keeping this tail
        -- nested prevents the large builder above from exhausting that register budget.
        return (function()
        -- Saved Outfits is intentionally isolated in its own function frame so the
        -- already-large Avatar Kreator builder stays under Delta/Luau register limits.
        (function()
            state.SavedOutfitsArea = create("Frame", {
                Name = "SavedOutfitsArea",
                Position = UDim2.fromOffset(0, 68),
                Size = UDim2.new(1, 0, 1, -68),
                BackgroundColor3 = BACKGROUND,
                BorderSizePixel = 0,
                Visible = false,
                ZIndex = 50
            })
            state.SavedOutfitsArea.Parent = Main

            state.SavedOutfitsHeader = create("Frame", {
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                ZIndex = 51
            })
            state.SavedOutfitsHeader.Parent = state.SavedOutfitsArea

            state.SavedOutfitsTitle = create("TextLabel", {
                Position = UDim2.fromOffset(10, 0),
                Size = UDim2.new(1, -126, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = "Saved Outfits",
                TextColor3 = TEXT,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 52
            })
            state.SavedOutfitsTitle.Parent = state.SavedOutfitsHeader

            state.SaveOutfitButton = create("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.fromOffset(104, 30),
                BackgroundColor3 = ACCENT,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = "Save Kurrent",
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 9,
                ZIndex = 52
            })
            addCorner(state.SaveOutfitButton, 9)
            state.SaveOutfitButton.Parent = state.SavedOutfitsHeader
            bindButtonVisual(state.SaveOutfitButton, ACCENT, ACCENT_HOVER)
            track(state.SaveOutfitButton.MouseButton1Click:Connect(function()
                if state.SaveCurrentOutfit then task.spawn(state.SaveCurrentOutfit) end
            end))

            state.SavedOutfitsScroll = create("ScrollingFrame", {
                Position = UDim2.fromOffset(8, 52),
                Size = UDim2.new(1, -16, 1, -60),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                CanvasSize = UDim2.fromOffset(0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = ACCENT,
                ZIndex = 51
            })
            state.SavedOutfitsScroll.Parent = state.SavedOutfitsArea

            state.SavedOutfitsGrid = create("UIGridLayout", {
                CellPadding = UDim2.fromOffset(6, 7),
                CellSize = UDim2.fromOffset(108, 150),
                FillDirection = Enum.FillDirection.Horizontal,
                FillDirectionMaxCells = 3,
                HorizontalAlignment = Enum.HorizontalAlignment.Left,
                SortOrder = Enum.SortOrder.LayoutOrder
            })
            state.SavedOutfitsGrid.Parent = state.SavedOutfitsScroll

            state.SavedOutfitsEmpty = create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 90),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = "No saved outfits yet. Wear wat u want, then press Save Kurrent.",
                TextColor3 = MUTED,
                TextSize = 11,
                TextWrapped = true,
                ZIndex = 52
            })
            state.SavedOutfitsEmpty.Parent = state.SavedOutfitsScroll

            state.ResizeSavedOutfitGrid = function()
                local width = state.SavedOutfitsScroll.AbsoluteSize.X
                if width <= 0 then return end
                local columns = width < 245 and 1 or (width < 340 and 2 or 3)
                local padding = 6
                local available = width - 2 - (padding * (columns - 1))
                state.SavedOutfitsGrid.FillDirectionMaxCells = columns
                state.SavedOutfitsGrid.CellSize = UDim2.fromOffset(math.max(104, math.floor(available / columns)), 150)
            end
            track(state.SavedOutfitsScroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(state.ResizeSavedOutfitGrid))
            task.defer(state.ResizeSavedOutfitGrid)
        end)()

        local classicSubButtons = {}

        local ClassicSubScroll = create("ScrollingFrame", {
            Name = "KlassicSubcategories",
            Position = UDim2.new(0, 8, 0, 89),
            Size = UDim2.new(1, -16, 0, 22),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.X,
            ScrollBarThickness = 0,
            ScrollingDirection = Enum.ScrollingDirection.X,
            Visible = false,
            ZIndex = 4
        })
        ClassicSubScroll.Parent = Controls

        local ClassicSubLayout = create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 5),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center
        })
        ClassicSubLayout.Parent = ClassicSubScroll
        state.ClassicSubScroll = ClassicSubScroll

        local function setClassicSubmenuVisible(visible)
            visible = visible == true
            if state.Mode == "viewer" or state.Mode == "outfit" then
                ClassicSubScroll.Visible = false
                Controls.Size = UDim2.new(1, 0, 0, 28)
                return
            end
            ClassicSubScroll.Visible = visible
            if visible then
                Controls.Size = UDim2.new(1, 0, 0, 113)
                ResultsArea.Position = UDim2.fromOffset(0, 153)
                ResultsArea.Size = UDim2.new(1, 0, 1, -153)
            else
                Controls.Size = UDim2.new(1, 0, 0, 88)
                ResultsArea.Position = UDim2.fromOffset(0, 128)
                ResultsArea.Size = UDim2.new(1, 0, 1, -128)
            end
        end

        local function updateCategoryVisuals()
            local selectedMainKey = state.CurrentCategory.ParentKey or state.CurrentCategory.Key
            for key, button in pairs(state.CategoryButtons) do
                local selected = key == selectedMainKey
                button.BackgroundColor3 = selected and ACCENT or PANEL_2
                button.TextColor3 = selected and Color3.new(1, 1, 1) or MUTED
            end
            for key, button in pairs(classicSubButtons) do
                local selected = key == state.CurrentCategory.Key
                button.BackgroundColor3 = selected and ACCENT or PANEL_2
                button.TextColor3 = selected and Color3.new(1, 1, 1) or MUTED
            end
        end

        local classicParent = CATEGORY_BY_KEY["classic"]
        for index, child in ipairs((classicParent and classicParent.Children) or {}) do
            local label = child.Name
            if child.Key == "classic_shirts" then label = "Shirts"
            elseif child.Key == "classic_pants" then label = "Pants"
            elseif child.Key == "classic_tshirts" then label = "T-Shirts"
            elseif child.Key == "classic_all" then label = "All Klassic" end

            local width = math.max(52, 18 + (#label * 5.4))
            local button = create("TextButton", {
                Name = child.Key,
                Size = UDim2.fromOffset(width, 22),
                BackgroundColor3 = PANEL_2,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = label,
                TextColor3 = MUTED,
                TextSize = 8.5,
                LayoutOrder = index,
                ZIndex = 5
            })
            addCorner(button, 7)
            addStroke(button, STROKE, 1, 0.25)
            button.Parent = ClassicSubScroll
            classicSubButtons[child.Key] = button

            button.MouseEnter:Connect(function()
                if state.CurrentCategory.Key ~= child.Key then
                    tween(button, 0.12, {BackgroundColor3 = PANEL_3})
                end
            end)
            button.MouseLeave:Connect(updateCategoryVisuals)
            button.MouseButton1Click:Connect(function()
                if state.Loading then return end
                state.CurrentCategory = child
                setClassicSubmenuVisible(true)
                updateCategoryVisuals()
                runActiveSearch()
            end)
        end

        for index, category in ipairs(CATEGORIES) do
            local width = math.max(52, 18 + (#category.Name * 5.4))
            local button = create("TextButton", {
                Name = category.Key,
                Size = UDim2.fromOffset(width, 22),
                BackgroundColor3 = category == state.CurrentCategory and ACCENT or PANEL_2,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = category.Name,
                TextColor3 = category == state.CurrentCategory and Color3.new(1, 1, 1) or MUTED,
                TextSize = 8.5,
                LayoutOrder = index,
                ZIndex = 5
            })
            addCorner(button, 7)
            addStroke(button, STROKE, 1, 0.25)
            button.Parent = CategoryScroll
            state.CategoryButtons[category.Key] = button

            button.MouseEnter:Connect(function()
                local selectedMainKey = state.CurrentCategory.ParentKey or state.CurrentCategory.Key
                if selectedMainKey ~= category.Key then
                    tween(button, 0.12, {BackgroundColor3 = PANEL_3})
                end
            end)
            button.MouseLeave:Connect(updateCategoryVisuals)
            button.MouseButton1Click:Connect(function()
                if state.Loading then return end
                state.CurrentCategory = category
                setClassicSubmenuVisible(category.Key == "classic")
                updateCategoryVisuals()
                runActiveSearch()
            end)
        end

        setClassicSubmenuVisible(false)
        updateCategoryVisuals()

        state.Viewer = {
            Visible = false,
            Rotation = 0
        }

        state.Viewer.Area = create("ScrollingFrame", {
            Name = "AvatarViewerArea",
            Position = UDim2.fromOffset(0, 68),
            Size = UDim2.new(1, 0, 1, -68),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = ACCENT,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
            ScrollingEnabled = true,
            Active = true,
            Visible = false,
            ZIndex = 12
        })
        state.Viewer.Area.Parent = Main

        state.Viewer.Hero = create("Frame", {
            Position = UDim2.new(0, 8, 0, 4),
            Size = UDim2.new(1, -16, 0, 122),
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0,
            ZIndex = 13
        })
        addCorner(state.Viewer.Hero, 12)
        addStroke(state.Viewer.Hero, STROKE, 1, 0.2)
        state.Viewer.Hero.Parent = state.Viewer.Area

        state.Viewer.Viewport = create("ViewportFrame", {
            Position = UDim2.fromOffset(7, 7),
            Size = UDim2.new(0.49, -10, 1, -14),
            BackgroundColor3 = PANEL_2,
            BorderSizePixel = 0,
            Ambient = Color3.fromRGB(205, 205, 218),
            LightColor = Color3.fromRGB(255, 255, 255),
            LightDirection = Vector3.new(-1, -1, -1),
            ZIndex = 14
        })
        addCorner(state.Viewer.Viewport, 10)
        state.Viewer.Viewport.Parent = state.Viewer.Hero

        state.Viewer.Controls = create("Frame", {
            Position = UDim2.new(0.50, 2, 0, 7),
            Size = UDim2.new(0.50, -9, 1, -14),
            BackgroundTransparency = 1,
            ZIndex = 14
        })
        state.Viewer.Controls.Parent = state.Viewer.Hero

        state.Viewer.Title = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 25),
