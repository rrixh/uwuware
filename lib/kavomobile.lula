        detailApply.LayoutOrder = 1
        detailApply.TextSize = 11.5
        detailApply.ZIndex = 9003
        animationText(detailApply)
        local detailRestore = makeKolorButton(detailActions, "Restore Original", ANIMATION_RED)
        detailRestore.LayoutOrder = 2
        detailRestore.TextSize = 11.5
        detailRestore.ZIndex = 9003
        animationText(detailRestore)
        local detailCopyTable = makeButton(detailActions, "Kopy Animation Bundle as Table")
        detailCopyTable.LayoutOrder = 3
        detailCopyTable.TextSize = 10.5
        detailCopyTable.TextWrapped = true
        detailCopyTable.ZIndex = 9003
        local detailCloseBottom = makeButton(detailActions, "Klose")
        detailCloseBottom.LayoutOrder = 4
        detailCloseBottom.TextSize = 11.5
        detailCloseBottom.ZIndex = 9003

        local selectedItem = nil
        local selectedDetails = nil
        local selectedSlots = nil
        local selectedSlotSources = nil
        local selectedVerification = nil

        local function clearDetailRows()
            for _, child in ipairs(detailScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end
        end

        local function closeDetails()
            detailsShade.Active = false
            detailsOverlay.Visible = false
            selectedItem = nil
            selectedDetails = nil
            selectedSlots = nil
            selectedSlotSources = nil
            selectedVerification = nil
        end

        local function makeDetailRow(slot, id, order, source)
            local row = Instance.new("Frame")
            row.Name = "Slot_" .. tostring(slot)
            row.LayoutOrder = order
            row.Size = UDim2.new(1, -2, 0, 57)
            row.BorderSizePixel = 0
            row.BackgroundTransparency = 0.02
            row.ZIndex = 9003
            row.Parent = detailScroll
            bind(row, "BackgroundColor3", "ElementColor")
            makeCorner(row, 9)
            makeStroke(row, active.Theme.SchemeColor, 0.63, 0.8)

            local propertyName = SLOT_COPY_NAMES[slot] or slot
            local slotLabel = makeText(row, propertyName .. "  [" .. tostring(slot) .. "]", 11.5, Enum.Font.GothamBold)
            slotLabel.Position = UDim2.fromOffset(10, 5)
            slotLabel.Size = UDim2.new(0.34, -10, 0, 19)
            slotLabel.TextXAlignment = Enum.TextXAlignment.Left
            slotLabel.TextTruncate = Enum.TextTruncate.AtEnd
            slotLabel.ZIndex = 9004

            local pathText = tostring(R15_SLOTS[slot] or slot)
            if source and tostring(source) ~= "" then pathText = pathText .. " | " .. tostring(source) end
            local pathLabel = makeText(row, pathText, 9.2, Enum.Font.Gotham)
            pathLabel.Position = UDim2.fromOffset(10, 27)
            pathLabel.Size = UDim2.new(0.62, -10, 0, 20)
            pathLabel.TextXAlignment = Enum.TextXAlignment.Left
            pathLabel.TextTruncate = Enum.TextTruncate.AtEnd
            pathLabel.ZIndex = 9004
            bind(pathLabel, "TextColor3", "MutedText")

            local idLabel = makeText(row, id and tostring(id) or "Not found", 10.5, Enum.Font.RobotoMono)
            idLabel.Position = UDim2.new(0.36, 0, 0, 0)
            idLabel.Size = UDim2.new(0.42, -4, 1, 0)
            idLabel.TextXAlignment = Enum.TextXAlignment.Right
            idLabel.TextTruncate = Enum.TextTruncate.AtEnd
            idLabel.ZIndex = 9004
            if id then bind(idLabel, "TextColor3", "SchemeColor") else idLabel.TextColor3 = active.Theme.Danger end

            local copyButton = makeButton(row, "Kopy")
            copyButton.AnchorPoint = Vector2.new(1, 0.5)
            copyButton.Position = UDim2.new(1, -7, 0.5, 0)
            copyButton.Size = UDim2.fromOffset(63, 31)
            copyButton.TextSize = 10.5
            copyButton.ZIndex = 9005
            copyButton.Active = id ~= nil
            copyButton.AutoButtonColor = id ~= nil
            if not id then copyButton.BackgroundTransparency = 0.55 end
            if id then
                track(copyButton.MouseButton1Click:Connect(function()
                    if copyText(tostring(id)) then
                        bundleNotify(propertyName .. " ID kopied: " .. tostring(id), "success", 2.4)
                    else
                        bundleNotify("Clipboard is not supported by this executor.", "error", 3)
                    end
                end))
            end
        end

        local detailSwitchApi = {}
        function detailSwitchApi:SetBusy(value)
            detailApply.Active = value ~= true
            detailApply.Text = value == true and "Applying..." or "Apply + Play"
            detailApply.BackgroundTransparency = value == true and 0.35 or 0
        end

        local function openDetails(item)
            if type(item) ~= "table" then
                bundleNotify("Animation pack info was unavailable.", "error", 3)
                return
            end

            selectedItem = item
            selectedDetails = nil
            selectedSlots = nil
            selectedSlotSources = nil
            selectedVerification = nil

            -- Prevent the same mobile tap from opening and instantly closing the panel.
            detailsShade.Active = false
            detailsOverlay.Parent = active.ScreenGui
            detailsOverlay.Visible = true
            task.delay(0.22, function()
                if detailsOverlay.Visible and selectedItem == item then
                    detailsShade.Active = true
                end
            end)

            clearDetailRows()
            detailLoading.Visible = true
            detailLoading.Text = "Loading Roblox bundle details..."
            detailTitle.Text = tostring(item.Name)
            detailCreator.Text = "By " .. tostring(item.CreatorName or "Unknown creator")
            detailMeta.Text = "Animation Bundle | Bundle ID: " .. tostring(item.Id)
            detailThumbnail.Image = "rbxthumb://type=BundleThumbnail&id=" .. tostring(item.Id) .. "&w=420&h=420"

            task.spawn(function()
                -- Render the panel/loading text before the heavier bundle lookup begins.
                RunService.RenderStepped:Wait()
                RunService.Heartbeat:Wait()
                local ok, slotsOrError, details, assets, slotSources, verification, catalogSlots = pcall(resolveItemSlots, item)
                if not detailsOverlay.Visible or selectedItem ~= item then return end
                if not ok then
                    detailLoading.Visible = true
                    detailLoading.Text = "Failed to resolve bundle info:\n" .. tostring(slotsOrError)
                    bundleNotify("Failed to load animation bundle details.", "error", 3.5)
                    return
                end

                selectedSlots = slotsOrError
                selectedDetails = details
                selectedSlotSources = slotSources or {}
                selectedVerification = verification
                detailTitle.Text = tostring(details.Name or item.Name)
                detailCreator.Text = "By " .. tostring(details.CreatorName or item.CreatorName or "Unknown creator")
                local meta = "Animation Bundle | Bundle ID: " .. tostring(details.Id or item.Id)
                if verification then
                    meta = meta .. " | Known-ID check: " .. tostring(verification.Matched or 0) .. "/" .. tostring(verification.Total or 9)
                else
                    meta = meta .. " | Known-ID check: not a classic reference pack"
                end
                detailMeta.Text = meta
                clearDetailRows()
                for index, slot in ipairs(SLOT_ORDER) do
                    makeDetailRow(slot, selectedSlots[slot], index, selectedSlotSources[slot])
                end
                detailLoading.Visible = false

                local found = 0
                for _, slot in ipairs(SLOT_ORDER) do if selectedSlots[slot] then found = found + 1 end end
                if verification and verification.Exact then
                    bundleNotify("Known original pack check matched all 9 working IDs.", "success", 3.5)
                elseif verification then
                    bundleNotify("Known original pack check matched " .. tostring(verification.Matched or 0) .. "/" .. tostring(verification.Total or 9) .. " IDs.", "warning", 4.5)
                end
                if found < 9 then
                    bundleNotify("Resolved " .. tostring(found) .. "/9 slots. Missing IDs show as Not found and copy as 0 in the table.", "warning", 4)
                end
            end)
        end

        track(detailsShade.Activated:Connect(function()
            if detailsShade.Active then closeDetails() end
        end))
        track(detailCloseTop.Activated:Connect(closeDetails))
        track(detailCloseBottom.Activated:Connect(closeDetails))
        track(detailApply.MouseButton1Click:Connect(function()
            if not selectedItem or not selectedSlots then
                bundleNotify("Bundle info is still loading.", "warning", 2.5)
                return
            end
            if tonumber(state.ActiveId) == tonumber(selectedItem.Id) then
                bundleNotify(tostring(selectedItem.Name) .. " is already active.", "info", 2.2)
                return
            end
            toggleBundle(selectedItem, detailSwitchApi)
        end))
        track(detailRestore.MouseButton1Click:Connect(function()
            state.ToggleSerial = (state.ToggleSerial or 0) + 1
            local restored = restoreOriginalAnimations(true)
            state.ActiveId = nil
            state.ActiveItem = nil
            state.ActiveSlots = nil
            refreshToggleVisuals()
            bundleNotify(restored and "Original animations restored." or "No stored original animation set was found.", restored and "success" or "warning", 2.8)
        end))
        track(detailCopyTable.MouseButton1Click:Connect(function()
            if not selectedDetails or not selectedSlots then
                bundleNotify("Bundle info is still loading.", "warning", 2.5)
                return
            end
            local snippet = makePackTable(selectedDetails.Name or selectedItem.Name, selectedSlots)
            if copyText(snippet) then
                bundleNotify("Animation bundle table kopied: " .. tostring(selectedDetails.Name or selectedItem.Name), "success", 3)
            else
                bundleNotify("Clipboard is not supported by this executor.", "error", 3)
            end
        end))
        return openDetails, closeDetails
        end

        local openDetails, closeDetails = createAnimationBundleDetailsOverlay()
        state.OpenDetails = openDetails
        state.CloseDetails = closeDetails


        local renderMarketplace
        local renderFavorites

        local function addFavorite(item)
            if favoriteIndex(item.Id) then
                LULA:Notify("info", "Free Animations", tostring(item.Name) .. " is already in Favorites.", 2.3, nil, true)
                return
            end
            local favorites = getFavorites()
            local saved = cleanFavorite(item)
            if not saved then return end
            table.insert(favorites, saved)
            saveFavorites(favorites)
            refreshStarVisuals()
            LULA:Notify("success", "Free Animations", tostring(item.Name) .. " was added to Favorites.", 2.5, nil, true)
            if currentMode == "favorites" and renderFavorites then
                renderFavorites(favoriteSearchBox.Text)
            end
        end

        local function removeFavorite(item, allowUndo)
            local favorites = getFavorites()
            local index = favoriteIndex(item.Id)
            if not index then return end

            local removed = table.remove(favorites, index)
            saveFavorites(favorites)
            refreshStarVisuals()
            if currentMode == "favorites" and renderFavorites then
                renderFavorites(favoriteSearchBox.Text)
            end

            if allowUndo ~= false then
                LULA:NotifyAction(
                    "warning",
                    "Animation Favorites",
                    tostring(removed.Name) .. " was removed from Favorites.",
                    4,
                    "Undo",
                    function()
                        local restored = getFavorites()
                        if not favoriteIndex(removed.Id) then
                            table.insert(restored, math.min(index, #restored + 1), removed)
                            saveFavorites(restored)
                        end
                        refreshStarVisuals()
                        if currentMode == "favorites" and renderFavorites then
                            renderFavorites(favoriteSearchBox.Text)
                        end
                    end
                )
            end
        end

        local function toggleFavorite(item)
            if favoriteIndex(item.Id) then
                removeFavorite(item, true)
            else
                addFavorite(item)
            end
        end

        local function makeStarButton(parent, item)
            local star = makeButton(parent, STAR_EMPTY)
            star.Name = "AnimationBundleFavoriteStar"
            star.Size = UDim2.fromOffset(24, 24)
            star.TextSize = 20
            star.TextColor3 = YELLOW
            star.BackgroundTransparency = 0.08
            star.ZIndex = 8

            local api = {}
            function api:Render(saved)
                star.Text = saved and STAR_FILLED or STAR_EMPTY
                star.TextColor3 = YELLOW
            end

            track(star.Activated:Connect(function()
                toggleFavorite(item)
            end))

            registerStar(item.Id, api)
            api:Render(favoriteIndex(item.Id) ~= nil)
            return star
        end

        local function createMarketplaceCard(item, order)
            resultItemsById[item.Id] = item
            local card = Instance.new("Frame")
            card.Name = "Bundle_" .. tostring(item.Id)
            card.LayoutOrder = order
            card.BorderSizePixel = 0
            card.BackgroundTransparency = 0.03
            card.Parent = marketHolder
            bind(card, "BackgroundColor3", "ElementColor")
            makeCorner(card, 8)
            makeStroke(card, active.Theme.SchemeColor, 0.48, 1)

            local thumbnail = Instance.new("ImageLabel")
            thumbnail.Name = "Thumbnail"
            thumbnail.Position = UDim2.fromOffset(4, 4)
            thumbnail.Size = UDim2.new(1, -8, 0, 80)
            thumbnail.BackgroundTransparency = 0.06
            thumbnail.BorderSizePixel = 0
            thumbnail.ScaleType = Enum.ScaleType.Fit
            thumbnail.Image = "rbxthumb://type=BundleThumbnail&id=" .. tostring(item.Id) .. "&w=420&h=420"
            thumbnail.Parent = card
            bind(thumbnail, "BackgroundColor3", "Header")
            makeCorner(thumbnail, 7)

            local star = makeStarButton(card, item)
            star.AnchorPoint = Vector2.new(1, 0)
            star.Position = UDim2.new(1, -6, 0, 6)

            local nameLabel = makeText(card, tostring(item.Name), 10.2, Enum.Font.GothamBold)
            nameLabel.Position = UDim2.fromOffset(5, 87)
            nameLabel.Size = UDim2.new(1, -10, 0, 31)
            nameLabel.TextXAlignment = Enum.TextXAlignment.Center
            nameLabel.TextYAlignment = Enum.TextYAlignment.Top
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd

            local infoButton = makeButton(card, "View Info")
            infoButton.Position = UDim2.new(0, 6, 0, 121)
            infoButton.Size = UDim2.new(1, -12, 0, 25)
            infoButton.TextSize = 10
            track(infoButton.Activated:Connect(function()
                task.defer(function() openDetails(item) end)
            end))

            local switch = makeToggleSwitch(card, item.Id, function(api)
                toggleBundle(item, api)
            end, false)
            switch.Pill.AnchorPoint = Vector2.new(0.5, 1)
            switch.Pill.Position = UDim2.new(0.5, 0, 1, -7)
            return card
        end

        local function createFavoriteRow(item, order)
            resultItemsById[item.Id] = item
            local row = newRow(favoritesHolder, "FavoriteBundle_" .. tostring(item.Id), 48)
            row.LayoutOrder = order
            row.BackgroundTransparency = 0.03

            local thumbnail = Instance.new("ImageLabel")
            thumbnail.Position = UDim2.fromOffset(5, 5)
            thumbnail.Size = UDim2.fromOffset(38, 38)
            thumbnail.BackgroundTransparency = 0.08
            thumbnail.BorderSizePixel = 0
            thumbnail.ScaleType = Enum.ScaleType.Fit
            thumbnail.Image = "rbxthumb://type=BundleThumbnail&id=" .. tostring(item.Id) .. "&w=150&h=150"
            thumbnail.Parent = row
            bind(thumbnail, "BackgroundColor3", "Header")
            makeCorner(thumbnail, 7)

            local nameLabel = makeText(row, tostring(item.Name), 11, Enum.Font.GothamBold)
            nameLabel.Position = UDim2.fromOffset(49, 5)
            nameLabel.Size = UDim2.new(1, -230, 0, 38)
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextYAlignment = Enum.TextYAlignment.Center
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd

            local infoButton = makeButton(row, "Info")
            infoButton.AnchorPoint = Vector2.new(1, 0.5)
            infoButton.Position = UDim2.new(1, -84, 0.5, 0)
            infoButton.Size = UDim2.fromOffset(42, 25)
            infoButton.TextSize = 9.5
            track(infoButton.Activated:Connect(function()
                task.defer(function() openDetails(item) end)
            end))

            local remove = makeKolorButton(row, "X", ANIMATION_RED)
            remove.AnchorPoint = Vector2.new(1, 0.5)
            remove.Position = UDim2.new(1, -5, 0.5, 0)
            remove.Size = UDim2.fromOffset(24, 24)
            remove.TextSize = 9.5
            track(remove.MouseButton1Click:Connect(function()
                removeFavorite(item, true)
            end))

            local switch = makeToggleSwitch(row, item.Id, function(api)
                toggleBundle(item, api)
            end, true)
            switch.Pill.AnchorPoint = Vector2.new(1, 0.5)
            switch.Pill.Position = UDim2.new(1, -35, 0.5, 0)
            return row
        end

        local function updateResultCount(count)
            count = tonumber(count) or 0
            resultCount.Text = tostring(count) .. (count == 1 and " animation bundle found" or " animation bundles found")
        end

        renderMarketplace = function(reset)
            if reset == true then
                clearChildren(marketHolder)
                toggleApisById = {}
                starApisById = {}
                renderedCount = 0
            end

            local shown = math.min(displayCount, #currentResults)
            for index = renderedCount + 1, shown do
                createMarketplaceCard(currentResults[index], index)
            end
            renderedCount = shown

            marketHolder.Visible = true
            favoritesHolder.Visible = false
            updateResultCount(#currentResults)
            emptyLabel.Visible = #currentResults == 0 and not searching
            emptyLabel.Text = #currentResults == 0
                and "No animation bundles found. Try another name or a shorter word."
                or ""
            loadMoreHint.Visible = not searching
                and (displayCount < #currentResults or currentHasMore == true)
            loadMoreHint.Text = loadingMore and "Loading..." or "Load More"
            refreshToggleVisuals()
            refreshStarVisuals()
        end

        renderFavorites = function(query)
            clearChildren(marketHolder)
            renderedCount = 0
            clearChildren(favoritesHolder)
            toggleApisById = {}
            starApisById = {}
            local favorites = getFavorites()
            local filtered = {}
            local normalizedQuery = normalizeWords(query)
            local queryTokens = tokenize(normalizedQuery)
            for _, favorite in ipairs(favorites) do
                local normalizedName = normalizeWords(favorite.Name)
                local matches = normalizedQuery == "" or normalizedName:find(normalizedQuery, 1, true) ~= nil
                if not matches and #queryTokens > 0 then
                    matches = true
                    for _, token in ipairs(queryTokens) do
                        if not normalizedName:find(token, 1, true) then
                            matches = false
                            break
                        end
                    end
                end
                if matches then table.insert(filtered, favorite) end
            end
            for index, item in ipairs(filtered) do
                createFavoriteRow(item, index)
            end
            marketHolder.Visible = false
            favoritesHolder.Visible = true
            updateResultCount(#filtered)
            emptyLabel.Visible = #filtered == 0
            if #favorites == 0 then
                emptyLabel.Text = "No favorites yet. Press the star on a Marketplace animation bundle to add one."
            else
                emptyLabel.Text = "No favorite animation bundles match this search."
            end
            refreshToggleVisuals()
        end

        local function setSuggestion(correctedQuery, originalQuery)
            local visible = correctedQuery ~= nil and originalQuery ~= nil
            suggestion.Visible = visible
            if visible then
                suggestionText.Text = "Showing results for \"" .. tostring(correctedQuery) .. "\""
                originalSearchButton.Text = "Search original: \"" .. tostring(originalQuery) .. "\""
            end
        end

        local function setSearching(value, message)
            searching = value == true
            loadingLabel.Visible = searching
            if message then loadingLabel.Text = tostring(message) end
            marketSearchButton.Active = not searching
            marketSearchBox.TextEditable = not searching
            favoriteSearchButton.Active = not searching
            favoriteSearchBox.TextEditable = not searching
            if currentMode == "marketplace" then emptyLabel.Visible = false end
        end

        local function appendResults(results)
            for _, item in ipairs(results or {}) do
                if not currentResultIds[item.Id] then
                    currentResultIds[item.Id] = true
                    table.insert(currentResults, item)
                end
            end
            sortResults(currentResults, currentEffectiveQuery)
        end

        local function bestResultScore(results, query)
            local best = 0
            for _, item in ipairs(results or {}) do
                best = math.max(best, resultScore(item.Name, query))
            end
            return best
        end

        local function performMarketplaceSearch(rawQuery, forceOriginal)
            local query = trim(rawQuery)
            searchSerial = searchSerial + 1
            local serial = searchSerial
            setSearching(true, "Searching Roblox Marketplace...")
            setSuggestion(nil, nil)
            currentOriginalQuery = nil
            displayCount = 0
            renderedCount = 0
            clearChildren(marketHolder)
            toggleApisById = {}
            starApisById = {}

            task.spawn(function()
                local ok, results, nextPage, hasMore = pcall(function()
                    return SearchService:SearchMerged(query, forceOriginal == true)
                end)
                if serial ~= searchSerial then return end
                if not ok then
                    currentResults = {}
                    currentResultIds = {}
                    currentNextPage = nil
                    currentHasMore = false
                    displayCount = 0
                    renderedCount = 0
                    setSearching(false)
                    renderMarketplace(true)
                    emptyLabel.Visible = true
                    emptyLabel.Text = "Marketplace search failed: " .. tostring(results)
                    bundleNotify("Roblox Marketplace search failed.", "error", 3.5)
                    return
                end

                local finalQuery = query
                local finalResults = results
                local finalNext = nextPage
                local finalHasMore = hasMore

                if not forceOriginal and query ~= "" then
                    local candidates = {}
                    local seen = {}
                    mergeResults(candidates, results, seen)
                    local correction = findCorrectedQuery(query, candidates)
                    local initialScore = bestResultScore(results, query)
                    if not correction and (#results == 0 or initialScore < 45) then
                        loadingLabel.Text = "Checking bundle names for a possible typo..."
                        local indexItems = SearchService:BuildFuzzyIndex(true)
                        mergeResults(candidates, indexItems, seen)
                        correction = findCorrectedQuery(query, candidates)
                    end
                    if correction and correction ~= normalizeWords(query) then
                        loadingLabel.Text = "Showing the closest matching animation bundles..."
                        local correctedOk, correctedResults, correctedNext, correctedHasMore = pcall(function()
                            return SearchService:SearchMerged(correction, false)
                        end)
                        if correctedOk and #correctedResults > 0 then
                            local correctedScore = bestResultScore(correctedResults, correction)
                            if #results == 0 or correctedScore >= initialScore then
                                finalQuery = correction
                                finalResults = correctedResults
                                finalNext = correctedNext
                                finalHasMore = correctedHasMore
                                currentOriginalQuery = query
                            end
                        end
                    end
                end

                if serial ~= searchSerial then return end
                currentResults = {}
                currentResultIds = {}
                currentEffectiveQuery = finalQuery
                currentNextPage = finalNext
                currentHasMore = finalHasMore == true
                displayCount = 0
                renderedCount = 0
                appendResults(finalResults)
                displayCount = math.min(displayStep, #currentResults)
                setSearching(false)
                renderMarketplace(true)
                if currentOriginalQuery then setSuggestion(finalQuery, currentOriginalQuery) end
            end)
        end

        local function loadMoreResults()
            if loadingMore or searching or currentMode ~= "marketplace" then return end

            if displayCount < #currentResults then
                displayCount = math.min(#currentResults, displayCount + displayStep)
                renderMarketplace(false)
                return
            end

            if not currentHasMore or typeof(currentNextPage) ~= "function" then
                loadMoreHint.Visible = false
                return
            end

            loadingMore = true
            loadMoreHint.Visible = true
            loadMoreHint.Text = "Loading..."
            loadingLabel.Text = "Loading more animation bundles..."
            loadingLabel.Visible = true

            task.spawn(function()
                local before = #currentResults
                local ok, page, hasMore = pcall(currentNextPage)
                if ok then
                    currentHasMore = hasMore == true
                    appendResults(page)
                    displayCount = math.min(
                        #currentResults,
                        math.max(displayCount + displayStep, before + displayStep)
                    )
                else
                    currentHasMore = false
                    bundleNotify("Could not load the next Marketplace page.", "error", 3)
                end

                loadingMore = false
                loadingLabel.Visible = searching
                renderMarketplace(true)
            end)
        end

        track(loadMoreHint.MouseButton1Click:Connect(function()
            loadMoreResults()
        end))

        local function runCurrentSearch(forceOriginal)
            if currentMode == "favorites" then
                searchSerial = searchSerial + 1
                setSuggestion(nil, nil)
                renderFavorites(favoriteSearchBox.Text)
            else
                performMarketplaceSearch(marketSearchBox.Text, forceOriginal == true)
            end
        end

        local function setMode(mode)
            currentMode = mode == "favorites" and "favorites" or "marketplace"
            state.Mode = currentMode
            local marketplaceActive = currentMode == "marketplace"
            marketplaceTabButton.BackgroundColor3 = marketplaceActive and animationAccent(active.Theme.SchemeColor) or active.Theme.ElementColor
            favoritesTabButton.BackgroundColor3 = marketplaceActive and active.Theme.ElementColor or animationAccent(active.Theme.SchemeColor)
            deleteAllButton.Visible = not marketplaceActive
            favoriteSaveControls:SetVisible(not marketplaceActive)
            marketSearchRow.Visible = marketplaceActive
            favoriteSearchRow.Visible = not marketplaceActive
            loadMoreHint.Visible = marketplaceActive
                and not searching
                and (displayCount < #currentResults or currentHasMore == true)
            suggestion.Visible = marketplaceActive and currentOriginalQuery ~= nil
            if marketplaceActive then
                marketHolder.Visible = true
                favoritesHolder.Visible = false
                if #currentResults == 0 and not searching then
                    performMarketplaceSearch(marketSearchBox.Text, false)
                else
                    renderMarketplace(false)
                end
            else
                renderFavorites(favoriteSearchBox.Text)
            end
            task.defer(function() scroll.CanvasPosition = Vector2.new(0, 0) end)
        end

        track(marketplaceTabButton.MouseButton1Click:Connect(function() setMode("marketplace") end))
        track(favoritesTabButton.MouseButton1Click:Connect(function() setMode("favorites") end))
        track(marketSearchButton.MouseButton1Click:Connect(function() runCurrentSearch(false) end))
        track(favoriteSearchButton.MouseButton1Click:Connect(function() runCurrentSearch(false) end))
        track(marketSearchBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then runCurrentSearch(false) end
        end))
        track(favoriteSearchBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then runCurrentSearch(false) end
        end))
        track(originalSearchButton.MouseButton1Click:Connect(function()
            if currentOriginalQuery then
                marketSearchBox.Text = currentOriginalQuery
                runCurrentSearch(true)
            end
        end))

        local marketClearButton = marketSearchRow:FindFirstChild("AnimationBundleMarketplaceSearchBox_ClearTextX")
        if marketClearButton then
            track(marketClearButton.MouseButton1Click:Connect(function()
                task.defer(function()
                    if currentMode == "marketplace" then runCurrentSearch(false) end
                end)
            end))
        end
        local favoriteClearButton = favoriteSearchRow:FindFirstChild("AnimationBundleFavoriteSearchBox_ClearTextX")
        if favoriteClearButton then
            track(favoriteClearButton.MouseButton1Click:Connect(function()
                task.defer(function()
                    if currentMode == "favorites" then renderFavorites(favoriteSearchBox.Text) end
                end)
            end))
        end

        track(deleteAllButton.MouseButton1Click:Connect(function()
            local favorites = getFavorites()
            if #favorites == 0 then
                bundleNotify("Favorites is already empty.", "info", 2.2)
                return
            end
            LULA:Confirm("Delete all favorites?", "Are you sure you want to delete every saved animation bundle from Favorites?", function()
                saveFavorites({})
                refreshStarVisuals()
                renderFavorites(favoriteSearchBox.Text)
                bundleNotify("All animation bundle favorites were deleted.", "success", 2.7)
            end)
        end))

        state.RefreshTheme = function()
            local marketplaceActive = currentMode == "marketplace"
            marketplaceTabButton.BackgroundColor3 = marketplaceActive and animationAccent(active.Theme.SchemeColor) or active.Theme.ElementColor
            favoritesTabButton.BackgroundColor3 = marketplaceActive and active.Theme.ElementColor or animationAccent(active.Theme.SchemeColor)
            favoriteSaveControls:Render()
            animationText(marketplaceTabButton)
            animationText(favoritesTabButton)
            animationText(detailApply)
            animationText(detailRestore)
            refreshStarVisuals()
            refreshToggleVisuals()
        end
        state.Refresh = function()
            if currentMode == "favorites" then renderFavorites(favoriteSearchBox.Text) else renderMarketplace() end
        end
        state.Search = function(query)
            marketSearchBox.Text = tostring(query or "")
            setMode("marketplace")
            runCurrentSearch(false)
        end
        state.RestoreOriginal = function()
            state.ToggleSerial = (state.ToggleSerial or 0) + 1
            local restored = restoreOriginalAnimations(true)
            state.ActiveId = nil
            state.ActiveItem = nil
            state.ActiveSlots = nil
            refreshToggleVisuals()
            return restored
        end

        settings.AnimationBundleFavorites = saveFavorites(getFavorites())
        setMode("marketplace")
        SearchService:BuildFuzzyIndex(false)
        return bundleTab
    end


    function window:EnableFreeEmotes(tabName)
        if active.FreeEmotes then return active.FreeEmotes.Tab end

        local emoteTab = self:NewTab(tabName or (utf8.char(0x2605) .. " Free Emotes"))
        emoteTab:EnsureBuilt()
        local scroll = emoteTab.Scroll
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.CanvasSize = UDim2.new()

        local UI = {}
        local state = {
            Tab = emoteTab,
            Scroll = scroll,
            Mode = "marketplace",
            Results = {},
            ResultIds = {},
            DisplayCount = 0,
            DisplayStep = 9,
            RenderedCount = 0,
            NextPage = nil,
            HasMore = false,
            Searching = false,
            LoadingMore = false,
            SearchSerial = 0,
            Active = {
                Id = nil,
                Item = nil,
                Track = nil,
                Animation = nil,
                StoppedConnection = nil,
                KeepAliveConnection = nil,
                Serial = 0,
                PlayableId = nil,
            },
            DetailItem = nil,
            DetailPreview = nil,
        }
        local cache = {
            Details = {},
            Playable = {},
            Fuzzy = {},
        }
        local registry = {
            Toggles = {},
            Stars = {},
            Speeds = {},
            Previews = {},
        }
        active.FreeEmotes = state

        local STAR_EMPTY = utf8.char(0x2606)
        local STAR_FILLED = utf8.char(0x2605)
        local STAR_EMOJI = utf8.char(0x2B50, 0xFE0F)
        local SEARCH_ICON = utf8.char(0x1F50D)
        local YELLOW = rgb(255, 213, 54)
        local EMOTE_DARK = rgb(18, 18, 24)
        local EMOTE_GREEN = blendColor(TOGGLE_ON_COLOR, EMOTE_DARK, 0.42)
        local EMOTE_RED = blendColor(TOGGLE_OFF_COLOR, EMOTE_DARK, 0.42)

        local function emoteAccent(color)
            return blendColor(color, EMOTE_DARK, 0.48)
        end

        local function trim(value)
            return tostring(value or ""):match("^%s*(.-)%s*$") or ""
        end

        local function lower(value)
            return string.lower(tostring(value or ""))
        end

        local function normalizeWords(value)
            local text = lower(value)
            text = text:gsub("_", " ")
            text = text:gsub("[^%w%s]", " ")
            text = text:gsub("%s+", " ")
            return trim(text)
        end

        local function tokenize(value)
            local output = {}
            for token in normalizeWords(value):gmatch("%S+") do
                table.insert(output, token)
            end
            return output
        end

        local function containsPlain(haystack, needle)
            return string.find(lower(haystack), lower(needle), 1, true) ~= nil
        end

        local function emoteNotify(message, kind, seconds)
            kind = tostring(kind or "info")
            LULA:Notify(kind, "Free Emotes", tostring(message), seconds or 3, nil, true)
        end

        local function getRequestFunction()
            local candidates = {
                rawget(env, "request"),
                rawget(env, "http_request"),
                rawget(env, "httprequest"),
            }
            local synTable = rawget(env, "syn")
            if type(synTable) == "table" then table.insert(candidates, synTable.request) end
            local fluxusTable = rawget(env, "fluxus")
            if type(fluxusTable) == "table" then table.insert(candidates, fluxusTable.request) end
            for _, candidate in ipairs(candidates) do
                if typeof(candidate) == "function" then return candidate end
            end
            return nil
        end

        local executorRequest = getRequestFunction()

        local function httpGet(url)
            local failures = {}
            if executorRequest then
                local ok, response = pcall(executorRequest, {
                    Url = tostring(url),
                    Method = "GET",
                    Headers = {
                        ["Accept"] = "application/json",
                        ["User-Agent"] = "Roblox/LollypopHub-FreeEmotes",
                    },
                })
                if ok and type(response) == "table" then
                    local status = tonumber(response.StatusCode or response.Status or response.status_code or 0) or 0
                    local body = response.Body or response.body
                    if status >= 200 and status < 300 and type(body) == "string" and #body > 0 then
                        return body
                    end
                    table.insert(failures, "request HTTP " .. tostring(status > 0 and status or "unknown"))
                elseif not ok then
                    table.insert(failures, tostring(response))
                end
            end

            local ok, body = pcall(function() return game:HttpGet(tostring(url), true) end)
            if ok and type(body) == "string" and #body > 0 then return body end
            if not ok then table.insert(failures, tostring(body)) end
            error("HTTP GET failed" .. (#failures > 0 and (": " .. table.concat(failures, "; ")) or ""))
        end

        local function copyText(text)
            text = tostring(text or "")
            local compat = rawget(env, "LHCompat")
            if type(compat) == "table" and type(compat.SetClipboard) == "function" then
                local ok, result = pcall(compat.SetClipboard, text)
                if ok and result ~= false then return true end
            end
            local candidates = {
                rawget(env, "setclipboard"),
                rawget(env, "toclipboard"),
                rawget(env, "writeclipboard"),
            }
            local synTable = rawget(env, "syn")
            if type(synTable) == "table" then
                table.insert(candidates, synTable.write_clipboard)
                table.insert(candidates, synTable.setclipboard)
            end
            for _, writer in ipairs(candidates) do
                if typeof(writer) == "function" and pcall(writer, text) then return true end
            end
            return false
        end

        local function isFiniteNumber(value)
            return type(value) == "number"
                and value == value
                and value ~= math.huge
                and value ~= -math.huge
        end

        local function formatSpeed(value)
            value = tonumber(value) or 1
            if value == 0 then return "0" end
            local absolute = math.abs(value)
            if absolute >= 1000000 or absolute < 0.0001 then
                return string.format("%.6g", value)
            end
            local text = string.format("%.3f", value)
            text = text:gsub("0+$", ""):gsub("%.$", "")
            if text == "-0" then text = "0" end
            return text
        end

        local function getSpeed(emoteId)
            local key = tostring(emoteId)
            local saved = settings.FreeEmoteSpeeds[key]
            saved = tonumber(saved)
            if not isFiniteNumber(saved) then
                saved = 1
                settings.FreeEmoteSpeeds[key] = saved
            end
            return saved
        end

        local function persistEmoteSettings()
            env.LHSettings = env.LHSettings or {}
            env.LHUISettings = env.LHUISettings or settings
            env.LHSettings.FreeEmoteFavorites = settings.FreeEmoteFavorites
            env.LHSettings.FreeEmoteAutoSave = settings.FreeEmoteAutoSave
            env.LHSettings.FreeEmoteSpeeds = settings.FreeEmoteSpeeds
            env.LHUISettings.FreeEmoteFavorites = settings.FreeEmoteFavorites
            env.LHUISettings.FreeEmoteAutoSave = settings.FreeEmoteAutoSave
            env.LHUISettings.FreeEmoteSpeeds = settings.FreeEmoteSpeeds
            markSettingsDirty()
        end

        local function refreshSpeedControls(emoteId)
            local list = registry.Speeds[tonumber(emoteId)] or {}
            local value = getSpeed(emoteId)
            for _, api in ipairs(list) do
                if api and api.Render then api:Render(value) end
            end
        end

        local function refreshPreviewSpeeds(emoteId)
            local list = registry.Previews[tonumber(emoteId)] or {}
            local value = getSpeed(emoteId)
            for _, api in ipairs(list) do
                if api and api.SetSpeed then api:SetSpeed(value) end
            end
        end

        local function setSpeed(emoteId, value)
            value = tonumber(value)
            if not isFiniteNumber(value) then return false end
            settings.FreeEmoteSpeeds[tostring(emoteId)] = value
            persistEmoteSettings()
            refreshSpeedControls(emoteId)
            refreshPreviewSpeeds(emoteId)
            if tonumber(state.Active.Id) == tonumber(emoteId) and state.Active.Track then
                pcall(function() state.Active.Track:AdjustSpeed(value) end)
            end
            return true
        end

        local function bindHoldRepeat(button, callback)
            local token = 0
            local lastPointerStart = 0

            local function stop()
                token = token + 1
            end

            track(button.InputBegan:Connect(function(input)
                local pointer = input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch
                if not pointer then return end
                token = token + 1
                local mine = token
                lastPointerStart = os.clock()
                callback()
                task.delay(0.34, function()
                    while mine == token and button.Parent do
                        callback()
                        task.wait(0.055)
                    end
                end)
            end))

            track(button.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    stop()
                end
            end))

            track(button.Activated:Connect(function()
                if os.clock() - lastPointerStart > 0.18 then callback() end
            end))
        end

        local function makeSpeedControl(parent, emoteId, compact)
            local api = {}
            local height = compact and 22 or 24
            local row = Instance.new("Frame")
            row.Name = "EmoteSpeedControl"
            row.Size = UDim2.new(1, 0, 0, height)
            row.BackgroundTransparency = 1
            row.Parent = parent

            local minus = makeButton(row, "-")
            minus.Position = UDim2.fromOffset(0, 0)
            minus.Size = UDim2.fromOffset(height, height)
            minus.TextSize = compact and 12 or 14

            local plus = makeButton(row, "+")
            plus.AnchorPoint = Vector2.new(1, 0)
            plus.Position = UDim2.new(1, 0, 0, 0)
            plus.Size = UDim2.fromOffset(height, height)
            plus.TextSize = compact and 12 or 14

            local box = Instance.new("TextBox")
            box.Name = "EmoteSpeedBox"
            box.Position = UDim2.fromOffset(height + 3, 0)
            box.Size = UDim2.new(1, -(height * 2 + 6), 1, 0)
            box.BackgroundTransparency = 0.05
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            box.Font = resolveUIFont(Enum.Font.GothamBold)
            box.TextSize = compact and 9.5 or 10.5
            box.TextXAlignment = Enum.TextXAlignment.Center
            box.Parent = row
            bind(box, "BackgroundColor3", "Header")
            bind(box, "TextColor3", "TextColor")
            makeCorner(box, 5)

            function api:Render(value)
                if box and box.Parent and not box:IsFocused() then
                    box.Text = formatSpeed(value)
                end
            end

            local function change(delta)
                setSpeed(emoteId, getSpeed(emoteId) + delta)
            end

            bindHoldRepeat(minus, function() change(-0.1) end)
            bindHoldRepeat(plus, function() change(0.1) end)
            track(box.FocusLost:Connect(function()
                local value = tonumber(trim(box.Text))
                if not isFiniteNumber(value) then
                    box.Text = formatSpeed(getSpeed(emoteId))
                    emoteNotify("Type a valid animation speed.", "warning", 2.4)
                    return
                end
                setSpeed(emoteId, value)
            end))

            registry.Speeds[tonumber(emoteId)] = registry.Speeds[tonumber(emoteId)] or {}
            table.insert(registry.Speeds[tonumber(emoteId)], api)
            api:Render(getSpeed(emoteId))
            api.Row = row
            api.Box = box
            return api
        end

        local function cleanFavorite(raw)
            if type(raw) ~= "table" then return nil end
            local id = tonumber(raw.Id or raw.id)
            local name = raw.Name or raw.name
            if not id or type(name) ~= "string" then return nil end
            return {
                Id = id,
                Name = name,
                Description = raw.Description or raw.description or "",
                CreatorName = raw.CreatorName or raw.creatorName or "Unknown creator",
                CreatorId = tonumber(raw.CreatorId or raw.creatorId),
                AssetType = tonumber(raw.AssetType or raw.assetType) or 61,
                Price = tonumber(raw.Price or raw.price),
                PlayableAnimationId = tonumber(raw.PlayableAnimationId or raw.playableAnimationId),
            }
        end

        local function getFavorites()
            local clean = {}
            local seen = {}
            for _, raw in ipairs(settings.FreeEmoteFavorites or {}) do
                local favorite = cleanFavorite(raw)
                if favorite and not seen[favorite.Id] then
                    seen[favorite.Id] = true
                    table.insert(clean, favorite)
                end
            end
            return clean
        end

        local function saveFavorites(updated, forceSave)
            local clean = {}
            local seen = {}
            for _, raw in ipairs(updated or {}) do
                local favorite = cleanFavorite(raw)
                if favorite and not seen[favorite.Id] then
                    seen[favorite.Id] = true
                    table.insert(clean, favorite)
                end
            end
            settings.FreeEmoteFavorites = clean
            persistEmoteSettings()
            if forceSave == true or settings.FreeEmoteAutoSave ~= false then
                saveSettingsNow()
            end
            return clean
        end

        local function favoriteIndex(emoteId)
            emoteId = tonumber(emoteId)
            for index, favorite in ipairs(getFavorites()) do
                if tonumber(favorite.Id) == emoteId then return index end
            end
            return nil
        end

        local function isEmoteAssetType(value)
            if typeof(value) == "EnumItem" then value = value.Name end
            if type(value) == "number" then return value == 61 end
            return lower(value):find("emote", 1, true) ~= nil
        end

        local function normalizeCatalogItem(raw, trusted)
            if type(raw) ~= "table" then return nil end
            local id = tonumber(raw.Id or raw.id or raw.AssetId or raw.assetId)
            local name = raw.Name or raw.name
            if not id or type(name) ~= "string" then return nil end

            local itemType = raw.ItemType or raw.itemType or raw.Type or raw.type
            local assetType = raw.AssetType or raw.assetType or raw.AssetTypeId or raw.assetTypeId
            if typeof(itemType) == "EnumItem" then itemType = itemType.Name end
            if itemType ~= nil then
                local itemText = lower(itemType)
                if itemText:find("bundle", 1, true) or tonumber(itemType) == 2 then return nil end
            end
            if assetType ~= nil and not isEmoteAssetType(assetType) then return nil end
            if assetType == nil and trusted ~= true then
                local productType = tonumber(raw.AssetTypeId or raw.assetTypeId)
                if productType and productType ~= 61 then return nil end
            end

            local creator = raw.Creator or raw.creator
            local creatorName = raw.CreatorName or raw.creatorName
            local creatorId = raw.CreatorId or raw.creatorId or raw.CreatorTargetId or raw.creatorTargetId
            if type(creator) == "table" then
                creatorName = creatorName or creator.Name or creator.name
                creatorId = creatorId or creator.Id or creator.id or creator.CreatorTargetId
            end

            return {
                Id = id,
                Name = name,
                Description = raw.Description or raw.description or "",
                CreatorName = creatorName or "Unknown creator",
                CreatorId = tonumber(creatorId),
                AssetType = tonumber(assetType) or 61,
                Price = tonumber(raw.Price or raw.price or raw.LowestPrice or raw.lowestPrice),
                Raw = raw,
            }
        end

        local function normalizePage(page, trusted)
            local output = {}
            local seen = {}
            for _, raw in ipairs(page or {}) do
                local item = normalizeCatalogItem(raw, trusted)
                if item and not seen[item.Id] then
                    seen[item.Id] = true
                    table.insert(output, item)
                end
            end
            return output
        end

        local function addFuzzyItems(items)
            local seen = {}
            for _, old in ipairs(cache.Fuzzy) do seen[tonumber(old.Id)] = true end
            for _, item in ipairs(items or {}) do
                if item and not seen[tonumber(item.Id)] then
                    seen[tonumber(item.Id)] = true
                    table.insert(cache.Fuzzy, item)
                end
            end
            while #cache.Fuzzy > 360 do table.remove(cache.Fuzzy, 1) end
        end

        local function mergeResults(items)
            for _, item in ipairs(items or {}) do
                if item and not state.ResultIds[item.Id] then
                    state.ResultIds[item.Id] = true
                    table.insert(state.Results, item)
                end
            end
            addFuzzyItems(items)
        end

        local function editDistance(a, b)
            a, b = normalizeWords(a), normalizeWords(b)
            if a == b then return 0 end
            if #a == 0 then return #b end
            if #b == 0 then return #a end
            local previous = {}
            for j = 0, #b do previous[j] = j end
            for i = 1, #a do
                local current = {[0] = i}
                local ac = a:sub(i, i)
                for j = 1, #b do
                    local cost = ac == b:sub(j, j) and 0 or 1
                    current[j] = math.min(
                        current[j - 1] + 1,
                        previous[j] + 1,
                        previous[j - 1] + cost
                    )
                end
                previous = current
            end
            return previous[#b]
        end

        local function findCorrection(query)
            query = normalizeWords(query)
            if query == "" then return nil end
            local bestName, bestDistance, bestRatio = nil, math.huge, 0
            for _, item in ipairs(cache.Fuzzy) do
                local candidate = normalizeWords(item.Name)
                if candidate ~= "" then
                    local distance = editDistance(query, candidate)
                    local ratio = 1 - distance / math.max(#query, #candidate, 1)
                    if ratio > bestRatio or (ratio == bestRatio and distance < bestDistance) then
                        bestName, bestDistance, bestRatio = candidate, distance, ratio
                    end
                end
            end
            if bestName and bestRatio >= 0.57 then return bestName end
            return nil
        end

        local function fetchDirectEmote(assetId)
            local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, tonumber(assetId), Enum.InfoType.Asset)
            if not ok or type(info) ~= "table" then return nil end
            local assetType = tonumber(info.AssetTypeId or info.AssetType)
            if assetType and assetType ~= 61 then return nil end
            return normalizeCatalogItem({
                Id = tonumber(info.AssetId or assetId),
                Name = info.Name or ("Emote " .. tostring(assetId)),
                Description = info.Description or "",
                Creator = info.Creator,
                AssetTypeId = assetType or 61,
                Price = info.PriceInRobux,
            }, true)
        end

        local function createEngineSearch(query)
            local params = CatalogSearchParams.new()
            params.SearchKeyword = tostring(query or "")
            params.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
            params.IncludeOffSale = true
            params.Limit = 30
            pcall(function() params.SortType = Enum.CatalogSortType.Relevance end)
            pcall(function() params.SortAggregation = Enum.CatalogSortAggregation.AllTime end)
            pcall(function() params.CategoryFilter = Enum.CatalogCategoryFilter.AvatarAnimations end)

            local pages = AvatarEditorService:SearchCatalogAsync(params)
            local first = normalizePage(pages:GetCurrentPage(), true)

            local function nextPage()
                local finished = false
                pcall(function() finished = pages.IsFinished end)
                if finished then return {}, false end
                pages:AdvanceToNextPageAsync()
                local page = normalizePage(pages:GetCurrentPage(), true)
                pcall(function() finished = pages.IsFinished end)
                return page, not finished
            end

            local finished = false
            pcall(function() finished = pages.IsFinished end)
            return first, nextPage, not finished
        end

        local function createHttpSearch(query, cursor)
            local url = "https://catalog.roblox.com/v1/search/items/details?Category=12&Subcategory=39&Limit=30&SortType=3"
            if trim(query) ~= "" then
                url = url .. "&Keyword=" .. HttpService:UrlEncode(trim(query))
            end
            if trim(cursor) ~= "" then
                url = url .. "&Cursor=" .. HttpService:UrlEncode(trim(cursor))
            end
            local decoded = HttpService:JSONDecode(httpGet(url))
            local items = normalizePage(decoded.data or decoded.Data or {}, true)
            local nextCursor = decoded.nextPageCursor or decoded.NextPageCursor

            local function nextPage()
                if not nextCursor then return {}, false end
                local nextItems, nextFunction, hasMore = createHttpSearch(query, nextCursor)
                return nextItems, hasMore, nextFunction
            end

            return items, nextPage, nextCursor ~= nil
        end

        local function startSearchBackend(query)
            local numericId = trim(query):match("^%d+$")
            if numericId then
                local direct = fetchDirectEmote(numericId)
                if direct then return {direct}, nil, false end
            end

            local ok, items, nextFunction, hasMore = pcall(createEngineSearch, query)
            if ok and type(items) == "table" then
                return items, nextFunction, hasMore == true
            end

            local httpOk, httpItems, httpNext, httpMore = pcall(createHttpSearch, query, nil)
            if httpOk and type(httpItems) == "table" then
                return httpItems, httpNext, httpMore == true
            end

            error("Roblox Marketplace search was unavailable.")
        end

        local KNOWN_ROBLOX_EMOTES = {
            ["elton john still standing"] = 11444443576,
            ["old town road lil nas x"] = 10714391240,
            ["shuffle"] = 10714371274,
            ["sleep"] = 10714360343,
            ["godlike"] = 10714347256,
            ["the floss"] = 10714340543,
            ["dizzy"] = 10714066964,
            ["festive dance"] = 15679621440,
            ["nicki minaj starships"] = 15571453761,
            ["cuco levitate"] = 15698404340,
            ["elton john heart skip"] = 11309255148,
            ["flex walk"] = 15505459811,
        }

        local function extractNumericId(value)
            if type(value) == "number" then return math.floor(value) end
            local digits = tostring(value or ""):match("(%d+)")
            return digits and tonumber(digits) or nil
        end

        local function animationUri(value)
            local id = extractNumericId(value)
            if not id then error("Invalid animation ID.") end
            return "rbxassetid://" .. tostring(id)
        end

        local function canonicalName(value)
            local text = normalizeWords(value)
            text = text:gsub("%s+roblox%s*$", "")
            return trim(text)
        end

        local function findAnimationInObject(root, fallbackId)
            if not root then return nil end
            local candidates = {}

            local function inspect(object)
                if object and object:IsA("Animation") then
                    local id = extractNumericId(object.AnimationId)
                    if id then table.insert(candidates, id) end
                end
            end

            inspect(root)
            for _, descendant in ipairs(root:GetDescendants()) do
                inspect(descendant)
            end

            -- Marketplace emote IDs can wrap a different sanitized animation ID.
            -- Always prefer an inner ID that differs from the Marketplace ID.
            for _, id in ipairs(candidates) do
                if id ~= tonumber(fallbackId) then return id end
            end
            return candidates[1]
        end

        local function destroyLoadedAsset(result)
            if typeof(result) == "Instance" then
                pcall(function() result:Destroy() end)
            elseif type(result) == "table" then
                for _, object in ipairs(result) do
                    if typeof(object) == "Instance" then
                        pcall(function() object:Destroy() end)
                    end
                end
            end
        end

        local function inspectLoadedAsset(result, fallbackId)
            if typeof(result) == "Instance" then
                return findAnimationInObject(result, fallbackId)
            end
            if type(result) == "table" then
                for _, object in ipairs(result) do
                    if typeof(object) == "Instance" then
                        local found = findAnimationInObject(object, fallbackId)
                        if found and found ~= tonumber(fallbackId) then return found end
                    end
                end
                for _, object in ipairs(result) do
                    if typeof(object) == "Instance" then
                        local found = findAnimationInObject(object, fallbackId)
                        if found then return found end
                    end
                end
            end
            return nil
        end

        local function inspectAsset(assetId)
            assetId = tonumber(assetId)
            if not assetId then return nil end

            local attempts = {
                {
                    Name = "AssetService inner AnimationId",
                    Load = function()
                        return AssetService:LoadAssetAsync(assetId)
                    end,
                },
                {
                    Name = "InsertService inner AnimationId",
                    Load = function()
                        return InsertService:LoadAsset(assetId)
                    end,
                },
                {
                    Name = "GetObjects inner AnimationId",
                    Load = function()
                        return game:GetObjects(animationUri(assetId))
                    end,
                },
            }

            for _, attempt in ipairs(attempts) do
                local ok, loaded = pcall(attempt.Load)
                if ok and loaded then
                    local found = inspectLoadedAsset(loaded, assetId)
                    destroyLoadedAsset(loaded)
                    if found and found ~= assetId then
                        return found, attempt.Name
                    end
                end
            end
            return nil
        end

        local function storePlayableId(item, marketplaceId, playableId, sourceName, wrapperOnly)
            cache.Playable[marketplaceId] = {
                Id = playableId,
                Source = sourceName,
                WrapperOnly = wrapperOnly == true,
            }
            item.PlayableAnimationId = playableId
            item.PlayableSource = sourceName

            local details = cache.Details[marketplaceId]
            if type(details) == "table" then
                details.PlayableAnimationId = playableId
                details.PlayableSource = sourceName
            end
        end

        local function resolvePlayableAnimationId(item)
            local marketplaceId = extractNumericId(item and item.Id)
            if not marketplaceId then error("This emote did not contain a valid ID.") end

            local cached = cache.Playable[marketplaceId]
            if cached then
                return cached.Id, cached.Source, cached.WrapperOnly == true
            end

            local raw = type(item.Raw) == "table" and item.Raw or {}
            local candidates = {
                item.PlayableAnimationId,
                item.AnimationId,
                raw.AnimationId,
                raw.animationId,
                raw.PlayableAnimationId,
                raw.playableAnimationId,
            }

            for _, candidate in ipairs(candidates) do
                local id = extractNumericId(candidate)
                if id and id ~= marketplaceId then
                    storePlayableId(item, marketplaceId, id, "Marketplace metadata", false)
                    return id, "Marketplace metadata", false
                end
            end

            local creatorText = lower(item.CreatorName)
            local known = KNOWN_ROBLOX_EMOTES[canonicalName(item.Name)]
            local official = tonumber(item.CreatorId) == 1
                or creatorText:find("roblox", 1, true) ~= nil

            if known and (official or known == marketplaceId) then
                storePlayableId(item, marketplaceId, known, "Verified Roblox emote", false)
                return known, "Verified Roblox emote", false
            end

            -- This inspection used to be skipped for AssetType 61. That caused the
            -- Marketplace wrapper ID to be cached as the playable animation ID.
            local inspected, sourceName = inspectAsset(marketplaceId)
            if inspected then
                storePlayableId(item, marketplaceId, inspected, sourceName, false)
                return inspected, sourceName, false
            end

            -- Keep the Marketplace ID for Roblox's native emote player, but mark it
            -- as a wrapper so manual LoadAnimation never receives it by mistake.
            storePlayableId(item, marketplaceId, marketplaceId, "Roblox emote player", true)
            return marketplaceId, "Roblox emote player", true
        end

        local function withRobloxIdentity(callback)
            local setter = rawget(env, "setthreadidentity")
                or rawget(env, "set_thread_identity")
                or rawget(env, "setidentity")
            local getter = rawget(env, "getthreadidentity")
                or rawget(env, "get_thread_identity")
                or rawget(env, "getidentity")

            local previous
            if type(getter) == "function" then
                pcall(function() previous = getter() end)
            end
            if type(setter) == "function" then
                pcall(setter, 8)
            end

            local ok, packed = pcall(function()
                return table.pack(callback())
            end)

            if type(setter) == "function" and previous ~= nil then
                pcall(setter, previous)
            end
            return ok, packed
        end

        local function findAnimationTrack(values)
            if type(values) ~= "table" then return nil end
            for index = 1, values.n or #values do
                local value = values[index]
                if typeof(value) == "Instance" and value:IsA("AnimationTrack") then
                    return value
                end
            end
            return nil
        end

        local function rememberTrackAnimationId(item, trackObject)
            local marketplaceId = extractNumericId(item and item.Id)
            local animationObject
            pcall(function() animationObject = trackObject.Animation end)
            local sanitizedId = animationObject and extractNumericId(animationObject.AnimationId)
            if marketplaceId and sanitizedId and sanitizedId ~= marketplaceId then
                storePlayableId(item, marketplaceId, sanitizedId, "Roblox sanitized emote", false)
            end
            return sanitizedId
        end

        local function tryNativeMarketplaceEmote(humanoid, item, speed)
            local marketplaceId = extractNumericId(item and item.Id)
            if not humanoid or not marketplaceId then return nil end

            local ok, packed = withRobloxIdentity(function()
                return humanoid:PlayEmoteAndGetAnimTrackById(marketplaceId)
            end)
            if not ok then return nil end

            local trackObject = findAnimationTrack(packed)
            if not trackObject then return nil end

            trackObject.Looped = true
            pcall(function() trackObject.Priority = Enum.AnimationPriority.Action4 end)
            pcall(function() trackObject:AdjustSpeed(speed) end)
            local sanitizedId = rememberTrackAnimationId(item, trackObject)
            return trackObject, sanitizedId or marketplaceId, "Roblox emote player"
        end

        local function tryLocalDescriptionEmote(humanoid, animator, item, speed)
            local character = LocalPlayer.Character
            if not humanoid or not character or humanoid.Parent ~= character then return nil end

            local marketplaceId = extractNumericId(item and item.Id)
            if not marketplaceId then return nil end

            local before = {}
            pcall(function()
                for _, trackObject in ipairs(animator:GetPlayingAnimationTracks()) do
                    before[trackObject] = true
                end
            end)

            local emoteName = "LH_FreeEmote"
            local appliedOk, played = pcall(function()
                local description = humanoid:GetAppliedDescription()
                pcall(function() description:RemoveEmote(emoteName) end)
                description:AddEmote(emoteName, marketplaceId)

                local applyOk = pcall(function()
                    humanoid:ApplyDescriptionAsync(description)
                end)
                if not applyOk then
                    humanoid:ApplyDescription(description)
                end

                if humanoid.PlayEmoteAsync then
                    return humanoid:PlayEmoteAsync(emoteName)
                end
                return humanoid:PlayEmote(emoteName)
            end)
            if not appliedOk or played ~= true then return nil end

            RunService.Heartbeat:Wait()
            local newTrack
            pcall(function()
                for _, trackObject in ipairs(animator:GetPlayingAnimationTracks()) do
                    if not before[trackObject] then
                        newTrack = trackObject
                        break
                    end
                end
            end)
            if not newTrack then return nil end

            newTrack.Looped = true
            pcall(function() newTrack.Priority = Enum.AnimationPriority.Action4 end)
            pcall(function() newTrack:AdjustSpeed(speed) end)
            local sanitizedId = rememberTrackAnimationId(item, newTrack)
            return newTrack, sanitizedId or marketplaceId, "Humanoid emote"
        end

        local function fetchDetails(item)
            if cache.Details[item.Id] then return cache.Details[item.Id] end
            local output = {
                Id = item.Id,
                Name = item.Name,
                Description = item.Description or "",
                CreatorName = item.CreatorName or "Unknown creator",
                CreatorId = item.CreatorId,
                AssetType = item.AssetType or 61,
                Price = item.Price,
            }
            local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, tonumber(item.Id), Enum.InfoType.Asset)
            if ok and type(info) == "table" then
                output.Name = info.Name or output.Name
                output.Description = info.Description or output.Description
                output.CreatorName = type(info.Creator) == "table" and (info.Creator.Name or output.CreatorName) or output.CreatorName
                output.CreatorId = type(info.Creator) == "table" and tonumber(info.Creator.Id or info.Creator.CreatorTargetId) or output.CreatorId
                output.AssetType = tonumber(info.AssetTypeId) or output.AssetType
                output.Price = tonumber(info.PriceInRobux) or output.Price
            end
            local playableId, sourceName = resolvePlayableAnimationId(item)
            output.PlayableAnimationId = playableId
            output.PlayableSource = sourceName
            output.Raw = item.Raw
            cache.Details[item.Id] = output
            return output
        end

        local function getCharacterAnimationLoader()
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
            if not humanoid then error("Your avatar does not have a Humanoid.") end
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if not animator then
                animator = Instance.new("Animator")
                animator.Parent = humanoid
            end
            return character, humanoid, animator
        end

        local function refreshToggleVisuals()
            for emoteId, apis in pairs(registry.Toggles) do
                local enabled = tonumber(state.Active.Id) == tonumber(emoteId)
                for _, api in ipairs(apis) do
                    if api and api.Render then api:Render(enabled) end
                end
            end
        end

        local function refreshStarVisuals()
            for emoteId, apis in pairs(registry.Stars) do
                local saved = favoriteIndex(emoteId) ~= nil
                for _, api in ipairs(apis) do
                    if api and api.Render then api:Render(saved) end
                end
            end
        end

        local function stopActiveEmote(silent)
            state.Active.Serial = state.Active.Serial + 1
            if state.Active.StoppedConnection then
                pcall(function() state.Active.StoppedConnection:Disconnect() end)
            end
            state.Active.StoppedConnection = nil
            if state.Active.KeepAliveConnection then
                pcall(function() state.Active.KeepAliveConnection:Disconnect() end)
            end
            state.Active.KeepAliveConnection = nil
            if state.Active.Track then
                pcall(function() state.Active.Track:Stop(0) end)
            end
            if state.Active.Animation then
                pcall(function() state.Active.Animation:Destroy() end)
            end
            local previousName = state.Active.Item and state.Active.Item.Name
            state.Active.Id = nil
            state.Active.Item = nil
            state.Active.Track = nil
            state.Active.Animation = nil
            state.Active.PlayableId = nil
            refreshToggleVisuals()
            if not silent and previousName then
                emoteNotify(tostring(previousName) .. " stopped.", "info", 2.3)
            end
            return true
        end

        local function playEmote(item, toggleApi)
            if tonumber(state.Active.Id) == tonumber(item.Id) then
                stopActiveEmote(false)
                return
            end

            stopActiveEmote(true)
            state.Active.Serial = state.Active.Serial + 1
            local serial = state.Active.Serial
            if toggleApi and toggleApi.SetBusy then toggleApi:SetBusy(true) end
            local loading = LULA:ShowIsland("Free Emotes", "Loading Emote...", {Progress = 8})

            task.spawn(function()
                RunService.RenderStepped:Wait()
                local ok, result = pcall(function()
                    local _, humanoid, animator = getCharacterAnimationLoader()
                    if serial ~= state.Active.Serial then return nil end

                    local speed = getSpeed(item.Id)
                    if loading then loading:SetProgress(28, "Opening Roblox emote...") end

                    local trackObject, playableId = tryNativeMarketplaceEmote(humanoid, item, speed)
                    local animation

                    if not trackObject then
                        if loading then loading:SetProgress(45, "Preparing your emote...") end
                        trackObject, playableId = tryLocalDescriptionEmote(humanoid, animator, item, speed)
                    end

                    if not trackObject then
                        if loading then loading:SetProgress(58, "Resolving animation ID...") end
                        local resolvedId, _, wrapperOnly = resolvePlayableAnimationId(item)
                        if wrapperOnly then
                            error("Roblox did not expose this Marketplace emote's playable animation.")
                        end

                        animation = Instance.new("Animation")
                        animation.Name = "LH_FreeEmote_" .. tostring(resolvedId)
                        animation.AnimationId = animationUri(resolvedId)

                        local loadOk
                        loadOk, trackObject = pcall(function()
                            return humanoid:LoadAnimation(animation)
                        end)
                        if not loadOk or not trackObject then
                            loadOk, trackObject = pcall(function()
                                return animator:LoadAnimation(animation)
                            end)
                        end
                        if not loadOk or not trackObject then
                            pcall(function() animation:Destroy() end)
                            error("Roblox did not allow this emote to load.")
                        end

                        trackObject.Looped = true
                        pcall(function() trackObject.Priority = Enum.AnimationPriority.Action4 end)
                        trackObject:Play()
                        pcall(function() trackObject:AdjustSpeed(speed) end)
                        playableId = resolvedId
                    end

                    if loading then loading:SetProgress(82, "Starting emote...") end
                    return {
                        Track = trackObject,
                        Animation = animation,
                        PlayableId = playableId or item.Id,
                    }
                end)

                if toggleApi and toggleApi.SetBusy then toggleApi:SetBusy(false) end
                if serial ~= state.Active.Serial then
                    if ok and result then
                        pcall(function() result.Track:Stop(0) end)
                        pcall(function() result.Animation:Destroy() end)
                    end
                    if loading then loading:Close() end
                    return
                end

                if not ok or not result then
                    if loading then loading:Close() end
                    refreshToggleVisuals()
                    emoteNotify("Could not play " .. tostring(item.Name) .. ": " .. tostring(result), "error", 4)
                    return
                end

                state.Active.Id = item.Id
                state.Active.Item = item
                state.Active.Track = result.Track
                state.Active.Animation = result.Animation
                state.Active.PlayableId = result.PlayableId

                local function restartActiveTrack()
                    if serial ~= state.Active.Serial then return end
                    if state.Active.Track ~= result.Track then return end

                    local currentSpeed = getSpeed(item.Id)
                    pcall(function()
                        result.Track.Looped = true
                        result.Track.Priority = Enum.AnimationPriority.Action4
                        if not result.Track.IsPlaying then
                            result.Track:Play(0, 1, currentSpeed)
                        end
                        result.Track:AdjustSpeed(currentSpeed)
                    end)
                end

                state.Active.StoppedConnection = result.Track.Stopped:Connect(function()
                    -- Walking, jumping or a game's Animate skript may stop the track.
                    -- Restart it unless stopActiveEmote() already changed the serial.
                    if serial ~= state.Active.Serial then return end
                    task.defer(restartActiveTrack)
                end)
                track(state.Active.StoppedConnection)

                local keepAliveElapsed = 0
                state.Active.KeepAliveConnection = RunService.Heartbeat:Connect(function(deltaTime)
                    if serial ~= state.Active.Serial or state.Active.Track ~= result.Track then return end
                    keepAliveElapsed = keepAliveElapsed + (tonumber(deltaTime) or 0)
                    if keepAliveElapsed < 0.10 then return end
                    keepAliveElapsed = 0
                    restartActiveTrack()
                end)
                track(state.Active.KeepAliveConnection)

                restartActiveTrack()
                refreshToggleVisuals()
                if loading then
                    loading:SetProgress(100, tostring(item.Name) .. " is playing.")
                    task.delay(0.35, function() pcall(function() loading:Close() end) end)
                end
            end)
        end

        local function registerPreview(emoteId, api)
            emoteId = tonumber(emoteId)
            registry.Previews[emoteId] = registry.Previews[emoteId] or {}
            table.insert(registry.Previews[emoteId], api)
        end

        local function clearPreviews()
            for _, list in pairs(registry.Previews) do
                for _, api in ipairs(list) do
                    if api and api.Destroy then api:Destroy() end
                end
            end
            registry.Previews = {}
        end

        local function createAvatarPreview(parent, item, compact)
            local viewport = Instance.new("ViewportFrame")
            local api = {Dead = false, Track = nil, Animation = nil, Model = nil, Viewport = viewport}
            viewport.Name = "EmoteAvatarPreview"
            viewport.Size = UDim2.fromScale(1, 1)
            viewport.BackgroundTransparency = 0.04
            viewport.BorderSizePixel = 0
            viewport.Ambient = rgb(220, 220, 228)
            viewport.LightColor = rgb(255, 255, 255)
            viewport.LightDirection = Vector3.new(-1, -1, -1)
            viewport.Parent = parent
            bind(viewport, "BackgroundColor3", "Header")
            makeCorner(viewport, compact and 7 or 9)

            local fallback = Instance.new("ImageLabel")
            fallback.Name = "AvatarThumbnailFallback"
            fallback.Size = UDim2.fromScale(1, 1)
            fallback.BackgroundTransparency = 1
            fallback.ScaleType = Enum.ScaleType.Crop
            fallback.Parent = viewport
            makeCorner(fallback, compact and 7 or 9)

            local loadingText = makeText(viewport, "Loading avatar preview...", compact and 8.5 or 9.5, Enum.Font.GothamMedium)
            loadingText.Size = UDim2.new(1, -10, 0, 28)
            loadingText.AnchorPoint = Vector2.new(0.5, 1)
            loadingText.Position = UDim2.new(0.5, 0, 1, -4)
            loadingText.TextWrapped = true
            loadingText.ZIndex = 6
            bind(loadingText, "TextColor3", "MutedText")

            task.spawn(function()
                local okThumb, image = pcall(function()
                    return Players:GetUserThumbnailAsync(
                        LocalPlayer.UserId,
                        Enum.ThumbnailType.AvatarBust,
                        Enum.ThumbnailSize.Size180x180
                    )
                end)
                if okThumb and fallback.Parent then fallback.Image = image end
            end)

            function api:SetSpeed(value)
                if self.Track then pcall(function() self.Track:AdjustSpeed(value) end) end
            end

            function api:Destroy()
                if self.Dead then return end
                self.Dead = true
                if self.Track then pcall(function() self.Track:Stop(0) end) end
                if self.Animation then pcall(function() self.Animation:Destroy() end) end
                if self.Model then pcall(function() self.Model:Destroy() end) end
                if self.Viewport then pcall(function() self.Viewport:Destroy() end) end
                self.Track, self.Animation, self.Model, self.Viewport = nil, nil, nil, nil
            end

            registerPreview(item.Id, api)
            track(parent.AncestryChanged:Connect(function(_, newParent)
                if not newParent then api:Destroy() end
            end))

            task.spawn(function()
                local model
                local modelOk = pcall(function()
                    model = Players:CreateHumanoidModelFromUserId(LocalPlayer.UserId)
                end)
                if (not modelOk or not model) and LocalPlayer.Character then
                    local oldArchivable = LocalPlayer.Character.Archivable
                    LocalPlayer.Character.Archivable = true
                    pcall(function() model = LocalPlayer.Character:Clone() end)
                    LocalPlayer.Character.Archivable = oldArchivable
                end
                if not model or api.Dead or not viewport.Parent then
                    loadingText.Text = "Avatar thumbnail"
                    return
                end

                for _, descendant in ipairs(model:GetDescendants()) do
                    if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("Tool") then
                        descendant:Destroy()
                    elseif descendant:IsA("BasePart") then
                        descendant.Anchored = false
                        descendant.CanCollide = false
                        descendant.Massless = true
                    end
                end

                local world = Instance.new("WorldModel")
                world.Name = "EmoteAvatarWorld"
                world.Parent = viewport

                local camera = Instance.new("Camera")
                camera.FieldOfView = compact and 34 or 30
                camera.Parent = viewport
                viewport.CurrentCamera = camera

                model.Name = "LocalAvatarEmotePreview"
                model.Parent = world
                pcall(function() model:PivotTo(CFrame.new()) end)
                api.Model = model

                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                if root then root.Anchored = true end

                local boxCFrame, boxSize = model:GetBoundingBox()
                local focus = boxCFrame.Position + Vector3.new(0, boxSize.Y * 0.03, 0)
                local halfFov = math.rad(camera.FieldOfView * 0.5)
                local distance = math.max(
                    4.5,
                    (boxSize.Y * 0.56) / math.max(0.05, math.tan(halfFov)),
                    (boxSize.X * 0.62) / math.max(0.05, math.tan(halfFov))
                )
                camera.CFrame = CFrame.lookAt(
                    focus + Vector3.new(0, boxSize.Y * 0.02, -distance),
                    focus,
                    Vector3.new(0, 1, 0)
                )

                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if not humanoid then
                    loadingText.Text = "Avatar thumbnail"
                    return
                end
                pcall(function() humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)

                local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
                local speed = getSpeed(item.Id)
                local trackObject, playableId = tryNativeMarketplaceEmote(humanoid, item, speed)
                local animation

                if not trackObject then
                    local resolvedId, _, wrapperOnly = resolvePlayableAnimationId(item)
                    if not wrapperOnly then
                        playableId = resolvedId
                        animation = Instance.new("Animation")
                        animation.Name = "LH_EmoteCardPreview"
                        animation.AnimationId = animationUri(resolvedId)

                        -- Match the animated avatar cards already used by Home/My Shelf.
                        local loadOk
                        loadOk, trackObject = pcall(function()
                            return animator:LoadAnimation(animation)
                        end)
                        if loadOk and trackObject then
                            trackObject.Looped = true
                            pcall(function() trackObject.Priority = Enum.AnimationPriority.Movement end)
                            trackObject:Play(0.18, 1, speed)
                        end
                    end
                end

                if not trackObject or api.Dead then
                    if animation then pcall(function() animation:Destroy() end) end
                    loadingText.Text = "Avatar thumbnail"
                    return
                end

                pcall(function() trackObject:AdjustSpeed(speed) end)
                api.Track = trackObject
                api.Animation = animation
                api.PlayableId = playableId
                fallback.Visible = false
                loadingText.Visible = false
            end)

            return api
        end

        local function clearHolder(holder, keepClass)
            for _, child in ipairs(holder:GetChildren()) do
                local keep = keepClass and child:IsA(keepClass)
                if not keep and not child:IsA("UIPadding") then child:Destroy() end
            end
        end

        local function makeToggleSwitch(parent, emoteId, callback, compact)
            local width = compact and 44 or 50
            local height = compact and 20 or 22
            local pill = Instance.new("Frame")
            pill.Name = "FreeEmoteToggle"
            pill.Size = UDim2.fromOffset(width, height)
            pill.BorderSizePixel = 0
            pill.BackgroundColor3 = EMOTE_RED
            pill.Parent = parent
            makeCorner(pill, height / 2)

            local knobSize = height - 4
            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(knobSize, knobSize)
            knob.Position = UDim2.fromOffset(2, 2)
            knob.BorderSizePixel = 0
            knob.BackgroundColor3 = rgb(255, 255, 255)
            knob.Parent = pill
            makeCorner(knob, knobSize / 2)

            local hit = makeButton(pill, "")
            hit.Size = UDim2.fromScale(1, 1)
            hit.BackgroundTransparency = 1
            hit.ZIndex = 7

            local api = {Pill = pill, Knob = knob, Busy = false}
            function api:Render(value)
                if not pill.Parent then return end
                value = value == true
                pill.BackgroundColor3 = value and EMOTE_GREEN or EMOTE_RED
                knob.Position = value and UDim2.fromOffset(width - knobSize - 2, 2) or UDim2.fromOffset(2, 2)
                pill.BackgroundTransparency = self.Busy and 0.35 or 0
            end
            function api:SetBusy(value)
                self.Busy = value == true
                self:Render(tonumber(state.Active.Id) == tonumber(emoteId))
            end
            track(hit.Activated:Connect(function()
                if not api.Busy and type(callback) == "function" then callback(api) end
            end))
            registry.Toggles[tonumber(emoteId)] = registry.Toggles[tonumber(emoteId)] or {}
            table.insert(registry.Toggles[tonumber(emoteId)], api)
            api:Render(tonumber(state.Active.Id) == tonumber(emoteId))
            return api
        end

        local renderFavorites

        local function addFavorite(item)
            if favoriteIndex(item.Id) then
                emoteNotify(tostring(item.Name) .. " is already in Favorites.", "info", 2.3)
                return
            end
            local favorites = getFavorites()
            local saved = cleanFavorite(item)
            if not saved then return end
            local ok, playableId = pcall(resolvePlayableAnimationId, item)
            if ok then saved.PlayableAnimationId = playableId end
            table.insert(favorites, saved)
            saveFavorites(favorites)
            refreshStarVisuals()
            emoteNotify(tostring(item.Name) .. " was added to Favorites.", "success", 2.5)
            if state.Mode == "favorites" and renderFavorites then
                renderFavorites(UI.FavoriteSearchBox.Text)
            end
        end

        local function removeFavorite(item, allowUndo)
            local favorites = getFavorites()
            local index = favoriteIndex(item.Id)
            if not index then return end
            local removed = table.remove(favorites, index)
            saveFavorites(favorites)
            refreshStarVisuals()
            if state.Mode == "favorites" and renderFavorites then
                renderFavorites(UI.FavoriteSearchBox.Text)
            end

            if allowUndo ~= false then
                LULA:NotifyAction("warning", "Emote Favorites", tostring(removed.Name) .. " was removed from Favorites.", 4, "Undo", function()
                    local restored = getFavorites()
                    if not favoriteIndex(removed.Id) then
                        table.insert(restored, math.min(index, #restored + 1), removed)
                        saveFavorites(restored)
                    end
                    refreshStarVisuals()
                    if state.Mode == "favorites" and renderFavorites then
                        renderFavorites(UI.FavoriteSearchBox.Text)
                    end
                end)
            end
        end

        local function toggleFavorite(item)
            if favoriteIndex(item.Id) then
                removeFavorite(item, true)
            else
                addFavorite(item)
            end
        end

        local function makeStarButton(parent, item)
            local button = makeButton(parent, STAR_EMPTY)
            button.Name = "FreeEmoteFavoriteStar"
            button.Size = UDim2.fromOffset(30, 28)
            button.TextSize = 18
            button.TextColor3 = YELLOW
            button.BackgroundTransparency = 0.06
            button.ZIndex = 10
            local api = {}
            function api:Render(saved)
                button.Text = saved and STAR_FILLED or STAR_EMPTY
                button.TextColor3 = YELLOW
            end
            track(button.Activated:Connect(function() toggleFavorite(item) end))
            registry.Stars[tonumber(item.Id)] = registry.Stars[tonumber(item.Id)] or {}
            table.insert(registry.Stars[tonumber(item.Id)], api)
            api:Render(favoriteIndex(item.Id) ~= nil)
            api.Button = button
            return api
        end

        local function createFavoriteSaveControls()
            local row = Instance.new("Frame")
            row.Name = "FreeEmoteFavoriteSaveControls"
            row.LayoutOrder = -4750
            row.Size = UDim2.new(1, -4, 0, 36)
            row.BackgroundTransparency = 1
            row.Visible = false
            row.Parent = scroll

            local autoSave = makeButton(row, "")
            autoSave.Position = UDim2.fromOffset(0, 0)
            autoSave.Size = UDim2.new(0.57, -3, 1, 0)
            autoSave.Text = ""
            autoSave.BackgroundTransparency = 0.04

            local label = makeText(autoSave, "Auto Save Favorites", 10.5, Enum.Font.GothamBold)
            label.Position = UDim2.fromOffset(9, 0)
            label.Size = UDim2.new(1, -59, 1, 0)
            label.TextXAlignment = Enum.TextXAlignment.Left

            local pill = Instance.new("Frame")
            pill.AnchorPoint = Vector2.new(1, 0.5)
            pill.Position = UDim2.new(1, -8, 0.5, 0)
            pill.Size = UDim2.fromOffset(39, 20)
            pill.BorderSizePixel = 0
            pill.Parent = autoSave
            makeCorner(pill, 10)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(16, 16)
            knob.BorderSizePixel = 0
            knob.BackgroundColor3 = rgb(250, 250, 252)
            knob.Parent = pill
            makeCorner(knob, 8)

            local save = makeButton(row, "Save Favorites")
            save.AnchorPoint = Vector2.new(1, 0)
            save.Position = UDim2.new(1, 0, 0, 0)
            save.Size = UDim2.new(0.43, -3, 1, 0)
            save.TextSize = 10.5
            save.BackgroundTransparency = 0.04

            local api = {Row = row}
            function api:Render()
                local enabled = settings.FreeEmoteAutoSave ~= false
                pill.BackgroundColor3 = enabled and EMOTE_GREEN or EMOTE_RED
                knob.Position = enabled and UDim2.fromOffset(21, 2) or UDim2.fromOffset(2, 2)
            end
            function api:SetVisible(value) row.Visible = value == true end

            track(autoSave.Activated:Connect(function()
                settings.FreeEmoteAutoSave = not (settings.FreeEmoteAutoSave ~= false)
                persistEmoteSettings()
                saveFavorites(getFavorites(), true)
                api:Render()
                emoteNotify(
                    settings.FreeEmoteAutoSave
                        and "Favorite edits now save automatically."
                        or "Favorite edits now wait for Save Settings or Save Favorites.",
                    "success",
                    2.8
                )
            end))
            track(save.Activated:Connect(function()
                saveFavorites(getFavorites(), true)
                emoteNotify("Emote favorites saved.", "success", 2.4)
            end))
            api:Render()
            return api
        end

