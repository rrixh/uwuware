        local function resizeDetailsDescription()
            local width = math.max(120, DetailsDescriptionShell.AbsoluteSize.X - 28)
            local bounds = TextService:GetTextSize(
                tostring(DetailsDescription.Text or ""),
                DetailsDescription.TextSize,
                DetailsDescription.Font,
                Vector2.new(width, 10000)
            )
            local textHeight = math.clamp(math.ceil(bounds.Y), 20, 238)
            DetailsDescription.Size = UDim2.new(1, -28, 0, textHeight)
            DetailsDescriptionShell.Size = UDim2.new(1, 0, 0, math.clamp(textHeight + 56, 76, 294))
        end

