        local selectedItem = nil
        local selectedDetails = nil
        local selectedSlots = nil
        local selectedSlotSources = nil
        local selectedVerification = nil

        local function clearDetailRows()
            for _, child in ipairs(detailScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end
        end

        local function closeDetails()
            detailsOverlay.Visible = false
            selectedItem = nil
            selectedDetails = nil
            selectedSlots = nil
            selectedSlotSources = nil
            selectedVerification = nil
        end

        local function makeDetailRow(slot, id, order, source)
            local row = Instance.new("Frame")
            row.Name = "Slot_" .. tostring(slot)
            row.LayoutOrder = order
            row.Size = UDim2.new(1, -2, 0, 57)
            row.BorderSizePixel = 0
            row.BackgroundTransparency = 0.02
            row.ZIndex = 343
            row.Parent = detailScroll
            bind(row, "BackgroundColor3", "ElementColor")
            makeCorner(row, 9)
            makeStroke(row, active.Theme.SchemeColor, 0.63, 0.8)

            local propertyName = SLOT_COPY_NAMES[slot] or slot
            local slotLabel = makeText(row, propertyName .. "  [" .. tostring(slot) .. "]", 11.5, Enum.Font.GothamBold)
            slotLabel.Position = UDim2.fromOffset(10, 5)
            slotLabel.Size = UDim2.new(0.34, -10, 0, 19)
            slotLabel.TextXAlignment = Enum.TextXAlignment.Left
            slotLabel.TextTruncate = Enum.TextTruncate.AtEnd
            slotLabel.ZIndex = 344

            local pathText = tostring(R15_SLOTS[slot] or slot)
            if source and tostring(source) ~= "" then pathText = pathText .. " | " .. tostring(source) end
            local pathLabel = makeText(row, pathText, 9.2, Enum.Font.Gotham)
            pathLabel.Position = UDim2.fromOffset(10, 27)
            pathLabel.Size = UDim2.new(0.62, -10, 0, 20)
            pathLabel.TextXAlignment = Enum.TextXAlignment.Left
            pathLabel.TextTruncate = Enum.TextTruncate.AtEnd
            pathLabel.ZIndex = 344
            bind(pathLabel, "TextColor3", "MutedText")

            local idLabel = makeText(row, id and tostring(id) or "Not found", 10.5, Enum.Font.RobotoMono)
            idLabel.Position = UDim2.new(0.36, 0, 0, 0)
            idLabel.Size = UDim2.new(0.42, -4, 1, 0)
            idLabel.TextXAlignment = Enum.TextXAlignment.Right
            idLabel.TextTruncate = Enum.TextTruncate.AtEnd
            idLabel.ZIndex = 344
            if id then bind(idLabel, "TextColor3", "SchemeColor") else idLabel.TextColor3 = active.Theme.Danger end

            local copyButton = makeButton(row, "Kopy")
            copyButton.AnchorPoint = Vector2.new(1, 0.5)
            copyButton.Position = UDim2.new(1, -7, 0.5, 0)
            copyButton.Size = UDim2.fromOffset(63, 31)
            copyButton.TextSize = 10.5
            copyButton.ZIndex = 345
            copyButton.Active = id ~= nil
            copyButton.AutoButtonColor = id ~= nil
            if not id then copyButton.BackgroundTransparency = 0.55 end
            if id then
                track(copyButton.MouseButton1Click:Connect(function()
                    if copyText(tostring(id)) then
                        bundleNotify(propertyName .. " ID kopied: " .. tostring(id), "success", 2.4)
                    else
                        bundleNotify("Clipboard is not supported by this executor.", "error", 3)
                    end
                end))
            end
        end

        local detailSwitchApi = {}
        function detailSwitchApi:SetBusy(value)
            detailApply.Active = value ~= true
            detailApply.Text = value == true and "Applying..." or "Apply + Play"
            detailApply.BackgroundTransparency = value == true and 0.35 or 0
        end

        local function openDetails(item)
            selectedItem = item
            selectedDetails = nil
            selectedSlots = nil
            selectedSlotSources = nil
            selectedVerification = nil
            detailsOverlay.Visible = true
            clearDetailRows()
            detailLoading.Visible = true
            detailLoading.Text = "Loading Roblox bundle details..."
            detailTitle.Text = tostring(item.Name)
            detailCreator.Text = "By " .. tostring(item.CreatorName or "Unknown creator")
            detailMeta.Text = "Animation Bundle | Bundle ID: " .. tostring(item.Id)
            detailThumbnail.Image = "rbxthumb://type=BundleThumbnail&id=" .. tostring(item.Id) .. "&w=420&h=420"

            task.spawn(function()
                local ok, slotsOrError, details, assets, slotSources, verification, catalogSlots = pcall(resolveItemSlots, item)
                if not detailsOverlay.Visible or selectedItem ~= item then return end
                if not ok then
                    detailLoading.Visible = true
                    detailLoading.Text = "Failed to resolve bundle info:\n" .. tostring(slotsOrError)
                    bundleNotify("Failed to load animation bundle details.", "error", 3.5)
                    return
                end

                selectedSlots = slotsOrError
                selectedDetails = details
                selectedSlotSources = slotSources or {}
                selectedVerification = verification
                detailTitle.Text = tostring(details.Name or item.Name)
                detailCreator.Text = "By " .. tostring(details.CreatorName or item.CreatorName or "Unknown creator")
                local meta = "Animation Bundle | Bundle ID: " .. tostring(details.Id or item.Id)
                if verification then
                    meta = meta .. " | Known-ID check: " .. tostring(verification.Matched or 0) .. "/" .. tostring(verification.Total or 9)
                else
                    meta = meta .. " | Known-ID check: not a classic reference pack"
                end
                detailMeta.Text = meta
                clearDetailRows()
                for index, slot in ipairs(SLOT_ORDER) do
                    makeDetailRow(slot, selectedSlots[slot], index, selectedSlotSources[slot])
                end
                detailLoading.Visible = false

                local found = 0
                for _, slot in ipairs(SLOT_ORDER) do if selectedSlots[slot] then found = found + 1 end end
                if verification and verification.Exact then
                    bundleNotify("Known original pack check matched all 9 working IDs.", "success", 3.5)
                elseif verification then
                    bundleNotify("Known original pack check matched " .. tostring(verification.Matched or 0) .. "/" .. tostring(verification.Total or 9) .. " IDs.", "warning", 4.5)
                end
                if found < 9 then
                    bundleNotify("Resolved " .. tostring(found) .. "/9 slots. Missing IDs show as Not found and copy as 0 in the table.", "warning", 4)
                end
            end)
        end

        track(detailsShade.MouseButton1Click:Connect(closeDetails))
        track(detailCloseTop.MouseButton1Click:Connect(closeDetails))
        track(detailCloseBottom.MouseButton1Click:Connect(closeDetails))
        track(detailApply.MouseButton1Click:Connect(function()
            if not selectedItem or not selectedSlots then
                bundleNotify("Bundle info is still loading.", "warning", 2.5)
                return
            end
            if tonumber(state.ActiveId) == tonumber(selectedItem.Id) then
                bundleNotify(tostring(selectedItem.Name) .. " is already active.", "info", 2.2)
                return
            end
            toggleBundle(selectedItem, detailSwitchApi)
        end))
        track(detailRestore.MouseButton1Click:Connect(function()
            state.ToggleSerial = (state.ToggleSerial or 0) + 1
            local restored = restoreOriginalAnimations(true)
            state.ActiveId = nil
            state.ActiveItem = nil
            state.ActiveSlots = nil
            refreshToggleVisuals()
            bundleNotify(restored and "Original animations restored." or "No stored original animation set was found.", restored and "success" or "warning", 2.8)
        end))
        track(detailCopyTable.MouseButton1Click:Connect(function()
            if not selectedDetails or not selectedSlots then
                bundleNotify("Bundle info is still loading.", "warning", 2.5)
                return
            end
            local snippet = makePackTable(selectedDetails.Name or selectedItem.Name, selectedSlots)
            if copyText(snippet) then
                bundleNotify("Animation bundle table kopied: " .. tostring(selectedDetails.Name or selectedItem.Name), "success", 3)
            else
                bundleNotify("Clipboard is not supported by this executor.", "error", 3)
            end
        end))
        return openDetails, closeDetails
        end

        local openDetails, closeDetails = createAnimationBundleDetailsOverlay()
        state.OpenDetails = openDetails
        state.CloseDetails = closeDetails


        local renderMarketplace
        local renderFavorites

        local function addFavorite(item)
            if favoriteIndex(item.Id) then
                bundleNotify(tostring(item.Name) .. " is already in favorites.", "info", 2.2)
                return
            end
            LULA:Confirm("Add to favorites?", "Add \"" .. tostring(item.Name) .. "\" to Animation Bundle Favorites?", function()
                local favorites = getFavorites()
                table.insert(favorites, {
                    Id = item.Id,
                    Name = item.Name,
                    CreatorName = item.CreatorName,
                    Description = item.Description,
                })
                saveFavorites(favorites)
                refreshStarVisuals()
                if currentMode == "favorites" and renderFavorites then renderFavorites(searchBox.Text) end
                bundleNotify(tostring(item.Name) .. " was added to favorites.", "success", 2.8)
            end)
        end

        local function removeFavorite(item, allowUndo)
            local favorites = getFavorites()
            local removedIndex = nil
            local removedItem = nil
            for index, favorite in ipairs(favorites) do
                if tonumber(favorite.Id) == tonumber(item.Id) then
                    removedIndex = index
                    removedItem = table.remove(favorites, index)
                    break
                end
            end
            if not removedItem then return end
            saveFavorites(favorites)
            refreshStarVisuals()
            if currentMode == "favorites" and renderFavorites then
                renderFavorites(searchBox.Text)
            else
                refreshStarVisuals()
            end

            if allowUndo ~= false then
                LULA:NotifyAction("warning", "Animation Favorites", tostring(removedItem.Name) .. " was removed from favorites.", 3, "Undo", function()
                    local restored = getFavorites()
                    if not favoriteIndex(removedItem.Id) then
                        table.insert(restored, math.clamp(removedIndex or (#restored + 1), 1, #restored + 1), removedItem)
                        saveFavorites(restored)
                    end
                    refreshStarVisuals()
                    if currentMode == "favorites" and renderFavorites then
                        renderFavorites(searchBox.Text)
                    else
                        refreshStarVisuals()
                    end
                    bundleNotify(tostring(removedItem.Name) .. " was restored to favorites.", "success", 2.4)
                end)
            end
        end

        local function makeStarButton(parent, item)
            local star = makeButton(parent, STAR_EMPTY)
            star.Name = "FavoriteStar"
            star.Size = UDim2.fromOffset(24, 24)
            star.TextSize = 20
            star.BackgroundTransparency = 0.08
            star.ZIndex = 8
            local api = {}
            function api:Render(saved)
                star.Text = saved and STAR_FILLED or STAR_EMPTY
                star.TextColor3 = saved and YELLOW or rgb(225, 225, 235)
            end
            track(star.MouseButton1Click:Connect(function()
                if favoriteIndex(item.Id) then
                    LULA:Confirm("Remove from favorites?", "Remove \"" .. tostring(item.Name) .. "\" from Animation Bundle Favorites?", function()
                        removeFavorite(item, true)
                    end)
                else
                    addFavorite(item)
                end
            end))
            registerStar(item.Id, api)
            api:Render(favoriteIndex(item.Id) ~= nil)
            return star
        end

