        bind(detailScroll, "ScrollBarImageColor3", "SchemeColor")
        local detailList = Instance.new("UIListLayout")
        detailList.Padding = UDim.new(0, 6)
        detailList.SortOrder = Enum.SortOrder.LayoutOrder
        detailList.Parent = detailScroll

        local detailLoading = makeText(detailScroll, "Loading Roblox bundle details...", 12, Enum.Font.GothamBold)
        detailLoading.Name = "Loading"
        detailLoading.Size = UDim2.new(1, -2, 0, 58)
        detailLoading.TextWrapped = true
        detailLoading.TextXAlignment = Enum.TextXAlignment.Center
        detailLoading.TextYAlignment = Enum.TextYAlignment.Center
        detailLoading.ZIndex = 9003
        bind(detailLoading, "TextColor3", "SchemeColor")

        local detailActions = Instance.new("Frame")
        detailActions.AnchorPoint = Vector2.new(0, 1)
        detailActions.Position = UDim2.fromScale(0, 1)
        detailActions.Size = UDim2.new(1, 0, 0, 94)
        detailActions.BorderSizePixel = 0
        detailActions.ZIndex = 9002
