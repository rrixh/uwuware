local function rgb(r, g, b)
    return Color3.fromRGB(r, g, b)
end

-- Fixed switch kolors stay readable in every theme and appearance mode.
local TOGGLE_ON_COLOR = rgb(35, 190, 88)
local TOGGLE_OFF_COLOR = rgb(224, 62, 72)
local DRAG_GLOW_COLOR = rgb(255, 255, 255)

local defaultAccent = env.LollypopTheme
if typeof(defaultAccent) ~= "Color3" then
    defaultAccent = rgb(255, 72, 176)
end;

local function normalizeOnlineStatus(value)
    if value == true then return "Online" end
    local normalized = tostring(value or ""):match("^%s*(.-)%s*$"):lower()
    return normalized == "online" and "Online" or "Offline"
end
local online_status = normalizeOnlineStatus(env.LH_ONLINE_STATUS)

