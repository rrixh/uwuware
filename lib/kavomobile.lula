        local function cleanFavorite(raw)
            if type(raw) ~= "table" then return nil end
            local id = tonumber(raw.Id or raw.id or raw.BundleId or raw.bundleId)
            local name = raw.Name or raw.name
            if not id or type(name) ~= "string" or trim(name) == "" then return nil end
            return {
                Id = id,
                Name = name,
                CreatorName = raw.CreatorName or raw.creatorName or "Unknown creator",
                Description = raw.Description or raw.description or "",
            }
        end

        local function getFavorites()
            local source = settings.AnimationBundleFavorites
            if type(source) ~= "table" then source = {} end
            local output = {}
            local seen = {}
            for _, raw in ipairs(source) do
                local favorite = cleanFavorite(raw)
                if favorite and not seen[favorite.Id] then
                    seen[favorite.Id] = true
                    table.insert(output, favorite)
                end
            end
            return output
        end

        local function saveFavorites(updated)
            local clean = {}
            local seen = {}
            for _, raw in ipairs(updated or {}) do
                local favorite = cleanFavorite(raw)
                if favorite and not seen[favorite.Id] then
                    seen[favorite.Id] = true
                    table.insert(clean, favorite)
                end
            end
            settings.AnimationBundleFavorites = clean
            env.LHSettings = env.LHSettings or {}
            env.LHUISettings = env.LHUISettings or settings
            env.LHSettings.AnimationBundleFavorites = clean
            env.LHUISettings.AnimationBundleFavorites = clean
            markSettingsDirty()
            saveSettingsNow()
            return clean
        end

        local function favoriteIndex(bundleId)
            bundleId = tonumber(bundleId)
            for index, favorite in ipairs(getFavorites()) do
                if tonumber(favorite.Id) == bundleId then return index end
            end
            return nil
        end

