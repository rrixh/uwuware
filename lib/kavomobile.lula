        local function cleanFavorite(raw)
            if type(raw) ~= "table" then return nil end
            local id = tonumber(raw.Id or raw.id or raw.BundleId or raw.bundleId)
            local name = raw.Name or raw.name
            if not id or type(name) ~= "string" or trim(name) == "" then return nil end
            return {
                Id = id,
                Name = name,
                CreatorName = raw.CreatorName or raw.creatorName or "Unknown creator",
                Description = raw.Description or raw.description or "",
            }
        end

        local function getFavorites()
            local source = settings.AnimationBundleFavorites
            if type(source) ~= "table" then source = {} end
            local output = {}
            local seen = {}
            for _, raw in ipairs(source) do
                local favorite = cleanFavorite(raw)
                if favorite and not seen[favorite.Id] then
                    seen[favorite.Id] = true
                    table.insert(output, favorite)
                end
            end
            return output
        end

        local function saveFavorites(updated, forceSave)
            local clean = {}
            local seen = {}
            for _, raw in ipairs(updated or {}) do
                local favorite = cleanFavorite(raw)
                if favorite and not seen[favorite.Id] then
                    seen[favorite.Id] = true
                    table.insert(clean, favorite)
                end
            end
            settings.AnimationBundleFavorites = clean
            env.LHSettings = env.LHSettings or {}
            env.LHUISettings = env.LHUISettings or settings
            env.LHSettings.AnimationBundleFavorites = clean
            env.LHUISettings.AnimationBundleFavorites = clean
            markSettingsDirty()
            if forceSave == true or settings.AnimationBundleAutoSave ~= false then
                saveSettingsNow()
            end
            return clean
        end

        local function favoriteIndex(bundleId)
            bundleId = tonumber(bundleId)
            for index, favorite in ipairs(getFavorites()) do
                if tonumber(favorite.Id) == bundleId then return index end
            end
            return nil
        end

        -- Kept in a nested builder so the large Marketplace method stays under
        -- Luau's active-local limit while still providing mobile-sized controls.
        local function createFavoriteSaveControls()
            local api = {}
            local row = Instance.new("Frame")
            row.Name = "AnimationBundleFavoriteSaveControls"
            row.LayoutOrder = -4850
            row.Size = UDim2.new(1, -4, 0, 36)
            row.BackgroundTransparency = 1
            row.Visible = false
            row.Parent = scroll

            local autoSaveHit = makeButton(row, "")
            autoSaveHit.Position = UDim2.fromOffset(0, 0)
            autoSaveHit.Size = UDim2.new(0.57, -3, 1, 0)
            autoSaveHit.Text = ""
            autoSaveHit.BackgroundTransparency = 0.04

            local autoSaveLabel = makeText(autoSaveHit, "Auto Save Favorites", 10.5, Enum.Font.GothamBold)
            autoSaveLabel.Position = UDim2.fromOffset(9, 0)
            autoSaveLabel.Size = UDim2.new(1, -59, 1, 0)
            autoSaveLabel.TextXAlignment = Enum.TextXAlignment.Left

            local pill = Instance.new("Frame")
            pill.AnchorPoint = Vector2.new(1, 0.5)
            pill.Position = UDim2.new(1, -8, 0.5, 0)
            pill.Size = UDim2.fromOffset(39, 20)
            pill.BorderSizePixel = 0
            pill.Parent = autoSaveHit
            makeCorner(pill, 10)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(16, 16)
            knob.BorderSizePixel = 0
            knob.BackgroundColor3 = rgb(250, 250, 252)
            knob.Parent = pill
            makeCorner(knob, 8)

            local saveButton = makeButton(row, "Save Favorites")
            saveButton.AnchorPoint = Vector2.new(1, 0)
            saveButton.Position = UDim2.new(1, 0, 0, 0)
            saveButton.Size = UDim2.new(0.43, -3, 1, 0)
            saveButton.TextSize = 10.5
            saveButton.BackgroundTransparency = 0.04

            function api:Render()
                local enabled = settings.AnimationBundleAutoSave ~= false
                pill.BackgroundColor3 = enabled and ANIMATION_GREEN or ANIMATION_RED
                knob.Position = enabled and UDim2.fromOffset(21, 2) or UDim2.fromOffset(2, 2)
            end

            function api:SetVisible(value)
                row.Visible = value == true
            end

            track(autoSaveHit.MouseButton1Click:Connect(function()
                settings.AnimationBundleAutoSave = not (settings.AnimationBundleAutoSave ~= false)
                env.LHSettings = env.LHSettings or {}
                env.LHUISettings = env.LHUISettings or settings
                env.LHSettings.AnimationBundleAutoSave = settings.AnimationBundleAutoSave
                env.LHUISettings.AnimationBundleAutoSave = settings.AnimationBundleAutoSave
                api:Render()

                -- The autosave preference remembers itself immediately. Enabling it
                -- also commits any pending favorite edits made while it was disabled.
                saveFavorites(getFavorites(), true)
                bundleNotify(
                    settings.AnimationBundleAutoSave
                        and "Favorite edits now save automatically."
                        or "Favorite edits now wait for Save Settings or Save Favorites.",
                    "success",
                    3
                )
            end))

            track(saveButton.MouseButton1Click:Connect(function()
                saveFavorites(getFavorites(), true)
                bundleNotify("Animation favorites saved.", "success", 2.4)
            end))

            api:Render()
            return api
        end

