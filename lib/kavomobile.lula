            UI.DetailsSpeedHolder.BackgroundTransparency = 1
            UI.DetailsSpeedHolder.Parent = UI.DetailsSpeedRow

            UI.DetailsActions = Instance.new("Frame")
            UI.DetailsActions.LayoutOrder = 6
            UI.DetailsActions.Size = UDim2.new(1, -4, 0, 76)
