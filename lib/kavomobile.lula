            thumbnail.BackgroundTransparency = 0.08
            thumbnail.BorderSizePixel = 0
            thumbnail.ScaleType = Enum.ScaleType.Fit
            thumbnail.Image = "rbxthumb://type=BundleThumbnail&id=" .. tostring(item.Id) .. "&w=150&h=150"
            thumbnail.Parent = row
            bind(thumbnail, "BackgroundColor3", "Header")
            makeCorner(thumbnail, 7)

            local nameLabel = makeText(row, tostring(item.Name), 11, Enum.Font.GothamBold)
            nameLabel.Position = UDim2.fromOffset(49, 5)
            nameLabel.Size = UDim2.new(1, -230, 0, 38)
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextYAlignment = Enum.TextYAlignment.Center
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd

            local infoButton = makeButton(row, "Info")
            infoButton.AnchorPoint = Vector2.new(1, 0.5)
            infoButton.Position = UDim2.new(1, -84, 0.5, 0)
            infoButton.Size = UDim2.fromOffset(42, 25)
            infoButton.TextSize = 9.5
            track(infoButton.MouseButton1Click:Connect(function() openDetails(item) end))

            local remove = makeKolorButton(row, "X", rgb(204, 45, 61))
            remove.AnchorPoint = Vector2.new(1, 0.5)
            remove.Position = UDim2.new(1, -5, 0.5, 0)
            remove.Size = UDim2.fromOffset(24, 24)
            remove.TextSize = 9.5
            track(remove.MouseButton1Click:Connect(function()
                removeFavorite(item, true)
            end))

            local switch = makeToggleSwitch(row, item.Id, function(api)
                toggleBundle(item, api)
            end, true)
            switch.Pill.AnchorPoint = Vector2.new(1, 0.5)
            switch.Pill.Position = UDim2.new(1, -35, 0.5, 0)
            return row
