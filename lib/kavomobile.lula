        local OutfitScroll = create("ScrollingFrame", {
            Position = UDim2.fromOffset(8, 52),
            Size = UDim2.new(1, -16, 1, -60),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = ACCENT,
            ZIndex = 51
        })
        OutfitScroll.Parent = OutfitOverlay

        local OutfitList = create("UIListLayout", {
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder
        })
        OutfitList.Parent = OutfitScroll

        local OutfitEmpty = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 100),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Text = "No Marketplace items are being tested right now.",
            TextColor3 = MUTED,
            TextSize = 13,
            TextWrapped = true,
            ZIndex = 52
