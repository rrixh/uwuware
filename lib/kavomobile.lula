        local copyProfileButton = makeButton(actionsRow, "Kopy Profile")
        self:StyleSpecialActionButton(copyProfileButton, "glass")
        copyProfileButton.Position = UDim2.new(0.50, 0, 0, 3)
        copyProfileButton.Size = UDim2.new(0.28, -3, 0, 33)

        local refreshButton = makeButton(actionsRow, "Refresh")
        self:StyleSpecialActionButton(refreshButton, "soft")
        refreshButton.Position = UDim2.new(0.79, 0, 0, 3)
        refreshButton.Size = UDim2.new(0.21, 0, 0, 33)

        local function setResultsVisible(value)
            value = value == true
            profileRow.Visible = value
            socialRow.Visible = value
            bioRow.Visible = value
            extraRow.Visible = value
            actionsRow.Visible = value
        end

        local function flashButton(button, text, seconds)
            if not button or not button.Parent then return end
            local original = button.Text
            button.Text = tostring(text)
            task.delay(seconds or 0.9, function()
                if button and button.Parent then button.Text = original end
            end)
        end

        local function findServerPlayer(userId, userName)
            local target = Players:GetPlayerByUserId(tonumber(userId) or 0)
            if target then return target end
            local wanted = string.lower(tostring(userName or ""))
            if wanted ~= "" then
                for _, player in ipairs(Players:GetPlayers()) do
                    if string.lower(tostring(player.Name or "")) == wanted then return player end
                end
            end
            return nil
        end

        local function refreshFriendButton()
            local userId = tonumber(state.UserId)
            if not userId then
                friendButton.Text = "Add Friend"
                friendButton.BackgroundColor3 = active.Theme.ElementColor
                return
            end
            if userId == LocalPlayer.UserId then
                friendButton.Text = "This Is You"
                friendButton.BackgroundColor3 = active.Theme.Header
                return
            end

            local isFriend = false
            pcall(function() isFriend = LocalPlayer:IsFriendsWithAsync(userId) == true end)
            if isFriend then
                friendButton.Text = "Already Friends"
                friendButton.BackgroundColor3 = TOGGLE_ON_COLOR
                return
            end

            friendButton.Text = "Add Friend"
            if findServerPlayer(userId, state.Profile and state.Profile.name) then
                friendButton.BackgroundColor3 = active.Theme.SchemeColor
            else
                friendButton.BackgroundColor3 = active.Theme.Header
            end
        end

        local function clearSearchMatches()
            for _, child in ipairs(searchResultsRow:GetChildren()) do
                if child:IsA("Frame") and child.Name == "UserMatch" then child:Destroy() end
            end
            searchResultsRow.Visible = false
        end
        state.ClearSearchMatches = clearSearchMatches

        local lookup
        local function renderSearchMatches(entries, queryText)
            clearSearchMatches()
            if type(entries) ~= "table" or #entries == 0 then return false end

            -- Keep username matches first so short searches feel like Roblox's
            -- player finder instead of burying the closest username under display names.
            local queryLower = string.lower(trim(queryText))
            table.sort(entries, function(a, b)
                local aName = string.lower(tostring(type(a) == "table" and a.name or ""))
                local bName = string.lower(tostring(type(b) == "table" and b.name or ""))
                local aDisplay = string.lower(tostring(type(a) == "table" and a.displayName or ""))
                local bDisplay = string.lower(tostring(type(b) == "table" and b.displayName or ""))
                local function rank(name, displayName)
                    if name == queryLower then return 0 end
                    if string.sub(name, 1, #queryLower) == queryLower then return 1 end
                    if string.find(name, queryLower, 1, true) then return 2 end
                    if string.sub(displayName, 1, #queryLower) == queryLower then return 3 end
                    if string.find(displayName, queryLower, 1, true) then return 4 end
                    return 5
                end
                local ar, br = rank(aName, aDisplay), rank(bName, bDisplay)
                if ar ~= br then return ar < br end
                if #aName ~= #bName then return #aName < #bName end
                return aName < bName
            end)

            searchResultsRow.Visible = true
            for index, entry in ipairs(entries) do
                if index > 10 then break end
                local userId = tonumber(entry.id or entry.userId)
                if userId then
                    local row = newRow(searchResultsRow, "UserMatch", 54)
                    row.LayoutOrder = index
                    row.BackgroundTransparency = 0.03
                    makeStroke(row, active.Theme.SchemeColor, 0.62, 1)

                    local icon = Instance.new("ImageLabel")
                    icon.Position = UDim2.fromOffset(6, 6)
                    icon.Size = UDim2.fromOffset(42, 42)
                    icon.BackgroundTransparency = 0.08
                    icon.BorderSizePixel = 0
                    icon.ScaleType = Enum.ScaleType.Crop
                    icon.Parent = row
                    bind(icon, "BackgroundColor3", "Header")
                    makeCorner(icon, 8)

                    local display = tostring(entry.displayName or entry.name or "Roblox User")
                    local uname = tostring(entry.name or "")
                    local title = makeText(row, display, 11.5, Enum.Font.GothamBold)
                    title.Position = UDim2.fromOffset(57, 7)
                    title.Size = UDim2.new(1, -150, 0, 18)
                    title.TextXAlignment = Enum.TextXAlignment.Left
                    title.TextWrapped = false
                    local sub = makeText(row, "@" .. uname .. "  |  ID " .. tostring(userId), 9.5, Enum.Font.GothamMedium)
                    sub.Position = UDim2.fromOffset(57, 27)
                    sub.Size = UDim2.new(1, -150, 0, 17)
                    sub.TextXAlignment = Enum.TextXAlignment.Left
                    sub.TextWrapped = false
                    bind(sub, "TextColor3", "MutedText")

                    local open = makeButton(row, "View")
                    self:StyleSpecialActionButton(open, "accent")
                    open.AnchorPoint = Vector2.new(1, 0.5)
                    open.Position = UDim2.new(1, -7, 0.5, 0)
                    open.Size = UDim2.fromOffset(78, 32)
                    open.TextSize = 10.5
                    trackLocal(open.MouseButton1Click:Connect(function()
                        if lookup then lookup(tostring(userId)) end
                    end))

                    task.spawn(function()
                        local image = ""
                        pcall(function()
                            local result = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                            image = tostring(result or "")
                        end)
                        if icon and icon.Parent then icon.Image = image end
                    end)
                end
            end
            status.Text = "Found Roblox users matching " .. tostring(queryText) .. ". Tap View for full info."
            return true
        end

        lookup = function(rawQuery)
            rawQuery = trim(rawQuery)
            if rawQuery == "" then
                setResultsVisible(false)
                status.Text = "Enter part of a Roblox username, @username, User ID, or profile link."
                return
            end

            state.Serial = state.Serial + 1
            local serial = state.Serial
            state.LastQuery = rawQuery
            searchButton.Text = "..."
            status.Text = "Looking up " .. rawQuery .. "..."
            setResultsVisible(false)

            task.spawn(function()
                local cleanQuery = rawQuery:gsub("^@", "")
                local userId = tonumber(cleanQuery:match("^%d+$"))
                    or tonumber(cleanQuery:match("[Rr][Oo][Bb][Ll][Oo][Xx]%.com/users/(%d+)"))
                    or tonumber(cleanQuery:match("/users/(%d+)"))

                if not userId then
                    local encoded = HttpService:UrlEncode(cleanQuery)
                    local searchData, searchError = httpJson(
                        "https://users.roblox.com/v1/users/search?keyword=" .. encoded .. "&limit=10",
                        8
                    )
                    if serial ~= state.Serial or state.Destroyed then return end
                    if type(searchData) ~= "table" then
                        searchData, searchError = httpJson(
                            "https://users.roblox.com/v1/users/search?keyword=" .. encoded,
                            6
                        )
                    end
                    if serial ~= state.Serial or state.Destroyed then return end
                    local matches = type(searchData) == "table" and searchData.data or nil
                    searchButton.Text = "Lookup"
                    setResultsVisible(false)
                    if type(matches) == "table" and #matches > 0 then
                        local renderedOk = pcall(renderSearchMatches, matches, cleanQuery)
                        if not renderedOk then
                            clearSearchMatches()
                            status.Text = "Could not show those results. Press Lookup to retry."
                        end
                        return
                    end

                    -- Keyword search is the preferred route because it supports partial names.
                    -- If it is unavailable, fall baxk to Roblox's exact-name resolver.
                    local exactId = nil
                    local exactOk, exactResult = pcall(function()
                        return Players:GetUserIdFromNameAsync(cleanQuery)
                    end)
                    if exactOk then exactId = tonumber(exactResult) end
                    if serial ~= state.Serial or state.Destroyed then return end
                    if exactId then
                        lookup(tostring(exactId))
                        return
                    end

                    clearSearchMatches()
                    if searchError == "timeout" then
                        status.Text = "Roblox user search took too long. Press Lookup to retry."
                    else
                        status.Text = "No matching Roblox users found. Try a longer or different spelling."
                    end
                    return
                end

                clearSearchMatches()
                if serial ~= state.Serial or state.Destroyed then return end

                local profile = httpJson("https://users.roblox.com/v1/users/" .. tostring(userId))
                if serial ~= state.Serial or state.Destroyed then return end
                if type(profile) ~= "table" or tonumber(profile.id or userId) ~= userId then
                    searchButton.Text = "Lookup"
                    status.Text = "Could not load that Roblox profile."
                    return
                end

                local verified = profile.hasVerifiedBadge == true
                local userService = get.UserService
                if userService then
                    local infoOk, info = pcall(function()
                        return userService:GetUserInfosByUserIdsAsync({userId})
                    end)
                    if infoOk and type(info) == "table" and type(info[1]) == "table" then
                        if info[1].Username and not profile.name then profile.name = info[1].Username end
                        if info[1].DisplayName and not profile.displayName then profile.displayName = info[1].DisplayName end
                        verified = info[1].HasVerifiedBadge == true or verified
                    end
                end

                local friendsData = httpJson("https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/friends/count")
                local followersData = httpJson("https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/followers/count")
                local followingData = httpJson("https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/followings/count")
                local historyData = httpJson("https://users.roblox.com/v1/users/" .. tostring(userId) .. "/username-history?limit=10&sortOrder=Desc")
                local primaryData = httpJson("https://groups.roblox.com/v1/users/" .. tostring(userId) .. "/groups/primary/role")

                if serial ~= state.Serial or state.Destroyed then return end

                local thumb = ""
                pcall(function()
                    local image, ready = Players:GetUserThumbnailAsync(
                        userId,
                        Enum.ThumbnailType.HeadShot,
                        Enum.ThumbnailSize.Size420x420
                    )
                    if ready or type(image) == "string" then thumb = tostring(image or "") end
                end)

                state.UserId = userId
                state.Profile = profile
                searchBox.Text = tostring(profile.name or cleanQuery)
                avatar.Image = thumb
                displayName.Text = tostring(profile.displayName or profile.name or "Roblox User")
                    .. (verified and (" " .. utf8.char(0x2713)) or "")
                username.Text = "@" .. tostring(profile.name or cleanQuery)
                idLine.Text = "User ID: " .. tostring(userId)

                local created = tostring(profile.created or "Unknown")
                local dateOnly = created:match("^(%d%d%d%d%-%d%d%-%d%d)") or created
                local accountAge = nil
                pcall(function()
                    local made = DateTime.fromIsoDate(created)
                    local now = DateTime.now()
                    accountAge = math.max(0, math.floor((now.UnixTimestamp - made.UnixTimestamp) / 86400))
                end)
                createdLine.Text = accountAge
                    and ("Kreated: " .. dateOnly .. "  |  " .. tostring(accountAge) .. " days ago")
                    or ("Kreated: " .. dateOnly)

                accountLine.Text = "Account: " .. (profile.isBanned == true and "Banned" or "Active")
                    .. (verified and "  |  Verified" or "")

                local serverPlayer = findServerPlayer(userId, profile.name)
                serverLine.Text = "In this server: " .. (serverPlayer and "Yes" or "No")

                socialValues.Friends.Text = tostring(type(friendsData) == "table" and friendsData.count or "--")
                socialValues.Followers.Text = tostring(type(followersData) == "table" and followersData.count or "--")
                socialValues.Following.Text = tostring(type(followingData) == "table" and followingData.count or "--")

                local description = trim(profile.description)
                bio.Text = description ~= "" and description or "No description."

                local oldNames = {}
                if type(historyData) == "table" and type(historyData.data) == "table" then
                    for index, entry in ipairs(historyData.data) do
                        if index > 5 then break end
                        local oldName = type(entry) == "table" and entry.name or nil
                        if oldName and oldName ~= "" then table.insert(oldNames, tostring(oldName)) end
                    end
                end
                history.Text = #oldNames > 0 and table.concat(oldNames, "  |  ") or "None found"

                local primaryName = "None"
                if type(primaryData) == "table" and type(primaryData.group) == "table" then
                    primaryName = tostring(primaryData.group.name or "None")
                    if type(primaryData.role) == "table" and primaryData.role.name then
                        primaryName = primaryName .. "  |  " .. tostring(primaryData.role.name)
                    end
                end
                group.Text = "Primary Group: " .. primaryName

                setResultsVisible(true)
                refreshFriendButton()
                status.Text = "Showing public info for @" .. tostring(profile.name or cleanQuery) .. "."
                searchButton.Text = "Lookup"
            end)
        end

        trackLocal(searchButton.MouseButton1Click:Connect(function()
            lookup(searchBox.Text)
        end))
        trackLocal(searchBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then lookup(searchBox.Text) end
        end))
        trackLocal(refreshButton.MouseButton1Click:Connect(function()
            lookup(state.LastQuery ~= "" and state.LastQuery or searchBox.Text)
        end))
        trackLocal(copyIdButton.MouseButton1Click:Connect(function()
            if state.UserId and copyText(tostring(state.UserId)) then
                flashButton(copyIdButton, "Kopied", 0.9)
            end
        end))
        trackLocal(copyProfileButton.MouseButton1Click:Connect(function()
            if state.UserId then
                local link = "https://www.roblox.com/users/" .. tostring(state.UserId) .. "/profile"
                if copyText(link) then flashButton(copyProfileButton, "Kopied", 0.9) end
            end
        end))
        trackLocal(friendButton.MouseButton1Click:Connect(function()
            local userId = tonumber(state.UserId)
            if not userId or userId == LocalPlayer.UserId then return end

            local isFriend = false
            pcall(function() isFriend = LocalPlayer:IsFriendsWithAsync(userId) == true end)
            if isFriend then
                refreshFriendButton()
                return
            end

            local target = findServerPlayer(userId, state.Profile and state.Profile.name)
            if not target then
                LULA:ShowIsland(
                    "Add Friend",
                    "That user must be in the same server before Roblox kan open the friend request.",
                    {Duration = 3.2}
                )
                return
            end

            local starterGui = get.StarterGui
            local prompted = false
            for _ = 1, 8 do
                local ok = pcall(function()
                    starterGui:SetCore("PromptSendFriendRequest", target)
                end)
                if ok then
                    prompted = true
                    break
                end
                task.wait(0.15)
            end
            if prompted then
                flashButton(friendButton, "Opened", 1)
            else
                flashButton(friendButton, "Unavailable", 1)
            end
        end))

        state.Lookup = lookup
        state.Cleanup = function()
            if state.Destroyed then return end
            state.Destroyed = true
            state.Serial = state.Serial + 1
            for _, connection in ipairs(state.Connections) do
                pcall(function() if connection and connection.Connected then connection:Disconnect() end end)
            end
            state.Connections = {}
        end

        return tab
    end

    function window:EnablePersonalShelf(tabName)
        if active.Shelf then return active.Shelf.Tab end
        local shelfTab = self:NewTab(tabName or "My Shelf")
        shelfTab:EnsureBuilt()
        local scroll = shelfTab.Scroll

        local profile = newRow(scroll, "ShelfProfile", 174)
        profile.LayoutOrder = -4000
        profile.BackgroundTransparency = 0.02
        makeStroke(profile, active.Theme.SchemeColor, 0.24, 1)

        local viewport, fallbackAvatar = createAnimatedAvatarViewport(profile, {
            Name = "ShelfAvatarViewport",
            ModelName = "ShelfAvatarModel",
            UserId = LocalPlayer.UserId,
            AnimationId = env.LH_MY_SHELF_ANIMATION_ID or DEFAULT_MY_SHELF_ANIMATION_ID,
            Position = UDim2.fromOffset(12, 12),
            Width = 116,
            Height = 116,
            Radius = 58,
            FieldOfView = 32,
            DistanceScale = 1.02,
            AnimationSpeed = 0.82,
        })

        local hi = makeText(profile, "Hi, my name is " .. tostring(LocalPlayer.DisplayName), 16, Enum.Font.GothamBold)
        hi.Position = UDim2.fromOffset(142, 12)
        hi.Size = UDim2.new(1, -154, 0, 30)
        hi.TextXAlignment = Enum.TextXAlignment.Left
        hi.TextWrapped = true

        local username = makeText(profile, "@" .. tostring(LocalPlayer.Name), 13, Enum.Font.GothamMedium)
        username.Position = UDim2.fromOffset(142, 45)
        username.Size = UDim2.new(1, -154, 0, 20)
        username.TextXAlignment = Enum.TextXAlignment.Left
        bind(username, "TextColor3", "SchemeColor")

        local details = makeText(profile,
            "User ID: " .. tostring(LocalPlayer.UserId) .. "  |  Account Age: " .. tostring(LocalPlayer.AccountAge) .. " days",
            11.5, Enum.Font.Gotham)
        details.Position = UDim2.fromOffset(142, 68)
        details.Size = UDim2.new(1, -154, 0, 34)
        details.TextXAlignment = Enum.TextXAlignment.Left
        details.TextWrapped = true
        bind(details, "TextColor3", "MutedText")

        local about = makeText(profile,
            "This is your personal LH tab. Save your favorite features, launch them fast, delete them with Undo, and rearrange them your way.",
            11.5, Enum.Font.Gotham)
        about.Position = UDim2.fromOffset(142, 103)
        about.Size = UDim2.new(1, -154, 0, 56)
        about.TextXAlignment = Enum.TextXAlignment.Left
        about.TextYAlignment = Enum.TextYAlignment.Top
        about.TextWrapped = true
        bind(about, "TextColor3", "MutedText")

        local controlsRow = Instance.new("Frame")
        controlsRow.Name = "ShelfTopControls"
        controlsRow.LayoutOrder = -3000
        controlsRow.Size = UDim2.new(1, -4, 0, 62)
        controlsRow.BackgroundTransparency = 1
        controlsRow.Parent = scroll
        local controlsLayout = Instance.new("UIListLayout")
        controlsLayout.FillDirection = Enum.FillDirection.Horizontal
        controlsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        controlsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        controlsLayout.Padding = UDim.new(0, 6)
        controlsLayout.Parent = controlsRow

        local status = Instance.new("Frame")
        status.Name = "ShelfEditingStatus"
        status.LayoutOrder = -2500
        status.Size = UDim2.new(1, -4, 0, 28)
        status.BackgroundTransparency = 1
        status.Visible = false
        status.Parent = scroll
        local statusIcon = makeShelfToolsIcon(status)
        statusIcon.AnchorPoint = Vector2.new(1, 0.5)
        statusIcon.Position = UDim2.new(0.5, -58, 0.5, 0)
        local statusText = makeText(status, "in Editing Mode", 12.5, Enum.Font.GothamBold)
        statusText.Position = UDim2.new(0.5, -52, 0, 0)
        statusText.Size = UDim2.fromOffset(150, 28)
        statusText.TextXAlignment = Enum.TextXAlignment.Left
        bind(statusText, "TextColor3", "SchemeColor")

        local itemsHolder = Instance.new("Frame")
        itemsHolder.Name = "ShelfItems"
        itemsHolder.LayoutOrder = 0
        itemsHolder.Size = UDim2.new(1, -4, 0, 0)
        itemsHolder.AutomaticSize = Enum.AutomaticSize.Y
        itemsHolder.BackgroundTransparency = 1
        itemsHolder.Parent = scroll
        local itemsLayout = Instance.new("UIListLayout")
        itemsLayout.Padding = UDim.new(0, 6)
        itemsLayout.SortOrder = Enum.SortOrder.LayoutOrder
        itemsLayout.Parent = itemsHolder
        local itemsPadding = Instance.new("UIPadding")
        itemsPadding.PaddingBottom = UDim.new(0, 8)
        itemsPadding.Parent = itemsHolder

        local shelfData = {
            Tab = shelfTab,
            Scroll = scroll,
            Profile = profile,
            ControlsRow = controlsRow,
            EditingStatus = status,
            ItemsHolder = itemsHolder,
            Editing = false,
            Dragging = nil,
            RowMap = {},
            DeleteAllUndo = nil,
        }
        active.Shelf = shelfData

        local function miniControl(name, isToggle, initialValue, callback, danger)
            local frame = newRow(controlsRow, name, 54)
            frame.Size = UDim2.new(1 / 3, -6, 0, 54)
            frame.BackgroundTransparency = 0.04
            local label = makeText(frame, name, 11.5, Enum.Font.GothamBold)
            label.Position = UDim2.fromOffset(7, 4)
            label.Size = UDim2.new(1, -14, 0, 23)
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.TextWrapped = true
            local hit = makeButton(frame, "")
            hit.Size = UDim2.fromScale(1, 1)
            hit.BackgroundTransparency = 1
            hit.ZIndex = 8

            local api = {Value = initialValue == true, Frame = frame}
            if isToggle then
                local pill = Instance.new("Frame")
                pill.AnchorPoint = Vector2.new(0.5, 1)
                pill.Position = UDim2.new(0.5, 0, 1, -5)
                pill.Size = UDim2.fromOffset(34, 18)
                pill.BorderSizePixel = 0
                pill.Parent = frame
                makeCorner(pill, 9)
                local knob = Instance.new("Frame")
                knob.Size = UDim2.fromOffset(14, 14)
                knob.BorderSizePixel = 0
                knob.BackgroundColor3 = rgb(248, 248, 250)
                knob.Parent = pill
                makeCorner(knob, 7)
                function api:Render()
                    pill.BackgroundColor3 = self.Value and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
                    knob.Position = self.Value and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
                end
                function api:SetValue(value, fire)
                    self.Value = value == true
                    self:Render()
                    if fire ~= false and type(callback) == "function" then callback(self.Value) end
                end
                api:Render()
                track(hit.MouseButton1Click:Connect(function() api:SetValue(not api.Value, true) end))
            else
                if danger then
                    frame.BackgroundColor3 = rgb(102, 31, 40)
                    label.TextColor3 = rgb(255, 236, 239)
                end
                track(hit.MouseButton1Click:Connect(function()
                    if type(callback) == "function" then callback() end
                end))
            end
            return api
        end

        -- This compact toggle lives in the profile card so users can disable the
        -- hold-to-add pop-up without disabling their saved Shelf items.
        local holdToggle = makeKolorButton(profile, "Shelf Hold Menu", TOGGLE_OFF_COLOR)
        holdToggle.AnchorPoint = Vector2.new(0, 1)
        holdToggle.Position = UDim2.fromOffset(12, 164)
        holdToggle.Size = UDim2.fromOffset(116, 28)
        holdToggle.TextSize = 10.5
        holdToggle.BackgroundTransparency = 0.08
        local holdDot = Instance.new("Frame")
        holdDot.AnchorPoint = Vector2.new(1, 0.5)
        holdDot.Position = UDim2.new(1, -7, 0.5, 0)
        holdDot.Size = UDim2.fromOffset(9, 9)
        holdDot.BorderSizePixel = 0
        holdDot.Parent = holdToggle
        makeCorner(holdDot, 5)
        local function renderHoldToggle()
            local enabled = settings.ShelfEnabled ~= false
            holdToggle.Text = "Shelf Hold Menu"
            holdToggle.BackgroundColor3 = enabled and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
            holdToggle.TextColor3 = rgb(255, 255, 255)
            holdDot.BackgroundColor3 = rgb(255, 255, 255)
        end
        renderHoldToggle()
        track(holdToggle.MouseButton1Click:Connect(function()
            settings.ShelfEnabled = not (settings.ShelfEnabled ~= false)
            env.LHSettings = env.LHSettings or {}
            env.LHSettings.ShelfEnabled = settings.ShelfEnabled
            env.LHUISettings.ShelfEnabled = settings.ShelfEnabled
            renderHoldToggle()
            persistIndependentShelfSetting()
            refreshShelf()
            LULA:ShowIsland("My Shelf", settings.ShelfEnabled and "Hold-to-add pop-ups enabled." or "Hold-to-add pop-ups disabled.", {Duration = 2.4})
        end))

        local autoSaveControl
        autoSaveControl = miniControl("Auto Save", true, settings.ShelfAutoSave == true, function(value)
            settings.ShelfAutoSave = value == true
            env.LHSettings = env.LHSettings or {}
            env.LHSettings.ShelfAutoSave = settings.ShelfAutoSave
            env.LHUISettings.ShelfAutoSave = settings.ShelfAutoSave
            persistIndependentShelfSetting()
            LULA:ShowIsland("My Shelf Auto Save", value and "Shelf edits save instantly." or "Shelf edits wait for Save Settings.", {Duration = 2.5})
        end)

        miniControl("Delete All", false, false, function()
            local current = getShelfList()
            if #current == 0 then
                LULA:ShowIsland("My Shelf", "Your Shelf is already empty.", {Duration = 2.2})
                return
            end
            LULA:Confirm("Delete All Shelf Skripts?", "Are you sure you want to delete all skripts in My Shelf?", function()
                local snapshot = {}
                for _, savedId in ipairs(current) do table.insert(snapshot, tostring(savedId)) end
                local undoToken = tostring(os.clock()) .. ":" .. tostring(math.random(100000, 999999))
                shelfData.DeleteAllUndo = {
                    Items = snapshot,
                    ExpiresAt = os.clock() + 7,
                    Token = undoToken,
                }
                saveShelfList({})
                refreshShelf()
                LULA:ShowIsland("My Shelf", "All Shelf skripts were deleted. Undo is available here for 7 seconds.", {Duration = 2.7})

                task.delay(7.05, function()
                    if not active or active.Shelf ~= shelfData then return end
                    local pending = shelfData.DeleteAllUndo
                    if pending and tostring(pending.Token or "") == undoToken then
                        shelfData.DeleteAllUndo = nil
                        refreshShelf()
                    end
                end)
            end)
        end, true)

        local rearrangeControl
        rearrangeControl = miniControl("Rearrange", true, false, function(value)
            shelfData.Editing = value == true
            status.Visible = shelfData.Editing
            refreshShelf()
        end)

        refreshShelf()
        task.spawn(function()
            for _, candidate in ipairs(active and active.Tabs or {}) do
                if not active then return end
                if candidate ~= shelfTab then candidate:EnsureBuilt() end
                task.wait()
            end
            refreshShelf()
        end)
        return shelfTab
    end

    function window:RefreshShelf() refreshShelf() end

    function window:GetUIState()
        if not active then return nil end
        local state = {
            Version = 4,
            SelectedTab = active.SelectedTab and active.SelectedTab.Name or nil,
            Visible = active.ScreenGui.Enabled,
            Main = {
                Position = {main.Position.X.Scale, main.Position.X.Offset, main.Position.Y.Scale, main.Position.Y.Offset},
                Size = {main.Size.X.Scale, main.Size.X.Offset, main.Size.Y.Scale, main.Size.Y.Offset},
            },
            TabList = {tabList.CanvasPosition.X, tabList.CanvasPosition.Y},
            Tabs = {},
            BackStack = shallowCopyArray(active.BackStack),
            ForwardStack = shallowCopyArray(active.ForwardStack),
        }
        for _, tab in ipairs(active.Tabs) do
            local position = tab.Scroll and tab.Scroll.CanvasPosition or tab.LastCanvasPosition or Vector2.new()
            state.Tabs[tab.Name] = {
                Scroll = {position.X, position.Y},
                Search = tab.SearchBar and tab.SearchBar.TextBox and tab.SearchBar.TextBox.Text or "",
            }
        end
        return state
    end

    function window:RestoreUIState(state)
        if type(state) ~= "table" or not active then return false, "invalid state" end
        local mainState = state.Main
        if type(mainState) == "table" then
            local position = mainState.Position
            local size = mainState.Size
            if type(size) == "table" and #size >= 4 then
                local width = math.clamp(tonumber(size[2]) or main.Size.X.Offset, 420, 760)
                local height = math.clamp(tonumber(size[4]) or main.Size.Y.Offset, 250, 520)
                main.Size = UDim2.new(tonumber(size[1]) or 0, width, tonumber(size[3]) or 0, height)
            end
            if type(position) == "table" and #position >= 4 then
                main.Position = UDim2.new(tonumber(position[1]) or 0.5, tonumber(position[2]) or 0, tonumber(position[3]) or 0.5, tonumber(position[4]) or 0)
            end
            clampMain(main)
        end
        active.BackStack = type(state.BackStack) == "table" and shallowCopyArray(state.BackStack) or {}
        active.ForwardStack = type(state.ForwardStack) == "table" and shallowCopyArray(state.ForwardStack) or {}
        if type(state.TabList) == "table" then
            tabList.CanvasPosition = Vector2.new(tonumber(state.TabList[1]) or 0, tonumber(state.TabList[2]) or 0)
        end
        local tabStates = type(state.Tabs) == "table" and state.Tabs or {}
        for _, tab in ipairs(active.Tabs) do
            local animationTabName = utf8.char(0x2605) .. " Free Animations"
            local emoteTabName = utf8.char(0x2605) .. " Free Emotes"
            local saved = tabStates[tab.Name]
                or ((tab.Name == animationTabName or tab.Name == "Free Animations")
                    and (tabStates["Free Animations"] or tabStates["Free Animation Packs"] or tabStates["Animation Bundles"]))
                or ((tab.Name == emoteTabName or tab.Name == "Free Emotes") and tabStates["Free Emotes"])
            if type(saved) == "table" and type(saved.Scroll) == "table" then
                tab.LastCanvasPosition = Vector2.new(tonumber(saved.Scroll[1]) or 0, tonumber(saved.Scroll[2]) or 0)
            end
        end
        local target = findTabByName(state.SelectedTab) or active.Tabs[1]
        if target then selectTab(target, "restore") end
        task.defer(function()
            RunService.Heartbeat:Wait()
            RunService.Heartbeat:Wait()
            if not active then return end

            -- Crash/session restore is UI-only on purpose. Never replay saved feature
            -- callbacks/toggles/textboxes here; those can change gameplay or execute stale actions.

            for _, tab in ipairs(active.Tabs) do
                local animationTabName = utf8.char(0x2605) .. " Free Animations"
            local emoteTabName = utf8.char(0x2605) .. " Free Emotes"
            local saved = tabStates[tab.Name]
                or ((tab.Name == animationTabName or tab.Name == "Free Animations")
                    and (tabStates["Free Animations"] or tabStates["Free Animation Packs"] or tabStates["Animation Bundles"]))
                or ((tab.Name == emoteTabName or tab.Name == "Free Emotes") and tabStates["Free Emotes"])
                if type(saved) == "table" then
                    if saved.Search and saved.Search ~= "" then
                        tab:EnsureBuilt()
                        if tab.SearchBar and tab.SearchBar.TextBox then
                            tab.SearchBar.TextBox.Text = tostring(saved.Search)
                            if type(tab.SearchBar.Apply) == "function" then
                                pcall(tab.SearchBar.Apply, saved.Search)
                            end
                        end
                    end
                    if tab.Scroll then
                        local wanted = tab.LastCanvasPosition or Vector2.new()
                        local maxY = math.max(0, tab.Scroll.AbsoluteCanvasSize.Y - tab.Scroll.AbsoluteWindowSize.Y)
                        tab.Scroll.CanvasPosition = Vector2.new(math.max(0, wanted.X), math.clamp(wanted.Y, 0, maxY))
                    end
                end
            end
            active.ScreenGui.Enabled = state.Visible ~= false
            updateNavButtons()
        end)
        return true
    end

    function window:GetTabs() return active.Tabs end
    function window:GetRoot() return main end
    function window:SetFooter(text) footer.Text = tostring(text or "") end
    function window:SetFont(fontName) return LULA:SetFont(fontName) end
    function window:Notify(...) return LULA:Notify(...) end
    function window:ShowIsland(...) return LULA:ShowIsland(...) end
    function window:SetVisible(value) return LULA:SetUIVisible(value) end
    function window:IsVisible() return LULA:IsVisible() end
    function window:Destroy() LULA:Destroy() end

    active.Window = window
    return window
end

function LULA:ToggleUI()
    if active and active.ScreenGui then
        active.ScreenGui.Enabled = not active.ScreenGui.Enabled
        setGlassBlur(active.ScreenGui.Enabled)
        return active.ScreenGui.Enabled
    end
    return false
end

function LULA:SetUIVisible(value)
    if not active or not active.ScreenGui then return false end
    active.ScreenGui.Enabled = value and true or false
    setGlassBlur(active.ScreenGui.Enabled)
    return active.ScreenGui.Enabled
end

function LULA:IsVisible()
    return active and active.ScreenGui and active.ScreenGui.Enabled == true or false
end

function LULA:ChangeColor(property, color)
    if not active or typeof(color) ~= "Color3" then return false end
    local aliases = {Accent = "SchemeColor", Scheme = "SchemeColor", Text = "TextColor"}
    property = aliases[property] or property
    if active.Theme[property] == nil then return false end
    if property == "TextColor" then color = readableTextColor(color, active.Theme) end
    active.Theme[property] = color
    if property == "SchemeColor" then env.LollypopTheme = color end
    applyTheme()
    return true, color
end

function LULA:SetTextColor(color)
    local ok, safeColor = self:ChangeColor("TextColor", color)
    if not ok then return nil end
    return safeColor
end

function LULA:SetTheme(themeInput)
    if not active then return false end
    active.ThemeSource = themeInput
    active.Theme = resolveTheme(themeInput)
    applyTheme()
    return true
end

function LULA:SetAppearanceMode(mode)
    mode = string.lower(tostring(mode or "Dark")) == "light" and "Light" or "Dark"
    settings.AppearanceMode = mode
    if active then
        active.Theme = resolveTheme(active.ThemeSource or "Kandy")
        applyTheme()
    end
    return mode
end

function LULA:SetThemeBrightness(value)
    value = math.clamp(tonumber(value) or 0, -80, 100)
    settings.ThemeBrightness = value
    if active then
        active.Theme = resolveTheme(active.ThemeSource or "Kandy")
        applyTheme()
    end
    return value
end

function LULA:GetThemeNames()
    local copy = {}
    for index, name in ipairs(publicThemeNames) do copy[index] = name end
    return copy
end

function LULA:GetFontNames()
    local copy = {}
    for index, name in ipairs(fontNames) do copy[index] = name end
    return copy
end

function LULA:SetFont(fontName)
    fontName = tostring(fontName or "Gotham")
    if not fontMap[fontName] then return false end
    settings.UIFont = fontName
    applyUIFont()
    return true
end

function LULA:SetReducedMotion(value)
    settings.ReducedMotion = value and true or false
end

function LULA:SetLowPerformance(value)
    settings.LowPerformance = value and true or false
    setGlassBlur(not settings.LowPerformance)
    if active and active.ParticleLayer then active.ParticleLayer.Visible = false end
end

function LULA:SetDragLocked(value)
    settings.DragLocked = value and true or false
end

function LULA:SetEdgeSnap(value)
    settings.EdgeSnap = value and true or false
end

function LULA:SetScaleMode(value)
    settings.ScaleMode = tostring(value or "Auto")
    if active and active.Scale then
        active.Scale.Scale = adaptiveScale()
        task.defer(function() clampMain(active.Main) end)
    end
end

function LULA:SetGlassBlur(_value)
    settings.GlassBlur = false
    setGlassBlur(false)
end

function LULA:SetCustomCursor(value)
    settings.CustomCursor = value and true or false
    if active and active.Cursor then
        active.Cursor.Visible = settings.CustomCursor and not UserInputService.TouchEnabled
        pcall(function() UserInputService.MouseIconEnabled = not active.Cursor.Visible end)
    end
end

function LULA:GetNotificationHistory()
    return notificationHistory
end

function LULA:GetActiveWindow()
    return active and active.Window or nil
end

function LULA:GetRoot()
    return active and active.Main or nil
end

function LULA:GetUIState()
    return active and active.Window and active.Window:GetUIState() or nil
end

function LULA:RestoreUIState(state)
    if not active or not active.Window then return false, "UI is not active" end
    return active.Window:RestoreUIState(state)
end

function LULA:RefreshShelf()
    refreshShelf()
end

function LULA:Destroy()
    if not active then return end
    if active.AnimationBundles and type(active.AnimationBundles.RestoreOriginal) == "function" then
        pcall(active.AnimationBundles.RestoreOriginal)
    end
    if active.FreeEmotes and type(active.FreeEmotes.Stop) == "function" then
        pcall(active.FreeEmotes.Stop)
    end
    if active.AvatarKreator and type(active.AvatarKreator.Cleanup) == "function" then
        pcall(function() active.AvatarKreator.Cleanup(true) end)
    end
    if active.AutoExecuteManager and type(active.AutoExecuteManager.Cleanup) == "function" then
        pcall(active.AutoExecuteManager.Cleanup)
    end
    if active.UserLookup and type(active.UserLookup.Cleanup) == "function" then
        pcall(active.UserLookup.Cleanup)
    end
    pcall(function() UserInputService.MouseIconEnabled = true end)
    disconnectAll()
    if active.Blur then pcall(function() active.Blur:Destroy() end) end
    if active.ScreenGui then pcall(function() active.ScreenGui:Destroy() end) end
    active = nil
    bindings = {}
    controlIdRegistry = {}
    controlFrameRegistry = setmetatable({}, {__mode = "k"})
end

return LULA;
