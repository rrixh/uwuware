        local function resetRegistries()
            registry.Toggles = {}
            registry.Stars = {}
            registry.Speeds = {}
            clearPreviews()
        end

        local function renderMarketplace(reset)
            UI.MarketHolder.Visible = true
            UI.FavoritesHolder.Visible = false
            if reset == true then
                clearHolder(UI.MarketHolder, "UIGridLayout")
                resetRegistries()
                state.RenderedCount = 0
            end

            local shown = math.min(state.DisplayCount, #state.Results)
            for index = state.RenderedCount + 1, shown do
                makeMarketplaceCard(state.Results[index], index)
            end
            state.RenderedCount = shown

            UI.ResultCount.Text = tostring(#state.Results) .. " emotes found"
                .. (shown < #state.Results and (" - showing " .. tostring(shown)) or "")
            UI.Empty.Visible = shown == 0 and not state.Searching
            UI.Empty.Text = trim(UI.MarketSearchBox.Text) == ""
                and "No emotes were returned by Roblox."
                or "No emotes matched this search."
            UI.LoadMore.Visible = not state.Searching
                and (state.DisplayCount < #state.Results or state.HasMore == true)
            UI.LoadMore.Text = state.LoadingMore and "Loading..." or "Load More"
            task.defer(updateGrid)
        end

        renderFavorites = function(query)
            UI.MarketHolder.Visible = false
            UI.FavoritesHolder.Visible = true
            clearHolder(UI.MarketHolder, "UIGridLayout")
            state.RenderedCount = 0
            clearHolder(UI.FavoritesHolder, "UIListLayout")
            resetRegistries()

            local filtered = {}
            local normalizedQuery = normalizeWords(query)
            for _, item in ipairs(getFavorites()) do
                if normalizedQuery == ""
                    or containsPlain(item.Name, normalizedQuery)
                    or containsPlain(item.CreatorName, normalizedQuery)
                    or tostring(item.Id):find(normalizedQuery, 1, true) then
                    table.insert(filtered, item)
                end
            end
            table.sort(filtered, function(a, b) return lower(a.Name) < lower(b.Name) end)
            for index, item in ipairs(filtered) do makeFavoriteRow(item, index) end

            UI.ResultCount.Text = tostring(#filtered) .. " favorite emotes"
            UI.Empty.Visible = #filtered == 0
            UI.Empty.Text = #getFavorites() == 0
                and "No favorite emotes saved yet."
                or "No favorite emotes matched this search."
            UI.LoadMore.Visible = false
        end

        local function setSearching(value, message)
            state.Searching = value == true
            UI.Loading.Visible = state.Searching
            if message then UI.Loading.Text = tostring(message) end
            UI.MarketSearchButton.Active = not state.Searching
            UI.MarketSearchBox.TextEditable = not state.Searching
        end

        local function setSuggestion(corrected, original)
            state.CorrectedQuery = corrected
            state.OriginalQuery = original
            UI.Suggestion.Visible = state.Mode == "marketplace" and corrected ~= nil and original ~= nil
            if UI.Suggestion.Visible then
                UI.SuggestionText.Text = "Showing results for \"" .. tostring(corrected) .. "\""
                UI.OriginalSearch.Text = "Search original: \"" .. tostring(original) .. "\""
            end
        end

        local function performSearch(query, forceOriginal)
            query = trim(query)
            state.SearchSerial = state.SearchSerial + 1
            local serial = state.SearchSerial
            setSuggestion(nil, nil)
            setSearching(true, "Searching Roblox Marketplace...")
            state.Results = {}
            state.ResultIds = {}
            state.DisplayCount = 0
            state.NextPage = nil
            state.HasMore = false
            state.RenderedCount = 0
            renderMarketplace(true)

            task.spawn(function()
                local ok, results, nextPage, hasMore = pcall(startSearchBackend, query)
                local finalQuery = query
                if ok and #results == 0 and query ~= "" and forceOriginal ~= true then
                    local correction = findCorrection(query)
                    if correction and correction ~= normalizeWords(query) then
                        local correctedOk, correctedResults, correctedNext, correctedMore = pcall(startSearchBackend, correction)
                        if correctedOk and #correctedResults > 0 then
                            ok = true
                            results = correctedResults
                            nextPage = correctedNext
                            hasMore = correctedMore
                            finalQuery = correction
                            setSuggestion(correction, query)
                        end
                    end
                end

                if serial ~= state.SearchSerial then return end
                if not ok then
                    setSearching(false)
                    renderMarketplace(true)
                    emoteNotify(tostring(results), "error", 4)
                    return
                end

                state.Results = {}
                state.ResultIds = {}
                state.NextPage = nextPage
                state.HasMore = hasMore == true
                mergeResults(results)
                state.DisplayCount = math.min(state.DisplayStep, #state.Results)
                if finalQuery ~= query and state.OriginalQuery == nil then
                    setSuggestion(finalQuery, query)
                end
                setSearching(false)
                renderMarketplace(true)
                task.defer(function() scroll.CanvasPosition = Vector2.new(0, 0) end)
            end)
        end

        local function loadMore()
            if state.Mode ~= "marketplace" or state.Searching or state.LoadingMore then return end

            if state.DisplayCount < #state.Results then
                state.DisplayCount = math.min(#state.Results, state.DisplayCount + state.DisplayStep)
                renderMarketplace(false)
                return
            end

            if not state.HasMore or typeof(state.NextPage) ~= "function" then
                UI.LoadMore.Visible = false
                return
            end

            state.LoadingMore = true
            UI.LoadMore.Text = "Loading..."
            task.spawn(function()
                local ok, page, hasMore, nextFunction = pcall(state.NextPage)
                if ok then
                    if type(nextFunction) == "function" then state.NextPage = nextFunction end
                    state.HasMore = hasMore == true
                    local before = #state.Results
                    mergeResults(page)
                    state.DisplayCount = math.min(#state.Results, math.max(state.DisplayCount + state.DisplayStep, before + state.DisplayStep))
                else
                    state.HasMore = false
                    emoteNotify("Could not load more Marketplace emotes.", "error", 3.5)
                end
                state.LoadingMore = false
                renderMarketplace(false)
            end)
        end

        local function setMode(mode)
            local previousMode = state.Mode
            state.Mode = mode == "favorites" and "favorites" or "marketplace"
            local marketplaceActive = state.Mode == "marketplace"
            UI.MarketplaceMode.BackgroundColor3 = marketplaceActive and emoteAccent(active.Theme.SchemeColor) or active.Theme.ElementColor
            UI.FavoritesMode.BackgroundColor3 = marketplaceActive and active.Theme.ElementColor or emoteAccent(active.Theme.SchemeColor)
            UI.MarketSearchRow.Visible = marketplaceActive
            UI.FavoriteSearchRow.Visible = not marketplaceActive
            UI.DeleteAll.Visible = not marketplaceActive
            UI.FavoriteSaveControls:SetVisible(not marketplaceActive)
            UI.Suggestion.Visible = marketplaceActive and state.CorrectedQuery ~= nil
            if marketplaceActive then
                if previousMode == "favorites" then
                    clearHolder(UI.FavoritesHolder, "UIListLayout")
                    resetRegistries()
                    state.RenderedCount = 0
                end
                if #state.Results == 0 and not state.Searching then
                    performSearch(UI.MarketSearchBox.Text, false)
                else
                    renderMarketplace(false)
                end
            else
                renderFavorites(UI.FavoriteSearchBox.Text)
            end
            task.defer(function() scroll.CanvasPosition = Vector2.new(0, 0) end)
        end

        track(UI.MarketplaceMode.Activated:Connect(function() setMode("marketplace") end))
        track(UI.FavoritesMode.Activated:Connect(function() setMode("favorites") end))
        track(UI.MarketSearchButton.Activated:Connect(function() performSearch(UI.MarketSearchBox.Text, false) end))
        track(UI.FavoriteSearchButton.Activated:Connect(function() renderFavorites(UI.FavoriteSearchBox.Text) end))
        track(UI.MarketSearchBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then performSearch(UI.MarketSearchBox.Text, false) end
        end))
        track(UI.FavoriteSearchBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then renderFavorites(UI.FavoriteSearchBox.Text) end
        end))
        track(UI.OriginalSearch.Activated:Connect(function()
            if state.OriginalQuery then
                UI.MarketSearchBox.Text = state.OriginalQuery
                performSearch(state.OriginalQuery, true)
            end
        end))

        local marketClear = UI.MarketSearchRow:FindFirstChild("FreeEmoteMarketplaceSearchBox_ClearTextX")
        if marketClear then
            track(marketClear.Activated:Connect(function()
                task.defer(function()
                    if state.Mode == "marketplace" then performSearch("", false) end
                end)
            end))
        end
        local favoriteClear = UI.FavoriteSearchRow:FindFirstChild("FreeEmoteFavoriteSearchBox_ClearTextX")
        if favoriteClear then
            track(favoriteClear.Activated:Connect(function()
                task.defer(function()
                    if state.Mode == "favorites" then renderFavorites("") end
                end)
            end))
        end

        track(UI.LoadMore.Activated:Connect(loadMore))
        track(UI.DeleteAll.Activated:Connect(function()
            local favorites = getFavorites()
            if #favorites == 0 then
                emoteNotify("Favorites is already empty.", "info", 2.2)
                return
            end
            LULA:Confirm("Delete all emote favorites?", "Are you sure you want to delete every saved emote from Favorites?", function()
                local backup = favorites
                saveFavorites({})
                refreshStarVisuals()
                renderFavorites(UI.FavoriteSearchBox.Text)
                LULA:NotifyAction("warning", "Emote Favorites", "All emote favorites were deleted.", 7, "Undo", function()
                    saveFavorites(backup)
                    refreshStarVisuals()
                    if state.Mode == "favorites" then renderFavorites(UI.FavoriteSearchBox.Text) end
                end)
            end)
        end))

        state.RefreshTheme = function()
            local marketplaceActive = state.Mode == "marketplace"
            UI.MarketplaceMode.BackgroundColor3 = marketplaceActive and emoteAccent(active.Theme.SchemeColor) or active.Theme.ElementColor
            UI.FavoritesMode.BackgroundColor3 = marketplaceActive and active.Theme.ElementColor or emoteAccent(active.Theme.SchemeColor)
            UI.FavoriteSaveControls:Render()
            refreshStarVisuals()
            refreshToggleVisuals()
        end
        state.Refresh = function()
            if state.Mode == "favorites" then
                renderFavorites(UI.FavoriteSearchBox.Text)
            else
                renderMarketplace(false)
            end
        end
        state.Search = function(query)
            UI.MarketSearchBox.Text = tostring(query or "")
            setMode("marketplace")
            performSearch(UI.MarketSearchBox.Text, false)
        end
        state.Stop = function() return stopActiveEmote(true) end

        track(LocalPlayer.CharacterAdded:Connect(function()
            stopActiveEmote(true)
        end))

        settings.FreeEmoteFavorites = saveFavorites(getFavorites())
        persistEmoteSettings()
        setMode("marketplace")
        return emoteTab
    end



    --==================================================
    -- AVATAR KREATOR - ROBLOX AVATAR MARKETPLACE
    -- Integrated from the verified V4 standalone test.
    --==================================================
    function window:EnableAvatarKreator(tabName)
        if active.AvatarKreator then return active.AvatarKreator.Tab end

        local avatarTab = self:NewTab(tabName or (utf8.char(0x2605) .. " Avatar Kreator"))
        avatarTab:EnsureBuilt()
        avatarTab.Scroll.Visible = false
        avatarTab.Scroll.ScrollingEnabled = false

        local Players = game:GetService("Players")
        local TweenService = game:GetService("TweenService")
        local UserInputService = game:GetService("UserInputService")
        local HttpService = game:GetService("HttpService")
        local MarketplaceService = game:GetService("MarketplaceService")
        local AvatarEditorService = game:GetService("AvatarEditorService")
        local AssetService = game:GetService("AssetService")
        local InsertService = game:GetService("InsertService")
        local CoreGui = game:GetService("CoreGui")
        local RunService = game:GetService("RunService")
        local TextService = game:GetService("TextService")

        local LocalPlayer = Players.LocalPlayer
        while not LocalPlayer do
            Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
            LocalPlayer = Players.LocalPlayer
        end

        local GUI_NAME = "LH_AvatarKreatorIntegrated"
        local RUNTIME_KEY = "LHAvatarKreatorRuntimeCleanup"

        local ACCENT = active.Theme.SchemeColor
        local ACCENT_HOVER = blendColor(active.Theme.SchemeColor, Color3.new(1, 1, 1), 0.14)
        local BACKGROUND = active.Theme.Background
        local PANEL = active.Theme.Header
        local PANEL_2 = active.Theme.ElementColor
        local PANEL_3 = blendColor(active.Theme.ElementColor, Color3.new(1, 1, 1), 0.08)
        local TEXT = active.Theme.TextColor
        local MUTED = active.Theme.MutedText
        local STROKE = blendColor(active.Theme.ElementColor, active.Theme.TextColor, 0.18)
        local SUCCESS = Color3.fromRGB(86, 213, 145)
        local WARNING = Color3.fromRGB(255, 190, 80)
        local ERROR_COLOR = active.Theme.Danger or Color3.fromRGB(255, 101, 116)

        local function getEnvironment()
            if typeof(getgenv) == "function" then
                local ok, env = pcall(getgenv)
                if ok and type(env) == "table" then
                    return env
                end
            end
            return _G
        end

        local ENV = getEnvironment()

        local previousCleanup = ENV[RUNTIME_KEY]
        if typeof(previousCleanup) == "function" then
            pcall(previousCleanup)
        end

        local function getGlobal(name)
            local value = rawget(ENV, name)
            if value ~= nil then
                return value
            end
            return rawget(_G, name)
        end

        local function getGuiParent()
            local gethuiFn = getGlobal("gethui")
            if typeof(gethuiFn) == "function" then
                local ok, result = pcall(gethuiFn)
                if ok and result then
                    return result
                end
            end

            local canUseCoreGui = pcall(function()
                local test = Instance.new("Folder")
                test.Name = "__LHAvatarGuiTest"
                test.Parent = CoreGui
                test:Destroy()
            end)

            if canUseCoreGui then
                return CoreGui
            end

            return LocalPlayer:WaitForChild("PlayerGui")
        end

        local GuiParent = getGuiParent()
        local oldGui = GuiParent:FindFirstChild(GUI_NAME)
        if oldGui then
            oldGui:Destroy()
        end

        local function create(className, properties, children)
            local object = Instance.new(className)
            for property, value in pairs(properties or {}) do
                object[property] = value
            end
            for _, child in ipairs(children or {}) do
                child.Parent = object
            end
            return object
        end

        local function addCorner(parent, radius)
            local corner = create("UICorner", {
                CornerRadius = UDim.new(0, radius or 10)
            })
            corner.Parent = parent
            return corner
        end

        local function addStroke(parent, color, thickness, transparency)
            local stroke = create("UIStroke", {
                Color = color or STROKE,
                Thickness = thickness or 1,
                Transparency = transparency or 0
            })
            stroke.Parent = parent
            return stroke
        end

        local function tween(object, duration, properties, style, direction)
            local animation = TweenService:Create(
                object,
                TweenInfo.new(
                    duration or 0.18,
                    style or Enum.EasingStyle.Quad,
                    direction or Enum.EasingDirection.Out
                ),
                properties
            )
            animation:Play()
            return animation
        end

        local function trim(value)
            return tostring(value or ""):match("^%s*(.-)%s*$")
        end

        local function lower(value)
            return string.lower(tostring(value or ""))
        end

        local function containsPlain(haystack, needle)
            return string.find(lower(haystack), lower(needle), 1, true) ~= nil
        end

        local function extractNumericId(value)
            if type(value) == "number" then
                return math.floor(value)
            end
            local digits = tostring(value or ""):match("(%d+)")
            return digits and tonumber(digits) or nil
        end

        local function safeDisconnect(connection)
            if connection and typeof(connection) == "RBXScriptConnection" then
                pcall(function()
                    connection:Disconnect()
                end)
            end
        end

        local function resolveRequestFunction()
            local candidates = {
                getGlobal("request"),
                getGlobal("http_request"),
                getGlobal("httprequest")
            }

            local synTable = getGlobal("syn")
            if type(synTable) == "table" then
                table.insert(candidates, synTable.request)
            end

            local fluxusTable = getGlobal("fluxus")
            if type(fluxusTable) == "table" then
                table.insert(candidates, fluxusTable.request)
            end

            for _, candidate in ipairs(candidates) do
                if typeof(candidate) == "function" then
                    return candidate
                end
            end

            return nil
        end

        local executorRequest = resolveRequestFunction()

        local function httpGet(url)
            local ok, result = pcall(function()
                return game:HttpGet(url, true)
            end)
            if ok and type(result) == "string" and #result > 0 then
                return result
            end

            if executorRequest then
                local requestOk, response = pcall(executorRequest, {
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["Accept"] = "application/json",
                        ["User-Agent"] = "Roblox/LH-AvatarMarketplace"
                    }
                })

                if requestOk and type(response) == "table" then
                    local status = tonumber(
                        response.StatusCode
                        or response.Status
                        or response.status_code
                        or 0
                    ) or 0
                    local body = response.Body or response.body
                    if status >= 200 and status < 300 and type(body) == "string" then
                        return body
                    end
                end
            end

            error("No working HTTP GET method was available.")
        end

        local function resolveClipboardWriter()
            local candidates = {
                getGlobal("setclipboard"),
                getGlobal("toclipboard"),
                getGlobal("writeclipboard")
            }

            local synTable = getGlobal("syn")
            if type(synTable) == "table" then
                table.insert(candidates, synTable.write_clipboard)
                table.insert(candidates, synTable.setclipboard)
            end

            return function(text)
                for _, writer in ipairs(candidates) do
                    if typeof(writer) == "function" then
                        local ok = pcall(writer, tostring(text))
                        if ok then
                            return true
                        end
                    end
                end
                return false
            end
        end

        local copyToClipboard = resolveClipboardWriter()

        local function avatarAssetType(name)
            local ok, result = pcall(function()
                return Enum.AvatarAssetType[name]
            end)
            if ok then
                return result
            end
            return nil
        end

        local function accessoryType(name)
            local ok, result = pcall(function()
                return Enum.AccessoryType[name]
            end)
            if ok then
                return result
            end
            return nil
        end

