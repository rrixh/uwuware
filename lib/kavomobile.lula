        local detailCloseTop = makeKolorButton(detailsHeader, "X", ANIMATION_RED)
        detailCloseTop.AnchorPoint = Vector2.new(1, 0)
        detailCloseTop.Position = UDim2.new(1, -9, 0, 9)
        detailCloseTop.Size = UDim2.fromOffset(31, 31)
        detailCloseTop.TextSize = 11
        detailCloseTop.ZIndex = 9004

        local detailSectionLabel = makeText(detailsPanel, "Animation IDs / Character.Animate Paths / Sources", 12.5, Enum.Font.GothamBold)
        detailSectionLabel.Position = UDim2.fromOffset(13, 119)
        detailSectionLabel.Size = UDim2.new(1, -26, 0, 23)
        detailSectionLabel.TextXAlignment = Enum.TextXAlignment.Left
        detailSectionLabel.ZIndex = 9002

        local detailScroll = Instance.new("ScrollingFrame")
        detailScroll.Name = "AnimationIdRows"
        detailScroll.Position = UDim2.fromOffset(13, 145)
