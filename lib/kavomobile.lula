-- Kavo UI v3.1 - Lollypop Hub klassik-look upgrade
-- Preserves the old Kavo layout while adding responsive scaling, resizing, drag lock, scrollable tabs, safer callbacks, and mobile support.
-- Solid panels only: no glassmorphism, glowing panel borders, gradient sidebar, or background particles.

local LULA = {}
local env = (getgenv and getgenv()) or _G

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local function rgb(r, g, b)
    return Color3.fromRGB(r, g, b)
end

