        track(LoadMoreButton.MouseButton1Click:Connect(function()
            if state.Mode ~= "marketplace"
                or state.Loading
                or not state.CurrentHasMore
                or typeof(state.CurrentNextPage) ~= "function" then
                return
            end

            setLoading(true, "Loading more Marketplace items...")
            local nextPage = state.CurrentNextPage

            task.spawn(function()
                local ok, page, hasMore = pcall(nextPage)
                if state.Destroyed then
                    return
                end

                setLoading(false)

                if not ok then
                    state.CurrentHasMore = false
                    LoadMoreButton.Visible = false
                    notify("Could not load the next Marketplace page.", "error")
                    return
                end

                state.CurrentHasMore = hasMore == true
                sortResults(page, state.CurrentQuery)
                appendResults(page)
            end)
        end))

        local function updateGrid()
            local width = ResultsScroll.AbsoluteSize.X
            if width <= 0 then return end

            local columns
            if width < 245 then
                columns = 1
            elseif width < 340 then
                columns = 2
            else
                columns = 3
            end

            local padding = 6
            local available = width - 2 - (padding * (columns - 1))
            local cellWidth = math.floor(available / columns)
            Grid.FillDirectionMaxCells = columns
            Grid.CellPadding = UDim2.fromOffset(padding, 7)
            Grid.CellSize = UDim2.fromOffset(math.max(104, cellWidth), 194)
        end

        track(ResultsScroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateGrid))
        track(Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if DetailsOverlay.Visible then task.defer(resizeDetailsDescription) end
        end))
        task.defer(updateGrid)

        -- Embedded in LH: the Ava Kreator surface stays locked to its tab.

        local function setMinimized(value)
            value = value == true
            if state.Minimized == value then
                return
            end

            state.Minimized = value

            if value then
                state.ExpandedPosition = Main.Position
                state.ExpandedAnchorPoint = Main.AnchorPoint
                state.ExpandedSize = Main.Size

                Controls.Visible = false
                ResultsArea.Visible = false
                DetailsOverlay.Visible = false
                OutfitOverlay.Visible = false
                if state.SavedOutfitsArea then state.SavedOutfitsArea.Visible = false end
                Subtitle.Visible = false
                OutfitButton.Visible = false

                Title.Text = "Avatar Katalog Kreator"
                Title.Size = UDim2.new(1, -144, 1, 0)
                Title.Position = UDim2.fromOffset(56, 0)
                Title.TextSize = 15
                Title.TextYAlignment = Enum.TextYAlignment.Center
                MinimizeButton.Text = "+"

                Main.AnchorPoint = Vector2.new(0, 0)
                Main.Position = UDim2.fromOffset(10, 10)

                local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
                    or Vector2.new(800, 600)
                local miniWidth = math.clamp(math.floor(viewport.X * 0.64), 255, 330)
                tween(Main, 0.2, {Size = UDim2.fromOffset(miniWidth, 56)})
            else
                Controls.Visible = true
                ResultsArea.Visible = true
                Subtitle.Visible = true
                OutfitButton.Visible = true

                Title.Text = "Avatar Katalog Kreator"
                Title.Size = UDim2.new(1, -132, 0, 20)
                Title.Position = UDim2.fromOffset(43, 2)
                Title.TextSize = 13.5
                Title.TextYAlignment = Enum.TextYAlignment.Center
                MinimizeButton.Text = "-"

                Main.AnchorPoint = state.ExpandedAnchorPoint
                Main.Position = state.ExpandedPosition
                tween(Main, 0.2, {Size = state.ExpandedSize})
            end
        end

        track(MinimizeButton.MouseButton1Click:Connect(function()
            setMinimized(not state.Minimized)
        end))

        local characterAddedConnection
        characterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(character)
            state.CurrentCharacter = character
            state.SnapshotByCharacter[character] = nil
            state.OriginalDescriptionByCharacter[character] = nil
            state.ViewerModifiedSlots = {}

            task.wait(1.4)
            if state.Destroyed then return end

            if countEquipped() > 0 then
                state.Reapplying = true
                for slot in pairs(state.EquippedBySlot) do
                    local selected = Wear.CopyItems(Wear.GetSlotItems(slot))
                    local ok, methodName = Wear.ApplySlotSelection(slot, selected)
                    Wear.Debug("Respawn Reapply " .. tostring(slot), ok, methodName)
                    task.wait(0.05)
                end
                state.Reapplying = false
            end
            refreshSelectedUi()
        end)

        local function runtimeCleanup(restoreAvatar)
            if state.Destroyed then
                return
            end
            state.Destroyed = true

            safeDisconnect(characterAddedConnection)

            if restoreAvatar ~= false then
                local character = getCharacter()
                if character then
                    local slots, seen = {}, {}
                    for slot in pairs(state.EquippedBySlot) do
                        seen[slot] = true
                        table.insert(slots, slot)
                    end
                    for slot in pairs(state.ViewerModifiedSlots or {}) do
                        if not seen[slot] then
                            seen[slot] = true
                            table.insert(slots, slot)
                        end
                    end
                    for _, slot in ipairs(slots) do
                        pcall(restoreOriginalSlot, character, slot)
                    end
                end
            end

            for _, connection in ipairs(state.Connections) do
                safeDisconnect(connection)
            end
            state.Connections = {}

            if ScreenGui and ScreenGui.Parent then
                ScreenGui:Destroy()
            end

            if ENV[RUNTIME_KEY] == runtimeCleanup then
                ENV[RUNTIME_KEY] = nil
            end
        end

        ENV[RUNTIME_KEY] = runtimeCleanup
        state.Cleanup = runtimeCleanup
        state.RestoreOriginal = function()
            return resetAllItems(true)
        end

        track(CloseButton.MouseButton1Click:Connect(function()
            runtimeCleanup(true)
        end))

        track(UserInputService.InputBegan:Connect(function(input, processed)
            if processed then
                return
            end

            if input.KeyCode == Enum.KeyCode.Escape then
                if DetailsOverlay.Visible then
                    closeDetails()
                elseif OutfitOverlay.Visible then
                    if state.SetMode then
                        state.SetMode("marketplace")
                    else
                        OutfitOverlay.Visible = false
                    end
                elseif state.SavedOutfitsArea and state.SavedOutfitsArea.Visible then
                    if state.SetMode then state.SetMode("marketplace") end
                end
            end
        end))

        updateOutfitButton()
        updateCategoryVisuals()

        task.defer(function()
            SearchBox.Text = ""
            updateModeVisuals()
            runActiveSearch()
        end)

        state.Search = function(query)
            SearchBox.Text = tostring(query or "")
            runActiveSearch()
        end
        state.Refresh = function()
            runActiveSearch()
        end
        return avatarTab
        end)()
    end

    function window:EnableAutoExecuteManager(tabName)
        if active.AutoExecuteManager then return active.AutoExecuteManager.Tab end
        local tab = self:NewTab(tabName or "Auto Execute")
        tab:EnsureBuilt()
        tab.Scroll.Visible = false

        local state = {
            Tab = tab,
            Connections = {},
            Selected = 1,
            Destroyed = false
        }
        active.AutoExecuteManager = state

        local function trackLocal(connection)
            if connection then table.insert(state.Connections, connection) end
            return connection
        end
        local function scripts()
            if type(settings.AutoExecuteScripts) ~= "table" then settings.AutoExecuteScripts = {} end
            if #settings.AutoExecuteScripts == 0 then
                settings.AutoExecuteScripts[1] = {Name = "Script 1", Source = "-- write your auto-execute skript here\n", AutoExecute = false}
            end
            return settings.AutoExecuteScripts
        end
        local function persist()
            if type(env.LHUISettings) == "table" then env.LHUISettings.AutoExecuteScripts = settings.AutoExecuteScripts end
            if type(env.LHSettings) == "table" then env.LHSettings.AutoExecuteScripts = settings.AutoExecuteScripts end
            markSettingsDirty()
            saveSettingsNow()
        end
        local function executeRecord(record)
            if type(record) ~= "table" then return false end
            local source = tostring(record.Source or "")
            if source:match("^%s*$") then return false end
            local compileOk, fnOrError = pcall(loadstring, source)
            if not compileOk or type(fnOrError) ~= "function" then
                warn("[Lollypop Hub Auto Execute] " .. tostring(fnOrError or "Compile failed."))
                return false
            end
            task.spawn(function()
                local runOk, runError = pcall(fnOrError)
                if not runOk then
                    warn("[Lollypop Hub Auto Execute] " .. tostring(runError))
                end
            end)
            return true
        end

        local root = Instance.new("Frame")
        root.Name = "AutoExecuteSurface"
        root.Size = UDim2.fromScale(1, 1)
        root.BackgroundTransparency = 1
        root.BorderSizePixel = 0
        root.Parent = tab.Page

        local header = Instance.new("Frame")
        header.Size = UDim2.new(1, -16, 0, 40)
        header.Position = UDim2.fromOffset(8, 8)
        header.BorderSizePixel = 0
        header.Parent = root
        bind(header, "BackgroundColor3", "Header")
        makeCorner(header, 10)

        local title = makeText(header, "Auto Execute", 16, Enum.Font.GothamBold)
        title.Position = UDim2.fromOffset(10, 3)
        title.Size = UDim2.new(1, -20, 0, 18)
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextWrapped = false

        local subtitle = makeText(header, "Saved skripts marked Auto-Exec run whenever Lollypop Hub loads.", 9.5, Enum.Font.Gotham)
        subtitle.Position = UDim2.fromOffset(10, 21)
        subtitle.Size = UDim2.new(1, -20, 0, 15)
        subtitle.TextXAlignment = Enum.TextXAlignment.Left
        subtitle.TextWrapped = false

        local tabs = Instance.new("ScrollingFrame")
        tabs.Name = "ScriptTabs"
        tabs.Position = UDim2.fromOffset(8, 54)
        tabs.Size = UDim2.new(1, -16, 0, 34)
        tabs.BackgroundTransparency = 1
        tabs.BorderSizePixel = 0
        tabs.AutomaticCanvasSize = Enum.AutomaticSize.X
        tabs.CanvasSize = UDim2.fromOffset(0, 0)
        tabs.ScrollBarThickness = 0
        tabs.ScrollingDirection = Enum.ScrollingDirection.X
        tabs.Parent = root
        local tabLayout = Instance.new("UIListLayout")
        tabLayout.FillDirection = Enum.FillDirection.Horizontal
        tabLayout.Padding = UDim.new(0, 5)
        tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
        tabLayout.Parent = tabs

        local editorShell = Instance.new("Frame")
        editorShell.Position = UDim2.fromOffset(8, 94)
        editorShell.Size = UDim2.new(1, -16, 1, -148)
        editorShell.BorderSizePixel = 0
        editorShell.Parent = root
        bind(editorShell, "BackgroundColor3", "ElementColor")
        makeCorner(editorShell, 10)
        makeStroke(editorShell, active.Theme.SchemeColor, 0.55, 1)

        local nameBox = Instance.new("TextBox")
        nameBox.Position = UDim2.fromOffset(8, 7)
        nameBox.Size = UDim2.new(1, -16, 0, 28)
        nameBox.BackgroundTransparency = 0.14
        nameBox.BorderSizePixel = 0
        nameBox.ClearTextOnFocus = false
        nameBox.Font = resolveUIFont(Enum.Font.GothamBold)
        nameBox.PlaceholderText = "Skript name"
        nameBox.Text = ""
        nameBox.TextSize = 11
        nameBox.TextXAlignment = Enum.TextXAlignment.Left
        nameBox.Parent = editorShell
        bind(nameBox, "BackgroundColor3", "Header")
        bind(nameBox, "TextColor3", "TextColor")
        makeCorner(nameBox, 7)
        local namePad = Instance.new("UIPadding")
        namePad.PaddingLeft = UDim.new(0, 8)
        namePad.PaddingRight = UDim.new(0, 8)
        namePad.Parent = nameBox

        local sourceScroll = Instance.new("ScrollingFrame")
        sourceScroll.Position = UDim2.fromOffset(8, 41)
        sourceScroll.Size = UDim2.new(1, -16, 1, -49)
        sourceScroll.BackgroundTransparency = 0.08
        sourceScroll.BorderSizePixel = 0
        sourceScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        sourceScroll.CanvasSize = UDim2.fromOffset(0, 0)
        sourceScroll.ScrollBarThickness = 3
        sourceScroll.Parent = editorShell
        bind(sourceScroll, "BackgroundColor3", "Background")
        makeCorner(sourceScroll, 7)

        local editor = Instance.new("TextBox")
        editor.Position = UDim2.fromOffset(7, 7)
        editor.Size = UDim2.new(1, -14, 0, 180)
        editor.AutomaticSize = Enum.AutomaticSize.Y
        editor.BackgroundTransparency = 1
        editor.BorderSizePixel = 0
        editor.ClearTextOnFocus = false
        editor.MultiLine = true
        editor.Font = resolveUIFont(Enum.Font.Code)
        editor.PlaceholderText = "-- paste or write your skript here"
        editor.Text = ""
        editor.TextSize = 11
        editor.TextWrapped = true
        editor.TextXAlignment = Enum.TextXAlignment.Left
        editor.TextYAlignment = Enum.TextYAlignment.Top
        editor.Parent = sourceScroll
        bind(editor, "TextColor3", "TextColor")

        local controls = Instance.new("Frame")
        controls.Position = UDim2.new(0, 8, 1, -47)
        controls.Size = UDim2.new(1, -16, 0, 39)
        controls.BackgroundTransparency = 1
        controls.Parent = root

        local run = makeButton(controls, "Run")
        run.Position = UDim2.fromOffset(0, 3)
        run.Size = UDim2.new(0.14, -2, 0, 33)

        local clear = makeButton(controls, "Klear")
        clear.Position = UDim2.new(0.145, 0, 0, 3)
        clear.Size = UDim2.new(0.15, -2, 0, 33)

        local save = makeButton(controls, "Save")
        save.Position = UDim2.new(0.30, 0, 0, 3)
        save.Size = UDim2.new(0.14, -2, 0, 33)

        local delete = makeKolorButton(controls, "Delete", rgb(196, 53, 66))
        delete.Position = UDim2.new(0.445, 0, 0, 3)
        delete.Size = UDim2.new(0.16, -2, 0, 33)

        local auto = makeButton(controls, "Auto-Exec: OFF")
        auto.Position = UDim2.new(0.61, 0, 0, 3)
        auto.Size = UDim2.new(0.39, 0, 0, 33)

        local function selectedRecord()
            local list = scripts()
            state.Selected = math.clamp(tonumber(state.Selected) or 1, 1, #list)
            return list[state.Selected]
        end
        local function saveEditor()
            local record = selectedRecord()
            record.Name = tostring(nameBox.Text or ""):match("^%s*(.-)%s*$")
            if record.Name == "" then record.Name = "Script " .. tostring(state.Selected) end
            record.Source = tostring(editor.Text or "")
            persist()
            return record
        end
        local renderTabs
        local function updateEditor()
            local record = selectedRecord()
            nameBox.Text = tostring(record.Name or ("Script " .. tostring(state.Selected)))
            editor.Text = tostring(record.Source or "")
            auto.Text = record.AutoExecute == true and "Auto-Exec: ON" or "Auto-Exec: OFF"
            auto.BackgroundColor3 = record.AutoExecute == true and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
            run.Text = "Run"
        end
        renderTabs = function()
            for _, child in ipairs(tabs:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            for index, record in ipairs(scripts()) do
                local button = makeButton(tabs, tostring(record.Name or ("Script " .. tostring(index))))
                button.Size = UDim2.fromOffset(92, 30)
                button.LayoutOrder = index
                if index == state.Selected then button.BackgroundColor3 = active.Theme.SchemeColor end
                trackLocal(button.MouseButton1Click:Connect(function()
                    saveEditor()
                    state.Selected = index
                    updateEditor()
                    renderTabs()
                end))
            end
            local plus = makeButton(tabs, "+")
            plus.Size = UDim2.fromOffset(34, 30)
            plus.LayoutOrder = 100000
            plus.TextSize = 18
            trackLocal(plus.MouseButton1Click:Connect(function()
                saveEditor()
                local list = scripts()
                list[#list + 1] = {Name = "Script " .. tostring(#list + 1), Source = "-- new LH auto-execute skript\n", AutoExecute = false}
                state.Selected = #list
                persist()
                updateEditor()
                renderTabs()
            end))
        end

        trackLocal(nameBox.FocusLost:Connect(function() saveEditor(); renderTabs() end))
        trackLocal(editor.FocusLost:Connect(function() saveEditor() end))
        trackLocal(run.MouseButton1Click:Connect(function()
            local didRun = executeRecord(saveEditor())
            if didRun then
                run.Text = "Done"
                local doneRecord = selectedRecord()
                task.delay(1, function()
                    if run and run.Parent and selectedRecord() == doneRecord then
                        run.Text = "Run"
                    end
                end)
            end
        end))
        trackLocal(clear.MouseButton1Click:Connect(function()
            LULA:Confirm(
                "Klear skript text?",
                "Are you sure you want to klear the input text?",
                function()
                    editor.Text = ""
                    saveEditor()
                    run.Text = "Run"
                end
            )
        end))
        trackLocal(save.MouseButton1Click:Connect(function()
            saveEditor()
            renderTabs()
        end))
        trackLocal(auto.MouseButton1Click:Connect(function()
            local record = saveEditor()
            record.AutoExecute = record.AutoExecute ~= true
            persist()
            updateEditor()
            renderTabs()
        end))
        trackLocal(delete.MouseButton1Click:Connect(function()
            local list = scripts()
            if #list <= 1 then
                list[1] = {Name = "Script 1", Source = "-- write your auto-execute skript here\n", AutoExecute = false}
                state.Selected = 1
            else
                table.remove(list, state.Selected)
                state.Selected = math.clamp(state.Selected, 1, #list)
            end
            persist()
            updateEditor()
            renderTabs()
        end))

        state.Cleanup = function()
            if state.Destroyed then return end
            state.Destroyed = true
            for _, connection in ipairs(state.Connections) do
                pcall(function() if connection and connection.Connected then connection:Disconnect() end end)
            end
            state.Connections = {}
        end

        updateEditor()
        renderTabs()
        task.defer(function()
            for _, record in ipairs(scripts()) do
                if record.AutoExecute == true then executeRecord(record) end
            end
        end)
        return tab
    end


    function window:StyleSpecialActionButton(button, variant)
        if not button or not button:IsA("TextButton") then return button end
        variant = tostring(variant or "accent")
        button.AutoButtonColor = false
        button.TextColor3 = rgb(255, 255, 255)
        button.Font = resolveUIFont(Enum.Font.GothamBold)
        button.BackgroundTransparency = 0.02

        local oldCorner = button:FindFirstChildOfClass("UICorner")
        if oldCorner then oldCorner.CornerRadius = UDim.new(0, 11) else makeCorner(button, 11) end

        local stroke = button:FindFirstChild("LHSpecialStroke")
        if not stroke then
            stroke = Instance.new("UIStroke")
            stroke.Name = "LHSpecialStroke"
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Thickness = 1.15
            stroke.Transparency = 0.24
            stroke.Parent = button
        end

        local glow = button:FindFirstChild("LHSpecialGradient")
        if not glow then
            glow = Instance.new("UIGradient")
            glow.Name = "LHSpecialGradient"
            glow.Rotation = 12
            glow.Parent = button
        end

        local accentA = active and active.Theme and active.Theme.SchemeColor or defaultAccent
        local accentB = active and active.Theme and active.Theme.Accent2 or brightenAccent(defaultAccent, 0.18)
        if variant == "soft" then
            button.BackgroundColor3 = blendColor(accentA, active.Theme.ElementColor, 0.48)
            glow.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, blendColor(accentA, rgb(255,255,255), 0.08)),
                ColorSequenceKeypoint.new(1, blendColor(accentB, active.Theme.ElementColor, 0.34)),
            })
        elseif variant == "glass" then
            button.BackgroundColor3 = active.Theme.ElementColor
            glow.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, blendColor(active.Theme.ElementColor, accentA, 0.32)),
                ColorSequenceKeypoint.new(0.55, active.Theme.ElementColor),
                ColorSequenceKeypoint.new(1, blendColor(active.Theme.ElementColor, accentB, 0.28)),
            })
        else
            button.BackgroundColor3 = accentA
            glow.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, brightenAccent(accentA, 0.10)),
                ColorSequenceKeypoint.new(1, brightenAccent(accentB, 0.08)),
            })
        end
        stroke.Color = brightenAccent(accentA, 0.22)

        local shine = button:FindFirstChild("LHSpecialShine")
        if not shine then
            shine = Instance.new("Frame")
            shine.Name = "LHSpecialShine"
            shine.Active = false
            shine.BorderSizePixel = 0
            shine.BackgroundColor3 = rgb(255,255,255)
            shine.BackgroundTransparency = 0.88
            shine.Position = UDim2.new(0, 8, 0, 4)
            shine.Size = UDim2.new(1, -16, 0, 2)
            shine.ZIndex = button.ZIndex + 1
            shine.Parent = button
            makeCorner(shine, 999)
        end
        return button
    end

    function window:EnableUserLookup(tabName)
        if active.UserLookup then return active.UserLookup.Tab end

        local tab = self:NewTab(tabName or "User Lookup")
        tab:EnsureBuilt()
        local scroll = tab.Scroll
        local state = {
            Tab = tab,
            Connections = {},
            Destroyed = false,
            Serial = 0,
            LastQuery = "",
            UserId = nil,
            Profile = nil,
        }
        active.UserLookup = state

        local function trackLocal(connection)
            if connection then table.insert(state.Connections, connection) end
            return connection
        end

        local function trim(value)
            return tostring(value or ""):match("^%s*(.-)%s*$")
        end

        local function decodeJson(body)
            if type(body) ~= "string" or body == "" then return nil end
            local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
            return ok and decoded or nil
        end

        local function rawHttpBody(url)
            url = tostring(url or "")
            if url == "" then return nil end

            local requesters = {
                rawget(env, "request"), rawget(env, "http_request"), rawget(env, "httprequest"),
            }
            local synTable = rawget(env, "syn")
            if type(synTable) == "table" then table.insert(requesters, synTable.request) end
            local httpTable = rawget(env, "http")
            if type(httpTable) == "table" then table.insert(requesters, httpTable.request) end

            for _, requester in ipairs(requesters) do
                if typeof(requester) == "function" then
                    local ok, response = pcall(requester, {
                        Url = url,
                        Method = "GET",
                        Headers = {Accept = "application/json"}
                    })
                    if ok then
                        if type(response) == "string" and response ~= "" then return response end
                        if type(response) == "table" then
                            local status = tonumber(response.StatusCode or response.Status or response.status_code)
                            local body = response.Body or response.body or response.ResponseBody
                            if (not status or (status >= 200 and status < 300)) and type(body) == "string" and body ~= "" then
                                return body
                            end
                        end
                    end
                end
            end

            local compat = rawget(env, "LHCompat")
            if type(compat) == "table" and type(compat.HttpGet) == "function" then
                local callOk, httpOk, body = pcall(compat.HttpGet, url, false)
                if callOk and httpOk and type(body) == "string" and body ~= "" then return body end
            end

            local ok, body = pcall(function() return game:HttpGet(url, false) end)
            if ok and type(body) == "string" and body ~= "" then return body end
            return nil
        end

        local function httpJson(url, timeoutSeconds)
            local finished, decoded = false, nil
            task.spawn(function()
                local body = rawHttpBody(url)
                decoded = decodeJson(body)
                finished = true
            end)
            local deadline = os.clock() + math.max(2, tonumber(timeoutSeconds) or 8)
            while not finished and os.clock() < deadline do task.wait(0.05) end
            if not finished then return nil, "timeout" end
            return decoded, decoded and nil or "request_failed"
        end

        local function copyText(text)
            text = tostring(text or "")
            local compat = rawget(env, "LHCompat")
            if type(compat) == "table" and type(compat.SetClipboard) == "function" then
                local ok, result = pcall(compat.SetClipboard, text)
                if ok and result ~= false then return true end
            end
            local candidates = {
                rawget(env, "setclipboard"),
                rawget(env, "toclipboard"),
                rawget(env, "writeclipboard"),
            }
            local synTable = rawget(env, "syn")
            if type(synTable) == "table" then
                table.insert(candidates, synTable.write_clipboard)
                table.insert(candidates, synTable.setclipboard)
            end
            for _, writer in ipairs(candidates) do
                if typeof(writer) == "function" and pcall(writer, text) then return true end
            end
            return false
        end

        local function loadRemoteAsset(url, relativePath)
            local fromUrl = rawget(env, "getcustomassetfromurl") or rawget(env, "get_custom_asset_from_url")
            if typeof(fromUrl) == "function" then
                local ok, result = pcall(fromUrl, url)
                if ok and type(result) == "string" and result ~= "" then return result end
            end

            local getAsset = rawget(env, "getcustomasset") or rawget(env, "getsynasset") or rawget(env, "get_custom_asset")
            local writeFile = rawget(env, "writefile") or rawget(env, "write_file")
            local makeFolder = rawget(env, "makefolder") or rawget(env, "make_folder")
            local isFolder = rawget(env, "isfolder") or rawget(env, "is_folder")
            if typeof(getAsset) ~= "function" or typeof(writeFile) ~= "function" then return nil end

            pcall(function()
                if typeof(makeFolder) == "function"
                    and (typeof(isFolder) ~= "function" or not isFolder("LollypopHub")) then
                    makeFolder("LollypopHub")
                end
            end)

            local body
            local compat = rawget(env, "LHCompat")
            if type(compat) == "table" and type(compat.HttpGet) == "function" then
                local callOk, httpOk, responseBody = pcall(compat.HttpGet, url, false)
                if callOk and httpOk and type(responseBody) == "string" then body = responseBody end
            end
            if not body then
                local bodyOk, responseBody = pcall(function() return game:HttpGet(url, false) end)
                if bodyOk and type(responseBody) == "string" then body = responseBody end
            end
            if not body or body == "" then return nil end

            local path = "LollypopHub/" .. tostring(relativePath or "userlookup.bin")
            if not pcall(writeFile, path, body) then return nil end
            local assetOk, asset = pcall(getAsset, path)
            return assetOk and type(asset) == "string" and asset or nil
        end

