local active = nil
local fontMap = {}
local fontNames = {}
for _, fontItem in ipairs(Enum.Font:GetEnumItems()) do
    fontMap[fontItem.Name] = fontItem
    table.insert(fontNames, fontItem.Name)
end
table.sort(fontNames)

local function resolveUIFont(fallback)
    return fontMap[tostring(settings.UIFont or "")] or fallback or Enum.Font.Gotham
end

local function applyUIFont()
    if not active or not active.ScreenGui then return end
    local selected = resolveUIFont(Enum.Font.Gotham)
    for _, object in ipairs(active.ScreenGui:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            pcall(function() object.Font = selected end)
        end
    end
end

active = nil
local connections = {}
local bindings = {}
local notificationHistory = env.LHNotificationHistory or {}
env.LHNotificationHistory = notificationHistory
local thumbnailCache = {}
-- Roblox Instances cannot hold arbitrary Lua fields. Keep kontrol metadata in a weak registry instead.
local sectionControlRegistry = setmetatable({}, {__mode = "k"})
local controlFrameRegistry = setmetatable({}, {__mode = "k"})
local controlIdRegistry = {}
local openControlMenu = nil

local function shallowCopyArray(source)
    local result = {}
    if type(source) == "table" then
        for index, value in ipairs(source) do result[index] = value end
    end
    return result
end

local function valuesEqual(a, b)
    if typeof(a) == "Color3" and typeof(b) == "Color3" then return a == b end
    if typeof(a) == "EnumItem" and typeof(b) == "EnumItem" then return a == b end
    return a == b
end

local function encodeSessionValue(value)
    local kind = typeof(value)
    if kind == "nil" then return nil end
    if kind == "boolean" or kind == "number" or kind == "string" then return value end
    if kind == "Color3" then
        return {__LHType = "Color3", R = value.R, G = value.G, B = value.B}
    end
    if kind == "EnumItem" then
        return {__LHType = "EnumItem", EnumType = tostring(value.EnumType), Name = value.Name}
    end
    return nil
end

local function decodeSessionValue(value)
    if type(value) ~= "table" then return value, true end
    if value.__LHType == "Color3" then
        return Color3.new(
            math.clamp(tonumber(value.R) or 0, 0, 1),
            math.clamp(tonumber(value.G) or 0, 0, 1),
            math.clamp(tonumber(value.B) or 0, 0, 1)
        ), true
    end
    if value.__LHType == "EnumItem" then
        local enumName = tostring(value.EnumType or ""):match("Enum%.(.+)")
        local enumType = enumName and Enum[enumName]
        local enumItem = enumType and enumType[tostring(value.Name or "")]
        if enumItem then return enumItem, true end
        return nil, false
    end
    return nil, false
end

local function markSettingsDirty()
    if env.LHRuntime and type(env.LHRuntime.SettingChanged) == "function" then
        pcall(function() env.LHRuntime:SettingChanged() end)
    end
end

local function saveSettingsNow()
    if env.LHRuntime and type(env.LHRuntime.SaveSettings) == "function" then
        task.defer(function() pcall(function() env.LHRuntime:SaveSettings() end) end)
    end
end

local function persistUiStateEdit()
    markSettingsDirty()
    if settings.ShelfAutoSave == true then saveSettingsNow() end
end

local function persistIndependentShelfSetting()
    -- Shelf Auto Save and Shelf Hold Menu remember their own state even when
    -- the main Save Settings button was not pressed.
    markSettingsDirty()
    saveSettingsNow()
end

local function track(connection)
    if connection then
        table.insert(connections, connection)
    end
    return connection
end

local function disconnectAll()
    for i = #connections, 1, -1 do
        local connection = connections[i]
        pcall(function()
            if connection and connection.Connected then connection:Disconnect() end
        end)
        connections[i] = nil
    end
end

local function safeCall(label, callback, ...)
    local args = table.pack(...)
    local ok, result = xpcall(function()
        return callback(table.unpack(args, 1, args.n))
    end, function(err)
        return debug.traceback(tostring(err), 2)
    end)
    if not ok then
        warn("[Lollypop UI] " .. tostring(label) .. " failed:\n" .. tostring(result))
        if env.LHNotify then
            pcall(env.LHNotify, "error", "Kontrol Error", tostring(result), 7)
        end
    end
    return ok, result
end

local function duration(seconds)
    if settings.ReducedMotion or settings.LowPerformance then return 0 end
    return seconds or 0.16
end

local function tween(object, properties, seconds, style, direction)
    if not object or not object.Parent then return nil end
    local d = duration(seconds)
    if d <= 0 then
        for property, value in pairs(properties) do
            pcall(function() object[property] = value end)
        end
        return nil
    end
    local tweenObject = TweenService:Create(
        object,
        TweenInfo.new(d, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
        properties
    )
    tweenObject:Play()
    return tweenObject
end

local function cloneTheme(source)
    local result = {}
    for key, value in pairs(source or {}) do result[key] = value end
    result.SchemeColor = result.SchemeColor or defaultAccent
    result.Accent2 = result.Accent2 or result.SchemeColor
    result.Background = result.Background or rgb(18, 18, 22)
    result.Header = result.Header or rgb(12, 12, 15)
    result.TextColor = result.TextColor or rgb(255, 255, 255)
    result.MutedText = result.MutedText or rgb(170, 170, 180)
    result.ElementColor = result.ElementColor or rgb(29, 29, 36)
    result.Danger = result.Danger or rgb(255, 70, 88)
    result.NotificationColor = result.NotificationColor or result.ElementColor
    result.NotificationTrack = result.NotificationTrack or result.Header
    result.StatusTextColor = result.StatusTextColor or result.TextColor
    return result
end

local function colorLuminance(color)
    local function channel(value)
        if value <= 0.03928 then return value / 12.92 end
        return ((value + 0.055) / 1.055) ^ 2.4
    end
    return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
    local l1, l2 = colorLuminance(a), colorLuminance(b)
    if l1 < l2 then l1, l2 = l2, l1 end
    return (l1 + 0.05) / (l2 + 0.05)
end

local function readableTextColor(color, theme)
    if typeof(color) ~= "Color3" then return rgb(245, 245, 248) end
    theme = theme or themes.Kandy
    local backgrounds = {
        theme.Background or rgb(18, 18, 22),
        theme.Header or rgb(12, 12, 15),
        theme.ElementColor or rgb(29, 29, 36),
    }
    local function lowestContrast(candidate)
        local lowest = math.huge
        for _, background in ipairs(backgrounds) do
            lowest = math.min(lowest, contrastRatio(candidate, background))
        end
        return lowest
    end
    if lowestContrast(color) >= 3.2 then return color end

    -- Never use pure black. Pick the safer off-white or readable charcoal.
    local light = rgb(248, 248, 252)
    local charcoal = rgb(42, 43, 52)
    if lowestContrast(light) >= lowestContrast(charcoal) then return light end
    return charcoal
end

local function blendColor(a, b, amount)
    amount = math.clamp(tonumber(amount) or 0, 0, 1)
    return Color3.new(
        a.R + (b.R - a.R) * amount,
        a.G + (b.G - a.G) * amount,
        a.B + (b.B - a.B) * amount
    )
end

local function brightenAccent(color, amount)
    local h, s, v = Color3.toHSV(color)
    amount = math.clamp(tonumber(amount) or 0.2, 0, 1)
    return Color3.fromHSV(h, math.clamp(s * 0.94 + 0.03, 0, 1), math.clamp(v + (1 - v) * amount, 0, 1))
end

local function applyAppearanceMode(theme)
    theme = cloneTheme(theme)
    local white = rgb(255, 255, 255)
    local isLight = string.lower(tostring(settings.AppearanceMode or "Dark")) == "light"

    if isLight then
        theme.SchemeColor = brightenAccent(theme.SchemeColor, 0.24)
        theme.Accent2 = brightenAccent(theme.Accent2, 0.24)
        theme.Background = blendColor(theme.Background, white, 0.91)
        theme.Header = blendColor(theme.Header, white, 0.86)
        theme.ElementColor = blendColor(theme.ElementColor, white, 0.80)
        theme.TextColor = rgb(39, 40, 48)
        theme.MutedText = blendColor(theme.SchemeColor, rgb(62, 64, 76), 0.78)
        theme.Danger = brightenAccent(theme.Danger, 0.16)
        theme.NotificationColor = blendColor(theme.ElementColor, white, 0.28)
        theme.NotificationTrack = blendColor(theme.Header, rgb(118, 120, 132), 0.14)
        theme.StatusTextColor = theme.SchemeColor
        return theme
    end

    -- Dark mode keeps the selected theme rich and readable instead of crushing
    -- every panel into near-black. The original kolor identity stays intact.
    theme.SchemeColor = brightenAccent(theme.SchemeColor, 0.15)
    theme.Accent2 = brightenAccent(theme.Accent2, 0.13)
    theme.Danger = brightenAccent(theme.Danger, 0.10)
    local tint = blendColor(theme.SchemeColor, theme.Accent2, 0.34)
    theme.Background = blendColor(blendColor(theme.Background, white, 0.075), tint, 0.095)
    theme.Header = blendColor(blendColor(theme.Header, white, 0.105), tint, 0.085)
    theme.ElementColor = blendColor(blendColor(theme.ElementColor, white, 0.145), tint, 0.105)
    theme.TextColor = blendColor(theme.TextColor, white, 0.12)
    theme.MutedText = blendColor(theme.MutedText, white, 0.20)
    theme.NotificationColor = blendColor(blendColor(theme.ElementColor, white, 0.07), tint, 0.045)
    theme.NotificationTrack = blendColor(theme.Header, white, 0.17)
    theme.StatusTextColor = rgb(255, 255, 255)
    return theme
end

local function resolveTheme(theme)
    local base
    if type(theme) == "string" then
        base = cloneTheme(themes[theme] or themes.Kandy)
    elseif type(theme) == "table" then
        base = cloneTheme(theme)
    else
        base = cloneTheme(themes.Kandy)
    end
    return applyAppearanceMode(base)
end

local function bind(object, property, themeKey)
    table.insert(bindings, {Object = object, Property = property, Key = themeKey})
    if active and active.Theme and active.Theme[themeKey] ~= nil then
        pcall(function() object[property] = active.Theme[themeKey] end)
    end
end

local function applyTheme()
    if not active then return end
    for i = #bindings, 1, -1 do
        local record = bindings[i]
        if not record.Object or not record.Object.Parent then
            table.remove(bindings, i)
        else
            local value = active.Theme[record.Key]
            if record.Property == "TextColor3" and record.Object:GetAttribute("LHForceWhiteText") then
                value = rgb(255, 255, 255)
            end
            if value ~= nil then
                pcall(function() record.Object[record.Property] = value end)
            end
        end
    end
    if active.SideGradient then
        active.SideGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, active.Theme.SchemeColor),
            ColorSequenceKeypoint.new(1, active.Theme.Accent2),
        })
    end
    if active.MainStroke then active.MainStroke.Color = DRAG_GLOW_COLOR end
    if active.Island and active.Island.Stroke then active.Island.Stroke.Color = active.Theme.SchemeColor end
    if active.AnimationBundles and type(active.AnimationBundles.RefreshTheme) == "function" then
        pcall(active.AnimationBundles.RefreshTheme)
    end
end

local function makeCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
    return corner
end

local function makeStroke(parent, color, transparency, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or rgb(255, 255, 255)
    stroke.Transparency = transparency or 0.72
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

local function makeText(parent, text, size, font)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Font = resolveUIFont(font or Enum.Font.Gotham)
    label.Text = tostring(text or "")
    label.TextSize = size or 15
    label.TextWrapped = true
    label.Parent = parent
    bind(label, "TextColor3", "TextColor")
    return label
end

-- Original Lollypop action glyph: kandy head, stick, shine, and spark.
-- This replaces the basic pointer-finger emoji on normal buttons.
local function makeLollyActionIcon(parent)
    local holder = Instance.new("Frame")
    holder.Name = "LollyActionIcon"
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Parent = parent

    local stick = Instance.new("Frame")
    stick.Name = "Stick"
    stick.AnchorPoint = Vector2.new(0.5, 0)
    stick.Position = UDim2.fromOffset(14, 10)
    stick.Size = UDim2.fromOffset(3, 11)
    stick.Rotation = -36
    stick.BackgroundColor3 = rgb(245, 245, 249)
    stick.BorderSizePixel = 0
    stick.Parent = holder
    makeCorner(stick, 999)

    local candy = Instance.new("Frame")
    candy.Name = "Kandy"
    candy.Position = UDim2.fromOffset(2, 1)
    candy.Size = UDim2.fromOffset(13, 13)
    candy.BorderSizePixel = 0
    candy.Parent = holder
    bind(candy, "BackgroundColor3", "SchemeColor")
    makeCorner(candy, 999)
    makeStroke(candy, rgb(255, 255, 255), 0.28, 1)

    local swirl = Instance.new("Frame")
    swirl.Name = "Swirl"
    swirl.AnchorPoint = Vector2.new(0.5, 0.5)
    swirl.Position = UDim2.fromScale(0.55, 0.55)
    swirl.Size = UDim2.fromOffset(8, 3)
    swirl.Rotation = 28
    swirl.BorderSizePixel = 0
    swirl.Parent = candy
    bind(swirl, "BackgroundColor3", "Accent2")
    makeCorner(swirl, 999)

    local shine = Instance.new("Frame")
    shine.Name = "Shine"
    shine.Position = UDim2.fromOffset(3, 2)
    shine.Size = UDim2.fromOffset(3, 3)
    shine.BackgroundColor3 = rgb(255, 255, 255)
    shine.BackgroundTransparency = 0.08
    shine.BorderSizePixel = 0
    shine.Parent = candy
    makeCorner(shine, 999)

    local spark = Instance.new("Frame")
    spark.Name = "Spark"
    spark.Position = UDim2.fromOffset(17, 2)
    spark.Size = UDim2.fromOffset(3, 3)
    spark.BorderSizePixel = 0
    spark.Parent = holder
    bind(spark, "BackgroundColor3", "Accent2")
    makeCorner(spark, 999)

    return holder
end

local function createButtonRipple(button, inputObject)
    if settings.ReducedMotion or settings.LowPerformance then return end
    if not button or not button.Parent then return end
    local absoluteSize = button.AbsoluteSize
    if absoluteSize.X <= 0 or absoluteSize.Y <= 0 then return end

    local absolutePosition = button.AbsolutePosition
    local point = inputObject and inputObject.Position or Vector3.new(
        absolutePosition.X + (absoluteSize.X * 0.5),
        absolutePosition.Y + (absoluteSize.Y * 0.5),
        0
    )
    local diameter = math.max(absoluteSize.X, absoluteSize.Y) * 2.25
    local ripple = Instance.new("Frame")
    ripple.Name = "LHRipple"
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Position = UDim2.fromOffset(point.X - absolutePosition.X, point.Y - absolutePosition.Y)
    ripple.Size = UDim2.fromOffset(0, 0)
    ripple.BackgroundColor3 = (active and active.Theme and active.Theme.SchemeColor) or defaultAccent
    ripple.BackgroundTransparency = 0.52
    ripple.BorderSizePixel = 0
    ripple.Active = false
    ripple.ZIndex = math.max(1, button.ZIndex)
    ripple.Parent = button
    makeCorner(ripple, 999)

    tween(ripple, {
        Size = UDim2.fromOffset(diameter, diameter),
        BackgroundTransparency = 1,
    }, 0.34, Enum.EasingStyle.Quad)
    task.delay(duration(0.38), function()
        if ripple then pcall(function() ripple:Destroy() end) end
    end)
end

local function addButtonPressEffect(button)
    if not button or not button:IsA("GuiButton") then return end
    if button:GetAttribute("LHPressEffectBound") then return end
    button:SetAttribute("LHPressEffectBound", true)
    button.ClipsDescendants = true
    local scaleObject = button:FindFirstChild("LHPressScale") or Instance.new("UIScale")
    scaleObject.Name = "LHPressScale"
    scaleObject.Scale = 1
    scaleObject.Parent = button
    local pressing = false
    track(button.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = true
            createButtonRipple(button, inputObject)
            tween(scaleObject, {Scale = 0.955}, 0.06, Enum.EasingStyle.Quad)
        end
    end))
    track(button.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = false
            tween(scaleObject, {Scale = 1}, 0.09, Enum.EasingStyle.Back)
        end
    end))
    track(button.MouseLeave:Connect(function()
        if pressing then
            pressing = false
            tween(scaleObject, {Scale = 1}, 0.09, Enum.EasingStyle.Back)
        end
    end))
end

local function makeButton(parent, text)
    local button = Instance.new("TextButton")
    button.AutoButtonColor = false
    button.BorderSizePixel = 0
    button.Font = resolveUIFont(Enum.Font.GothamMedium)
    button.Text = tostring(text or "")
    button.TextSize = 14
    button.Parent = parent
    bind(button, "TextColor3", "TextColor")
    bind(button, "BackgroundColor3", "ElementColor")
    makeCorner(button, 7)
    addButtonPressEffect(button)
    return button
end

local function makeKolorButton(parent, text, kolor)
    local button = Instance.new("TextButton")
    button.AutoButtonColor = false
    button.BorderSizePixel = 0
    button.Font = resolveUIFont(Enum.Font.GothamBold)
    button.Text = tostring(text or "")
    button.TextSize = 14
    button.TextColor3 = rgb(255, 255, 255)
    button.BackgroundColor3 = kolor
    button.Parent = parent
    makeCorner(button, 7)
    addButtonPressEffect(button)
    return button
end

local function attachClearX(textBox, onClear)
    if not textBox then return nil end
    local clearParent = textBox.Parent or textBox
    local existing = clearParent:FindFirstChild(tostring(textBox.Name) .. "_ClearTextX")
    if existing then return existing end

    local padding = textBox:FindFirstChildOfClass("UIPadding") or Instance.new("UIPadding")
    if padding.PaddingLeft.Offset == 0 then padding.PaddingLeft = UDim.new(0, 8) end
    padding.PaddingRight = UDim.new(0, 28)
    padding.Parent = textBox

    -- Make X a sibling instead of a child of the TextBox so tapping it cannot focus the keyboard.
    local clear = makeKolorButton(clearParent, "X", rgb(220, 48, 65))
    clear.Name = tostring(textBox.Name) .. "_ClearTextX"
    clear.AnchorPoint = Vector2.new(1, 0.5)
    clear.Position = UDim2.new(
        textBox.Position.X.Scale + textBox.Size.X.Scale,
        textBox.Position.X.Offset + textBox.Size.X.Offset - 3,
        textBox.Position.Y.Scale + (textBox.Size.Y.Scale * 0.5),
        textBox.Position.Y.Offset + (textBox.Size.Y.Offset * 0.5)
    )
    clear.Size = UDim2.fromOffset(20, 20)
    clear.TextSize = 10
    clear.ZIndex = math.max(5, textBox.ZIndex + 2)

    track(clear.MouseButton1Click:Connect(function()
        pcall(function() textBox:ReleaseFocus(false) end)
        textBox.Text = ""
        if type(onClear) == "function" then safeCall("Clear TextBox", onClear, textBox) end
    end))
    return clear
end

local function viewportSize()
    local camera = workspace.CurrentCamera
    if camera then return camera.ViewportSize end
    local ok, size = pcall(function() return UserInputService:GetScreenResolution() end)
    if ok then return size end
    return Vector2.new(1280, 720)
end

local function adaptiveScale()
    local size = viewportSize()
    local safeW = math.max(320, size.X - 24)
    local safeH = math.max(280, size.Y - 70)
    local fit = math.min(safeW / 525, safeH / 330, 1)
    if settings.ScaleMode == "Mini" then fit = math.min(fit, 0.72)
    elseif settings.ScaleMode == "Normal" then fit = math.min(fit, 1)
    elseif settings.ScaleMode == "Large" then fit = math.min(math.max(fit, 0.92), 1.12) end
    return math.max(0.58, fit)
end

local function clampMain(main)
    if not main or not main.Parent then return end
    local view = viewportSize()
    local size = main.AbsoluteSize
    local pos = main.AbsolutePosition
    local x = math.clamp(pos.X, 6, math.max(6, view.X - size.X - 6))
    local y = math.clamp(pos.Y, 6, math.max(6, view.Y - size.Y - 6))
    main.Position = UDim2.fromOffset(
        x + size.X * main.AnchorPoint.X,
        y + size.Y * main.AnchorPoint.Y
    )
end

local function snapMain(main)
    if not settings.EdgeSnap then
        clampMain(main)
        return
    end
    local view = viewportSize()
    local size = main.AbsoluteSize
    local pos = main.AbsolutePosition
    local margin = 14
    local x = math.clamp(pos.X, 6, math.max(6, view.X - size.X - 6))
    local y = math.clamp(pos.Y, 6, math.max(6, view.Y - size.Y - 6))
    local left = x
    local right = view.X - (x + size.X)
    local top = y
    local bottom = view.Y - (y + size.Y)
    local nearest = math.min(left, right, top, bottom)
    if nearest == left and left <= margin then x = 6
    elseif nearest == right and right <= margin then x = math.max(6, view.X - size.X - 6)
    elseif nearest == top and top <= margin then y = 6
    elseif nearest == bottom and bottom <= margin then y = math.max(6, view.Y - size.Y - 6) end
    tween(main, {Position = UDim2.fromOffset(
        x + size.X * main.AnchorPoint.X,
        y + size.Y * main.AnchorPoint.Y
    )}, 0.13)
end

function LULA:DraggingEnabled(handle, target)
    target = target or handle
    local dragging = false
    local dragInput = nil
    local startPosition = nil
    local startFrame = nil

    local function setDragGlow(enabled)
        if not active or target ~= active.Main or not active.MainStroke then return end
        -- The drag outline is intentionally always white. Theme or appearance
        -- changes are never allowed to tint it black, dim, or another kolor.
        active.MainStroke.Color = DRAG_GLOW_COLOR
        if enabled then
            tween(active.MainStroke, {Color = DRAG_GLOW_COLOR, Transparency = 0.10, Thickness = 5.2}, 0.10, Enum.EasingStyle.Quad)
        else
            tween(active.MainStroke, {Color = DRAG_GLOW_COLOR, Transparency = 1, Thickness = 1}, 0.16, Enum.EasingStyle.Quad)
        end
    end

    track(handle.InputBegan:Connect(function(inputObject)
        if settings.DragLocked then return end
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = inputObject
            startPosition = inputObject.Position
            startFrame = target.Position
            setDragGlow(true)
            local ended
            ended = inputObject.Changed:Connect(function()
                if inputObject.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    setDragGlow(false)
                    if ended then ended:Disconnect() end
                    -- Main UI intentionally stays exactly where the user drops it.
                end
            end)
            track(ended)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(inputObject)
        if not dragging or settings.DragLocked then return end
        if inputObject == dragInput or inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then
            local delta = inputObject.Position - startPosition
            target.Position = UDim2.new(
                startFrame.X.Scale, startFrame.X.Offset + delta.X,
                startFrame.Y.Scale, startFrame.Y.Offset + delta.Y
            )
        end
    end))
end

local function createReset(parent, callback)
    local reset = makeButton(parent, "R")
    reset.Name = "Reset"
    reset.AnchorPoint = Vector2.new(1, 0.5)
    reset.Position = UDim2.new(1, -7, 0.5, 0)
    reset.Size = UDim2.fromOffset(24, 24)
    reset.TextSize = 11
    reset.ZIndex = 5
    reset.BackgroundTransparency = 0.12
    track(reset.MouseButton1Click:Connect(function()
        local node = parent
        local settingsControl = false
        while node do
            if node:GetAttribute("LHTabName") == "Ui Kustomization" then
                settingsControl = true
                break
            end
            node = node.Parent
        end
        local resetAction = function()
            safeCall("Reset " .. tostring(parent.Name), callback)
        end
        if settingsControl and type(env.LHConfirmReset) == "function" then
            env.LHConfirmReset("Are you sure you want to reset " .. tostring(parent.Name) .. " to default?", resetAction)
        else
            resetAction()
        end
    end))
    return reset
end

local function attachTip(row, tip)
    tip = tostring(tip or "")
    if not active then return end
    if tip ~= "" then row:SetAttribute("LHDescription", tip) end
    local token = 0
    local longPressed = false

    local function show()
        if tip == "" or not active or not active.Tooltip then return end
        active.Tooltip.Text = tip
        active.Tooltip.Visible = true
        tween(active.Tooltip, {BackgroundTransparency = 0.08, TextTransparency = 0}, 0.12)
    end
    local function hide()
        if not active or not active.Tooltip then return end
        tween(active.Tooltip, {BackgroundTransparency = 1, TextTransparency = 1}, 0.1)
        task.delay(duration(0.11), function()
            if active and active.Tooltip then active.Tooltip.Visible = false end
        end)
    end

    track(row.MouseEnter:Connect(function()
        if not UserInputService.TouchEnabled then show() end
    end))
    track(row.MouseLeave:Connect(function()
        token = token + 1
        longPressed = false
        row:SetAttribute("LHLongPressTriggered", false)
        hide()
    end))
    local function beginHold(inputObject)
        if inputObject.UserInputType ~= Enum.UserInputType.Touch and inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        token = token + 1
        local mine = token
        longPressed = false
        row:SetAttribute("LHLongPressTriggered", false)
        task.delay(0.52, function()
            if token ~= mine or not row.Parent then return end
            longPressed = true
            row:SetAttribute("LHLongPressTriggered", true)
            hide()
            if settings.ShelfEnabled == false then return end
            local api = controlFrameRegistry[row]
            if api and type(openControlMenu) == "function" then
                openControlMenu(api)
            else
                show()
            end
        end)
    end
    local function endHold(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.Touch or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
            token = token + 1
            if longPressed then
                task.delay(0.18, function()
                    if row then row:SetAttribute("LHLongPressTriggered", false) end
                end)
            elseif UserInputService.TouchEnabled then
                hide()
            end
            longPressed = false
        end
    end

    local inputTargets = {row}
    for _, descendant in ipairs(row:GetDescendants()) do
        if descendant:IsA("GuiObject") then table.insert(inputTargets, descendant) end
    end
    for _, target in ipairs(inputTargets) do
        track(target.InputBegan:Connect(beginHold))
        track(target.InputEnded:Connect(endHold))
    end
end

local function addHover(row)
    local baseTransparency = row.BackgroundTransparency
    track(row.MouseEnter:Connect(function()
        tween(row, {BackgroundTransparency = math.max(0, baseTransparency - 0.08)}, 0.09)
    end))
    track(row.MouseLeave:Connect(function()
        tween(row, {BackgroundTransparency = baseTransparency}, 0.09)
    end))
end

local function newRow(parent, name, height)
    local row = Instance.new("Frame")
    row.Name = tostring(name or "Kontrol")
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, height or 33)
    row.BackgroundTransparency = 0
    row.Parent = parent
    bind(row, "BackgroundColor3", "ElementColor")
    makeCorner(row, 4)
    addHover(row)
    return row
end

local function setGlassBlur(_enabled)
    settings.GlassBlur = false
    local blur = Lighting:FindFirstChild("LHGlassBlur")
    if blur then
        pcall(function() blur:Destroy() end)
    end
    if active then active.Blur = nil end
end

local function createNotificationHost(screenGui)
    local host = Instance.new("Frame")
    host.Name = "NotificationHost"
    host.AnchorPoint = Vector2.new(0, 1)
    host.Position = UDim2.new(0, 12, 1, -12)
    host.Size = UDim2.fromOffset(320, 500)
    host.BackgroundTransparency = 1
    host.ZIndex = 100
    host.Parent = screenGui
    local layout = Instance.new("UIListLayout")
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = host
    return host
end

local kindColors = {
    success = rgb(46, 204, 113),
    error = rgb(255, 74, 86),
    warning = rgb(255, 184, 61),
    info = rgb(66, 164, 255),
}

function LULA:Notify(kind, title, text, seconds, progress, force)
    kind = string.lower(tostring(kind or "info"))
    title = tostring(title or "Lollypop Hub")
    text = tostring(text or "")
    if progress ~= nil then
        seconds = math.clamp(tonumber(seconds) or 8, 2, 15)
    else
        seconds = math.clamp(tonumber(seconds) or 3, 1.5, 3.5)
    end
    table.insert(notificationHistory, 1, {
        Time = os.time(), Kind = kind, Title = title, Text = text, Progress = progress,
    })
    while #notificationHistory > 100 do table.remove(notificationHistory) end
    if (settings.NotificationMuted and force ~= true) or not active or not active.NotificationHost then return nil end

    local width = 310
    local bodyWidth = width - 34
    local bodyBounds = TextService:GetTextSize(text ~= "" and text or " ", 12, resolveUIFont(Enum.Font.Gotham), Vector2.new(bodyWidth, 1000))
    local bodyHeight = math.clamp(math.ceil(bodyBounds.Y) + 4, 18, 96)
    local titleHeight = 20
    local cardHeight = 10 + titleHeight + 4 + bodyHeight + (progress ~= nil and 22 or 9)

    local holder = Instance.new("Frame")
    holder.Name = "NotificationHolder"
    holder.Size = UDim2.fromOffset(width, cardHeight)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = false
    holder.ZIndex = 101
    holder.Parent = active.NotificationHost

    local card = Instance.new("CanvasGroup")
    card.Name = "Notification"
    card.Size = UDim2.fromScale(1, 1)
    card.Position = UDim2.fromOffset(-330, 0)
    card.BackgroundTransparency = 0.04
    card.GroupTransparency = 0
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 102
    card.Parent = holder
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 10)
    makeStroke(card, kindColors[kind] or kindColors.info, 0.2, 1)

    local stripe = Instance.new("Frame")
    stripe.Size = UDim2.new(0, 4, 1, 0)
    stripe.BorderSizePixel = 0
    stripe.BackgroundColor3 = kindColors[kind] or kindColors.info
    stripe.Parent = card

    local titleLabel = makeText(card, title, 14, Enum.Font.GothamBold)
    titleLabel.Position = UDim2.fromOffset(14, 8)
    titleLabel.Size = UDim2.new(1, -46, 0, titleHeight)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.TextWrapped = false

    local body = makeText(card, text, 12, Enum.Font.Gotham)
    body.Position = UDim2.fromOffset(14, 31)
    body.Size = UDim2.new(1, -28, 0, bodyHeight)
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.TextWrapped = true
    bind(body, "TextColor3", "MutedText")

    local close = makeKolorButton(card, "X", rgb(210, 48, 65))
    close.Position = UDim2.new(1, -28, 0, 6)
    close.Size = UDim2.fromOffset(22, 22)
    close.TextSize = 10

    local progressFill = nil
    if progress ~= nil then
        local bar = Instance.new("Frame")
        bar.Position = UDim2.new(0, 14, 1, -13)
        bar.Size = UDim2.new(1, -28, 0, 5)
        bar.BorderSizePixel = 0
        bar.Parent = card
        bind(bar, "BackgroundColor3", "NotificationTrack")
        makeCorner(bar, 3)
        progressFill = Instance.new("Frame")
        progressFill.Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 100) / 100, 0, 1, 0)
        progressFill.BorderSizePixel = 0
        progressFill.BackgroundColor3 = kindColors[kind] or kindColors.info
        progressFill.Parent = bar
        makeCorner(progressFill, 3)
    end

    tween(card, {Position = UDim2.fromOffset(0, 0)}, 0.22)
    local dead = false
    local function dismiss()
        if dead then return end
        dead = true
        tween(card, {
            Position = UDim2.fromOffset(0, -24),
            GroupTransparency = 1,
            BackgroundTransparency = 1,
        }, 0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        task.delay(duration(0.44), function()
            if holder then holder:Destroy() end
        end)
    end
    track(close.MouseButton1Click:Connect(dismiss))
    task.delay(seconds, dismiss)

    local soundIds = env.LH_NOTIFICATION_SOUND_IDS or {
        success = "rbxassetid://9118823107",
        error = "rbxassetid://9118823107",
        warning = "rbxassetid://9118823107",
        info = "rbxassetid://9118823107",
    }
    local soundId = soundIds[kind]
    if not settings.NotificationMuted and soundId and tonumber(settings.NotificationVolume or 0) > 0 then
        local sound = Instance.new("Sound")
        sound.Name = "LHNotificationSound"
        sound.SoundId = tostring(soundId)
        sound.Volume = math.clamp(tonumber(settings.NotificationVolume) or 0.45, 0, 1)
        sound.Parent = card
        pcall(function() sound:Play() end)
        task.delay(6, function() if sound then sound:Destroy() end end)
    end

    local api = {Frame = card, Holder = holder}
    function api:SetProgress(value, newText)
        value = math.clamp(tonumber(value) or 0, 0, 100)
        if progressFill then tween(progressFill, {Size = UDim2.new(value / 100, 0, 1, 0)}, 0.1) end
        if newText ~= nil then body.Text = tostring(newText) end
    end
    function api:Close() dismiss() end
    return api
end

function LULA:NotifyAction(kind, title, text, seconds, buttonText, callback)
    kind = string.lower(tostring(kind or "warning"))
    title = tostring(title or "Lollypop Hub")
    text = tostring(text or "")
    seconds = math.clamp(tonumber(seconds) or 4, 2, 10)
    buttonText = tostring(buttonText or "Undo")

    table.insert(notificationHistory, 1, {
        Time = os.time(), Kind = kind, Title = title, Text = text, Action = buttonText,
    })
    while #notificationHistory > 100 do table.remove(notificationHistory) end
    if not active or not active.NotificationHost then return nil end

    local width, cardHeight = 330, 82
    local holder = Instance.new("Frame")
    holder.Name = "ActionNotificationHolder"
    holder.Size = UDim2.fromOffset(width, cardHeight)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = false
    holder.ZIndex = 111
    holder.Parent = active.NotificationHost

    local view = viewportSize()
    local hostCenter = active.NotificationHost.AbsolutePosition.X + active.NotificationHost.AbsoluteSize.X * 0.5
    local leavesLeft = hostCenter <= view.X * 0.5
    local offscreenX = leavesLeft and -(width + 28) or (width + 28)

    local card = Instance.new("CanvasGroup")
    card.Name = "ActionNotification"
    card.Size = UDim2.fromScale(1, 1)
    card.Position = UDim2.fromOffset(offscreenX, 0)
    card.BackgroundTransparency = 0.03
    card.GroupTransparency = 0
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 112
    card.Parent = holder
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 11)
    makeStroke(card, kindColors[kind] or kindColors.warning, 0.12, 1.2)

    local stripe = Instance.new("Frame")
    stripe.Size = UDim2.new(0, 4, 1, 0)
    stripe.BorderSizePixel = 0
    stripe.BackgroundColor3 = kindColors[kind] or kindColors.warning
    stripe.ZIndex = 113
    stripe.Parent = card

    local titleLabel = makeText(card, title, 14, Enum.Font.GothamBold)
    titleLabel.Position = UDim2.fromOffset(14, 8)
    titleLabel.Size = UDim2.new(1, -120, 0, 20)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 113

    local body = makeText(card, text, 12, Enum.Font.Gotham)
    body.Position = UDim2.fromOffset(14, 31)
    body.Size = UDim2.new(1, -122, 0, 42)
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.TextWrapped = true
    body.ZIndex = 113
    bind(body, "TextColor3", "MutedText")

    local action = makeButton(card, buttonText)
    action.AnchorPoint = Vector2.new(1, 0.5)
    action.Position = UDim2.new(1, -12, 0.5, 0)
    action.Size = UDim2.fromOffset(92, 34)
    action.BackgroundTransparency = 0.02
    action.ZIndex = 114
    bind(action, "BackgroundColor3", "SchemeColor")

    local dead = false
    local function dismiss()
        if dead then return false end
        dead = true
        tween(card, {
            Position = UDim2.fromOffset(offscreenX, 0),
            GroupTransparency = 1,
            BackgroundTransparency = 1,
        }, 0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        task.delay(duration(0.41), function()
            if holder and holder.Parent then holder:Destroy() end
        end)
        return true
    end

    track(action.MouseButton1Click:Connect(function()
        if dead then return end
        dismiss()
        if type(callback) == "function" then safeCall("Notification action " .. buttonText, callback) end
    end))

    tween(card, {Position = UDim2.fromOffset(0, 0)}, 0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    task.delay(seconds, dismiss)

    local api = {Frame = card, Holder = holder, ActionButton = action}
    function api:Close() dismiss() end
    return api
end


--==================================================
-- DYNAMIC ISLAND / UNDO / PERSONAL SHELF
--==================================================
local function normalizeControlId(value)
    return tostring(value or "kontrol"):gsub("[^%w%-%_:%./ ]", ""):sub(1, 180)
end

local function getShelfList()
    local source = env.LHSettings and env.LHSettings.PersonalShelf or settings.PersonalShelf
    local copy = {}
    if type(source) == "table" then
        for _, savedId in ipairs(source) do table.insert(copy, tostring(savedId)) end
    end
    return copy
end

local function shelfIndex(list, controlId)
    for index, savedId in ipairs(type(list) == "table" and list or {}) do
        if tostring(savedId) == tostring(controlId) then return index end
    end
    return nil
end

local function shelfContains(controlId)
    return shelfIndex(getShelfList(), controlId) ~= nil
end

local function saveShelfList(updated)
    env.LHSettings = env.LHSettings or {}
    local clean = {}
    local seen = {}
    for _, savedId in ipairs(type(updated) == "table" and updated or {}) do
        savedId = tostring(savedId)
        if savedId ~= "" and not seen[savedId] then
            seen[savedId] = true
            table.insert(clean, savedId)
        end
    end
    env.LHSettings.PersonalShelf = clean
    settings.PersonalShelf = clean
    persistUiStateEdit()
    return clean
end

local function saveShelf(controlId, shouldPin)
    local updated = getShelfList()
    local index = shelfIndex(updated, controlId)
    if shouldPin and not index then
        table.insert(updated, tostring(controlId))
    elseif not shouldPin and index then
        table.remove(updated, index)
    end
    return saveShelfList(updated)
end

local function updateNavButtons()
    if not active then return end
    if active.BackButton then active.BackButton.TextTransparency = #active.BackStack > 0 and 0 or 0.62 end
    if active.ForwardButton then active.ForwardButton.TextTransparency = #active.ForwardStack > 0 and 0 or 0.62 end
    if active.UndoButton then active.UndoButton.TextTransparency = #active.UndoStack > 0 and 0 or 0.62 end
end

function LULA:RecordUndo(controlId, name, oldValue, newValue, applyOld)
    if not active or active.Undoing or active.RestoringState or type(applyOld) ~= "function" or valuesEqual(oldValue, newValue) then return false end
    local now = os.clock()
    controlId = normalizeControlId(controlId)
    local last = active.UndoStack[#active.UndoStack]
    if last and last.ControlId == controlId and now - last.ChangedAt <= 0.7 then
        last.NewValue = newValue
        last.ChangedAt = now
    else
        table.insert(active.UndoStack, {
            ControlId = controlId,
            Name = tostring(name or controlId),
            OldValue = oldValue,
            NewValue = newValue,
            ApplyOld = applyOld,
            ChangedAt = now,
        })
        while #active.UndoStack > 30 do table.remove(active.UndoStack, 1) end
    end
    updateNavButtons()
    return true
end

function LULA:Undo()
    if not active then return false, "UI is not active" end
    local item = table.remove(active.UndoStack)
    if not item then
        LULA:ShowIsland("Undo History", "Nothing to undo.", {Duration = 2.2})
        updateNavButtons()
        return false, "empty"
    end
    active.Undoing = true
    local ok, err = safeCall("Undo " .. tostring(item.Name), item.ApplyOld)
    active.Undoing = false
    updateNavButtons()
    if ok then
        LULA:ShowIsland("Undone", tostring(item.Name), {Duration = 2.5})
    else
        LULA:Notify("error", "Undo Failed", tostring(err), 5, nil, true)
    end
    return ok, err
end

function LULA:GetUndoHistory()
    if not active then return {} end
    local copy = {}
    for index = #active.UndoStack, 1, -1 do
        local item = active.UndoStack[index]
        table.insert(copy, {Name = item.Name, OldValue = item.OldValue, NewValue = item.NewValue, ChangedAt = item.ChangedAt})
    end
    return copy
end

function LULA:OpenUndoHistory()
    if not active or not active.ScreenGui then return end
    if active.ContextOverlay then active.ContextOverlay:Destroy(); active.ContextOverlay = nil end
    local overlay = Instance.new("CanvasGroup")
    overlay.Name = "LHUndoHistory"
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = rgb(0, 0, 0)
    overlay.BackgroundTransparency = 0.48
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 300
    overlay.Parent = active.ScreenGui
    active.ContextOverlay = overlay

    local dismiss = Instance.new("TextButton")
    dismiss.Size = UDim2.fromScale(1, 1)
    dismiss.BackgroundTransparency = 1
    dismiss.Text = ""
    dismiss.ZIndex = 300
    dismiss.Parent = overlay

    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.fromScale(0.5, 0.5)
    card.Size = UDim2.fromOffset(390, 320)
    card.BorderSizePixel = 0
    card.ZIndex = 301
    card.Parent = overlay
    bind(card, "BackgroundColor3", "NotificationColor")
    makeCorner(card, 13)
    makeStroke(card, active.Theme.SchemeColor, 0.16, 1.2)
    local cardScale = Instance.new("UIScale", card)
    local view = viewportSize()
    cardScale.Scale = math.max(0.72, math.min(1, (view.X - 24) / 410, (view.Y - 50) / 340))

    local title = makeText(card, "Undo History", 17, Enum.Font.GothamBold)
    title.Position = UDim2.fromOffset(14, 8)
    title.Size = UDim2.new(1, -92, 0, 30)
    title.ZIndex = 302
    local undoNow = makeButton(card, "UNDO")
    undoNow.AnchorPoint = Vector2.new(1, 0)
    undoNow.Position = UDim2.new(1, -10, 0, 8)
    undoNow.Size = UDim2.fromOffset(68, 30)
    undoNow.ZIndex = 303

    local scroll = Instance.new("ScrollingFrame")
    scroll.Position = UDim2.fromOffset(10, 46)
    scroll.Size = UDim2.new(1, -20, 1, -56)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new()
    scroll.ScrollBarThickness = 3
    scroll.ZIndex = 302
    scroll.Parent = card
    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0, 5)

    if #active.UndoStack == 0 then
        local empty = makeText(scroll, "Nothing to undo yet.", 13, Enum.Font.GothamMedium)
        empty.Size = UDim2.new(1, 0, 0, 44)
        empty.ZIndex = 303
    else
        for index = #active.UndoStack, 1, -1 do
            local item = active.UndoStack[index]
            local row = makeButton(scroll, tostring(item.Name))
            row.Size = UDim2.new(1, -4, 0, 40)
            row.TextXAlignment = Enum.TextXAlignment.Left
            row.Text = "  " .. tostring(item.Name)
            row.ZIndex = 303
            row.BackgroundTransparency = 0.08
        end
    end

    local function closePanel()
        if active and active.ContextOverlay == overlay then active.ContextOverlay = nil end
        if overlay.Parent then overlay:Destroy() end
    end
    track(dismiss.MouseButton1Click:Connect(closePanel))
    track(undoNow.MouseButton1Click:Connect(function()
        closePanel()
        LULA:Undo()
    end))
end

function LULA:Confirm(titleText, bodyText, onConfirm)
    if not active or not active.ScreenGui then return false end
    if active.ContextOverlay then active.ContextOverlay:Destroy(); active.ContextOverlay = nil end

    local overlay = Instance.new("CanvasGroup")
