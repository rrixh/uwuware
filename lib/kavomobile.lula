        local function notify(message, kind, duration)
            if state.Destroyed then
                return
            end

            kind = kind or "info"
            duration = duration or 2.8

            if type(LULA.Notify) == "function" then
                local delivered = pcall(function()
                    LULA:Notify(kind, "Avatar Kreator", tostring(message), duration, nil, true)
                end)
                if delivered then return end
            end

            local color = ACCENT
            if kind == "success" then
                color = SUCCESS
            elseif kind == "warning" then
                color = WARNING
            elseif kind == "error" then
                color = ERROR_COLOR
            end

            local toast = create("Frame", {
                Size = UDim2.fromOffset(300, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = PANEL,
                BackgroundTransparency = 0.03,
                BorderSizePixel = 0,
                ZIndex = 101
            })
            addCorner(toast, 11)
            addStroke(toast, color, 1, 0.15)
            toast.Parent = ToastHolder

            local accentBar = create("Frame", {
                Size = UDim2.new(0, 4, 1, 0),
                BackgroundColor3 = color,
                BorderSizePixel = 0,
                ZIndex = 102
            })
            addCorner(accentBar, 4)
            accentBar.Parent = toast

            local label = create("TextLabel", {
                Position = UDim2.fromOffset(14, 0),
                Size = UDim2.new(1, -26, 0, 42),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = tostring(message),
                TextColor3 = TEXT,
                TextSize = 12,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center,
                ZIndex = 102
            })
            label.Parent = toast

            toast.Position = UDim2.fromOffset(20, 0)
            toast.BackgroundTransparency = 1
            label.TextTransparency = 1
            tween(toast, 0.18, {
                Position = UDim2.fromOffset(0, 0),
                BackgroundTransparency = 0.03
            })
            tween(label, 0.18, {TextTransparency = 0})

            task.delay(duration, function()
                if not toast.Parent then
                    return
                end
                tween(toast, 0.18, {
                    Position = UDim2.fromOffset(20, 0),
                    BackgroundTransparency = 1
                })
                tween(label, 0.18, {TextTransparency = 1})
                task.delay(0.2, function()
                    if toast.Parent then
                        toast:Destroy()
                    end
                end)
            end)
        end

        local function bindButtonVisual(button, normalColor, hoverColor)
            normalColor = normalColor or PANEL_2
            hoverColor = hoverColor or PANEL_3

            track(button.MouseEnter:Connect(function()
                tween(button, 0.12, {BackgroundColor3 = hoverColor})
            end))

            track(button.MouseLeave:Connect(function()
                tween(button, 0.12, {BackgroundColor3 = normalColor})
            end))

            track(button.MouseButton1Down:Connect(function()
                tween(button, 0.07, {BackgroundTransparency = 0.22})
            end))

            track(button.MouseButton1Up:Connect(function()
                tween(button, 0.10, {BackgroundTransparency = 0})
            end))
        end

        bindButtonVisual(SearchButton, ACCENT, ACCENT_HOVER)
        bindButtonVisual(OutfitButton, PANEL_2, PANEL_3)
