        detailActionPadding.PaddingTop = UDim.new(0, 8)
        detailActionPadding.PaddingBottom = UDim.new(0, 8)
        detailActionPadding.PaddingLeft = UDim.new(0, 9)
        detailActionPadding.PaddingRight = UDim.new(0, 9)
