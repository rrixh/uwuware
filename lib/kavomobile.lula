            createAvatarPreview(preview, item, true)

            local name = makeText(row, tostring(item.Name), 11.5, Enum.Font.GothamBold)
            name.Position = UDim2.fromOffset(94, 5)
            name.Size = UDim2.new(1, -230, 0, 25)
            name.TextXAlignment = Enum.TextXAlignment.Left
            name.TextTruncate = Enum.TextTruncate.AtEnd

