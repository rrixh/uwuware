            local value = makeText(card, "--", 16, Enum.Font.GothamBold)
            value.Position = UDim2.fromOffset(5, 7)
            value.Size = UDim2.new(1, -10, 0, 23)
            value.TextXAlignment = Enum.TextXAlignment.Center
            bind(value, "TextColor3", "SchemeColor")
            local label = makeText(card, info[1], 9.5, Enum.Font.GothamMedium)
            label.Position = UDim2.fromOffset(5, 32)
            label.Size = UDim2.new(1, -10, 0, 17)
            label.TextXAlignment = Enum.TextXAlignment.Center
            bind(label, "TextColor3", "MutedText")
            socialValues[info[1]] = value
        end

        local bioRow = newRow(scroll, "UserLookupBio", 96)
