            bind(UI.DetailsMeta, "TextColor3", "MutedText")

            UI.DetailsDescription = makeText(UI.DetailsScroll, "", 11, Enum.Font.Gotham)
            UI.DetailsDescription.LayoutOrder = 4
            UI.DetailsDescription.Size = UDim2.new(1, -4, 0, 72)
            UI.DetailsDescription.TextXAlignment = Enum.TextXAlignment.Left
            UI.DetailsDescription.TextYAlignment = Enum.TextYAlignment.Top
            UI.DetailsDescription.TextWrapped = true
            UI.DetailsDescription.ZIndex = 9004

            UI.DetailsSpeedRow = newRow(UI.DetailsScroll, "FreeEmoteDetailsSpeed", 34)
            UI.DetailsSpeedRow.LayoutOrder = 5
            UI.DetailsSpeedRow.ZIndex = 9004
