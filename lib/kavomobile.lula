        local function updateResultCount(count)
            count = tonumber(count) or 0
            resultCount.Text = tostring(count) .. (count == 1 and " animation bundle found" or " animation bundles found")
        end

        renderMarketplace = function()
            clearChildren(marketHolder)
            toggleApisById = {}
            starApisById = {}
            for index, item in ipairs(currentResults) do
                createMarketplaceCard(item, index)
            end
            marketHolder.Visible = true
            favoritesHolder.Visible = false
            updateResultCount(#currentResults)
            emptyLabel.Visible = #currentResults == 0 and not searching
            emptyLabel.Text = #currentResults == 0 and "No animation bundles found. Try another name or a shorter word." or ""
            refreshToggleVisuals()
            refreshStarVisuals()
        end

        renderFavorites = function(query)
            clearChildren(favoritesHolder)
            toggleApisById = {}
            starApisById = {}
            local favorites = getFavorites()
            local filtered = {}
            local normalizedQuery = normalizeWords(query)
            local queryTokens = tokenize(normalizedQuery)
            for _, favorite in ipairs(favorites) do
                local normalizedName = normalizeWords(favorite.Name)
                local matches = normalizedQuery == "" or normalizedName:find(normalizedQuery, 1, true) ~= nil
                if not matches and #queryTokens > 0 then
                    matches = true
                    for _, token in ipairs(queryTokens) do
                        if not normalizedName:find(token, 1, true) then
                            matches = false
                            break
                        end
                    end
                end
                if matches then table.insert(filtered, favorite) end
            end
            for index, item in ipairs(filtered) do
                createFavoriteRow(item, index)
            end
            marketHolder.Visible = false
            favoritesHolder.Visible = true
            updateResultCount(#filtered)
            emptyLabel.Visible = #filtered == 0
            if #favorites == 0 then
                emptyLabel.Text = "No favorites yet. Press the star on a Marketplace animation bundle to add one."
            else
                emptyLabel.Text = "No favorite animation bundles match this search."
            end
            refreshToggleVisuals()
        end

        local function setSuggestion(correctedQuery, originalQuery)
            local visible = correctedQuery ~= nil and originalQuery ~= nil
            suggestion.Visible = visible
            if visible then
                suggestionText.Text = "Showing results for \"" .. tostring(correctedQuery) .. "\""
                originalSearchButton.Text = "Search original: \"" .. tostring(originalQuery) .. "\""
            end
        end

        local function setSearching(value, message)
            searching = value == true
            loadingLabel.Visible = searching
            if message then loadingLabel.Text = tostring(message) end
            searchButton.Active = not searching
            searchBox.TextEditable = not searching
            if currentMode == "marketplace" then emptyLabel.Visible = false end
        end

        local function appendResults(results)
            for _, item in ipairs(results or {}) do
                if not currentResultIds[item.Id] then
                    currentResultIds[item.Id] = true
                    table.insert(currentResults, item)
                end
            end
            sortResults(currentResults, currentEffectiveQuery)
            renderMarketplace()
        end

        local function bestResultScore(results, query)
            local best = 0
            for _, item in ipairs(results or {}) do
                best = math.max(best, resultScore(item.Name, query))
            end
            return best
        end

        local function performMarketplaceSearch(rawQuery, forceOriginal)
            local query = trim(rawQuery)
            searchSerial = searchSerial + 1
            local serial = searchSerial
            setSearching(true, "Searching Roblox Marketplace...")
            setSuggestion(nil, nil)
            currentOriginalQuery = nil

            task.spawn(function()
                local ok, results, nextPage, hasMore = pcall(function()
                    return SearchService:SearchMerged(query, forceOriginal == true)
                end)
                if serial ~= searchSerial then return end
                if not ok then
                    currentResults = {}
                    currentResultIds = {}
                    currentNextPage = nil
                    currentHasMore = false
                    setSearching(false)
                    renderMarketplace()
                    emptyLabel.Visible = true
                    emptyLabel.Text = "Marketplace search failed: " .. tostring(results)
                    bundleNotify("Roblox Marketplace search failed.", "error", 3.5)
                    return
                end

                local finalQuery = query
                local finalResults = results
                local finalNext = nextPage
                local finalHasMore = hasMore

                if not forceOriginal and query ~= "" then
                    local candidates = {}
                    local seen = {}
                    mergeResults(candidates, results, seen)
                    local correction = findCorrectedQuery(query, candidates)
                    local initialScore = bestResultScore(results, query)
                    if not correction and (#results == 0 or initialScore < 45) then
                        loadingLabel.Text = "Checking bundle names for a possible typo..."
                        local indexItems = SearchService:BuildFuzzyIndex(true)
                        mergeResults(candidates, indexItems, seen)
                        correction = findCorrectedQuery(query, candidates)
                    end
                    if correction and correction ~= normalizeWords(query) then
                        loadingLabel.Text = "Showing the closest matching animation bundles..."
                        local correctedOk, correctedResults, correctedNext, correctedHasMore = pcall(function()
                            return SearchService:SearchMerged(correction, false)
                        end)
                        if correctedOk and #correctedResults > 0 then
                            local correctedScore = bestResultScore(correctedResults, correction)
                            if #results == 0 or correctedScore >= initialScore then
                                finalQuery = correction
                                finalResults = correctedResults
                                finalNext = correctedNext
                                finalHasMore = correctedHasMore
                                currentOriginalQuery = query
                            end
                        end
                    end
                end

                if serial ~= searchSerial then return end
                currentResults = {}
                currentResultIds = {}
                currentEffectiveQuery = finalQuery
                currentNextPage = finalNext
                currentHasMore = finalHasMore == true
                appendResults(finalResults)
                setSearching(false)
                if currentOriginalQuery then setSuggestion(finalQuery, currentOriginalQuery) end
            end)
        end

        local function loadMoreResults()
            if loadingMore or searching or currentMode ~= "marketplace" then return end
            if not currentHasMore or typeof(currentNextPage) ~= "function" then return end
            loadingMore = true
            loadingLabel.Text = "Loading more animation bundles..."
            loadingLabel.Visible = true
            task.spawn(function()
                local ok, page, hasMore = pcall(currentNextPage)
                if ok then
                    currentHasMore = hasMore == true
                    appendResults(page)
                else
                    currentHasMore = false
                    bundleNotify("Could not load the next Marketplace page.", "error", 3)
                end
                loadingMore = false
                loadingLabel.Visible = searching
            end)
        end

        local function runCurrentSearch(forceOriginal)
            if currentMode == "favorites" then
                searchSerial = searchSerial + 1
                setSuggestion(nil, nil)
                renderFavorites(searchBox.Text)
            else
                performMarketplaceSearch(searchBox.Text, forceOriginal == true)
            end
        end

        local function setMode(mode)
            currentMode = mode == "favorites" and "favorites" or "marketplace"
            state.Mode = currentMode
            local marketplaceActive = currentMode == "marketplace"
            marketplaceTabButton.BackgroundColor3 = marketplaceActive and active.Theme.SchemeColor or active.Theme.ElementColor
            favoritesTabButton.BackgroundColor3 = marketplaceActive and active.Theme.ElementColor or active.Theme.SchemeColor
            deleteAllButton.Visible = not marketplaceActive
            suggestion.Visible = marketplaceActive and currentOriginalQuery ~= nil
            if marketplaceActive then
                marketHolder.Visible = true
                favoritesHolder.Visible = false
                if #currentResults == 0 and not searching then
                    performMarketplaceSearch(searchBox.Text, false)
                else
                    renderMarketplace()
                end
            else
                renderFavorites(searchBox.Text)
            end
            task.defer(function() scroll.CanvasPosition = Vector2.new(0, 0) end)
        end

        track(marketplaceTabButton.MouseButton1Click:Connect(function() setMode("marketplace") end))
        track(favoritesTabButton.MouseButton1Click:Connect(function() setMode("favorites") end))
        track(searchButton.MouseButton1Click:Connect(function() runCurrentSearch(false) end))
        track(searchBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then runCurrentSearch(false) end
        end))
        track(originalSearchButton.MouseButton1Click:Connect(function()
            if currentOriginalQuery then
                searchBox.Text = currentOriginalQuery
                runCurrentSearch(true)
            end
        end))

        -- The clear X should leave the TextBox blank while showing featured
        -- Marketplace results or the full local Favorites list.
        local clearButton = searchRow:FindFirstChild("AnimationBundleSearchBox_ClearTextX")
        if clearButton then
            track(clearButton.MouseButton1Click:Connect(function()
                task.defer(function() runCurrentSearch(false) end)
            end))
        end

        track(deleteAllButton.MouseButton1Click:Connect(function()
            local favorites = getFavorites()
            if #favorites == 0 then
                bundleNotify("Favorites is already empty.", "info", 2.2)
                return
            end
            LULA:Confirm("Delete all favorites?", "Are you sure you want to delete every saved animation bundle from Favorites?", function()
                saveFavorites({})
                refreshStarVisuals()
                renderFavorites(searchBox.Text)
                bundleNotify("All animation bundle favorites were deleted.", "success", 2.7)
            end)
        end))

        track(scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
            if currentMode ~= "marketplace" or searching or loadingMore then return end
            local remaining = scroll.AbsoluteCanvasSize.Y - (scroll.CanvasPosition.Y + scroll.AbsoluteWindowSize.Y)
            if remaining < 90 then loadMoreResults() end
        end))

        state.RefreshTheme = function()
            local marketplaceActive = currentMode == "marketplace"
            marketplaceTabButton.BackgroundColor3 = marketplaceActive and active.Theme.SchemeColor or active.Theme.ElementColor
            favoritesTabButton.BackgroundColor3 = marketplaceActive and active.Theme.ElementColor or active.Theme.SchemeColor
            refreshStarVisuals()
            refreshToggleVisuals()
        end
        state.Refresh = function()
            if currentMode == "favorites" then renderFavorites(searchBox.Text) else renderMarketplace() end
        end
        state.Search = function(query)
            searchBox.Text = tostring(query or "")
            runCurrentSearch(false)
        end
        state.RestoreOriginal = function()
            state.ToggleSerial = (state.ToggleSerial or 0) + 1
            local restored = restoreOriginalAnimations(true)
            state.ActiveId = nil
            state.ActiveItem = nil
            state.ActiveSlots = nil
            refreshToggleVisuals()
            return restored
        end

        settings.AnimationBundleFavorites = saveFavorites(getFavorites())
        setMode("marketplace")
        SearchService:BuildFuzzyIndex(false)
        return bundleTab
    end

    function window:EnablePersonalShelf(tabName)
        if active.Shelf then return active.Shelf.Tab end
        local shelfTab = self:NewTab(tabName or "My Shelf")
        shelfTab:EnsureBuilt()
        local scroll = shelfTab.Scroll

        local profile = newRow(scroll, "ShelfProfile", 174)
        profile.LayoutOrder = -4000
        profile.BackgroundTransparency = 0.02
        makeStroke(profile, active.Theme.SchemeColor, 0.24, 1)

        local viewport, fallbackAvatar = createAnimatedAvatarViewport(profile, {
            Name = "ShelfAvatarViewport",
            ModelName = "ShelfAvatarModel",
            UserId = LocalPlayer.UserId,
            AnimationId = env.LH_MY_SHELF_ANIMATION_ID or DEFAULT_MY_SHELF_ANIMATION_ID,
            Position = UDim2.fromOffset(12, 12),
            Width = 116,
            Height = 116,
            Radius = 58,
            FieldOfView = 32,
            DistanceScale = 1.02,
            AnimationSpeed = 0.82,
        })

        local hi = makeText(profile, "Hi, my name is " .. tostring(LocalPlayer.DisplayName), 16, Enum.Font.GothamBold)
        hi.Position = UDim2.fromOffset(142, 12)
        hi.Size = UDim2.new(1, -154, 0, 30)
        hi.TextXAlignment = Enum.TextXAlignment.Left
        hi.TextWrapped = true

        local username = makeText(profile, "@" .. tostring(LocalPlayer.Name), 13, Enum.Font.GothamMedium)
        username.Position = UDim2.fromOffset(142, 45)
        username.Size = UDim2.new(1, -154, 0, 20)
        username.TextXAlignment = Enum.TextXAlignment.Left
        bind(username, "TextColor3", "SchemeColor")

        local details = makeText(profile,
            "User ID: " .. tostring(LocalPlayer.UserId) .. "  |  Account Age: " .. tostring(LocalPlayer.AccountAge) .. " days",
            11.5, Enum.Font.Gotham)
        details.Position = UDim2.fromOffset(142, 68)
        details.Size = UDim2.new(1, -154, 0, 34)
        details.TextXAlignment = Enum.TextXAlignment.Left
        details.TextWrapped = true
        bind(details, "TextColor3", "MutedText")

        local about = makeText(profile,
            "This is your personal LH tab. Save your favorite features, launch them fast, delete them with Undo, and rearrange them your way.",
            11.5, Enum.Font.Gotham)
        about.Position = UDim2.fromOffset(142, 103)
        about.Size = UDim2.new(1, -154, 0, 56)
        about.TextXAlignment = Enum.TextXAlignment.Left
        about.TextYAlignment = Enum.TextYAlignment.Top
        about.TextWrapped = true
        bind(about, "TextColor3", "MutedText")

        local controlsRow = Instance.new("Frame")
        controlsRow.Name = "ShelfTopControls"
        controlsRow.LayoutOrder = -3000
        controlsRow.Size = UDim2.new(1, -4, 0, 62)
        controlsRow.BackgroundTransparency = 1
        controlsRow.Parent = scroll
        local controlsLayout = Instance.new("UIListLayout")
        controlsLayout.FillDirection = Enum.FillDirection.Horizontal
        controlsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        controlsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        controlsLayout.Padding = UDim.new(0, 6)
        controlsLayout.Parent = controlsRow

        local status = Instance.new("Frame")
        status.Name = "ShelfEditingStatus"
        status.LayoutOrder = -2500
        status.Size = UDim2.new(1, -4, 0, 28)
        status.BackgroundTransparency = 1
        status.Visible = false
        status.Parent = scroll
        local statusIcon = makeShelfToolsIcon(status)
        statusIcon.AnchorPoint = Vector2.new(1, 0.5)
        statusIcon.Position = UDim2.new(0.5, -58, 0.5, 0)
        local statusText = makeText(status, "in Editing Mode", 12.5, Enum.Font.GothamBold)
        statusText.Position = UDim2.new(0.5, -52, 0, 0)
        statusText.Size = UDim2.fromOffset(150, 28)
        statusText.TextXAlignment = Enum.TextXAlignment.Left
        bind(statusText, "TextColor3", "SchemeColor")

        local itemsHolder = Instance.new("Frame")
        itemsHolder.Name = "ShelfItems"
        itemsHolder.LayoutOrder = 0
        itemsHolder.Size = UDim2.new(1, -4, 0, 0)
        itemsHolder.AutomaticSize = Enum.AutomaticSize.Y
        itemsHolder.BackgroundTransparency = 1
        itemsHolder.Parent = scroll
        local itemsLayout = Instance.new("UIListLayout")
        itemsLayout.Padding = UDim.new(0, 6)
        itemsLayout.SortOrder = Enum.SortOrder.LayoutOrder
        itemsLayout.Parent = itemsHolder
        local itemsPadding = Instance.new("UIPadding")
        itemsPadding.PaddingBottom = UDim.new(0, 8)
        itemsPadding.Parent = itemsHolder

        local shelfData = {
            Tab = shelfTab,
            Scroll = scroll,
            Profile = profile,
            ControlsRow = controlsRow,
            EditingStatus = status,
            ItemsHolder = itemsHolder,
            Editing = false,
            Dragging = nil,
            RowMap = {},
            DeleteAllUndo = nil,
        }
        active.Shelf = shelfData

        local function miniControl(name, isToggle, initialValue, callback, danger)
            local frame = newRow(controlsRow, name, 54)
            frame.Size = UDim2.new(1 / 3, -6, 0, 54)
            frame.BackgroundTransparency = 0.04
            local label = makeText(frame, name, 11.5, Enum.Font.GothamBold)
            label.Position = UDim2.fromOffset(7, 4)
            label.Size = UDim2.new(1, -14, 0, 23)
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.TextWrapped = true
            local hit = makeButton(frame, "")
            hit.Size = UDim2.fromScale(1, 1)
            hit.BackgroundTransparency = 1
            hit.ZIndex = 8

            local api = {Value = initialValue == true, Frame = frame}
            if isToggle then
                local pill = Instance.new("Frame")
                pill.AnchorPoint = Vector2.new(0.5, 1)
                pill.Position = UDim2.new(0.5, 0, 1, -5)
                pill.Size = UDim2.fromOffset(34, 18)
                pill.BorderSizePixel = 0
                pill.Parent = frame
                makeCorner(pill, 9)
                local knob = Instance.new("Frame")
                knob.Size = UDim2.fromOffset(14, 14)
                knob.BorderSizePixel = 0
                knob.BackgroundColor3 = rgb(248, 248, 250)
                knob.Parent = pill
                makeCorner(knob, 7)
                function api:Render()
                    pill.BackgroundColor3 = self.Value and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
                    knob.Position = self.Value and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
                end
                function api:SetValue(value, fire)
                    self.Value = value == true
                    self:Render()
                    if fire ~= false and type(callback) == "function" then callback(self.Value) end
                end
                api:Render()
                track(hit.MouseButton1Click:Connect(function() api:SetValue(not api.Value, true) end))
            else
                if danger then
                    frame.BackgroundColor3 = rgb(102, 31, 40)
                    label.TextColor3 = rgb(255, 236, 239)
                end
                track(hit.MouseButton1Click:Connect(function()
                    if type(callback) == "function" then callback() end
                end))
            end
            return api
        end

        -- This compact toggle lives in the profile card so users can disable the
        -- hold-to-add pop-up without disabling their saved Shelf items.
        local holdToggle = makeKolorButton(profile, "Shelf Hold Menu", TOGGLE_OFF_COLOR)
        holdToggle.AnchorPoint = Vector2.new(0, 1)
        holdToggle.Position = UDim2.fromOffset(12, 164)
        holdToggle.Size = UDim2.fromOffset(116, 28)
        holdToggle.TextSize = 10.5
        holdToggle.BackgroundTransparency = 0.08
        local holdDot = Instance.new("Frame")
        holdDot.AnchorPoint = Vector2.new(1, 0.5)
        holdDot.Position = UDim2.new(1, -7, 0.5, 0)
        holdDot.Size = UDim2.fromOffset(9, 9)
        holdDot.BorderSizePixel = 0
        holdDot.Parent = holdToggle
        makeCorner(holdDot, 5)
        local function renderHoldToggle()
            local enabled = settings.ShelfEnabled ~= false
            holdToggle.Text = "Shelf Hold Menu"
            holdToggle.BackgroundColor3 = enabled and TOGGLE_ON_COLOR or TOGGLE_OFF_COLOR
            holdToggle.TextColor3 = rgb(255, 255, 255)
            holdDot.BackgroundColor3 = rgb(255, 255, 255)
        end
        renderHoldToggle()
        track(holdToggle.MouseButton1Click:Connect(function()
            settings.ShelfEnabled = not (settings.ShelfEnabled ~= false)
            env.LHSettings = env.LHSettings or {}
            env.LHSettings.ShelfEnabled = settings.ShelfEnabled
            env.LHUISettings.ShelfEnabled = settings.ShelfEnabled
            renderHoldToggle()
            persistIndependentShelfSetting()
            refreshShelf()
            LULA:ShowIsland("My Shelf", settings.ShelfEnabled and "Hold-to-add pop-ups enabled." or "Hold-to-add pop-ups disabled.", {Duration = 2.4})
        end))

        local autoSaveControl
        autoSaveControl = miniControl("Auto Save", true, settings.ShelfAutoSave == true, function(value)
            settings.ShelfAutoSave = value == true
            env.LHSettings = env.LHSettings or {}
            env.LHSettings.ShelfAutoSave = settings.ShelfAutoSave
            env.LHUISettings.ShelfAutoSave = settings.ShelfAutoSave
            persistIndependentShelfSetting()
            LULA:ShowIsland("My Shelf Auto Save", value and "Shelf edits save instantly." or "Shelf edits wait for Save Settings.", {Duration = 2.5})
        end)

        miniControl("Delete All", false, false, function()
            local current = getShelfList()
            if #current == 0 then
                LULA:ShowIsland("My Shelf", "Your Shelf is already empty.", {Duration = 2.2})
                return
            end
            LULA:Confirm("Delete All Shelf Skripts?", "Are you sure you want to delete all skripts in My Shelf?", function()
                local snapshot = {}
                for _, savedId in ipairs(current) do table.insert(snapshot, tostring(savedId)) end
                local undoToken = tostring(os.clock()) .. ":" .. tostring(math.random(100000, 999999))
                shelfData.DeleteAllUndo = {
                    Items = snapshot,
                    ExpiresAt = os.clock() + 7,
                    Token = undoToken,
                }
                saveShelfList({})
                refreshShelf()
                LULA:ShowIsland("My Shelf", "All Shelf skripts were deleted. Undo is available here for 7 seconds.", {Duration = 2.7})

                task.delay(7.05, function()
                    if not active or active.Shelf ~= shelfData then return end
                    local pending = shelfData.DeleteAllUndo
                    if pending and tostring(pending.Token or "") == undoToken then
                        shelfData.DeleteAllUndo = nil
                        refreshShelf()
                    end
                end)
            end)
        end, true)

        local rearrangeControl
        rearrangeControl = miniControl("Rearrange", true, false, function(value)
            shelfData.Editing = value == true
            status.Visible = shelfData.Editing
            refreshShelf()
        end)

        refreshShelf()
        task.spawn(function()
            for _, candidate in ipairs(active and active.Tabs or {}) do
                if not active then return end
                if candidate ~= shelfTab then candidate:EnsureBuilt() end
                task.wait()
            end
            refreshShelf()
        end)
        return shelfTab
    end

    function window:RefreshShelf() refreshShelf() end

    function window:GetUIState()
        if not active then return nil end
        local state = {
            Version = 3,
            SelectedTab = active.SelectedTab and active.SelectedTab.Name or nil,
            Visible = active.ScreenGui.Enabled,
            Main = {
                Position = {main.Position.X.Scale, main.Position.X.Offset, main.Position.Y.Scale, main.Position.Y.Offset},
                Size = {main.Size.X.Scale, main.Size.X.Offset, main.Size.Y.Scale, main.Size.Y.Offset},
            },
            TabList = {tabList.CanvasPosition.X, tabList.CanvasPosition.Y},
            Tabs = {},
            Controls = {},
            BackStack = shallowCopyArray(active.BackStack),
            ForwardStack = shallowCopyArray(active.ForwardStack),
        }
        for controlId, api in pairs(controlIdRegistry) do
            if api and type(api.GetValue) == "function" and type(api.SetValue) == "function" then
                local ok, value = pcall(function() return api:GetValue() end)
                if ok then
                    local encoded = encodeSessionValue(value)
                    if encoded ~= nil then state.Controls[tostring(controlId)] = encoded end
                end
            end
        end
        for _, tab in ipairs(active.Tabs) do
            local position = tab.Scroll and tab.Scroll.CanvasPosition or tab.LastCanvasPosition or Vector2.new()
            state.Tabs[tab.Name] = {
                Scroll = {position.X, position.Y},
                Search = tab.SearchBar and tab.SearchBar.TextBox and tab.SearchBar.TextBox.Text or "",
            }
        end
        return state
    end

    function window:RestoreUIState(state)
        if type(state) ~= "table" or not active then return false, "invalid state" end
        local mainState = state.Main
        if type(mainState) == "table" then
            local position = mainState.Position
            local size = mainState.Size
            if type(size) == "table" and #size >= 4 then
                local width = math.clamp(tonumber(size[2]) or main.Size.X.Offset, 420, 760)
                local height = math.clamp(tonumber(size[4]) or main.Size.Y.Offset, 250, 520)
                main.Size = UDim2.new(tonumber(size[1]) or 0, width, tonumber(size[3]) or 0, height)
            end
            if type(position) == "table" and #position >= 4 then
                main.Position = UDim2.new(tonumber(position[1]) or 0.5, tonumber(position[2]) or 0, tonumber(position[3]) or 0.5, tonumber(position[4]) or 0)
            end
            clampMain(main)
        end
        active.BackStack = type(state.BackStack) == "table" and shallowCopyArray(state.BackStack) or {}
        active.ForwardStack = type(state.ForwardStack) == "table" and shallowCopyArray(state.ForwardStack) or {}
        if type(state.TabList) == "table" then
            tabList.CanvasPosition = Vector2.new(tonumber(state.TabList[1]) or 0, tonumber(state.TabList[2]) or 0)
        end
        local tabStates = type(state.Tabs) == "table" and state.Tabs or {}
        for _, tab in ipairs(active.Tabs) do
            local saved = tabStates[tab.Name]
            if type(saved) == "table" and type(saved.Scroll) == "table" then
                tab.LastCanvasPosition = Vector2.new(tonumber(saved.Scroll[1]) or 0, tonumber(saved.Scroll[2]) or 0)
            end
        end
        local target = findTabByName(state.SelectedTab) or active.Tabs[1]
        if target then selectTab(target, "restore") end
        task.defer(function()
            RunService.Heartbeat:Wait()
            RunService.Heartbeat:Wait()
            if not active then return end

            -- A restored session must reapply enabled toggles and kontrol values, not only
            -- reopen the page. Build lazy tabs first so every saved kontrol can be resolved.
            local savedControls = type(state.Controls) == "table" and state.Controls or {}
            if next(savedControls) ~= nil then
                for _, tab in ipairs(active.Tabs) do tab:EnsureBuilt() end
                active.RestoringState = true
                local function restoreKontrols(togglePass)
                    for controlId, encoded in pairs(savedControls) do
                        local api = controlIdRegistry[tostring(controlId)]
                        local isToggle = api and api.Kind == "toggle"
                        if api and isToggle == togglePass and type(api.SetValue) == "function" then
                            local decoded, valid = decodeSessionValue(encoded)
                            if valid and (api.Kind ~= "dropdown" or type(api.ContainsValue) ~= "function" or api:ContainsValue(decoded)) then
                                pcall(function() api:SetValue(decoded, true) end)
                            end
                        end
                    end
                end
                -- Restore values/ranges/targets before enabling feature toggles that depend on them.
                restoreKontrols(false)
                restoreKontrols(true)
                active.RestoringState = false
            end

            for _, tab in ipairs(active.Tabs) do
                local saved = tabStates[tab.Name]
                if type(saved) == "table" then
                    if saved.Search and saved.Search ~= "" then
                        tab:EnsureBuilt()
                        if tab.SearchBar and tab.SearchBar.TextBox then
                            tab.SearchBar.TextBox.Text = tostring(saved.Search)
                            tab.SearchBar.Apply(saved.Search)
                        end
                    end
                    if tab.Scroll then
                        local wanted = tab.LastCanvasPosition or Vector2.new()
                        local maxY = math.max(0, tab.Scroll.AbsoluteCanvasSize.Y - tab.Scroll.AbsoluteWindowSize.Y)
                        tab.Scroll.CanvasPosition = Vector2.new(math.max(0, wanted.X), math.clamp(wanted.Y, 0, maxY))
                    end
                end
            end
            active.ScreenGui.Enabled = state.Visible ~= false
            updateNavButtons()
        end)
        return true
    end

    function window:GetTabs() return active.Tabs end
    function window:GetRoot() return main end
    function window:SetFooter(text) footer.Text = tostring(text or "") end
    function window:SetFont(fontName) return LULA:SetFont(fontName) end
    function window:Notify(...) return LULA:Notify(...) end
    function window:ShowIsland(...) return LULA:ShowIsland(...) end
    function window:SetVisible(value) return LULA:SetUIVisible(value) end
    function window:IsVisible() return LULA:IsVisible() end
    function window:Destroy() LULA:Destroy() end

    active.Window = window
    return window
end

function LULA:ToggleUI()
    if active and active.ScreenGui then
        active.ScreenGui.Enabled = not active.ScreenGui.Enabled
        setGlassBlur(active.ScreenGui.Enabled)
        return active.ScreenGui.Enabled
    end
    return false
end

function LULA:SetUIVisible(value)
    if not active or not active.ScreenGui then return false end
    active.ScreenGui.Enabled = value and true or false
    setGlassBlur(active.ScreenGui.Enabled)
    return active.ScreenGui.Enabled
end

function LULA:IsVisible()
    return active and active.ScreenGui and active.ScreenGui.Enabled == true or false
end

function LULA:ChangeColor(property, color)
    if not active or typeof(color) ~= "Color3" then return false end
    local aliases = {Accent = "SchemeColor", Scheme = "SchemeColor", Text = "TextColor"}
    property = aliases[property] or property
    if active.Theme[property] == nil then return false end
    if property == "TextColor" then color = readableTextColor(color, active.Theme) end
    active.Theme[property] = color
    if property == "SchemeColor" then env.LollypopTheme = color end
    applyTheme()
    return true, color
end

function LULA:SetTextColor(color)
    local ok, safeColor = self:ChangeColor("TextColor", color)
    if not ok then return nil end
    return safeColor
end

function LULA:SetTheme(themeInput)
    if not active then return false end
    active.ThemeSource = themeInput
    active.Theme = resolveTheme(themeInput)
    applyTheme()
    return true
end

function LULA:SetAppearanceMode(mode)
    mode = string.lower(tostring(mode or "Dark")) == "light" and "Light" or "Dark"
    settings.AppearanceMode = mode
    if active then
        active.Theme = resolveTheme(active.ThemeSource or "Kandy")
        applyTheme()
    end
    return mode
end

function LULA:GetThemeNames()
    local copy = {}
    for index, name in ipairs(publicThemeNames) do copy[index] = name end
    return copy
end

function LULA:GetFontNames()
    local copy = {}
    for index, name in ipairs(fontNames) do copy[index] = name end
    return copy
end

function LULA:SetFont(fontName)
    fontName = tostring(fontName or "Gotham")
    if not fontMap[fontName] then return false end
    settings.UIFont = fontName
    applyUIFont()
    return true
end

function LULA:SetReducedMotion(value)
    settings.ReducedMotion = value and true or false
end

function LULA:SetLowPerformance(value)
    settings.LowPerformance = value and true or false
    setGlassBlur(not settings.LowPerformance)
    if active and active.ParticleLayer then active.ParticleLayer.Visible = false end
end

function LULA:SetDragLocked(value)
    settings.DragLocked = value and true or false
end

function LULA:SetEdgeSnap(value)
    settings.EdgeSnap = value and true or false
end

function LULA:SetScaleMode(value)
    settings.ScaleMode = tostring(value or "Auto")
    if active and active.Scale then
        active.Scale.Scale = adaptiveScale()
        task.defer(function() clampMain(active.Main) end)
    end
end

function LULA:SetGlassBlur(_value)
    settings.GlassBlur = false
    setGlassBlur(false)
end

function LULA:SetCustomCursor(value)
    settings.CustomCursor = value and true or false
    if active and active.Cursor then
        active.Cursor.Visible = settings.CustomCursor and not UserInputService.TouchEnabled
        pcall(function() UserInputService.MouseIconEnabled = not active.Cursor.Visible end)
    end
end

function LULA:GetNotificationHistory()
    return notificationHistory
end

function LULA:GetActiveWindow()
    return active and active.Window or nil
end

function LULA:GetRoot()
    return active and active.Main or nil
end

function LULA:GetUIState()
    return active and active.Window and active.Window:GetUIState() or nil
end

function LULA:RestoreUIState(state)
    if not active or not active.Window then return false, "UI is not active" end
    return active.Window:RestoreUIState(state)
end

function LULA:RefreshShelf()
    refreshShelf()
end

function LULA:Destroy()
    if not active then return end
    if active.AnimationBundles and type(active.AnimationBundles.RestoreOriginal) == "function" then
        pcall(active.AnimationBundles.RestoreOriginal)
    end
    pcall(function() UserInputService.MouseIconEnabled = true end)
    disconnectAll()
    if active.Blur then pcall(function() active.Blur:Destroy() end) end
    if active.ScreenGui then pcall(function() active.ScreenGui:Destroy() end) end
    active = nil
    bindings = {}
    controlIdRegistry = {}
    controlFrameRegistry = setmetatable({}, {__mode = "k"})
end

return LULA
