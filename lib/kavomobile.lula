    title.TextXAlignment = Enum.TextXAlignment.Center
    title.ZIndex = 322

    local body = makeText(card, tostring(bodyText or "This action cannot be undone."), 13, Enum.Font.GothamMedium)
    body.Position = UDim2.fromOffset(18, 48)
    body.Size = UDim2.new(1, -36, 0, 58)
    body.TextWrapped = true
    body.TextXAlignment = Enum.TextXAlignment.Center
    body.TextYAlignment = Enum.TextYAlignment.Center
    body.ZIndex = 322
    bind(body, "TextColor3", "MutedText")

    local yes = makeButton(card, "Yes")
    yes.Position = UDim2.new(0.5, -142, 1, -54)
    yes.Size = UDim2.fromOffset(130, 38)
    yes.BackgroundTransparency = 0.02
    yes.ZIndex = 323
    yes.BackgroundColor3 = rgb(40, 177, 91)

    local no = makeButton(card, "No")
    no.Position = UDim2.new(0.5, 12, 1, -54)
    no.Size = UDim2.fromOffset(130, 38)
