        active.AnimationBundles = state

        local function clearChildren(holder)
            for _, child in ipairs(holder:GetChildren()) do
                if not child:IsA("UIGridLayout") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                    child:Destroy()
                end
            end
        end

        local function registerToggle(bundleId, api)
            bundleId = tonumber(bundleId)
            toggleApisById[bundleId] = toggleApisById[bundleId] or {}
            table.insert(toggleApisById[bundleId], api)
        end

        local function registerStar(bundleId, api)
            bundleId = tonumber(bundleId)
            starApisById[bundleId] = starApisById[bundleId] or {}
            table.insert(starApisById[bundleId], api)
        end

        local function refreshToggleVisuals()
            for bundleId, apis in pairs(toggleApisById) do
                for _, api in ipairs(apis) do
                    if api and api.Render then api:Render(tonumber(state.ActiveId) == tonumber(bundleId)) end
                end
            end
        end

        local function refreshStarVisuals()
            for bundleId, apis in pairs(starApisById) do
                local saved = favoriteIndex(bundleId) ~= nil
                for _, api in ipairs(apis) do
                    if api and api.Render then api:Render(saved) end
                end
            end
        end

        local function makeToggleSwitch(parent, bundleId, callback, compact)
            local width = compact and 44 or 50
            local height = compact and 20 or 22
            local pill = Instance.new("Frame")
            pill.Name = "AnimationBundleToggle"
            pill.Size = UDim2.fromOffset(width, height)
            pill.BorderSizePixel = 0
            pill.BackgroundColor3 = ANIMATION_RED
            pill.Parent = parent
            makeCorner(pill, height / 2)

            local knobSize = height - 4
            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(knobSize, knobSize)
            knob.Position = UDim2.fromOffset(2, 2)
            knob.BorderSizePixel = 0
            knob.BackgroundColor3 = rgb(255, 255, 255)
            knob.Parent = pill
            makeCorner(knob, knobSize / 2)

            local hit = makeButton(pill, "")
            hit.Size = UDim2.fromScale(1, 1)
            hit.BackgroundTransparency = 1
            hit.ZIndex = 6

            local api = {Pill = pill, Knob = knob, Busy = false}
            function api:Render(value)
                if not pill or not pill.Parent then return end
                value = value == true
                pill.BackgroundColor3 = value and ANIMATION_GREEN or ANIMATION_RED
                knob.Position = value and UDim2.fromOffset(width - knobSize - 2, 2) or UDim2.fromOffset(2, 2)
                pill.BackgroundTransparency = self.Busy and 0.35 or 0
            end
            function api:SetBusy(value)
                self.Busy = value == true
                if not pill or not pill.Parent then return end
                self:Render(tonumber(state.ActiveId) == tonumber(bundleId))
            end
            track(hit.MouseButton1Click:Connect(function()
                if api.Busy then return end
                if type(callback) == "function" then callback(api) end
            end))
            registerToggle(bundleId, api)
            api:Render(tonumber(state.ActiveId) == tonumber(bundleId))
            return api
        end

        local function resolveItemSlots(item)
            local cached = resolvedSlotsCache[item.Id]
            if cached then
                return cached.Slots, cached.Details, cached.Assets, cached.SlotSources, cached.Verification, cached.CatalogSlots
            end
            local details = fetchBundleDetails(item)
            local slots, assets, slotSources, verification, catalogSlots = resolveAnimationSlots(details)
            local count = 0
            for _, slot in ipairs(SLOT_ORDER) do
                if slots[slot] then count = count + 1 end
            end
            if count == 0 then error("Roblox returned no playable animation IDs for this bundle.") end
            resolvedSlotsCache[item.Id] = {
                Slots = slots,
                Details = details,
                Assets = assets,
                SlotSources = slotSources or {},
                Verification = verification,
                CatalogSlots = catalogSlots or {},
            }
            return slots, details, assets, slotSources or {}, verification, catalogSlots or {}
        end

        local function toggleBundle(item, switchApi)
            state.ToggleSerial = (state.ToggleSerial or 0) + 1
            local toggleSerial = state.ToggleSerial
            if tonumber(state.ActiveId) == tonumber(item.Id) then
                restoreOriginalAnimations(true)
                state.ActiveId = nil
                state.ActiveItem = nil
                state.ActiveSlots = nil
                refreshToggleVisuals()
                bundleNotify(tostring(item.Name) .. " was turned off. Original animations restored.", "success", 2.7)
                return
            end

            switchApi:SetBusy(true)
            local loadingHandle = LULA:ShowIsland(
                "Free Animations",
                "Loading Animation...",
                {Progress = 5}
            )

            task.spawn(function()
                -- Give mobile clients two render opportunities before Roblox's
                -- synchronous bundle/detail calls begin, so the loading state is visible.
                RunService.RenderStepped:Wait()
                RunService.Heartbeat:Wait()
                if loadingHandle then
                    loadingHandle:SetProgress(24, "Loading Animation...")
                end

                local ok, slotsOrError = pcall(function()
                    local slots = resolveItemSlots(item)
                    if toggleSerial ~= state.ToggleSerial then return nil end
                    if loadingHandle then
                        loadingHandle:SetProgress(76, "Applying Animation...")
                    end
                    restoreOriginalAnimations(true)
                    activeBundle = {Name = item.Name, Slots = slots}
                    if not applyAnimationSlots(slots, true) then
                        error("Character.Animate could not apply this bundle.")
                    end
                    return slots
                end)

                switchApi:SetBusy(false)

                if loadingHandle then
                    loadingHandle:SetProgress(ok and 100 or 0, ok and "Animation Loaded." or "Animation Failed.")
                    task.delay(0.22, function()
                        pcall(function() loadingHandle:Close() end)
                    end)
                end

                if toggleSerial ~= state.ToggleSerial then return end
                if not ok then
                    state.ActiveId = nil
                    state.ActiveItem = nil
                    state.ActiveSlots = nil
                    refreshToggleVisuals()
                    bundleNotify("Could not play " .. tostring(item.Name) .. ": " .. tostring(slotsOrError), "error", 3.5)
                    return
                end
                state.ActiveId = item.Id
                state.ActiveItem = item
                state.ActiveSlots = slotsOrError
                refreshToggleVisuals()
                bundleNotify(tostring(item.Name) .. " is now active.", "success", 2.7)
            end)
        end



        -- Marketplace V4 native bundle information overlay. Kept in a nested
        -- builder so the large Animation Bundles method stays below Luau's active-local limit.
