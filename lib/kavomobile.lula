local settings = env.LHUISettings or {}
env.LHUISettings = settings
if settings.ReducedMotion == nil then settings.ReducedMotion = false end
if settings.LowPerformance == nil then settings.LowPerformance = false end
if settings.DragLocked == nil then settings.DragLocked = false end
if settings.EdgeSnap == nil then settings.EdgeSnap = true end
if settings.ScaleMode == nil then settings.ScaleMode = "Auto" end
if settings.GlassBlur == nil then settings.GlassBlur = false end
if settings.CustomCursor == nil then settings.CustomCursor = false end
if settings.NotificationMuted == nil then settings.NotificationMuted = true end
if settings.NotificationVolume == nil then settings.NotificationVolume = 0.45 end
if settings.UIFont == nil then settings.UIFont = "Gotham" end

local active = nil
local fontMap = {}
local fontNames = {}
for _, fontItem in ipairs(Enum.Font:GetEnumItems()) do
    fontMap[fontItem.Name] = fontItem
    table.insert(fontNames, fontItem.Name)
end
table.sort(fontNames)

local function resolveUIFont(fallback)
    return fontMap[tostring(settings.UIFont or "")] or fallback or Enum.Font.Gotham
end

local function applyUIFont()
    if not active or not active.ScreenGui then return end
    local selected = resolveUIFont(Enum.Font.Gotham)
    for _, object in ipairs(active.ScreenGui:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            pcall(function() object.Font = selected end)
        end
    end
end

active = nil
local connections = {}
local bindings = {}
local notificationHistory = env.LHNotificationHistory or {}
env.LHNotificationHistory = notificationHistory
local thumbnailCache = {}
-- Roblox Instances cannot hold arbitrary Lua fields. Keep kontrol metadata in a weak registry instead.
local sectionControlRegistry = setmetatable({}, {__mode = "k"})

local function track(connection)
    if connection then
        table.insert(connections, connection)
    end
    return connection
end

local function disconnectAll()
    for i = #connections, 1, -1 do
        local connection = connections[i]
        pcall(function()
            if connection and connection.Connected then connection:Disconnect() end
        end)
        connections[i] = nil
    end
end

local function safeCall(label, callback, ...)
    local args = table.pack(...)
    local ok, result = xpcall(function()
        return callback(table.unpack(args, 1, args.n))
    end, function(err)
        return debug.traceback(tostring(err), 2)
    end)
    if not ok then
        warn("[Lollypop UI] " .. tostring(label) .. " failed:\n" .. tostring(result))
        if env.LHNotify then
            pcall(env.LHNotify, "error", "Kontrol Error", tostring(result), 7)
        end
    end
    return ok, result
end

local function duration(seconds)
    if settings.ReducedMotion or settings.LowPerformance then return 0 end
    return seconds or 0.16
end

local function tween(object, properties, seconds, style, direction)
    if not object or not object.Parent then return nil end
    local d = duration(seconds)
    if d <= 0 then
        for property, value in pairs(properties) do
            pcall(function() object[property] = value end)
        end
        return nil
    end
    local tweenObject = TweenService:Create(
        object,
        TweenInfo.new(d, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
        properties
    )
    tweenObject:Play()
    return tweenObject
end

local function cloneTheme(source)
    local result = {}
    for key, value in pairs(source or {}) do result[key] = value end
    result.SchemeColor = result.SchemeColor or defaultAccent
    result.Accent2 = result.Accent2 or result.SchemeColor
    result.Background = result.Background or rgb(18, 18, 22)
    result.Header = result.Header or rgb(12, 12, 15)
    result.TextColor = result.TextColor or rgb(255, 255, 255)
    result.MutedText = result.MutedText or rgb(170, 170, 180)
    result.ElementColor = result.ElementColor or rgb(29, 29, 36)
    result.Danger = result.Danger or rgb(255, 70, 88)
    return result
end

local function resolveTheme(theme)
    if type(theme) == "string" then
        return cloneTheme(themes[theme] or themes.Kandy)
    elseif type(theme) == "table" then
        return cloneTheme(theme)
    end
    return cloneTheme(themes.Kandy)
end

local function bind(object, property, themeKey)
    table.insert(bindings, {Object = object, Property = property, Key = themeKey})
    if active and active.Theme and active.Theme[themeKey] ~= nil then
        pcall(function() object[property] = active.Theme[themeKey] end)
    end
end

local function applyTheme()
    if not active then return end
    for i = #bindings, 1, -1 do
        local record = bindings[i]
        if not record.Object or not record.Object.Parent then
            table.remove(bindings, i)
        else
            local value = active.Theme[record.Key]
            if value ~= nil then
                pcall(function() record.Object[record.Property] = value end)
            end
        end
    end
    if active.SideGradient then
        active.SideGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, active.Theme.SchemeColor),
            ColorSequenceKeypoint.new(1, active.Theme.Accent2),
        })
    end
    if active.MainStroke then active.MainStroke.Color = active.Theme.SchemeColor end
end

local function makeCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
    return corner
end

local function makeStroke(parent, color, transparency, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or rgb(255, 255, 255)
    stroke.Transparency = transparency or 0.72
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

local function makeText(parent, text, size, font)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Font = resolveUIFont(font or Enum.Font.Gotham)
    label.Text = tostring(text or "")
    label.TextSize = size or 15
    label.TextWrapped = true
    label.Parent = parent
    bind(label, "TextColor3", "TextColor")
    return label
end

local function createButtonRipple(button, inputObject)
    if settings.ReducedMotion or settings.LowPerformance then return end
    if not button or not button.Parent then return end
    local absoluteSize = button.AbsoluteSize
    if absoluteSize.X <= 0 or absoluteSize.Y <= 0 then return end

    local absolutePosition = button.AbsolutePosition
    local point = inputObject and inputObject.Position or Vector3.new(
        absolutePosition.X + (absoluteSize.X * 0.5),
        absolutePosition.Y + (absoluteSize.Y * 0.5),
        0
    )
    local diameter = math.max(absoluteSize.X, absoluteSize.Y) * 2.25
    local ripple = Instance.new("Frame")
    ripple.Name = "LHRipple"
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Position = UDim2.fromOffset(point.X - absolutePosition.X, point.Y - absolutePosition.Y)
    ripple.Size = UDim2.fromOffset(0, 0)
    ripple.BackgroundColor3 = (active and active.Theme and active.Theme.SchemeColor) or defaultAccent
    ripple.BackgroundTransparency = 0.52
    ripple.BorderSizePixel = 0
    ripple.Active = false
    ripple.ZIndex = math.max(1, button.ZIndex)
    ripple.Parent = button
    makeCorner(ripple, 999)

    tween(ripple, {
        Size = UDim2.fromOffset(diameter, diameter),
        BackgroundTransparency = 1,
    }, 0.34, Enum.EasingStyle.Quad)
    task.delay(duration(0.38), function()
        if ripple then pcall(function() ripple:Destroy() end) end
    end)
end

local function addButtonPressEffect(button)
    if not button or not button:IsA("GuiButton") then return end
    if button:GetAttribute("LHPressEffectBound") then return end
    button:SetAttribute("LHPressEffectBound", true)
    button.ClipsDescendants = true
    local scaleObject = button:FindFirstChild("LHPressScale") or Instance.new("UIScale")
    scaleObject.Name = "LHPressScale"
    scaleObject.Scale = 1
    scaleObject.Parent = button
    local pressing = false
    track(button.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = true
            createButtonRipple(button, inputObject)
            tween(scaleObject, {Scale = 0.955}, 0.06, Enum.EasingStyle.Quad)
        end
    end))
    track(button.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = false
            tween(scaleObject, {Scale = 1}, 0.09, Enum.EasingStyle.Back)
        end
    end))
    track(button.MouseLeave:Connect(function()
        if pressing then
            pressing = false
            tween(scaleObject, {Scale = 1}, 0.09, Enum.EasingStyle.Back)
        end
    end))
end

local function makeButton(parent, text)
    local button = Instance.new("TextButton")
    button.AutoButtonColor = false
    button.BorderSizePixel = 0
    button.Font = resolveUIFont(Enum.Font.GothamMedium)
    button.Text = tostring(text or "")
    button.TextSize = 14
    button.Parent = parent
    bind(button, "TextColor3", "TextColor")
    bind(button, "BackgroundColor3", "ElementColor")
    makeCorner(button, 7)
    addButtonPressEffect(button)
    return button
end

local function makeKolorButton(parent, text, kolor)
    local button = Instance.new("TextButton")
    button.AutoButtonColor = false
    button.BorderSizePixel = 0
    button.Font = resolveUIFont(Enum.Font.GothamBold)
    button.Text = tostring(text or "")
    button.TextSize = 14
    button.TextColor3 = rgb(255, 255, 255)
    button.BackgroundColor3 = kolor
    button.Parent = parent
    makeCorner(button, 7)
    addButtonPressEffect(button)
    return button
end

local function attachClearX(textBox, onClear)
    if not textBox then return nil end
    local clearParent = textBox.Parent or textBox
    local existing = clearParent:FindFirstChild(tostring(textBox.Name) .. "_ClearTextX")
    if existing then return existing end

    local padding = textBox:FindFirstChildOfClass("UIPadding") or Instance.new("UIPadding")
    if padding.PaddingLeft.Offset == 0 then padding.PaddingLeft = UDim.new(0, 8) end
    padding.PaddingRight = UDim.new(0, 28)
    padding.Parent = textBox

    -- Make X a sibling instead of a child of the TextBox so tapping it cannot focus the keyboard.
    local clear = makeKolorButton(clearParent, "X", rgb(220, 48, 65))
    clear.Name = tostring(textBox.Name) .. "_ClearTextX"
    clear.AnchorPoint = Vector2.new(1, 0.5)
    clear.Position = UDim2.new(
        textBox.Position.X.Scale + textBox.Size.X.Scale,
        textBox.Position.X.Offset + textBox.Size.X.Offset - 3,
        textBox.Position.Y.Scale + (textBox.Size.Y.Scale * 0.5),
        textBox.Position.Y.Offset + (textBox.Size.Y.Offset * 0.5)
    )
    clear.Size = UDim2.fromOffset(20, 20)
    clear.TextSize = 10
    clear.ZIndex = math.max(5, textBox.ZIndex + 2)

    track(clear.MouseButton1Click:Connect(function()
        pcall(function() textBox:ReleaseFocus(false) end)
        textBox.Text = ""
        if type(onClear) == "function" then safeCall("Clear TextBox", onClear, textBox) end
    end))
    return clear
end

local function viewportSize()
    local camera = workspace.CurrentCamera
    if camera then return camera.ViewportSize end
    local ok, size = pcall(function() return UserInputService:GetScreenResolution() end)
    if ok then return size end
    return Vector2.new(1280, 720)
end

local function adaptiveScale()
    local size = viewportSize()
    local safeW = math.max(320, size.X - 24)
    local safeH = math.max(280, size.Y - 70)
    local fit = math.min(safeW / 525, safeH / 330, 1)
    if settings.ScaleMode == "Mini" then fit = math.min(fit, 0.72)
    elseif settings.ScaleMode == "Normal" then fit = math.min(fit, 1)
    elseif settings.ScaleMode == "Large" then fit = math.min(math.max(fit, 0.92), 1.12) end
    return math.max(0.58, fit)
end

local function clampMain(main)
    if not main or not main.Parent then return end
    local view = viewportSize()
    local size = main.AbsoluteSize
    local pos = main.AbsolutePosition
    local x = math.clamp(pos.X, 6, math.max(6, view.X - size.X - 6))
    local y = math.clamp(pos.Y, 6, math.max(6, view.Y - size.Y - 6))
    main.Position = UDim2.fromOffset(
        x + size.X * main.AnchorPoint.X,
        y + size.Y * main.AnchorPoint.Y
    )
end

local function snapMain(main)
    if not settings.EdgeSnap then
        clampMain(main)
        return
    end
    local view = viewportSize()
    local size = main.AbsoluteSize
    local pos = main.AbsolutePosition
    local margin = 14
    local x = math.clamp(pos.X, 6, math.max(6, view.X - size.X - 6))
    local y = math.clamp(pos.Y, 6, math.max(6, view.Y - size.Y - 6))
    local left = x
    local right = view.X - (x + size.X)
    local top = y
    local bottom = view.Y - (y + size.Y)
    local nearest = math.min(left, right, top, bottom)
    if nearest == left and left <= margin then x = 6
    elseif nearest == right and right <= margin then x = math.max(6, view.X - size.X - 6)
    elseif nearest == top and top <= margin then y = 6
    elseif nearest == bottom and bottom <= margin then y = math.max(6, view.Y - size.Y - 6) end
    tween(main, {Position = UDim2.fromOffset(
        x + size.X * main.AnchorPoint.X,
        y + size.Y * main.AnchorPoint.Y
    )}, 0.13)
end

function LULA:DraggingEnabled(handle, target)
    target = target or handle
    local dragging = false
    local dragInput = nil
    local startPosition = nil
    local startFrame = nil

    track(handle.InputBegan:Connect(function(inputObject)
        if settings.DragLocked then return end
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = inputObject
            startPosition = inputObject.Position
            startFrame = target.Position
            local ended
            ended = inputObject.Changed:Connect(function()
                if inputObject.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if ended then ended:Disconnect() end
                    -- Main UI intentionally stays exactly where the user drops it.
                end
            end)
            track(ended)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(inputObject)
        if not dragging or settings.DragLocked then return end
        if inputObject == dragInput or inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then
            local delta = inputObject.Position - startPosition
            target.Position = UDim2.new(
                startFrame.X.Scale, startFrame.X.Offset + delta.X,
                startFrame.Y.Scale, startFrame.Y.Offset + delta.Y
            )
        end
    end))
end

local function createReset(parent, callback)
    local reset = makeButton(parent, "R")
    reset.Name = "Reset"
    reset.AnchorPoint = Vector2.new(1, 0.5)
    reset.Position = UDim2.new(1, -7, 0.5, 0)
    reset.Size = UDim2.fromOffset(24, 24)
    reset.TextSize = 11
    reset.ZIndex = 5
    reset.BackgroundTransparency = 0.12
    track(reset.MouseButton1Click:Connect(function()
        local node = parent
        local settingsControl = false
        while node do
            if node:GetAttribute("LHTabName") == "Ui Kustomization" then
                settingsControl = true
                break
            end
            node = node.Parent
        end
        local resetAction = function()
            safeCall("Reset " .. tostring(parent.Name), callback)
        end
        if settingsControl and type(env.LHConfirmReset) == "function" then
            env.LHConfirmReset("Are you sure you want to reset " .. tostring(parent.Name) .. " to default?", resetAction)
        else
            resetAction()
        end
    end))
    return reset
end

local function attachTip(row, tip)
    tip = tostring(tip or "")
    if tip == "" or not active then return end
    row:SetAttribute("LHDescription", tip)
    local token = 0
    local longPressed = false

    local function show()
        if not active or not active.Tooltip then return end
        active.Tooltip.Text = tip
        active.Tooltip.Visible = true
        tween(active.Tooltip, {BackgroundTransparency = 0.08, TextTransparency = 0}, 0.12)
    end
    local function hide()
        if not active or not active.Tooltip then return end
        tween(active.Tooltip, {BackgroundTransparency = 1, TextTransparency = 1}, 0.1)
        task.delay(duration(0.11), function()
            if active and active.Tooltip then active.Tooltip.Visible = false end
        end)
    end

    track(row.MouseEnter:Connect(function()
        if not UserInputService.TouchEnabled then show() end
    end))
    track(row.MouseLeave:Connect(function()
        token = token + 1
        longPressed = false
        row:SetAttribute("LHLongPressTriggered", false)
        hide()
    end))
    local function beginHold(inputObject)
        if inputObject.UserInputType ~= Enum.UserInputType.Touch and inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        token = token + 1
        local mine = token
        longPressed = false
        row:SetAttribute("LHLongPressTriggered", false)
        task.delay(0.5, function()
            if token == mine and row.Parent then
                longPressed = true
                row:SetAttribute("LHLongPressTriggered", true)
                show()
            end
        end)
    end
    local function endHold(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.Touch or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
            token = token + 1
            if longPressed then
                task.delay(1.35, hide)
                task.delay(0.18, function()
                    if row then row:SetAttribute("LHLongPressTriggered", false) end
                end)
            elseif UserInputService.TouchEnabled then
                hide()
            end
            longPressed = false
        end
    end

    local inputTargets = {row}
    for _, descendant in ipairs(row:GetDescendants()) do
        if descendant:IsA("GuiObject") then table.insert(inputTargets, descendant) end
    end
    for _, target in ipairs(inputTargets) do
        track(target.InputBegan:Connect(beginHold))
        track(target.InputEnded:Connect(endHold))
    end
end

local function addHover(row)
    local baseTransparency = row.BackgroundTransparency
    track(row.MouseEnter:Connect(function()
        tween(row, {BackgroundTransparency = math.max(0, baseTransparency - 0.08)}, 0.09)
    end))
    track(row.MouseLeave:Connect(function()
        tween(row, {BackgroundTransparency = baseTransparency}, 0.09)
    end))
end

local function newRow(parent, name, height)
    local row = Instance.new("Frame")
    row.Name = tostring(name or "Kontrol")
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, height or 33)
    row.BackgroundTransparency = 0
    row.Parent = parent
    bind(row, "BackgroundColor3", "ElementColor")
    makeCorner(row, 4)
    addHover(row)
    return row
end

local function setGlassBlur(_enabled)
    settings.GlassBlur = false
    local blur = Lighting:FindFirstChild("LHGlassBlur")
    if blur then
        pcall(function() blur:Destroy() end)
    end
    if active then active.Blur = nil end
end

local function createNotificationHost(screenGui)
    local host = Instance.new("Frame")
    host.Name = "NotificationHost"
    host.AnchorPoint = Vector2.new(0, 1)
    host.Position = UDim2.new(0, 12, 1, -12)
    host.Size = UDim2.fromOffset(320, 500)
    host.BackgroundTransparency = 1
    host.ZIndex = 100
    host.Parent = screenGui
    local layout = Instance.new("UIListLayout")
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = host
    return host
end

local kindColors = {
    success = rgb(46, 204, 113),
    error = rgb(255, 74, 86),
    warning = rgb(255, 184, 61),
    info = rgb(66, 164, 255),
}

function LULA:Notify(kind, title, text, seconds, progress, force)
    kind = string.lower(tostring(kind or "info"))
    title = tostring(title or "Lollypop Hub")
    text = tostring(text or "")
    if progress ~= nil then
        seconds = math.clamp(tonumber(seconds) or 8, 2, 15)
    else
        seconds = math.clamp(tonumber(seconds) or 3, 1.5, 3.5)
    end
    table.insert(notificationHistory, 1, {
        Time = os.time(), Kind = kind, Title = title, Text = text, Progress = progress,
    })
    while #notificationHistory > 100 do table.remove(notificationHistory) end
    if (settings.NotificationMuted and force ~= true) or not active or not active.NotificationHost then return nil end

    local width = 310
    local bodyWidth = width - 34
    local bodyBounds = TextService:GetTextSize(text ~= "" and text or " ", 12, resolveUIFont(Enum.Font.Gotham), Vector2.new(bodyWidth, 1000))
    local bodyHeight = math.clamp(math.ceil(bodyBounds.Y) + 4, 18, 96)
    local titleHeight = 20
    local cardHeight = 10 + titleHeight + 4 + bodyHeight + (progress ~= nil and 22 or 9)

    local holder = Instance.new("Frame")
    holder.Name = "NotificationHolder"
    holder.Size = UDim2.fromOffset(width, cardHeight)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = false
    holder.ZIndex = 101
    holder.Parent = active.NotificationHost

    local card = Instance.new("CanvasGroup")
    card.Name = "Notification"
    card.Size = UDim2.fromScale(1, 1)
    card.Position = UDim2.fromOffset(-330, 0)
    card.BackgroundTransparency = 0.04
    card.GroupTransparency = 0
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 102
    card.Parent = holder
    bind(card, "BackgroundColor3", "Header")
    makeCorner(card, 10)
    makeStroke(card, kindColors[kind] or kindColors.info, 0.2, 1)

    local stripe = Instance.new("Frame")
    stripe.Size = UDim2.new(0, 4, 1, 0)
    stripe.BorderSizePixel = 0
    stripe.BackgroundColor3 = kindColors[kind] or kindColors.info
    stripe.Parent = card

    local titleLabel = makeText(card, title, 14, Enum.Font.GothamBold)
    titleLabel.Position = UDim2.fromOffset(14, 8)
    titleLabel.Size = UDim2.new(1, -46, 0, titleHeight)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.TextWrapped = false

    local body = makeText(card, text, 12, Enum.Font.Gotham)
    body.Position = UDim2.fromOffset(14, 31)
    body.Size = UDim2.new(1, -28, 0, bodyHeight)
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.TextWrapped = true
    bind(body, "TextColor3", "MutedText")

    local close = makeKolorButton(card, "X", rgb(210, 48, 65))
    close.Position = UDim2.new(1, -28, 0, 6)
    close.Size = UDim2.fromOffset(22, 22)
    close.TextSize = 10

    local progressFill = nil
    if progress ~= nil then
        local bar = Instance.new("Frame")
        bar.Position = UDim2.new(0, 14, 1, -13)
        bar.Size = UDim2.new(1, -28, 0, 5)
        bar.BorderSizePixel = 0
        bar.BackgroundColor3 = rgb(60, 60, 68)
        bar.Parent = card
        makeCorner(bar, 3)
        progressFill = Instance.new("Frame")
        progressFill.Size = UDim2.new(math.clamp(tonumber(progress) or 0, 0, 100) / 100, 0, 1, 0)
        progressFill.BorderSizePixel = 0
        progressFill.BackgroundColor3 = kindColors[kind] or kindColors.info
        progressFill.Parent = bar
        makeCorner(progressFill, 3)
    end

    tween(card, {Position = UDim2.fromOffset(0, 0)}, 0.22)
    local dead = false
    local function dismiss()
        if dead then return end
        dead = true
        tween(card, {
            Position = UDim2.fromOffset(0, -24),
            GroupTransparency = 1,
            BackgroundTransparency = 1,
        }, 0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        task.delay(duration(0.44), function()
            if holder then holder:Destroy() end
        end)
    end
    track(close.MouseButton1Click:Connect(dismiss))
    task.delay(seconds, dismiss)

    local soundIds = env.LH_NOTIFICATION_SOUND_IDS or {
        success = "rbxassetid://9118823107",
        error = "rbxassetid://9118823107",
        warning = "rbxassetid://9118823107",
        info = "rbxassetid://9118823107",
    }
    local soundId = soundIds[kind]
    if not settings.NotificationMuted and soundId and tonumber(settings.NotificationVolume or 0) > 0 then
        local sound = Instance.new("Sound")
        sound.Name = "LHNotificationSound"
        sound.SoundId = tostring(soundId)
        sound.Volume = math.clamp(tonumber(settings.NotificationVolume) or 0.45, 0, 1)
        sound.Parent = card
        pcall(function() sound:Play() end)
        task.delay(6, function() if sound then sound:Destroy() end end)
    end

    local api = {Frame = card, Holder = holder}
    function api:SetProgress(value, newText)
        value = math.clamp(tonumber(value) or 0, 0, 100)
        if progressFill then tween(progressFill, {Size = UDim2.new(value / 100, 0, 1, 0)}, 0.1) end
        if newText ~= nil then body.Text = tostring(newText) end
    end
    function api:Close() dismiss() end
    return api
end

function LULA.CreateLib(kavName, themeInput)
    if active then LULA:Destroy() end
    bindings = {}
    connections = {}

    local theme = resolveTheme(themeInput)
    local parent = CoreGui
    pcall(function()
        if gethui then parent = gethui() end
    end)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "LollypopHubUI_" .. tostring(math.random(10000, 99999))
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 900000
    screenGui.Parent = parent

    track(screenGui.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("GuiButton") then
            task.defer(addButtonPressEffect, descendant)
        end
    end))

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.Position = UDim2.fromScale(0.5, 0.5)
    main.Size = UDim2.fromOffset(525, 318)
    main.BorderSizePixel = 0
    main.BackgroundTransparency = 0
    main.ClipsDescendants = true
    main.Parent = screenGui
    makeCorner(main, 13)
    bind(main, "BackgroundColor3", "Background")
    local mainStroke = makeStroke(main, theme.SchemeColor, 1, 1)

    local particleLayer = Instance.new("Frame")
    particleLayer.Name = "BackgroundParticles"
    particleLayer.Size = UDim2.fromScale(1, 1)
    particleLayer.BackgroundTransparency = 1
    particleLayer.ClipsDescendants = true
    particleLayer.ZIndex = 0
    particleLayer.Visible = false
    particleLayer.Parent = main
    local particleObjects = {}
    for index = 1, 18 do
        local particle = makeText(particleLayer, index % 3 == 0 and "+" or index % 2 == 0 and "o" or ".", math.random(9, 17), Enum.Font.GothamBold)
        particle.Name = "Particle"
        particle.Position = UDim2.new(math.random(), 0, math.random(), 0)
        particle.Size = UDim2.fromOffset(20, 20)
        particle.TextTransparency = 0.72
        particle.ZIndex = 0
        bind(particle, "TextColor3", index % 2 == 0 and "SchemeColor" or "Accent2")
        table.insert(particleObjects, particle)
    end

    local scale = Instance.new("UIScale")
    scale.Scale = adaptiveScale()
    scale.Parent = main

    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 29)
    header.BorderSizePixel = 0
    header.Parent = main
    bind(header, "BackgroundColor3", "Header")
    makeCorner(header, 13)

    local logo = Instance.new("ImageButton")
    logo.Name = "Logo"
    logo.BackgroundTransparency = 1
    logo.Position = UDim2.fromOffset(5, 3)
    logo.Size = UDim2.fromOffset(23, 23)
    logo.ScaleType = Enum.ScaleType.Fit
    logo.Image = "rbxassetid://" .. tostring(env.getImg or env.lollypopimg or 17767487755)
    logo.Parent = header
    logo.Visible = false

    local title = makeText(header, kavName or "Lollypop Hub", tonumber(env.titlesize) or 16.5, Enum.Font.LuckiestGuy)
    title.Name = "Title"
    title.Position = UDim2.fromOffset(9, 0)
    title.Size = UDim2.new(1, -48, 1, 0)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextWrapped = false

    local close = makeButton(header, "X")
    close.Position = UDim2.new(1, -29, 0, 2)
    close.Size = UDim2.fromOffset(24, 24)
    close.BackgroundTransparency = 1

    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Position = UDim2.fromOffset(0, 29)
    sidebar.Size = UDim2.new(0, 149, 1, -29)
    sidebar.BorderSizePixel = 0
    sidebar.BackgroundTransparency = 0
    sidebar.Parent = main
    bind(sidebar, "BackgroundColor3", "Header")
    makeCorner(sidebar, 13)

    local sideGradient = Instance.new("UIGradient")
    sideGradient.Rotation = 90
    sideGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.SchemeColor),
        ColorSequenceKeypoint.new(1, theme.Accent2),
    })
    sideGradient.Transparency = NumberSequence.new(1)
    sideGradient.Parent = sidebar

    local tabList = Instance.new("ScrollingFrame")
    tabList.Name = "TabList"
    tabList.Position = UDim2.fromOffset(7, 0)
    tabList.Size = UDim2.new(0, 135, 1, 0)
    tabList.BackgroundTransparency = 1
    tabList.BorderSizePixel = 0
    tabList.ScrollBarThickness = 2
    tabList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabList.CanvasSize = UDim2.new()
    tabList.Parent = sidebar
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 0)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = tabList

    local pages = Instance.new("Frame")
    pages.Name = "Pages"
    pages.Position = UDim2.fromOffset(149, 29)
    pages.Size = UDim2.new(1, -149, 1, -49)
    pages.BackgroundTransparency = 1
    pages.ClipsDescendants = true
    pages.Parent = main

    local footer = makeText(main, "Lollypop Hub v10.0.0", 11, Enum.Font.GothamMedium)
    footer.Name = "Footer"
    footer.Position = UDim2.new(0, 158, 1, -20)
    footer.Size = UDim2.new(1, -165, 0, 18)
    footer.TextXAlignment = Enum.TextXAlignment.Right
    bind(footer, "TextColor3", "MutedText")

    local tooltip = makeText(screenGui, "", 12, Enum.Font.GothamMedium)
    tooltip.Name = "Tooltip"
    tooltip.AnchorPoint = Vector2.new(0.5, 1)
    tooltip.Position = UDim2.new(0.5, 0, 1, -18)
    tooltip.Size = UDim2.new(0, 420, 0, 42)
    tooltip.BackgroundTransparency = 1
    tooltip.TextTransparency = 1
    tooltip.Visible = false
    tooltip.ZIndex = 150
    tooltip.TextWrapped = true
    bind(tooltip, "BackgroundColor3", "Header")
    makeCorner(tooltip, 4)
    makeStroke(tooltip, theme.SchemeColor, 1, 1)

    local resize = makeButton(main, "//")
    resize.Name = "ResizeHandle"
    resize.AnchorPoint = Vector2.new(1, 1)
    resize.Position = UDim2.new(1, -3, 1, -3)
    resize.Size = UDim2.fromOffset(24, 24)
    resize.BackgroundTransparency = 1
    resize.TextSize = 12
    resize.ZIndex = 30

    active = {
        ScreenGui = screenGui,
        Main = main,
        Header = header,
        Sidebar = sidebar,
        Pages = pages,
        TabList = tabList,
        Theme = theme,
        MainStroke = mainStroke,
        SideGradient = sideGradient,
        Tooltip = tooltip,
        NotificationHost = createNotificationHost(screenGui),
        Tabs = {},
        SelectedTab = nil,
        Scale = scale,
        Footer = footer,
        Logo = logo,
        ParticleLayer = particleLayer,
        ParticleObjects = particleObjects,
        Cursor = nil,
        SessionStarted = tonumber(env.LHSessionStart) or tick(),
    }
    applyTheme()
    setGlassBlur(true)
    LULA:DraggingEnabled(header, main)

    local particleClock = 0
    track(RunService.RenderStepped:Connect(function(delta)
        if not active or not particleLayer.Visible or settings.LowPerformance or settings.ReducedMotion then return end
        particleClock = particleClock + delta
        if particleClock < 0.035 then return end
        particleClock = 0
        for index, particle in ipairs(particleObjects) do
            particle.Position = UDim2.new(
                particle.Position.X.Scale,
                particle.Position.X.Offset,
                (particle.Position.Y.Scale - 0.0008 * (index + 4)) % 1,
                particle.Position.Y.Offset
            )
        end
    end))

    local customCursor = Instance.new("ImageLabel")
    customCursor.Name = "LollypopCursor"
    customCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    customCursor.Size = UDim2.fromOffset(26, 26)
    customCursor.BackgroundTransparency = 1
    customCursor.Image = "rbxassetid://" .. tostring(env.getImg or env.lollypopimg or 17767487755)
    customCursor.ScaleType = Enum.ScaleType.Fit
    customCursor.ZIndex = 500
    customCursor.Visible = settings.CustomCursor and not UserInputService.TouchEnabled
    customCursor.Parent = screenGui
    active.Cursor = customCursor
    pcall(function() UserInputService.MouseIconEnabled = not customCursor.Visible end)
    track(UserInputService.InputChanged:Connect(function(inputObject)
        if customCursor.Visible and inputObject.UserInputType == Enum.UserInputType.MouseMovement then
            customCursor.Position = UDim2.fromOffset(inputObject.Position.X, inputObject.Position.Y)
        end
    end))

    track(close.MouseButton1Click:Connect(function()
        if type(env.LHRequestClose) == "function" then
            safeCall("Close confirmation", env.LHRequestClose)
        elseif env.LHRuntime and type(env.LHRuntime.Unload) == "function" then
            safeCall("Unload LH", function() env.LHRuntime:Unload("close button") end)
        else
            LULA:Destroy()
        end
    end))

    local logoClicks = 0
    track(logo.MouseButton1Click:Connect(function()
        logoClicks = logoClicks + 1
        tween(logo, {Rotation = logo.Rotation + 120}, 0.22, Enum.EasingStyle.Back)
        if logoClicks >= 7 then
            logoClicks = 0
            LULA:Notify("success", "Easter Egg", "Seven licks. The lollypop woke up.", 5)
            if env.LHEasterEgg then safeCall("Easter egg", env.LHEasterEgg) end
        end
    end))

    local resizing = false
    local resizeStart = nil
    local sizeStart = nil
    track(resize.InputBegan:Connect(function(inputObject)
        if settings.DragLocked then return end
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = inputObject.Position
            sizeStart = main.Size
        end
    end))
    track(UserInputService.InputChanged:Connect(function(inputObject)
        if not resizing then return end
        if inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then
            local delta = inputObject.Position - resizeStart
            local width = math.clamp(sizeStart.X.Offset + delta.X / math.max(scale.Scale, 0.01), 420, 760)
            local height = math.clamp(sizeStart.Y.Offset + delta.Y / math.max(scale.Scale, 0.01), 250, 520)
            main.Size = UDim2.fromOffset(width, height)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            resizing = false
            -- Resized UI intentionally stays exactly where the user leaves it.
        end
    end))

    local function refreshScale()
        scale.Scale = adaptiveScale()
        -- Do not boomerang/reposition the main UI after viewport changes.
    end
    local camera = workspace.CurrentCamera
    if camera then track(camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale)) end
    track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local newCamera = workspace.CurrentCamera
        if newCamera then track(newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale)) end
        refreshScale()
    end))

    local window = {}

    local function selectTab(tab)
        if not tab or active.SelectedTab == tab then
            if tab and tab.EnsureBuilt then tab:EnsureBuilt() end
            return
        end
        local old = active.SelectedTab
        active.SelectedTab = tab
        if old then
            tween(old.Page, {Position = UDim2.new(-0.04, 0, 0, 0), GroupTransparency = 1}, 0.12)
            task.delay(duration(0.13), function() if old.Page then old.Page.Visible = false end end)
            tween(old.Button, {BackgroundTransparency = 1}, 0.1)
        end
        tab:EnsureBuilt()
        tab.Page.Position = UDim2.new(0.04, 0, 0, 0)
        tab.Page.GroupTransparency = 1
        tab.Page.Visible = true
        tween(tab.Page, {Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0}, 0.15)
        tween(tab.Button, {BackgroundTransparency = 0.04}, 0.1)
    end

    function window:NewTab(tabName)
        tabName = tostring(tabName or "Tab")
        local tabButton = makeButton(tabList, tabName)
        tabButton.Name = tabName .. "TabButton"
        tabButton.Size = UDim2.new(0, 135, 0, 28)
        tabButton.TextXAlignment = Enum.TextXAlignment.Left
        tabButton.Text = tabName
        tabButton.BackgroundTransparency = 1
        tabButton.TextSize = tonumber(env.tabtextsize) or 16
        tabButton.Font = resolveUIFont(Enum.Font.DenkOne)

        local page = Instance.new("CanvasGroup")
        page.Name = tabName .. "Page"
        page:SetAttribute("LHTabName", tabName)
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.Parent = pages

        local scroll = Instance.new("ScrollingFrame")
        scroll.Name = "Scroll"
        scroll.Position = UDim2.fromOffset(8, 0)
        scroll.Size = UDim2.new(1, -16, 1, 0)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 3
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.CanvasSize = UDim2.new()
        scroll.Parent = page
        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Padding = UDim.new(0, 5)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = scroll

        local tab = {
            Name = tabName,
            Button = tabButton,
            Page = page,
            Scroll = scroll,
            Built = false,
            Builder = nil,
            Sections = {},
        }

        function tab:SetLazyBuilder(builder)
            self.Builder = builder
            if active and active.SelectedTab == self then self:EnsureBuilt() end
            return self
        end

        function tab:EnsureBuilt()
            if self.Built then return end
            self.Built = true
            if self.Builder then safeCall("Build tab " .. self.Name, self.Builder, self) end
        end

        function tab:NewSection(sectionName, hidden)
            self.Built = true
            sectionName = tostring(sectionName or "Section")
            local section = Instance.new("Frame")
            section.Name = sectionName
            section.Size = UDim2.new(1, -4, 0, 0)
            section.AutomaticSize = Enum.AutomaticSize.Y
            section.BackgroundTransparency = 1
            section.Parent = scroll
            local sectionLayout = Instance.new("UIListLayout")
            sectionLayout.Padding = UDim.new(0, 5)
            sectionLayout.SortOrder = Enum.SortOrder.LayoutOrder
            sectionLayout.Parent = section

            if not hidden then
                local heading = Instance.new("TextLabel")
                heading.Name = "SectionHeading"
                heading.Size = UDim2.new(1, 0, 0, 36)
                heading.BackgroundTransparency = 0
                heading.BackgroundColor3 = rgb(235, 177, 45)
                heading.BorderSizePixel = 0
                heading.Font = resolveUIFont(Enum.Font.GothamBold)
                heading.Text = "[      " .. string.upper(sectionName) .. "      ]"
                heading.TextSize = tonumber(env.sektiontextsize) or 18.5
                heading.TextColor3 = rgb(42, 27, 5)
                heading.TextXAlignment = Enum.TextXAlignment.Center
                heading.TextWrapped = true
                heading.Parent = section
                makeCorner(heading, 7)
                local headingGradient = Instance.new("UIGradient")
                headingGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, rgb(255, 226, 119)),
                    ColorSequenceKeypoint.new(0.5, rgb(232, 164, 31)),
                    ColorSequenceKeypoint.new(1, rgb(255, 207, 74)),
                })
                headingGradient.Rotation = 8
                headingGradient.Parent = heading
                makeStroke(heading, rgb(255, 225, 125), 0.2, 1)
            end

            local elements = {}
            local controls = {}

            local function register(api, row, searchable)
                api = api or {}
                api.Frame = row
                api.SearchText = string.lower(tostring(searchable or row.Name))
                api.BaseVisible = row.Visible
                local searchStroke = makeStroke(row, active.Theme.SchemeColor, 1, 1.4)
                searchStroke.Name = "LHSearchMatch"
                searchStroke.Enabled = false
                table.insert(controls, api)
                function api:SetVisible(value)
                    self.BaseVisible = value and true or false
                    row.Visible = self.BaseVisible
                end
                function api:SetSearchHighlighted(value)
                    searchStroke.Enabled = value and true or false
                    if searchStroke.Enabled then
                        searchStroke.Color = active.Theme.SchemeColor
                        tween(searchStroke, {Transparency = 0.08}, 0.1)
                    else
                        searchStroke.Transparency = 1
                    end
                end
                return api
            end

            function elements:NewButton(name, tip, callback)
                callback = callback or function() end
                local row = newRow(section, name, 33)
                local icon = makeText(row, utf8.char(0x1F449), 18, Enum.Font.PatrickHand)
                icon.Position = UDim2.fromOffset(10, 0)
                icon.Size = UDim2.fromOffset(18, 33)
                bind(icon, "TextColor3", "SchemeColor")
                local textLabel = makeText(row, name, tonumber(env.buttontextsize) or 18, Enum.Font.PatrickHand)
                textLabel.Position = UDim2.fromOffset(34, 0)
                textLabel.Size = UDim2.new(1, -46, 1, 0)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local click = Instance.new("TextButton")
                click.BackgroundTransparency = 1
                click.Text = ""
                click.Size = UDim2.new(1, -34, 1, 0)
                click.Parent = row
                local infoButton = makeButton(row, "...")
                infoButton.Name = "InfoDots"
                infoButton.AnchorPoint = Vector2.new(1, 0.5)
                infoButton.Position = UDim2.new(1, -5, 0.5, 0)
                infoButton.Size = UDim2.fromOffset(28, 25)
                infoButton.TextSize = 15
                infoButton.BackgroundTransparency = 1
                infoButton.ZIndex = 4
                track(infoButton.MouseButton1Click:Connect(function()
                    if tostring(tip or "") ~= "" then
                        LULA:Notify("info", tostring(name), tostring(tip), 5)
                    end
                end))
                local busy = false
                track(click.MouseButton1Click:Connect(function()
                    if row:GetAttribute("LHLongPressTriggered") then
                        row:SetAttribute("LHLongPressTriggered", false)
                        return
                    end
                    if busy then return end
                    busy = true
                    tween(row, {Size = UDim2.new(1, -3, 0, 31)}, 0.06)
                    safeCall("Button " .. tostring(name), callback)
                    task.delay(0.18, function()
                        if row and row.Parent then tween(row, {Size = UDim2.new(1, 0, 0, 33)}, 0.08) end
                        busy = false
                    end)
                end))
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                function api:Fire() safeCall("Button " .. tostring(name), callback) end
                return api
            end

            function elements:NewToggle(name, tip, callback, defaultValue)
                callback = callback or function() end
                local default = defaultValue == true
                local value = default
                local row = newRow(section, name, 36)
                local textLabel = makeText(row, name, tonumber(env.togtextsize) or 17, Enum.Font.PatrickHand)
                textLabel.Position = UDim2.fromOffset(12, 0)
                textLabel.Size = UDim2.new(1, -104, 1, 0)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local pill = Instance.new("Frame")
                pill.Position = UDim2.new(1, -70, 0.5, -11)
                pill.Size = UDim2.fromOffset(38, 22)
                pill.BorderSizePixel = 0
                pill.Parent = row
                makeCorner(pill, 11)
                local knob = Instance.new("Frame")
                knob.Size = UDim2.fromOffset(18, 18)
                knob.Position = UDim2.fromOffset(2, 2)
                knob.BorderSizePixel = 0
                knob.BackgroundColor3 = rgb(245, 245, 248)
                knob.Parent = pill
                makeCorner(knob, 9)
                local hit = Instance.new("TextButton")
                hit.BackgroundTransparency = 1
                hit.Text = ""
                hit.Size = UDim2.fromScale(1, 1)
                hit.Parent = pill
                local function render(animate)
                    local onColor = active.Theme.SchemeColor
                    local offColor = rgb(74, 74, 84)
                    if animate then
                        tween(pill, {BackgroundColor3 = value and onColor or offColor}, 0.12)
                        tween(knob, {Position = value and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)}, 0.12)
                    else
                        pill.BackgroundColor3 = value and onColor or offColor
                        knob.Position = value and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
                    end
                end
                local function set(newValue, fire)
                    value = newValue and true or false
                    render(true)
                    if fire ~= false then safeCall("Toggle " .. tostring(name), callback, value) end
                end
                -- Toggles do not need a separate Reset button; switching OFF is already the reset action.
                track(hit.MouseButton1Click:Connect(function()
                    if row:GetAttribute("LHLongPressTriggered") then
                        row:SetAttribute("LHLongPressTriggered", false)
                        return
                    end
                    set(not value)
                end))
                render(false)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault) default = newDefault == true end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewTextBox(name, tip, callback, placeholder, defaultValue)
                callback = callback or function() end
                local default = tostring(defaultValue or "")
                if default == "TextBox" then default = "" end
                local row = newRow(section, name, 66)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 3)
                textLabel.Size = UDim2.new(1, -46, 0, 23)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local box = Instance.new("TextBox")
                box.Position = UDim2.fromOffset(10, 29)
                box.Size = UDim2.new(1, -46, 0, 29)
                box.BackgroundTransparency = 0.1
                box.BorderSizePixel = 0
                box.ClearTextOnFocus = false
                box.Font = resolveUIFont(Enum.Font.Gotham)
                box.TextSize = 13
                box.TextXAlignment = Enum.TextXAlignment.Left
                box.PlaceholderText = tostring(placeholder or "Type here...")
                box.Text = (default == "TextBox") and "" or default
                box.Parent = row
                if box.Text == "TextBox" then box.Text = "" end
                bind(box, "BackgroundColor3", "Header")
                bind(box, "TextColor3", "TextColor")
                makeCorner(box, 6)
                local padding = Instance.new("UIPadding")
                padding.PaddingLeft = UDim.new(0, 8)
                padding.PaddingRight = UDim.new(0, 8)
                padding.Parent = box
                local function submit()
                    safeCall("TextBox " .. tostring(name), callback, box.Text)
                end
                createReset(row, function() box.Text = default; submit() end)
                attachClearX(box)
                track(box.FocusLost:Connect(function(enterPressed)
                    if enterPressed then submit() end
                end))
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                function api:SetValue(value, fire)
                    box.Text = tostring(value or "")
                    if fire ~= false then submit() end
                end
                function api:GetValue() return box.Text end
                function api:SetResetDefault(newDefault) default = tostring(newDefault or "") end
                function api:Reset() box.Text = default; submit() end
                return api
            end

            function elements:NewSlider(name, tip, minValue, maxValue, callback, defaultValue)
                callback = callback or function() end
                minValue = tonumber(minValue) or 0
                maxValue = tonumber(maxValue) or 100
                if maxValue < minValue then minValue, maxValue = maxValue, minValue end
                local default = math.clamp(tonumber(defaultValue) or minValue, minValue, maxValue)
                local value = default
                local row = newRow(section, name, 70)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 2)
                textLabel.Size = UDim2.new(1, -150, 0, 23)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local valueBox = Instance.new("TextBox")
                valueBox.AnchorPoint = Vector2.new(1, 0)
                -- Keep the number field fully visible and reserve the far-right column for X / R.
                valueBox.Position = UDim2.new(1, -70, 0, 5)
                valueBox.Size = UDim2.fromOffset(70, 24)
                valueBox.BackgroundTransparency = 0.08
                valueBox.BorderSizePixel = 0
                valueBox.ClearTextOnFocus = false
                valueBox.Font = resolveUIFont(Enum.Font.GothamMedium)
                valueBox.TextSize = 12
                valueBox.Parent = row
                bind(valueBox, "BackgroundColor3", "Header")
                bind(valueBox, "TextColor3", "TextColor")
                makeCorner(valueBox, 6)
                local trackBar = Instance.new("Frame")
                trackBar.Position = UDim2.fromOffset(12, 43)
                trackBar.Size = UDim2.new(1, -50, 0, 7)
                trackBar.BorderSizePixel = 0
                trackBar.BackgroundColor3 = rgb(70, 70, 80)
                trackBar.Parent = row
                makeCorner(trackBar, 4)
                local fill = Instance.new("Frame")
                fill.Size = UDim2.new(0, 0, 1, 0)
                fill.BorderSizePixel = 0
                fill.Parent = trackBar
                bind(fill, "BackgroundColor3", "SchemeColor")
                makeCorner(fill, 4)
                local knob = Instance.new("Frame")
                knob.AnchorPoint = Vector2.new(0.5, 0.5)
                knob.Position = UDim2.fromScale(0, 0.5)
                knob.Size = UDim2.fromOffset(15, 15)
                knob.BorderSizePixel = 0
                knob.BackgroundColor3 = rgb(245, 245, 248)
                knob.Parent = trackBar
                makeCorner(knob, 8)
                local dragging = false
                local function set(newValue, fire)
                    value = math.clamp(tonumber(newValue) or value, minValue, maxValue)
                    local alpha = maxValue == minValue and 0 or (value - minValue) / (maxValue - minValue)
                    valueBox.Text = tostring(math.floor(value * 100 + 0.5) / 100)
                    tween(fill, {Size = UDim2.new(alpha, 0, 1, 0)}, 0.08)
                    tween(knob, {Position = UDim2.fromScale(alpha, 0.5)}, 0.08)
                    if fire ~= false then safeCall("Slider " .. tostring(name), callback, value) end
                end
                local function setFromInput(inputObject)
                    local alpha = math.clamp((inputObject.Position.X - trackBar.AbsolutePosition.X) / math.max(trackBar.AbsoluteSize.X, 1), 0, 1)
                    set(minValue + (maxValue - minValue) * alpha)
                end
                track(trackBar.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        setFromInput(inputObject)
                    end
                end))
                track(UserInputService.InputChanged:Connect(function(inputObject)
                    if dragging and (inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch) then
                        setFromInput(inputObject)
                    end
                end))
                track(UserInputService.InputEnded:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then dragging = false end
                end))
                local clearSlider = makeKolorButton(row, "X", rgb(220, 48, 65))
                clearSlider.Name = "ClearSliderTextX"
                clearSlider.AnchorPoint = Vector2.new(1, 0.5)
                clearSlider.Position = UDim2.new(1, -7, 0, 15)
                clearSlider.Size = UDim2.fromOffset(22, 22)
                clearSlider.TextSize = 10
                clearSlider.ZIndex = 7
                track(clearSlider.MouseButton1Click:Connect(function()
                    -- X only clears; it must not summon the keyboard.
                    pcall(function() valueBox:ReleaseFocus(false) end)
                    valueBox.Text = ""
                end))
                track(valueBox.FocusLost:Connect(function(enterPressed) if enterPressed then set(tonumber(valueBox.Text) or value) end end))
                local sliderReset = createReset(row, function() set(default) end)
                sliderReset.Position = UDim2.new(1, -7, 0, 54)
                set(default, false)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault) default = math.clamp(tonumber(newDefault) or minValue, minValue, maxValue) end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewDropdown(name, tip, list, callback, defaultValue)
                callback = callback or function() end
                list = type(list) == "table" and list or {}
                local default = defaultValue ~= nil and defaultValue or list[1]
                local value = default
                local row = newRow(section, name, 70)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 2)
                textLabel.Size = UDim2.new(1, -46, 0, 22)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local selectButton = makeButton(row, value ~= nil and tostring(value) or "Select...")
                selectButton.Position = UDim2.fromOffset(10, 29)
                selectButton.Size = UDim2.new(1, -46, 0, 31)
                selectButton.TextXAlignment = Enum.TextXAlignment.Left
                selectButton.Text = "  " .. selectButton.Text
                makeStroke(selectButton, active.Theme.SchemeColor, 0.55, 1)
                local arrow = makeText(selectButton, utf8.char(0x25BC), 12, Enum.Font.GothamBold)
                arrow.AnchorPoint = Vector2.new(1, 0.5)
                arrow.Position = UDim2.new(1, -10, 0.5, 0)
                arrow.Size = UDim2.fromOffset(18, 20)
                arrow.TextXAlignment = Enum.TextXAlignment.Center
                bind(arrow, "TextColor3", "SchemeColor")
                local popup = Instance.new("ScrollingFrame")
                popup.Name = "DropdownPopup"
                popup.Position = UDim2.fromOffset(10, 62)
                popup.Size = UDim2.new(1, -46, 0, 0)
                popup.BackgroundTransparency = 0.02
                popup.BorderSizePixel = 0
                popup.AutomaticCanvasSize = Enum.AutomaticSize.Y
                popup.CanvasSize = UDim2.new()
                popup.ScrollBarThickness = 2
                popup.Visible = false
                popup.ZIndex = 20
                popup.Parent = row
                bind(popup, "BackgroundColor3", "Header")
                makeCorner(popup, 7)
                makeStroke(popup, active.Theme.SchemeColor, 0.45, 1)
                local popupLayout = Instance.new("UIListLayout")
                popupLayout.Padding = UDim.new(0, 2)
                popupLayout.Parent = popup
                local open = false
                local api
                local function set(newValue, fire)
                    value = newValue
                    selectButton.Text = "  " .. tostring(value or "Select...")
                    if fire ~= false then safeCall("Dropdown " .. tostring(name), callback, value) end
                end
                local function closePopup()
                    open = false
                    arrow.Rotation = 0
                    popup.Visible = false
                    row.Size = UDim2.new(1, 0, 0, 70)
                    popup.Size = UDim2.new(1, -46, 0, 0)
                end
                local function rebuild(newList)
                    list = type(newList) == "table" and newList or {}
                    for _, child in ipairs(popup:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    for _, option in ipairs(list) do
                        local optionButton = makeButton(popup, tostring(option))
                        optionButton.Size = UDim2.new(1, -4, 0, 28)
                        optionButton.TextXAlignment = Enum.TextXAlignment.Left
                        optionButton.Text = (option == value and ("  " .. utf8.char(0x2713) .. "  ") or "     ") .. tostring(option)
                        optionButton.ZIndex = 21
                        if option == value then
                            optionButton.BackgroundTransparency = 0.02
                            bind(optionButton, "TextColor3", "SchemeColor")
                        else
                            optionButton.BackgroundTransparency = 0.16
                        end
                        track(optionButton.MouseButton1Click:Connect(function()
                            set(option)
                            closePopup()
                        end))
                    end
                end
                rebuild(list)
                track(selectButton.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        arrow.Rotation = 180
                        local height = math.min(150, math.max(32, #list * 30))
                        popup.Visible = true
                        popup.Size = UDim2.new(1, -46, 0, height)
                        row.Size = UDim2.new(1, 0, 0, 70 + height)
                    else
                        arrow.Rotation = 0
                        closePopup()
                    end
                end))
                createReset(row, function() set(default) end)
                attachTip(row, tip)
                api = register({}, row, tostring(name) .. " " .. tostring(tip) .. " " .. table.concat(list, " "))
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:Refresh(newList)
                    rebuild(newList)
                    self.SearchText = string.lower(tostring(name) .. " " .. tostring(tip) .. " " .. table.concat(list, " "))
                end
                function api:SetResetDefault(newDefault) default = newDefault end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewCounter(name, tip, stepValue, callback, defaultValue, minValue, maxValue)
                callback = callback or function() end
                local step = math.abs(tonumber(stepValue) or 0.5)
                if step == 0 then step = 0.5 end
                local default = tonumber(defaultValue) or 0
                local minimum = tonumber(minValue)
                local maximum = tonumber(maxValue)
                local value = default
                local row = newRow(section, name, 72)

                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 2)
                textLabel.Size = UDim2.new(1, -46, 0, 22)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left

                local minus = makeKolorButton(row, "-", rgb(214, 50, 67))
                minus.Position = UDim2.fromOffset(10, 31)
                minus.Size = UDim2.fromOffset(42, 31)
                minus.TextSize = 21

                local plus = makeKolorButton(row, "+", rgb(40, 177, 91))
                plus.Position = UDim2.new(1, -87, 0, 31)
                plus.Size = UDim2.fromOffset(42, 31)
                plus.TextSize = 20

                local valueBox = Instance.new("TextBox")
                valueBox.Position = UDim2.fromOffset(58, 31)
                valueBox.Size = UDim2.new(1, -151, 0, 31)
                valueBox.BackgroundTransparency = 0.08
                valueBox.BorderSizePixel = 0
                valueBox.ClearTextOnFocus = false
                valueBox.Font = resolveUIFont(Enum.Font.GothamBold)
                valueBox.TextSize = 13
                valueBox.TextXAlignment = Enum.TextXAlignment.Center
                valueBox.PlaceholderText = tostring(default)
                valueBox.Parent = row
                bind(valueBox, "BackgroundColor3", "Header")
                bind(valueBox, "TextColor3", "TextColor")
                makeCorner(valueBox, 7)
                attachClearX(valueBox)

                local function cleanNumber(number)
                    number = tonumber(number) or 0
                    local rounded = math.floor(number * 10000 + (number >= 0 and 0.5 or -0.5)) / 10000
                    return rounded
                end

                local function set(newValue, fire)
                    local number = tonumber(newValue)
                    if number == nil then number = value end
                    if minimum ~= nil then number = math.max(minimum, number) end
                    if maximum ~= nil then number = math.min(maximum, number) end
                    value = cleanNumber(number)
                    valueBox.Text = tostring(value)
                    if fire ~= false then safeCall("Kounter " .. tostring(name), callback, value) end
                end

                local holdToken = 0
                local function beginHold(direction)
                    holdToken = holdToken + 1
                    local mine = holdToken
                    local started = tick()
                    set(value + (step * direction))
                    task.spawn(function()
                        task.wait(0.3)
                        while mine == holdToken and row.Parent do
                            local elapsed = tick() - started
                            local multiplier = elapsed >= 2 and 5 or (elapsed >= 1 and 2 or 1)
                            set(value + (step * multiplier * direction))
                            task.wait(math.max(0.045, 0.13 - math.min(elapsed, 2) * 0.03))
                        end
                    end)
                end
                local function stopHold()
                    holdToken = holdToken + 1
                end
                local function bindHold(button, direction)
                    track(button.InputBegan:Connect(function(inputObject)
                        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                            beginHold(direction)
                        end
                    end))
                    track(button.InputEnded:Connect(function(inputObject)
                        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                            stopHold()
                        end
                    end))
                    track(button.MouseLeave:Connect(stopHold))
                end
                bindHold(minus, -1)
                bindHold(plus, 1)

                track(valueBox.FocusLost:Connect(function(enterPressed)
                    if enterPressed then set(tonumber(valueBox.Text) or value) end
                end))
                local resetCounter = makeButton(row, "Reset")
                resetCounter.AnchorPoint = Vector2.new(1, 0.5)
                resetCounter.Position = UDim2.new(1, -6, 0, 46)
                resetCounter.Size = UDim2.fromOffset(38, 24)
                resetCounter.TextSize = 9
                resetCounter.ZIndex = 7
                track(resetCounter.MouseButton1Click:Connect(function() set(default) end))
                set(default, false)
                attachTip(row, tip)

                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                function api:SetValue(newValue, fire) set(newValue, fire) end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault) default = tonumber(newDefault) or default end
                function api:Reset() set(default) end
                return api
            end

            function elements:NewKeybind(name, tip, first, callback)
                callback = callback or function() end
                local default = first or Enum.KeyCode.RightShift
                local current = default
                local row = newRow(section, name, 48)
                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 0)
                textLabel.Size = UDim2.new(1, -150, 1, 0)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left
                local bindButton = makeButton(row, UserInputService.TouchEnabled and "MOBILE TAP" or tostring(current.Name or current))
                bindButton.Position = UDim2.new(1, -137, 0.5, -14)
                bindButton.Size = UDim2.fromOffset(101, 28)
                local mobileButton = nil
                local listening = false
                local function removeMobileButton()
                    if mobileButton then mobileButton:Destroy(); mobileButton = nil end
                end
                local function makeMobileButton()
                    removeMobileButton()
                    mobileButton = makeButton(screenGui, ">")
                    mobileButton.Name = "MobileKeybind_" .. tostring(name)
                    mobileButton.AnchorPoint = Vector2.new(1, 0.5)
                    mobileButton.Position = UDim2.new(1, -18, 0.55, 0)
                    mobileButton.Size = UDim2.fromOffset(50, 50)
                    mobileButton.ZIndex = 200
                    makeCorner(mobileButton, 25)
                    track(mobileButton.MouseButton1Click:Connect(function()
                        safeCall("Mobile keybind " .. tostring(name), callback)
                    end))
                    LULA:DraggingEnabled(mobileButton, mobileButton)
                end
                track(bindButton.MouseButton1Click:Connect(function()
                    if UserInputService.TouchEnabled then
                        if mobileButton then
                            removeMobileButton()
                            bindButton.Text = "MOBILE OFF"
                        else
                            makeMobileButton()
                            bindButton.Text = "MOBILE ON"
                        end
                    else
                        listening = true
                        bindButton.Text = "PRESS KEY..."
                    end
                end))
                track(UserInputService.InputBegan:Connect(function(inputObject, processed)
                    if processed then return end
                    if listening and inputObject.UserInputType == Enum.UserInputType.Keyboard then
                        current = inputObject.KeyCode
                        listening = false
                        bindButton.Text = tostring(current.Name)
                        return
                    end
                    if not UserInputService.TouchEnabled and inputObject.KeyCode == current then
                        safeCall("Keybind " .. tostring(name), callback)
                    end
                end))
                createReset(row, function()
                    current = default
                    listening = false
                    removeMobileButton()
                    bindButton.Text = UserInputService.TouchEnabled and "MOBILE TAP" or tostring(current.Name or current)
                end)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip))
                function api:SetValue(newValue)
                    current = newValue or default
                    bindButton.Text = UserInputService.TouchEnabled and "MOBILE TAP" or tostring(current.Name or current)
                end
                function api:GetValue() return current end
                function api:SetResetDefault(newDefault) default = newDefault or default end
                function api:Reset()
                    current = default
                    removeMobileButton()
                end
                return api
            end

            function elements:NewColorPicker(name, tip, defaultColor, callback)
                callback = callback or function() end
                local default = typeof(defaultColor) == "Color3" and defaultColor or active.Theme.SchemeColor
                local value = default
                local hue, saturation, brightness = default:ToHSV()
                local rainbow = false
                local rainbowConnection = nil
                local row = newRow(section, name, 156)

                local textLabel = makeText(row, name, 13, Enum.Font.GothamMedium)
                textLabel.Position = UDim2.fromOffset(12, 0)
                textLabel.Size = UDim2.new(1, -112, 0, 28)
                textLabel.TextXAlignment = Enum.TextXAlignment.Left

                local preview = Instance.new("Frame")
                preview.Position = UDim2.new(1, -70, 0, 6)
                preview.Size = UDim2.fromOffset(34, 22)
                preview.BorderSizePixel = 0
                preview.Parent = row
                makeCorner(preview, 6)
                makeStroke(preview, rgb(255, 255, 255), 0.55, 1)

                -- Main area: full rainbow. X selects hue; Y selects saturation.
                local colorArea = Instance.new("TextButton")
                colorArea.Name = "ManualKolorPicker"
                colorArea.Text = ""
                colorArea.AutoButtonColor = false
                colorArea.Position = UDim2.fromOffset(10, 36)
                colorArea.Size = UDim2.new(1, -96, 0, 82)
                colorArea.BackgroundColor3 = rgb(255, 255, 255)
                colorArea.BorderSizePixel = 0
                colorArea.ClipsDescendants = true
                colorArea.Parent = row
                makeCorner(colorArea, 7)

                local rainbowGradient = Instance.new("UIGradient")
                rainbowGradient.Rotation = 0
                rainbowGradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.00, Color3.fromHSV(0.00, 1, 1)),
                    ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
                    ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
                    ColorSequenceKeypoint.new(0.50, Color3.fromHSV(0.50, 1, 1)),
                    ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
                    ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
                    ColorSequenceKeypoint.new(1.00, Color3.fromHSV(1.00, 1, 1)),
                })
                rainbowGradient.Parent = colorArea

                local saturationLayer = Instance.new("Frame")
                saturationLayer.Size = UDim2.fromScale(1, 1)
                saturationLayer.BackgroundColor3 = rgb(255, 255, 255)
                saturationLayer.BorderSizePixel = 0
                saturationLayer.Parent = colorArea
                local saturationGradient = Instance.new("UIGradient")
                saturationGradient.Rotation = 90
                saturationGradient.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1),
                })
                saturationGradient.Parent = saturationLayer

                local colorCursor = Instance.new("Frame")
                colorCursor.AnchorPoint = Vector2.new(0.5, 0.5)
                colorCursor.Size = UDim2.fromOffset(14, 14)
                colorCursor.BackgroundTransparency = 1
                colorCursor.BorderSizePixel = 0
                colorCursor.ZIndex = 5
                colorCursor.Parent = colorArea
                makeCorner(colorCursor, 7)
                makeStroke(colorCursor, rgb(255, 255, 255), 0, 2)

                -- Side slider: bright selected kolor at top, dark at bottom.
                local brightnessBar = Instance.new("TextButton")
                brightnessBar.Name = "BrightnessBar"
                brightnessBar.Text = ""
                brightnessBar.AutoButtonColor = false
                brightnessBar.Position = UDim2.new(1, -75, 0, 36)
                brightnessBar.Size = UDim2.fromOffset(18, 82)
                brightnessBar.BackgroundColor3 = rgb(255, 255, 255)
                brightnessBar.BorderSizePixel = 0
                brightnessBar.ClipsDescendants = false
                brightnessBar.Parent = row
                makeCorner(brightnessBar, 7)
                local brightnessGradient = Instance.new("UIGradient")
                brightnessGradient.Rotation = 90
                brightnessGradient.Parent = brightnessBar

                local brightnessCursor = Instance.new("Frame")
                brightnessCursor.AnchorPoint = Vector2.new(0.5, 0.5)
                brightnessCursor.Size = UDim2.fromOffset(24, 5)
                brightnessCursor.BackgroundColor3 = rgb(255, 255, 255)
                brightnessCursor.BorderSizePixel = 0
                brightnessCursor.ZIndex = 5
                brightnessCursor.Parent = brightnessBar
                makeCorner(brightnessCursor, 3)
                makeStroke(brightnessCursor, rgb(0, 0, 0), 0.2, 1)

                local rainbowButton = makeButton(row, "Rainbow: OFF")
                rainbowButton.Position = UDim2.fromOffset(10, 124)
                rainbowButton.Size = UDim2.new(1, -46, 0, 25)
                rainbowButton.TextSize = 12
                rainbowButton.ZIndex = 5
                makeStroke(rainbowButton, active.Theme.SchemeColor, 0.45, 1)

                local function stopRainbow()
                    rainbow = false
                    rainbowButton.Text = "Rainbow: OFF"
                    if rainbowConnection then
                        pcall(function() rainbowConnection:Disconnect() end)
                        rainbowConnection = nil
                    end
                end

                local function render(fire)
                    value = Color3.fromHSV(hue, saturation, brightness)
                    preview.BackgroundColor3 = value
                    colorCursor.Position = UDim2.fromScale(hue, saturation)
                    brightnessCursor.Position = UDim2.fromScale(0.5, 1 - brightness)
                    brightnessGradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, saturation, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
                    })
                    if fire ~= false then safeCall("Color picker " .. tostring(name), callback, value) end
                end

                local function set(newColor, fire)
                    if typeof(newColor) ~= "Color3" then return end
                    hue, saturation, brightness = newColor:ToHSV()
                    render(fire)
                end

                local function setColorArea(position)
                    stopRainbow()
                    hue = math.clamp((position.X - colorArea.AbsolutePosition.X) / math.max(colorArea.AbsoluteSize.X, 1), 0, 1)
                    saturation = math.clamp((position.Y - colorArea.AbsolutePosition.Y) / math.max(colorArea.AbsoluteSize.Y, 1), 0, 1)
                    render(true)
                end

                local function setBrightness(position)
                    stopRainbow()
                    local y = math.clamp((position.Y - brightnessBar.AbsolutePosition.Y) / math.max(brightnessBar.AbsoluteSize.Y, 1), 0, 1)
                    brightness = 1 - y
                    render(true)
                end

                local draggingColor = false
                local draggingBrightness = false
                track(colorArea.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        draggingColor = true
                        setColorArea(inputObject.Position)
                    end
                end))
                track(brightnessBar.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        draggingBrightness = true
                        setBrightness(inputObject.Position)
                    end
                end))
                track(UserInputService.InputChanged:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then
                        if draggingColor then setColorArea(inputObject.Position) end
                        if draggingBrightness then setBrightness(inputObject.Position) end
                    end
                end))
                track(UserInputService.InputEnded:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
                        draggingColor = false
                        draggingBrightness = false
                    end
                end))

                local function startRainbow()
                    if rainbow then return end
                    rainbow = true
                    rainbowButton.Text = "Rainbow: ON"
                    rainbowConnection = RunService.RenderStepped:Connect(function()
                        hue = (os.clock() % 5) / 5
                        saturation = 1
                        brightness = 1
                        render(true)
                    end)
                    track(rainbowConnection)
                end

                track(rainbowButton.MouseButton1Click:Connect(function()
                    if rainbow then stopRainbow() else startRainbow() end
                end))

                createReset(row, function()
                    stopRainbow()
                    set(default)
                end)
                set(default, false)
                attachTip(row, tip)
                local api = register({}, row, tostring(name) .. " " .. tostring(tip) .. " rainbow manual kolor picker")
                function api:SetValue(newColor, fire)
                    stopRainbow()
                    set(newColor, fire)
                end
                function api:GetValue() return value end
                function api:SetResetDefault(newDefault)
                    if typeof(newDefault) == "Color3" then default = newDefault end
                end
                function api:SetRainbow(enabled)
                    if enabled then startRainbow() else stopRainbow() end
                end
                function api:Reset()
                    stopRainbow()
                    set(default)
                end
                return api
            end

            function elements:NewLabel(labelText)
                local row = newRow(section, "label", 42)
                row.BackgroundTransparency = 0.08
                local accent = Instance.new("Frame")
                accent.Size = UDim2.new(0, 4, 1, -10)
                accent.Position = UDim2.fromOffset(6, 5)
                accent.BorderSizePixel = 0
                accent.BackgroundColor3 = rgb(236, 176, 40)
                accent.Parent = row
                makeCorner(accent, 2)
                local label = makeText(row, tostring(labelText or ""), 12.5, Enum.Font.GothamMedium)
                label.Position = UDim2.fromOffset(17, 4)
                label.Size = UDim2.new(1, -25, 1, -8)
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.TextYAlignment = Enum.TextYAlignment.Center
                bind(label, "TextColor3", "MutedText")
                local api = register({}, row, tostring(labelText))
                function api:UpdateLabel(newText) label.Text = tostring(newText or "") end
                return api
            end

            function elements:NewParagraph(paragraphTitle, paragraphText)
                local row = newRow(section, "paragraph", 76)
                row.AutomaticSize = Enum.AutomaticSize.Y
                local heading = makeText(row, paragraphTitle or "", 14, Enum.Font.GothamBold)
                heading.Position = UDim2.fromOffset(12, 8)
                heading.Size = UDim2.new(1, -24, 0, 20)
                heading.TextXAlignment = Enum.TextXAlignment.Left
                local body = makeText(row, paragraphText or "", 12, Enum.Font.Gotham)
                body.Position = UDim2.fromOffset(12, 31)
                body.Size = UDim2.new(1, -24, 0, 38)
                body.AutomaticSize = Enum.AutomaticSize.Y
                body.TextXAlignment = Enum.TextXAlignment.Left
                body.TextYAlignment = Enum.TextYAlignment.Top
                bind(body, "TextColor3", "MutedText")
                return register({}, row, tostring(paragraphTitle) .. " " .. tostring(paragraphText))
            end

            function elements:NewKreditsCard(config)
                config = config or {}
                local username = tostring(config.Username or "lulaslollipop")
                local displayName = tostring(config.DisplayName or (LocalPlayer and LocalPlayer.DisplayName) or username)
                local userId = tonumber(config.UserId) or 3001347724
                local sessionStarted = tonumber(config.SessionStarted) or tonumber(env.LHSessionStart) or (active and active.SessionStarted) or tick()
                local row = newRow(section, "KreditsCard", 252)

                local avatar = Instance.new("ImageLabel")
                avatar.AnchorPoint = Vector2.new(0.5, 0)
                avatar.Position = UDim2.new(0.5, 0, 0, 10)
                avatar.Size = UDim2.fromOffset(82, 82)
                avatar.BackgroundTransparency = 1
                avatar.Parent = row
                makeCorner(avatar, 41)
                makeStroke(avatar, rgb(236, 176, 40), 0.12, 2)
                task.spawn(function()
                    if thumbnailCache[userId] then
                        avatar.Image = thumbnailCache[userId]
                        return
                    end
                    local ok, image = pcall(function()
                        return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                    end)
                    if ok then thumbnailCache[userId] = image end
                    if ok and avatar.Parent then avatar.Image = image end
                end)

                local welcome = makeText(row, "Welkome to Lollypop Hub, " .. displayName, 15, Enum.Font.GothamBold)
                welcome.Position = UDim2.fromOffset(12, 99)
                welcome.Size = UDim2.new(1, -24, 0, 24)
                welcome.TextXAlignment = Enum.TextXAlignment.Center

                local owner = makeText(row, "Owner: @" .. username, 12, Enum.Font.GothamMedium)
                owner.Position = UDim2.fromOffset(12, 124)
                owner.Size = UDim2.new(1, -24, 0, 18)
                owner.TextXAlignment = Enum.TextXAlignment.Center
                bind(owner, "TextColor3", "SchemeColor")

                local liveTime = makeText(row, "Live Time: " .. os.date("%I:%M:%S %p"), 12, Enum.Font.Gotham)
                liveTime.Position = UDim2.fromOffset(14, 148)
                liveTime.Size = UDim2.new(1, -28, 0, 18)
                liveTime.TextXAlignment = Enum.TextXAlignment.Left
                bind(liveTime, "TextColor3", "MutedText")

                local sessionTime = makeText(row, "Session Time: 00:00:00", 12, Enum.Font.Gotham)
                sessionTime.Position = UDim2.fromOffset(14, 168)
                sessionTime.Size = UDim2.new(1, -28, 0, 18)
                sessionTime.TextXAlignment = Enum.TextXAlignment.Left
                bind(sessionTime, "TextColor3", "SchemeColor")

                local today = makeText(row, "Today's Date: " .. os.date("%A, %B %d, %Y"), 12, Enum.Font.Gotham)
                today.Position = UDim2.fromOffset(14, 188)
                today.Size = UDim2.new(1, -28, 0, 18)
                today.TextXAlignment = Enum.TextXAlignment.Left
                bind(today, "TextColor3", "MutedText")

                local lastOnline = makeText(row, "Last Online: " .. tostring(config.LastOnline or "Today"), 12, Enum.Font.Gotham)
                lastOnline.Position = UDim2.fromOffset(14, 208)
                lastOnline.Size = UDim2.new(0.5, -14, 0, 18)
                lastOnline.TextXAlignment = Enum.TextXAlignment.Left
                bind(lastOnline, "TextColor3", "MutedText")

                local statusText = tostring(config.OnlineStatus or "Online")
                local statusIcon = statusText:lower() == "offline" and utf8.char(0x1F534) or utf8.char(0x1F7E2)
                local status = makeText(row, "Online Status: " .. statusText .. " " .. statusIcon, 12, Enum.Font.Gotham)
                status.Position = UDim2.new(0.5, 0, 0, 208)
                status.Size = UDim2.new(0.5, -14, 0, 18)
                status.TextXAlignment = Enum.TextXAlignment.Right
                bind(status, "TextColor3", "SchemeColor")

                task.spawn(function()
                    while row.Parent do
                        local elapsed = math.max(0, math.floor(tick() - sessionStarted))
                        local hours = math.floor(elapsed / 3600)
                        local minutes = math.floor((elapsed % 3600) / 60)
                        local seconds = elapsed % 60
                        liveTime.Text = "Live Time: " .. os.date("%I:%M:%S %p")
                        sessionTime.Text = string.format("Session Time: %02d:%02d:%02d", hours, minutes, seconds)
                        today.Text = "Today's Date: " .. os.date("%A, %B %d, %Y")
                        task.wait(1)
                    end
                end)

                local api = register({}, row, username .. " " .. displayName .. " session time")
                api.Rows = {
                    Username = owner,
                    Welcome = welcome,
                    LastOnline = lastOnline,
                    OnlineStatus = status,
                    LiveTime = liveTime,
                    SessionTime = sessionTime,
                    Today = today,
                    Status = status,
                }
                api.Avatar = avatar
                function api:UpdateRow(key, newValue)
                    if self.Rows[key] then self.Rows[key].Text = tostring(newValue) end
                end
                return api
            end

            sectionControlRegistry[section] = controls
            table.insert(tab.Sections, section)
            return elements
        end

        function tab:NewSearchBar(config)
            config = config or {}
            local holder = newRow(scroll, "KavoSearch", 40)
            holder.LayoutOrder = -100000
            local box = Instance.new("TextBox")
            box.Position = UDim2.fromOffset(8, 5)
            box.Size = UDim2.new(1, -44, 0, 30)
            box.BackgroundTransparency = 1
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            box.Font = resolveUIFont(Enum.Font.Gotham)
            box.TextSize = 13
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.PlaceholderText = tostring(config.Placeholder or "Search...")
            box.Text = ""
            box.Parent = holder
            bind(box, "TextColor3", "TextColor")
            local clear = makeKolorButton(holder, "X", rgb(220, 48, 65))
            clear.Position = UDim2.new(1, -34, 0, 6)
            clear.Size = UDim2.fromOffset(28, 28)
            clear.BackgroundTransparency = 0.08
            local searching = false
            local savedSectionVisibility = setmetatable({}, {__mode = "k"})
            local savedControlVisibility = setmetatable({}, {__mode = "k"})
            local function apply(query)
                query = string.lower(tostring(query or "")):gsub("^%s+", ""):gsub("%s+$", "")

                if query == "" and not searching then
                    for _, sectionFrame in ipairs(tab.Sections) do
                        for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                            if api.SetSearchHighlighted then api:SetSearchHighlighted(false) end
                        end
                    end
                    return
                end

                if query ~= "" and not searching then
                    searching = true
                    for _, sectionFrame in ipairs(tab.Sections) do
                        savedSectionVisibility[sectionFrame] = sectionFrame.Visible
                        for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                            savedControlVisibility[api] = api.Frame.Visible
                        end
                    end
                elseif query == "" and searching then
                    searching = false
                    for _, sectionFrame in ipairs(tab.Sections) do
                        sectionFrame.Visible = savedSectionVisibility[sectionFrame] ~= false
                        for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                            api.Frame.Visible = savedControlVisibility[api] ~= false
                            if api.SetSearchHighlighted then api:SetSearchHighlighted(false) end
                        end
                    end
                    table.clear(savedSectionVisibility)
                    table.clear(savedControlVisibility)
                    return
                end

                for _, sectionFrame in ipairs(tab.Sections) do
                    local any = query == ""
                    for _, api in ipairs(sectionControlRegistry[sectionFrame] or {}) do
                        local originallyVisible = savedControlVisibility[api] ~= false
                        local matched = query == "" or (originallyVisible and string.find(api.SearchText or "", query, 1, true) ~= nil)
                        api.Frame.Visible = matched
                        if api.SetSearchHighlighted then api:SetSearchHighlighted(query ~= "" and matched) end
                        if matched then any = true end
                    end
                    sectionFrame.Visible = any
                end
            end
            track(box:GetPropertyChangedSignal("Text"):Connect(function() apply(box.Text) end))
            track(clear.MouseButton1Click:Connect(function() box.Text = ""; apply("") end))
            return {Frame = holder, TextBox = box, ClearButton = clear, Apply = apply}
        end

        table.insert(active.Tabs, tab)
        track(tabButton.MouseButton1Click:Connect(function() selectTab(tab) end))
        if not active.SelectedTab then
            active.SelectedTab = tab
            tab.Page.Visible = true
            tab.Button.BackgroundTransparency = 0.04
        end
        return tab
    end

    function window:SelectTab(name)
        local needle = string.lower(tostring(name or ""))
        for _, tab in ipairs(active.Tabs) do
            if string.lower(tab.Name) == needle or string.find(string.lower(tab.Name), needle, 1, true) then
                selectTab(tab)
                return true
            end
        end
        return false
    end

    function window:GetTabs() return active.Tabs end
    function window:GetRoot() return main end
    function window:SetFooter(text) footer.Text = tostring(text or "") end
    function window:SetFont(fontName) return LULA:SetFont(fontName) end
    function window:Notify(...) return LULA:Notify(...) end
    function window:SetVisible(value) return LULA:SetUIVisible(value) end
    function window:IsVisible() return LULA:IsVisible() end
    function window:Destroy() LULA:Destroy() end

    active.Window = window
    return window
end

function LULA:ToggleUI()
    if active and active.ScreenGui then
        active.ScreenGui.Enabled = not active.ScreenGui.Enabled
        setGlassBlur(active.ScreenGui.Enabled)
        return active.ScreenGui.Enabled
    end
    return false
end

function LULA:SetUIVisible(value)
    if not active or not active.ScreenGui then return false end
    active.ScreenGui.Enabled = value and true or false
    setGlassBlur(active.ScreenGui.Enabled)
    return active.ScreenGui.Enabled
end

function LULA:IsVisible()
    return active and active.ScreenGui and active.ScreenGui.Enabled == true or false
end

function LULA:ChangeColor(property, color)
    if not active or typeof(color) ~= "Color3" then return false end
    local aliases = {Accent = "SchemeColor", Scheme = "SchemeColor"}
    property = aliases[property] or property
    if active.Theme[property] == nil then return false end
    active.Theme[property] = color
    if property == "SchemeColor" then env.LollypopTheme = color end
    applyTheme()
    return true
end

function LULA:SetTheme(themeInput)
    if not active then return false end
    active.Theme = resolveTheme(themeInput)
    applyTheme()
    return true
end

function LULA:GetFontNames()
    local copy = {}
    for index, name in ipairs(fontNames) do copy[index] = name end
    return copy
end

function LULA:SetFont(fontName)
    fontName = tostring(fontName or "Gotham")
    if not fontMap[fontName] then return false end
    settings.UIFont = fontName
    applyUIFont()
    return true
end

function LULA:SetReducedMotion(value)
    settings.ReducedMotion = value and true or false
end

function LULA:SetLowPerformance(value)
    settings.LowPerformance = value and true or false
    setGlassBlur(not settings.LowPerformance)
    if active and active.ParticleLayer then active.ParticleLayer.Visible = false end
end

function LULA:SetDragLocked(value)
    settings.DragLocked = value and true or false
end

function LULA:SetEdgeSnap(value)
    settings.EdgeSnap = value and true or false
end

function LULA:SetScaleMode(value)
    settings.ScaleMode = tostring(value or "Auto")
    if active and active.Scale then
        active.Scale.Scale = adaptiveScale()
        task.defer(function() clampMain(active.Main) end)
    end
end

function LULA:SetGlassBlur(_value)
    settings.GlassBlur = false
    setGlassBlur(false)
end

function LULA:SetCustomCursor(value)
    settings.CustomCursor = value and true or false
    if active and active.Cursor then
        active.Cursor.Visible = settings.CustomCursor and not UserInputService.TouchEnabled
        pcall(function() UserInputService.MouseIconEnabled = not active.Cursor.Visible end)
    end
end

function LULA:GetNotificationHistory()
    return notificationHistory
end

function LULA:GetActiveWindow()
    return active and active.Window or nil
end

function LULA:GetRoot()
    return active and active.Main or nil
end

function LULA:Destroy()
    if not active then return end
    pcall(function() UserInputService.MouseIconEnabled = true end)
    disconnectAll()
    if active.Blur then pcall(function() active.Blur:Destroy() end) end
    if active.ScreenGui then pcall(function() active.ScreenGui:Destroy() end) end
    active = nil
    bindings = {}
end

return LULA
